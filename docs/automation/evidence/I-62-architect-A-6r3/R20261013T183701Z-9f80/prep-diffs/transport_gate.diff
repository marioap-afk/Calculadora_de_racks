+UTF8_BOM = b"\xef\xbb\xbf"
+UTF16_BOMS = (b"\xff\xfe", b"\xfe\xff")
+
+
+def decode_cli_output(b, context=8):
+    """Decodificación explícita de la salida de claude.exe (decisiones §84, punto 5). Pura: la autoprueba la ejerce con bytes sintéticos.
+    UTF-8 estricto; el BOM UTF-8 inicial se quita y se registra (Bom); nunca la página de la consola ni la del locale. Falla cerrado (Ok = false,
+    Text = None) ante una salida no capturada en bytes, vacía, con BOM UTF-16 o que no es UTF-8; HexExcerpt = los bytes del problema y hasta
+    `context` bytes a cada lado (context=0: solo los bytes del problema). → {Ok, Problems, Encoding, Bytes, Bom, Text, HexExcerpt}."""
+    probs = []
+    raw = bytes(b) if isinstance(b, (bytes, bytearray)) else None
+    out = {"Encoding": "utf-8 (estricto; BOM UTF-8 inicial quitado y registrado)", "Bytes": len(raw) if raw is not None else None, "Bom": False,
+           "Text": None, "HexExcerpt": None}
+    body = raw or b""
+    if body.startswith(UTF8_BOM):
+        out["Bom"], body = True, body[len(UTF8_BOM):]
+    if raw is None:
+        probs.append("salida del binario no capturada en bytes (%s)" % type(b).__name__)
+    elif not body.strip():
+        probs.append("salida del binario vacía (%d bytes)" % len(raw))
+        out["HexExcerpt"] = body[:2 * context].hex(" ")
+    elif body[:2] in UTF16_BOMS:
+        probs.append("salida del binario con BOM UTF-16 (%s): no es UTF-8" % body[:2].hex(" "))
+        out["HexExcerpt"] = body[:2 + 2 * context].hex(" ")
+    else:
+        try:
+            out["Text"] = body.decode("utf-8", "strict")
+        except UnicodeDecodeError as e:
+            probs.append("salida del binario que no es UTF-8 estricto (posición %d: %s)" % (e.start, e.reason))
+            out["HexExcerpt"] = body[max(0, e.start - context):e.end + context].hex(" ")
+    out["Problems"], out["Ok"] = probs, not probs
+    return out
+
+
+def run_bytes(argv, cwd):
+    """Ejecuta argv y devuelve (código de salida, stdout en BYTES): sin text=True, ninguna decodificación implícita."""
+    r = subprocess.run(argv, capture_output=True, cwd=cwd)
+    return r.returncode, r.stdout
+
+
 def cli_version(path, cwd):
-    return subprocess.run([path, "--version"], capture_output=True, text=True, cwd=cwd).stdout.strip()
+    """`--version` en bytes, decodificado con decode_cli_output. → {Version: el texto sin espacios en los extremos, o None si no se decodifica;
+    ReturnCode; Decoding: el registro de la decodificación, sin el texto}."""
+    rc, out = run_bytes([path, "--version"], cwd)
+    d = decode_cli_output(out)
+    return {"Version": d["Text"].strip() if d["Ok"] else None, "ReturnCode": rc, "Decoding": {k: v for k, v in d.items() if k != "Text"}}
 
