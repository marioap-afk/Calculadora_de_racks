    "eng/research/I52Ctda/harness/Program.cs",
    "eng/research/I52Ctda/tests/Program.cs",
    "eng/research/I52Ctda/README.md"
  ],
  "testsAdded": [
    "smoke pass control",
    "smoke rejects unbound fixture",
    "smoke rejects fixture count",
    "smoke rejects incomplete cleanup",
    "smoke rejects unavailable logger",
    "logger fallback path",
    "smoke command identity",
    "smoke event log checks",
    "harness requires scratch dwg",
    "harness process fence",
    "smoke rejects governed dispatch"
  ],
  "materializationBindings": {
    "normative": "STATE-S-0 bytes HFV30:S:0; STATE-M-0 displacement (10,20,0) and layer RACKCAD_CTDA_V30_A; STATE-SM-0 siblings {F-REF-A,F-REF-B}; F-REF-C absent; layer RACKCAD_CTDA_V30_B for STATE-M-1",
    "nonNormative": "reference block RACKCAD_CTDA_V34_REF (one AcDbPoint); F-XR NOD key RACKCAD_CTDA_V34_F-XR; triggers are AcDbPoint entities on layer 0 at (1000|1010|1020,0,0); F-REF-A at (0,0,0); F-REF-C at (20,20,0) then erased; smoke reactors: object reactor on F-TRIGGER-ERASE-OBJ, entity reactor on F-REF-A",
    "openItem": "STATE-SM-0 linkage bytes HFV30:LINK:A,B have no storage defined in NPM/FEC-V34; not materialized; Coordinator/Architect decision required before governed SM/ALL probes"
  },
