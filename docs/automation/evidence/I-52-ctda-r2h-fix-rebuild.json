  "entrySha": "c096ca1f1bc2d0c845839f9e97fbe14e483b728e",
  "defects": {
    "R2H-D1": "I52CTDA_SMOKE materializes the FEC-V34 fixture in its own runtime-owned bootstrap transaction (F-TRIGGER-MOD/ERASE-DB/ERASE-OBJ, F-XR in NOD at STATE-S-0, F-REF-A, F-REF-B at STATE-M-0, F-REF-C declared absent as an erased reference, layers RACKCAD_CTDA_V30_A/B), calls I52CtdaFixture::bind and registerFixtureObjects (now by ObjectId), resolves the 7 identities and emits a deterministic snapshot",
    "R2H-D2": "result and cleanup computed from runtime state: fixture bound, 7/7 resolved, logger ready, cleanupComplete(), fixture reactors detached, owned transactions/locks/queued work/guards zero, governed dispatch zero; no literal PASS or cleanup text",
    "R2H-D3": "ordered logger honors I52_CTDA_EVENT_LOG, otherwise derives <I52_CTDA_OUTPUT>.events.jsonl, fails closed with neither; every record carries sequence, timestamp, PID, TID, document, database, application context, command identity and detail; smoke markers BEGIN/MATERIALIZED/BOUND/RESOLVED/END carry cleanup state; unload writes MARK-UNLOAD-REACTORS",
    "R2H-D4": "harness smoke requires an explicit existing scratch DWG, starts one dedicated AutoCAD process on it, records PID/start/exit/executable/arguments, unloads the helper and quits without saving, verifies the exact PID is gone, times out fail-closed and evaluates PASS only when native report, event log and process fence agree"
  },
  "additionalCorrection": "registerFixtureObjects stored raw object pointers and unregisterReactors called removeReactor on closed objects; reactors are now attached/detached by ObjectId with the target open for read, and an undetachable fixture reactor is leaked instead of deleted",
  "filesChanged": [
    "eng/research/I52Ctda/native/I52CtdaFixture.h",
    "eng/research/I52Ctda/native/I52CtdaFixture.cpp",
    "eng/research/I52Ctda/native/I52CtdaRuntime.h",
    "eng/research/I52Ctda/native/I52CtdaRuntime.cpp",
    "eng/research/I52Ctda/native/I52CtdaNative.cpp",
