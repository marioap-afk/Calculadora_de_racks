     "type": [
      "boolean",
      "null"
     ]
    },
    "PackageBlobMatches": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "GuardsBlobMatches": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "GuardsResultBlobMatches": {
     "type": [
      "boolean",
      "null"
     ]
