     "$ref": "#/$defs/tn"
    },
    "SuitableForCoordinatorAgreement": {
     "$ref": "#/$defs/tn"
    }
   }
  },
  "KnownLimitations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "RecommendedNextAction": {
   "type": "string"
  }
 },
 "$defs": {
  "tn": {
   "type": [
    "boolean",
    "null"
   ]
  },
  "premise": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "Path",
    "Section",
    "LineStart",
    "LineEnd",
    "Quote"
   ],
   "properties": {
    "Path": {
     "type": "string",
     "minLength": 1
    },
    "Section": {
     "type": "string"
    },
    "LineStart": {
     "type": "integer",
     "minimum": 1
    },
    "LineEnd": {
     "type": "integer",
     "minimum": 1
    },
    "Quote": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "required": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "FindingId",
    "AffectedDelta",
    "ViolatedInvariant",
    "Counterexample",
    "CorrectionRequired",
    "PremiseRefs",
    "WhyItMatters"
   ],
   "properties": {
    "FindingId": {
     "type": "string",
     "pattern": "^A62-A2-[0-9]{2}$"
    },
    "AffectedDelta": {
     "type": "string",
     "minLength": 1
    },
    "ViolatedInvariant": {
     "type": "string"
    },
    "Counterexample": {
     "type": "string"
    },
    "CorrectionRequired": {
     "type": "string",
     "minLength": 1
    },
    "PremiseRefs": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/premise"
     }
    },
    "WhyItMatters": {
     "type": "string",
     "minLength": 1
    }
   },
   "anyOf": [
    {
     "properties": {
      "ViolatedInvariant": {
       "minLength": 1
      }
     }
    },
    {
     "properties": {
      "Counterexample": {
       "minLength": 1
      }
     }
    }
   ]
  },
  "optional": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "FindingId",
    "AffectedDelta",
    "Note",
    "PremiseRefs"
   ],
   "properties": {
    "FindingId": {
     "type": "string",
     "pattern": "^A62-A2-O[0-9]+$"
    },
    "AffectedDelta": {
     "type": "string"
    },
    "Note": {
     "type": "string",
     "minLength": 1
    },
    "PremiseRefs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/premise"
     }
    }
   }
  },
  "nochange": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "Assessment",
    "Note"
   ],
   "properties": {
    "Assessment": {
     "enum": [
      "NO_CHANGE",
      "CHANGE",
      "NOT_DETERMINED"
     ]
    },
    "Note": {
     "type": "string"
    }
   }
  },
  "mtable": {
