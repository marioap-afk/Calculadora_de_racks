  "NoChangeConfirmation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "ContractsB1toB11",
    "StateV2",
    "Section20",
    "A1",
    "AutomationPlan16x",
    "F4"
   ],
   "properties": {
