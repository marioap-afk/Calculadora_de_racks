     "FindingIds": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^A62-A2-(O[0-9]+|[0-9]{2})$"
      }
     },
     "Rationale": {
      "type": "string",
      "minLength": 1
     },
     "PremiseRefs": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/premise"
      }
     }
    }
   }
  },
  "Focus": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "Item",
     "Assessment",
     "Note"
