    "type": "string"
   }
  },
  "Verdict": {
   "enum": [
    "AGREED",
    "CHANGES REQUIRED",
    "BLOCKED — OWNER DECISION",
    "NOT_ACCREDITED"
   ]
  },
  "RequiredFindings": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/required"
   }
  },
  "OptionalFindings": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/optional"
   }
  },
  "QuestionDispositions": {
   "type": "array",
   "items": {
