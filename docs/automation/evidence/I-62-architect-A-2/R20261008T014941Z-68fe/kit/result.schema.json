      "boolean",
      "null"
     ]
    },
    "Notes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "Guard",
       "ClaimHolds",
       "Note"
      ],
      "properties": {
       "Guard": {
        "enum": [
         "G1",
         "G2",
         "G3",
         "G4",
         "G5"
        ]
       },
       "ClaimHolds": {
        "enum": [
         "HOLDS",
         "DOES_NOT_HOLD",
         "NOT_VERIFIED"
        ]
       },
       "Note": {
        "type": "string"
       }
      }
     }
    }
   }
