{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "rackcad-architect-review-result/v1 — representación experimental para la revisión formal de la enmienda candidata A-2 (I-62; kit adaptado del kit v4 de A-1)",
 "$comment": "NOT_ASSESSED (Materiality) y null (ReviewedCommit, ReviewedBlob, IdentityCheck, LegacyApplicability, OwnerDecisionRequired) solo con Verdict = NOT_ACCREDITED; con un veredicto, el auditor v4-a2.1 los exige evaluados",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "Schema",
  "RunId",
  "InvocationId",
  "LogicalReviewRequestId",
  "AttemptSeq",
  "RequestedRole",
  "Action",
  "ReviewedUnit",
  "ReviewedCommit",
  "ReviewedPath",
  "ReviewedBlob",
  "ReviewerMode",
  "SamePersonAsAuthor",
  "ReviewerDeclaredIdentity",
  "InjectedContextDeclaration",
  "IdentityCheck",
  "InputsRead",
  "Verdict",
  "RequiredFindings",
  "OptionalFindings",
  "QuestionDispositions",
  "Focus",
  "NoChangeConfirmation",
  "GuardsVerification",
  "Materiality",
  "OwnerAuthorityCheck",
  "LegacyApplicability",
  "IfAgreed",
  "KnownLimitations",
  "RecommendedNextAction"
 ],
 "properties": {
  "Schema": {
   "type": "string",
   "minLength": 1
  },
  "RunId": {
   "type": "string",
   "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
  },
  "InvocationId": {
   "type": "string",
   "pattern": "^I[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
  },
  "LogicalReviewRequestId": {
   "type": "string",
   "pattern": "^L[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
  },
  "AttemptSeq": {
   "type": "integer",
   "const": 1
  },
  "RequestedRole": {
   "const": "ARCHITECT"
  },
  "Action": {
   "const": "REVIEW_DESIGN"
  },
  "ReviewedUnit": {
   "const": "I-62"
  },
  "ReviewedCommit": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{40}$"
  },
  "ReviewedPath": {
   "const": "docs/initiatives/I-62-A-2.md"
  },
  "ReviewedBlob": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{40}$"
  },
  "ReviewerMode": {
   "enum": [
    "SAME-SESSION ROLE",
    "SEPARATE SESSION",
    "EXTERNAL HUMAN"
   ]
  },
  "SamePersonAsAuthor": {
   "type": "string",
   "minLength": 1
  },
  "ReviewerDeclaredIdentity": {
   "type": "object",
   "additionalProperties": false,
