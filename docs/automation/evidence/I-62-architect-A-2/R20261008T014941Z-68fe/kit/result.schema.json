    "additionalProperties": false,
    "required": [
     "Id",
     "Disposition",
     "FindingIds",
     "Rationale",
     "PremiseRefs"
    ],
    "properties": {
     "Id": {
      "enum": [
       "Q-A2-01",
       "Q-A2-02",
       "Q-A2-03",
       "Q-A2-04",
       "Q-A2-05",
       "Q-A2-06",
       "Q-A2-07"
      ]
     },
     "Disposition": {
      "enum": [
       "REQUIRED",
       "OPTIONAL",
       "NO_FINDING"
      ]
