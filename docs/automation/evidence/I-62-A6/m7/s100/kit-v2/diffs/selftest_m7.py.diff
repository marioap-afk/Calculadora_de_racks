+def nocontract(b):
+    """kit v2: the log without its executions of `contract` (both events of each such item; lines kept byte for byte), so that the
+    reconstruction rule v3 (declared order set) is compared with the reference on the rest of the log."""
+    lines = b.split(b'\n')
+    drop = set()
+    for line in lines:
+        try:
+            it = json.loads(line.decode('utf-8')).get('item')
+        except Exception:
+            continue
+        if isinstance(it, dict) and it.get('type') == 'command_execution' and L.B in (it.get('command') or '') \
+                and ' -I - contract ' in (it.get('command') or ''):
+            drop.add(it.get('id'))
+    if not drop:
+        return b
+    keep = []
+    for line in lines:
+        try:
+            it = json.loads(line.decode('utf-8')).get('item')
+        except Exception:
+            it = None
+        if isinstance(it, dict) and it.get('id') in drop:
+            continue
+        keep.append(line)
+    return b'\n'.join(keep)
+
