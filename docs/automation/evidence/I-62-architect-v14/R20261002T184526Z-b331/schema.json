        "Section": {
          "type": "string"
        },
        "LineStart": {
          "type": "integer"
        },
        "LineEnd": {
          "type": "integer"
        },
        "Quote": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "FindingId",
        "LineageId",
