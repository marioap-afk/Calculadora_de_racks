            "type": "string",
            "enum": [
              "CONFIRMED",
              "CHALLENGED"
            ]
          },
          "Rationale": {
            "type": "string"
          }
        }
      }
    },
    "OwnerDecisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
