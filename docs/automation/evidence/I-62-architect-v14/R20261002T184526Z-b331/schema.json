    "ReviewedUnit": {
      "type": "string"
    },
    "ReviewedCommit": {
      "type": "string"
    },
    "ReviewedPath": {
      "type": "string"
    },
    "ReviewedBlob": {
      "type": "string"
    },
    "PackagePath": {
      "type": "string"
