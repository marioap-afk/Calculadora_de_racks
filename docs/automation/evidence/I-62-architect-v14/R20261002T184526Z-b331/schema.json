    "InjectedContextDeclaration",
    "InputsRead",
    "InputFidelityEvidenceRef",
    "IndependenceEvidence",
    "Verdict",
    "RequiredFindings",
    "OptionalFindings",
    "FindingDispositions",
    "Downgrades",
    "RequirementAssessments",
