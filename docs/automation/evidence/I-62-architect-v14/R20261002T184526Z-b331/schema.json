    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Path",
        "Section",
        "LineStart",
        "LineEnd"
      ],
      "properties": {
        "Path": {
          "type": "string"
        },
        "Section": {
          "type": "string"
        },
        "LineStart": {
          "type": "integer"
        },
        "LineEnd": {
          "type": "integer"
        }
      }
    }
  }
