    "FreezeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A62V1101State",
        "PriorClosuresValid",
        "BothOD6AlternativesExecutable",
        "ReadyForConsensusFreezeAfterOD6",
        "Notes"
      ],
      "properties": {
        "A62V1101State": {
          "type": "string"
        },
        "PriorClosuresValid": {
          "type": "string"
        },
        "BothOD6AlternativesExecutable": {
          "type": "string"
        },
        "ReadyForConsensusFreezeAfterOD6": {
          "type": "string"
        },
        "Notes": {
          "type": "string"
        }
      }
    },
    "AutonomyAssessment": {
      "type": "string"
    },
    "KnownLimitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "RecommendedNextAction": {
      "type": "string"
    }
