        "CorrectionRequired"
      ],
      "properties": {
        "FindingId": {
          "type": "string"
        },
        "LineageId": {
          "type": "string"
        },
        "Source": {
          "type": "string"
        },
        "AffectedSection": {
          "type": "string"
        },
        "Evidence": {
          "type": "string"
        },
        "PremiseRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/premise"
          }
        },
        "WhyItMatters": {
          "type": "string"
        },
        "CorrectionRequired": {
          "type": "string"
        },
        "PremiseEnvelopeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "NormativeDependencyRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
