          "Rationale": {
            "type": "string"
          },
          "PremiseRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/premise"
            }
          }
        }
      }
    },
    "PreservedDispositionChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "FindingId",
          "PreservedState",
