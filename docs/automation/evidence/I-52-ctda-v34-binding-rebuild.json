  "governance": "V34 BINDING CLARIFICATION (Coordinator AGREED, Architect AGREED; no V35; NPM/NEC/FEC/NSC normative text unchanged)",
  "bindings": {
    "smLinkStorage": {
      "carrier": "one AcDbXrecord owned by the scratch NOD",
      "key": "RACKCAD_CTDA_V34_SM-LINK",
      "payload": "exactly one resbuf AcDb::kDxfText; ASCII exact",
      "sm0": "HFV30:LINK:A,B",
      "sm1": "HFV30:LINK:A,C",
      "fixtureIdentity": false,
      "lifecycle": "bootstrap creates in the fixture transaction (duplicate fails); MUT-SM writes A,C ForWrite in the caller transaction; VER-SM resolves by NOD key in a fresh transaction and cross-checks the bound ObjectId; cleanup removes the NOD entry and erases the Xrecord (LINK-CARRIER-REMOVED)",
      "failClosed": "pre-trigger LINK-MISSING/DUPLICATE/WRONG-TYPE/PRECONDITION-MISMATCH/IDENTITY-DRIFT/ERASED = UNKNOWN (trigger not fired); post-mutation valid structure + wrong bytes = FAIL-SM; structural anomaly = UNKNOWN"
    },
    "openSmB": {
      "membership": "SM-LINK relation + liveness of named members",
      "sm0": "carrier A,B; A live; B live; C does not exist",
      "sm1": "carrier A,C; A live; C live; B live but not a sibling member",
      "fRefB": "M target; never erased, opened ForWrite, opened erased or used as MUT-SM target",
      "fRefC": "absent at bootstrap; MUT-SM appends exactly one RACKCAD_CTDA_V34_REF insert at (20,20,0) on RACKCAD_CTDA_V30_A (non-normative placement)",
      "mutAllWriteSets": {
        "MUT-S": "{F-XR}",
        "MUT-M": "{F-REF-B}",
        "MUT-SM": "{SM-LINK carrier, new F-REF-C}"
      },
      "verSm": "carrier A,C; fresh reads of A and C with Matrix3d/LayerId as evidence only; fresh model-space enumeration without opening B; C = unique new live REF insert at the creation position matching the reported ObjectId"
    }
  },
  "implementation": {
    "native": [
      "materialize: A, B, F-XR and SM-LINK carrier at A,B; F-REF-C not created",
      "captureSm: raw SM facts (carrier via NOD key, identity, erased via eWasErased, type, resbuf count, HFV30:LINK:* carrier count, A live, B live only when includeB, REF inserts other than A/B, C identity/position) without openErased and without opening B post-trigger",
      "mutateMixed (MUT-SM): requires an active caller transaction and the SM-0 precondition; appends one C; writes A,C",
      "mutateAll: MUT-S, MUT-M, MUT-SM exactly once, disjoint write sets",
      "removeSmResources + linkCarrierRemoved: cleanup; runtime cleanupComplete() requires LINK-CARRIER-REMOVED",
      "smoke: reports smLinkBinding, smPrecondition facts, snapshot binding line and linkCarrierRemoved"
    ],
    "managed": [
      "SmRules: single classifier of SM facts (UNKNOWN / FAIL-SM / OK)",
      "SmBindingGuard: static guards over MUT-SM, MUT-ALL and bootstrap bodies and the identity count, part of static-native",
      "SmokeEvaluator: SM-LINK binding, precondition, snapshot shape and carrier removal",
      "CleanupObligation.LinkCarrierRemoved"
    ]
  },
