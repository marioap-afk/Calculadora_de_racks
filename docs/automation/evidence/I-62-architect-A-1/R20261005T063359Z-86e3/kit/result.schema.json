{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "rackcad-architect-review-result/v1 — representación experimental para la revisión formal de la A-1 corregida para A62-A1R-01..03 (I-62, kit v3)",
 "type": "object",
 "additionalProperties": false,
 "required": ["Schema", "RunId", "InvocationId", "LogicalReviewRequestId", "AttemptSeq", "RequestedRole", "Action", "ReviewedUnit", "ReviewedCommit",
  "ReviewedPath", "ReviewedBlob", "ReviewerMode", "SamePersonAsAuthor", "ReviewerDeclaredIdentity", "InjectedContextDeclaration", "IdentityCheck",
  "InputsRead", "Verdict", "RequiredFindings", "OptionalFindings", "FindingDispositions", "OptionalCorrections", "Focus", "F3ContractCrossCheck",
  "CounterexampleVerification", "Materiality", "OwnerAuthorityCheck", "LegacyApplicability", "IfAgreed", "KnownLimitations", "RecommendedNextAction"],
 "properties": {
  "Schema": {"type": "string", "minLength": 1},
  "RunId": {"type": "string", "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"},
  "InvocationId": {"type": "string", "pattern": "^I[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"},
  "LogicalReviewRequestId": {"type": "string", "pattern": "^L[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"},
  "AttemptSeq": {"type": "integer", "const": 1},
  "RequestedRole": {"const": "ARCHITECT"},
  "Action": {"const": "REVIEW_DESIGN"},
  "ReviewedUnit": {"const": "I-62"},
  "ReviewedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
  "ReviewedPath": {"const": "docs/initiatives/I-62-A-1.md"},
  "ReviewedBlob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
  "ReviewerMode": {"enum": ["SAME-SESSION ROLE", "SEPARATE SESSION", "EXTERNAL HUMAN"]},
  "SamePersonAsAuthor": {"type": "string", "minLength": 1},
  "ReviewerDeclaredIdentity": {"type": "object", "additionalProperties": false, "required": ["Runtime", "Model", "Effort", "SessionOrThread"],
   "properties": {"Runtime": {"type": "string"}, "Model": {"type": "string"}, "Effort": {"type": "string"}, "SessionOrThread": {"type": "string"}}},
  "InjectedContextDeclaration": {"type": "object", "additionalProperties": false, "required": ["State", "Items"],
   "properties": {"State": {"enum": ["DECLARED", "NONE"]}, "Items": {"type": "array", "items": {"type": "string"}}}},
  "IdentityCheck": {"type": "object", "additionalProperties": false,
   "required": ["CloneHeadMatches", "WorktreeHeadMatches", "ObjectBlobMatches", "PackageBlobMatches", "CleanTree", "OrderSha256Matches", "PriorAuthorizationSha256Matches"],
   "properties": {"CloneHeadMatches": {"type": "boolean"}, "WorktreeHeadMatches": {"type": "boolean"}, "ObjectBlobMatches": {"type": "boolean"},
    "PackageBlobMatches": {"type": "boolean"}, "CleanTree": {"type": "boolean"}, "OrderSha256Matches": {"type": "boolean"},
    "PriorAuthorizationSha256Matches": {"type": "boolean"}}},
  "InputsRead": {"type": "array", "items": {"type": "string"}},
  "Verdict": {"enum": ["AGREED", "CHANGES REQUIRED", "BLOCKED — OWNER DECISION", "NOT_ACCREDITED"]},
  "RequiredFindings": {"type": "array", "items": {"$ref": "#/$defs/required"}},
  "OptionalFindings": {"type": "array", "items": {"$ref": "#/$defs/optional"}},
  "FindingDispositions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["FindingId", "State", "Rationale", "PremiseRefs"],
   "properties": {"FindingId": {"enum": ["A62-A1-01", "A62-A1-02", "A62-A1-03", "A62-A1-04", "A62-A1-05", "A62-A1-06", "OBS-A1-01", "A62-A1R-01", "A62-A1R-02", "A62-A1R-03"]},
    "State": {"enum": ["CLOSED", "STILL_OPEN"]}, "Rationale": {"type": "string", "minLength": 1}, "PremiseRefs": {"type": "array", "items": {"$ref": "#/$defs/premise"}}}}},
  "OptionalCorrections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["Id", "Assessment", "Note"],
   "properties": {"Id": {"enum": ["A62-A1-O1", "A62-A1-O2", "A62-A1-O3", "A62-A1-O4", "A62-A1-O5", "A62-A1R-O1", "A62-A1R-O2", "A62-A1R-O3", "A62-A1R-O4", "A62-A1R-O5"]}, "Assessment": {"enum": ["CONFIRMED", "CHALLENGED", "NOT_APPLICABLE"]},
    "Note": {"type": "string"}}}},
  "Focus": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["Item", "Assessment", "Note"],
   "properties": {"Item": {"type": "integer", "minimum": 1, "maximum": 16}, "Assessment": {"enum": ["CONFIRMED", "CHALLENGED"]}, "Note": {"type": "string", "minLength": 1}}}},
  "F3ContractCrossCheck": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["Contract", "Assessment", "Note"],
   "properties": {"Contract": {"type": "string", "minLength": 1}, "Assessment": {"enum": ["COMPATIBLE", "TEXT_AMENDMENT_DECLARED", "REQUIRES_SCHEMA_CHANGE"]},
    "Note": {"type": "string"}}}},
  "CounterexampleVerification": {"type": "object", "additionalProperties": false, "required": ["Traces", "Valid", "Invalid", "AllAsExpected", "Notes"],
   "properties": {"Traces": {"type": "integer"}, "Valid": {"type": "integer"}, "Invalid": {"type": "integer"}, "AllAsExpected": {"type": ["boolean", "null"]},
    "Notes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["Trace", "ClaimedReasonHolds", "Note"],
     "properties": {"Trace": {"type": "string"}, "ClaimedReasonHolds": {"type": "boolean"}, "Note": {"type": "string"}}}}}},
  "Materiality": {"type": "object", "additionalProperties": false, "required": ["Overall", "ObsA101", "Note"],
   "properties": {"Overall": {"$ref": "#/$defs/mtable"}, "ObsA101": {"$ref": "#/$defs/mtable"}, "Note": {"type": "string"}}},
  "OwnerAuthorityCheck": {"type": "object", "additionalProperties": false,
   "required": ["Spending", "Credentials", "Destructive", "NewOVScenario", "OVRemovalOrReassignment", "OwnerPolicyChoice", "NewOwnerAuthority", "OwnerDecisionRequired"],
   "properties": {"Spending": {"type": "string"}, "Credentials": {"type": "string"}, "Destructive": {"type": "string"}, "NewOVScenario": {"type": "string"},
    "OVRemovalOrReassignment": {"type": "string"}, "OwnerPolicyChoice": {"type": "string"}, "NewOwnerAuthority": {"type": "string"}, "OwnerDecisionRequired": {"type": "boolean"}}},
  "LegacyApplicability": {"type": "object", "additionalProperties": false, "required": ["AppliesOnlyToI62", "NoRetroactiveI61Change", "NoI64FixClaim", "Note"],
   "properties": {"AppliesOnlyToI62": {"type": "boolean"}, "NoRetroactiveI61Change": {"type": "boolean"}, "NoI64FixClaim": {"type": "boolean"}, "Note": {"type": "string"}}},
  "IfAgreed": {"type": "object", "additionalProperties": false,
   "required": ["A62_A1_01_CLOSED", "A62_A1_02_CLOSED", "A62_A1_03_CLOSED", "A62_A1_04_CLOSED", "A62_A1_05_CLOSED", "A62_A1_06_CLOSED", "OBS_A1_01_CLOSED", "A62_A1R_01_CLOSED", "A62_A1R_02_CLOSED", "A62_A1R_03_CLOSED", "FC01Resolved", "FC02Resolved", "NoOwnerDecisionRequired", "SuitableForCoordinatorAgreement", "F4MayProceedAfterCoordinatorAgreed"],
   "properties": {"A62_A1_01_CLOSED": {"$ref": "#/$defs/tn"}, "A62_A1_02_CLOSED": {"$ref": "#/$defs/tn"}, "A62_A1_03_CLOSED": {"$ref": "#/$defs/tn"},
    "A62_A1_04_CLOSED": {"$ref": "#/$defs/tn"}, "A62_A1_05_CLOSED": {"$ref": "#/$defs/tn"}, "A62_A1_06_CLOSED": {"$ref": "#/$defs/tn"},
    "OBS_A1_01_CLOSED": {"$ref": "#/$defs/tn"}, "A62_A1R_01_CLOSED": {"$ref": "#/$defs/tn"}, "A62_A1R_02_CLOSED": {"$ref": "#/$defs/tn"},
    "A62_A1R_03_CLOSED": {"$ref": "#/$defs/tn"}, "FC01Resolved": {"$ref": "#/$defs/tn"}, "FC02Resolved": {"$ref": "#/$defs/tn"},
    "NoOwnerDecisionRequired": {"$ref": "#/$defs/tn"}, "SuitableForCoordinatorAgreement": {"$ref": "#/$defs/tn"}, "F4MayProceedAfterCoordinatorAgreed": {"$ref": "#/$defs/tn"}}},
  "KnownLimitations": {"type": "array", "items": {"type": "string"}},
  "RecommendedNextAction": {"type": "string"}
 },
 "$defs": {
  "tn": {"type": ["boolean", "null"]},
  "premise": {"type": "object", "additionalProperties": false, "required": ["Path", "Section", "LineStart", "LineEnd", "Quote"],
   "properties": {"Path": {"type": "string", "minLength": 1}, "Section": {"type": "string"}, "LineStart": {"type": "integer", "minimum": 1},
    "LineEnd": {"type": "integer", "minimum": 1}, "Quote": {"type": "string", "minLength": 1}}},
  "required": {"type": "object", "additionalProperties": false,
   "required": ["FindingId", "AffectedDelta", "ViolatedInvariant", "Counterexample", "CorrectionRequired", "PremiseRefs", "WhyItMatters"],
   "properties": {"FindingId": {"type": "string", "pattern": "^A62-A1S-[0-9]{2}$"}, "AffectedDelta": {"type": "string", "minLength": 1},
    "ViolatedInvariant": {"type": "string", "minLength": 1}, "Counterexample": {"type": "string", "minLength": 1}, "CorrectionRequired": {"type": "string", "minLength": 1},
    "PremiseRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/premise"}}, "WhyItMatters": {"type": "string", "minLength": 1}}},
  "optional": {"type": "object", "additionalProperties": false, "required": ["FindingId", "AffectedDelta", "Note", "PremiseRefs"],
   "properties": {"FindingId": {"type": "string", "pattern": "^A62-A1S-O[0-9]+$"}, "AffectedDelta": {"type": "string"}, "Note": {"type": "string", "minLength": 1},
    "PremiseRefs": {"type": "array", "items": {"$ref": "#/$defs/premise"}}}},
  "mtable": {"type": "object", "additionalProperties": false, "required": ["M01", "M02", "M03", "M04", "M05", "M06", "M07", "M08"],
   "properties": {"M01": {"$ref": "#/$defs/yn"}, "M02": {"$ref": "#/$defs/yn"}, "M03": {"$ref": "#/$defs/yn"}, "M04": {"$ref": "#/$defs/yn"},
    "M05": {"$ref": "#/$defs/yn"}, "M06": {"$ref": "#/$defs/yn"}, "M07": {"$ref": "#/$defs/yn"}, "M08": {"$ref": "#/$defs/yn"}}},
  "yn": {"enum": ["YES", "NO"]}
 }
}
