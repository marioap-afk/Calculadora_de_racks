# SHA inexistente para el camino de error (git cat-file -t => 128) y para nc1
BAD_SHA='0a41a41a41a41a41a41a41a41a41a41a41a41a41'
# Ruta del paquete para CleanTree (check-ignore; ignorada por el .gitignore de U-08, c785def9): output.json del RunId de la verificación del escenario
IGNORE_PATH='artifacts/orchestration/FX-U1/T1/0/R20261009T212000Z-a41c/output.json'
