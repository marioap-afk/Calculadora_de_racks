# Copia este archivo a gates.env y rellénalo SOLO cuando consten en docs/automation/decisions/I-62.md, en este orden:
#   1) A-4 = AGREED con A4-1 incluida (revisión acreditada + veredicto del Coordinator; decisiones §61.2 y §62.2), sobre la versión acordada
#      (hoy la candidata es el blob 0d954376, corrección 2);
#   2) la disposición de aplicación del Coordinator que nombra la celda, la shell y el trío exacto y FIJA el directorio de trabajo -C de la medición:
#      un clon con la historia que necesita `git diff <base>..<head>` (A4-1, regla 3, A-4 0d954376; A62-A4-O2);
#   3) la línea del Owner A4-SONDA-CONSUMO = A (decisiones §61.4-§61.5 y §62.5; el silencio no es aprobación).
# run_probe.sh se niega a correr si queda algún '<' o '>' (marcador) en estos valores, si alguno de los registros no aparece literal en
# DECISIONS_FILE, si DISPOSITION_DIR_MARKER no contiene PROBE_DIR o si EVIDENCE_ROOT ya tiene una medición de A4-1 (tope uno en total para FX-02 en F6).

# Archivo de decisiones del worktree de I-62 (ruta local; no se copia a ningún informe)
DECISIONS_FILE='<ruta local de docs/automation/decisions/I-62.md>'
# Texto literal, copiado del registro del acuerdo de A-4, que pruebe que A4-1 quedó AGREED
A4_AGREED_MARKER='<texto literal del registro del acuerdo>'
# Texto literal, copiado de la disposición de aplicación de A4-1 (celda, shell y trío)
DISPOSITION_MARKER='<texto literal de la disposición de aplicación>'
# Texto literal de la misma disposición que fija el directorio -C; tiene que contener PROBE_DIR (A4-1, regla 3)
DISPOSITION_DIR_MARKER='<texto literal de la disposición que fija el directorio -C>'
# consumo-line.txt debe contener la línea A4-SONDA-CONSUMO de la versión ACORDADA de A-4. La actual es la de A-4 §7 en el blob 0d954376,
# byte a byte igual a la de 27ffa26b; si la versión acordada la cambia, se sustituye antes de congelar.

# Lo que nombra la disposición. Si difiere de las constantes de run_probe.sh (celda gpt-6-luna/high, shell cmd.exe, trío de OD-2e), el kit se rehace
CELL='gpt-6-luna/high'
SHELL_NAME='cmd.exe'
TRIO='3553cd6e7df5a093d8cb8301cd8088a57e0971aba71ddbe0e67f7f44a15cdf68/26.1002.7124.0/6518EFAB0BC0C0C2C2C5DCCD3A3D3646DFDC9F15B222FD6B744CBC84B857DB32'

# Directorio -C de la sonda: el que FIJA la disposición (regla 3). D:\r62-fixture\A2 solo tras S03 y antes de S04 (nunca con A2 abierta), u otro clon
# con la historia de BASE_SHA..HEAD_SHA
PROBE_DIR='<directorio que fija la disposición>'

# Tope uno en total para FX-02 en F6 (regla 3): directorio de la evidencia real donde se custodia cada medición de A4-1 (<RunId>-a4-1-probe).
# Si ya existe alguna, el script se niega: solo la regla 4 abre otra, con un bloque A2-P2 nuevo por una actualización nueva, y eso exige otro kit
EVIDENCE_ROOT='<ruta local de docs/automation/evidence/I-62-F6/OD-2 del worktree de I-62>'

# Operaciones de A4-1, regla 2 (se congelan con el kit tras el AGREED)
BASE_SHA='<40 hex de la historia de fx/u1; propuesta: d30fb6a9d26c0b5cb189a30b98ec97d0edcb7b99 (alternativa: 1a4fc9c62bb564d7c51fad8158876a5d5a8a5bdf, 2 commits, uno con Co-Authored-By y otro sin él)>'
HEAD_SHA='<40 hex; propuesta: ae25b596a11fe3508ac60a3ef7de5dc23df971ce (3 rutas con la base propuesta; 5 con la alternativa)>'
# Rama de la unidad, para Identity (origin/<rama>) y Remote (ls-remote)
BRANCH='fx/u1'
# Ruta que CleanTree comprueba con git check-ignore (AP 16.9 #8: ruta del paquete ignorada). Propuesta: una ruta del área transitoria; con el
# clon en c785def9 o posterior (.gitignore de U-08) queda ignorada; antes de c785def9 la lectura es igual de reproducible pero no ejerce un caso ignorado
IGNORE_PATH='<ruta relativa; propuesta: artifacts/orchestration/FX-U1/T1/check-ignore-probe.json>'
HASH_FILES='docs/automation/decisions/FX-U1-T1.gate-contract.json src/Fixture.Lib/Calculator.cs'
JSON_INPUT='docs/automation/decisions/FX-U1-T1.gate-contract.json'
JSON_FIELDS='Schema TaskId MainSha RoutingEnforcement CorrectionsAuthorized'
JSON_ARRAYS='AllowedWriteScope RequiredTests RoleRequirements'
# RESOLVE si el contrato exige la resolución efectiva por el mapa; DECLARED_UNAVAILABLE si el contrato la declara no disponible (Q-A4-03)
CLAUSE_MAP_MODE='<RESOLVE o DECLARED_UNAVAILABLE>'
CLAUSE_MAP_PATH='docs/automation/agent-execution/compatibility/I62-clause-map.json'
# Solo con RESOLVE: pares Path|Section separados por ';' (propuesta: uno presente en Entries y uno ausente)
CLAUSE_PAIRS='<pares Path|Section>'
# Solo con DECLARED_UNAVAILABLE (con RESOLVE se dejan como '-')
DECLARATION_FILE='-'
DECLARATION_TEXT='-'
