# Copia este archivo a gates.env y rellénalo SOLO cuando consten en docs/automation/decisions/I-62.md, en este orden:
#   1) A-4 = AGREED con A4-1 incluida (revisión acreditada + veredicto del Coordinator; decisiones §61.2);
#   2) la disposición de aplicación del Coordinator que nombra la celda, la shell, el trío exacto y el directorio (A4-1, regla 3; A-4 no fija el directorio);
#   3) la línea del Owner A4-SONDA-CONSUMO = A (decisiones §61.4-§61.5; el silencio no es aprobación).
# run_probe.sh se niega a correr si queda algún '<' (marcador) en estos valores o si alguno de los tres registros no aparece literal en DECISIONS_FILE.

# Archivo de decisiones del worktree de I-62 (ruta local; no se copia a ningún informe)
DECISIONS_FILE='<ruta local de docs/automation/decisions/I-62.md>'
# Texto literal, copiado del registro del acuerdo de A-4, que pruebe que A4-1 quedó AGREED
A4_AGREED_MARKER='<texto literal del registro del acuerdo>'
# Texto literal, copiado de la disposición de aplicación de A4-1
DISPOSITION_MARKER='<texto literal de la disposición de aplicación>'
# consumo-line.txt debe contener la línea A4-SONDA-CONSUMO de la versión ACORDADA de A-4; la actual es la de A-4 §7 en el blob 27ffa26b.

# Lo que nombra la disposición. Si difiere de las constantes de run_probe.sh (celda gpt-6-luna/high, shell cmd.exe, trío de OD-2e), el kit se rehace
CELL='gpt-6-luna/high'
SHELL_NAME='cmd.exe'
TRIO='3553cd6e7df5a093d8cb8301cd8088a57e0971aba71ddbe0e67f7f44a15cdf68/26.1002.7124.0/6518EFAB0BC0C0C2C2C5DCCD3A3D3646DFDC9F15B222FD6B744CBC84B857DB32'

# Directorio -C de la sonda, según la disposición: D:\r62-fixture\A2 solo tras S03 y antes de S04 (nunca con A2 abierta), u otro clon con historia
PROBE_DIR='<directorio de la disposición>'

# Operaciones de A4-1, regla 2 (se congelan con el kit tras el AGREED)
BASE_SHA='<40 hex de la historia de fx/u1; propuesta: d30fb6a9d26c0b5cb189a30b98ec97d0edcb7b99>'
HEAD_SHA='<40 hex; propuesta: ae25b596a11fe3508ac60a3ef7de5dc23df971ce (3 rutas cambiadas)>'
HASH_FILES='docs/automation/decisions/FX-U1-T1.gate-contract.json src/Fixture.Lib/Calculator.cs'
