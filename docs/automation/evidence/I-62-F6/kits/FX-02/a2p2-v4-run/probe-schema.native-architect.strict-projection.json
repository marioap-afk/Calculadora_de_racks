{
 "type": "object",
 "description": "Salida de la sonda 2 del bloque A2-P2 (kit a2p2-v4, Architect, receta literal): steps 1-6 y el resultado canónico de la revisión incrustado (proyección estricta: sin minLength).",
 "additionalProperties": false,
 "required": [
  "steps",
  "head_sha",
  "architect_review_result_v1"
 ],
 "properties": {
  "steps": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "commands",
     "ok",
     "values",
     "error"
    ],
    "properties": {
     "id": {
      "type": "integer",
      "description": "número del paso del texto, de 1 a 6"
     },
     "commands": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "ok": {
      "type": "boolean"
     },
     "values": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "key",
        "value"
       ],
       "properties": {
        "key": {
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       }
      }
     },
     "error": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "head_sha": {
   "type": [
    "string",
    "null"
   ]
  },
  "architect_review_result_v1": {
   "title": "rackcad-architect-review-result/v1",
   "description": "Resultado de una revisión del ARCHITECT (Proposal V14 §20.5, §20.7 y Anexo B.10.0-B.10.1). Lo ingiere el Principal mecánicamente; su autoridad la discrimina el triple RequestedRole + Action + OutputContract. Subordinado: no crea requisitos de evidencia, estados, gates, reglas Git ni decisiones del Owner. Inactivo hasta I62_EFFECTIVE_SHA (AUTOMATION_PLAN 16.14).",
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "Schema": {
     "type": "string",
     "enum": [
      "rackcad-architect-review-result/v1"
     ]
    },
    "ResultId": {
     "type": "string"
    },
    "LogicalReviewRequestId": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^L[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "InvocationId": {
     "type": "string",
     "pattern": "^I[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "AttemptSeq": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1
    },
    "RequestedRole": {
     "type": "string",
     "enum": [
      "ARCHITECT"
     ]
    },
    "Action": {
     "type": "string",
     "enum": [
      "REVIEW_DESIGN"
     ]
    },
    "ReviewedUnit": {
     "type": "string"
    },
    "ReviewedCommit": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "ReviewedPath": {
     "type": "string"
    },
    "ReviewedBlob": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "ReviewerBinding": {
     "type": "object",
     "description": "BindingRef (B.2).",
     "additionalProperties": false,
     "properties": {
      "UnitId": {
       "type": "string"
      },
      "Scope": {
       "type": "string",
       "enum": [
        "UNIT",
        "TASK"
       ]
      },
      "TaskId": {
       "type": [
        "string",
        "null"
       ],
       "description": "Nullable = no aplica, solo con Scope UNIT."
      },
      "Role": {
       "type": "string",
       "enum": [
        "PRINCIPAL_COORDINATOR",
        "ARCHITECT",
        "EXECUTION_CONTROLLER",
        "WORKER",
        "REVIEWER"
       ]
      },
      "BindingId": {
       "type": "string",
       "pattern": "^B[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
      },
      "Sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "Location": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "Kind": {
         "type": "string",
         "enum": [
          "TRANSIENT",
          "CUSTODIED"
         ]
        },
        "Path": {
         "type": "string"
        },
        "Commit": {
         "type": [
          "string",
          "null"
         ],
         "pattern": "^[0-9a-f]{40}$",
         "description": "Nullable = no aplica, solo con TRANSIENT."
        },
        "Blob": {
         "type": [
          "string",
          "null"
         ],
         "pattern": "^[0-9a-f]{40}$",
         "description": "Nullable = no aplica, solo con TRANSIENT."
        }
       },
       "required": [
        "Kind",
        "Path",
        "Commit",
        "Blob"
       ]
      }
     },
     "required": [
      "UnitId",
      "Scope",
      "TaskId",
      "Role",
      "BindingId",
      "Sha256",
      "Location"
     ]
    },
    "ReviewerDeclaredIdentity": {
     "type": "object",
     "description": "Informativa (§20.3.2): cada campo puede ser UNKNOWN; nunca un estado MATCH.",
     "additionalProperties": false,
     "properties": {
      "Runtime": {
       "type": "string"
      },
      "Model": {
       "type": "string"
      },
      "Effort": {
       "type": "string"
      },
      "SessionOrThread": {
       "type": "string"
      }
     },
     "required": [
      "Runtime",
      "Model",
      "Effort",
      "SessionOrThread"
     ]
    },
    "ReviewerMode": {
     "type": "string",
     "enum": [
      "SAME-SESSION ROLE",
      "SEPARATE SESSION",
      "EXTERNAL HUMAN"
     ]
    },
    "InjectedContextDeclaration": {
     "type": "object",
     "description": "Obligatoria: «ninguno» se declara como NONE_DECLARED.",
     "additionalProperties": false,
     "properties": {
      "State": {
       "type": "string",
       "enum": [
        "NONE_DECLARED",
        "DECLARED"
       ]
      },
      "Items": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "Kind": {
          "type": "string"
         },
         "Source": {
          "type": "string"
         },
         "SizeOrSha256": {
          "type": "string",
          "pattern": "^([0-9]+|[0-9a-f]{64})$",
          "description": "Tamaño en bytes o SHA-256."
         }
        },
        "required": [
         "Kind",
         "Source",
         "SizeOrSha256"
        ]
       }
      }
     },
     "required": [
      "State",
      "Items"
     ]
    },
    "InputsRead": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "InputFidelityEvidenceRef": {
     "type": "object",
     "description": "Copia informativa de la referencia recibida; el revisor no la certifica.",
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "blob": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}$"
      }
     },
     "required": [
      "path",
      "blob"
     ]
    },
    "IndependenceEvidence": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "Dimensions": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "ReferenceRole": {
          "type": "string",
          "enum": [
           "PRINCIPAL_COORDINATOR",
           "ARCHITECT",
           "EXECUTION_CONTROLLER",
           "WORKER",
           "REVIEWER",
           "AUTHOR",
           "PROPOSER",
           "EVIDENCE_AUTHOR"
          ]
         },
         "Dimension": {
          "type": "string",
          "enum": [
           "Actor",
           "Session",
           "Context",
           "Provider"
          ]
         },
         "Result": {
          "type": "string",
          "enum": [
           "SATISFIED",
           "NOT_SATISFIED",
           "UNKNOWN"
          ]
         },
         "Evidence": {
          "type": "string"
         }
        },
        "required": [
         "ReferenceRole",
         "Dimension",
         "Result",
         "Evidence"
        ]
       }
      },
      "ReviewSubject": {
       "type": [
        "object",
        "null"
       ],
       "description": "ReviewSubject (B.2): conjunto acotado a la unidad y al objeto; null = no aplica fuera de una revisión mayor (§11.4).",
       "additionalProperties": false,
       "properties": {
        "Kind": {
         "type": "string",
         "enum": [
          "DESIGN",
          "IMPLEMENTATION"
         ]
        },
        "Commit": {
         "type": "string",
         "pattern": "^[0-9a-f]{40}$"
        },
        "Paths": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "Blobs": {
         "type": "array",
         "items": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
         }
        },
        "RangeBase": {
         "type": [
          "string",
          "null"
         ],
         "pattern": "^[0-9a-f]{40}$",
         "description": "merge-base de IMPLEMENTATION; null = no aplica en DESIGN."
        },
        "Authors": {
         "type": "array",
         "items": {
          "type": "object",
          "description": "AuthorRef (B.2).",
          "additionalProperties": false,
          "properties": {
           "Kind": {
            "type": "string",
            "enum": [
             "AI_SESSION",
             "HUMAN",
             "UNKNOWN"
            ]
           },
           "Actor": {
            "type": [
             "object",
             "null"
            ],
            "description": "ActorRef (B.2).",
            "additionalProperties": false,
            "properties": {
             "AdapterId": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
             },
             "InstanceId": {
              "type": "string"
             },
             "InstanceIdSource": {
              "type": "string"
             },
             "Assurance": {
              "type": "string",
              "enum": [
               "REQUESTED",
               "CONFIGURED",
               "RUNTIME_OBSERVED",
               "SERVICE_ATTESTED",
               "NONE"
              ]
             }
            },
            "required": [
             "AdapterId",
             "InstanceId",
             "InstanceIdSource",
             "Assurance"
            ]
           },
           "Session": {
            "type": [
             "object",
             "null"
            ],
            "description": "SessionRef (B.2).",
            "additionalProperties": false,
            "properties": {
             "AdapterId": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
             },
             "SessionId": {
              "type": "string"
             },
             "Assurance": {
              "type": "string",
              "enum": [
               "REQUESTED",
               "CONFIGURED",
               "RUNTIME_OBSERVED",
               "SERVICE_ATTESTED",
               "NONE"
              ]
             }
            },
            "required": [
             "AdapterId",
             "SessionId",
             "Assurance"
            ]
           },
           "HumanId": {
            "type": [
             "string",
             "null"
            ]
           },
           "Operator": {
            "type": [
             "string",
             "null"
            ],
            "description": "HumanId o \"UNKNOWN\"; null = no aplica según el Kind."
           },
           "Commits": {
            "type": "array",
            "items": {
             "type": "string",
             "pattern": "^[0-9a-f]{40}$"
            }
           },
           "Evidence": {
            "type": "string"
           }
          },
          "required": [
           "Kind",
           "Actor",
           "Session",
           "HumanId",
           "Operator",
           "Commits",
           "Evidence"
          ]
         }
        }
       },
       "required": [
        "Kind",
        "Commit",
        "Paths",
        "Blobs",
        "RangeBase",
        "Authors"
       ]
      }
     },
     "required": [
      "Dimensions",
      "ReviewSubject"
     ]
    },
    "KnownLimitations": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "RecommendedNextAction": {
     "type": "string",
     "description": "Informativa; no es autoridad."
    },
    "Verdict": {
     "type": "string",
     "enum": [
      "AGREED",
      "CHANGES REQUIRED",
      "BLOCKED — OWNER DECISION"
     ]
    },
    "RequiredFindings": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "FindingId": {
        "type": "string"
       },
       "LineageId": {
        "type": [
         "string",
         "null"
        ],
        "description": "null = linaje nuevo o por asignar en la ingestión."
       },
       "Source": {
        "type": "string"
       },
       "AffectedSection": {
        "type": "string"
       },
       "Evidence": {
        "type": "string"
       },
       "PremiseRefs": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "Path": {
           "type": "string"
          },
          "Section": {
           "type": "string"
          },
          "LineStart": {
           "type": "integer",
           "minimum": 1
          },
          "LineEnd": {
           "type": "integer",
           "minimum": 1
          },
          "Quote": {
           "type": "string",
           "description": "La proposición normativa completa (§20.3.3)."
          }
         },
         "required": [
          "Path",
          "Section",
          "LineStart",
          "LineEnd",
          "Quote"
         ]
        }
       },
       "WhyItMatters": {
        "type": "string"
       },
       "CorrectionRequired": {
        "type": "string"
       }
      },
      "required": [
       "FindingId",
       "LineageId",
       "Source",
       "AffectedSection",
       "Evidence",
       "PremiseRefs",
       "WhyItMatters",
       "CorrectionRequired"
      ]
     }
    },
    "OptionalFindings": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "FindingId": {
        "type": "string"
       },
       "LineageId": {
        "type": [
         "string",
         "null"
        ],
        "description": "null = linaje nuevo o por asignar en la ingestión."
       },
       "Source": {
        "type": "string"
       },
       "AffectedSection": {
        "type": "string"
       },
       "Evidence": {
        "type": "string"
       },
       "PremiseRefs": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "Path": {
           "type": "string"
          },
          "Section": {
           "type": "string"
          },
          "LineStart": {
           "type": "integer",
           "minimum": 1
          },
          "LineEnd": {
           "type": "integer",
           "minimum": 1
          },
          "Quote": {
           "type": "string",
           "description": "La proposición normativa completa (§20.3.3)."
          }
         },
         "required": [
          "Path",
          "Section",
          "LineStart",
          "LineEnd",
          "Quote"
         ]
        }
       },
       "WhyItMatters": {
        "type": "string"
       },
       "CorrectionRequired": {
        "type": "string"
       }
      },
      "required": [
       "FindingId",
       "LineageId",
       "Source",
       "AffectedSection",
       "Evidence",
       "PremiseRefs",
       "WhyItMatters",
       "CorrectionRequired"
      ]
     }
    },
    "FindingDispositions": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "FindingId": {
        "type": "string"
       },
       "LineageId": {
        "type": "string"
       },
       "State": {
        "type": "string",
        "enum": [
         "OPEN",
         "CLOSED",
         "STILL_OPEN",
         "SUPERSEDED"
        ]
       },
       "SupersededBy": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "Rationale": {
        "type": "string"
       },
       "EvaluatedObject": {
        "type": "object",
