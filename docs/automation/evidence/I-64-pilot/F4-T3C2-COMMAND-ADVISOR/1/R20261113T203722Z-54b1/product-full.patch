diff --git a/src/RackCad.Application/Workspace/WorkspaceCloseAdvisorRelay.cs b/src/RackCad.Application/Workspace/WorkspaceCloseAdvisorRelay.cs
new file mode 100644
index 00000000..aade9094
--- /dev/null
+++ b/src/RackCad.Application/Workspace/WorkspaceCloseAdvisorRelay.cs
@@ -0,0 +1,204 @@
+#nullable enable
+using System;
+using System.Collections.Generic;
+
+namespace RackCad.Application.Workspace
+{
+    /// <summary>
+    /// I-64 F4-T3C2 (D-T3C2-04): the wrapper of the lifecycle advisor. Every decision is the one of the inner advisor (the host core): the
+    /// wrapper never decides alone, holds no state of drafts and consumes no queue of the panel. It only adds the words that the user
+    /// needs on the command line: a notice when a close was vetoed and, later, a notice of the work that a destroyed document lost.
+    ///
+    /// <see cref="AdviseClose"/> starts from Veto (the default value of <see cref="CloseDecision"/> is Allow, so it is never the start) and
+    /// gives Allow only when the inner advisor does; an exception of the inner advisor is a Veto. The write of the notice and the queries
+    /// for it never change the decision.
+    ///
+    /// <see cref="SessionDestroyed"/> reads the risk of the session BEFORE it delegates, because after the retirement the host answers
+    /// "nothing at risk"; all of that work is contained, and the delegation happens always and once, uncontained: its exception goes to
+    /// the core, which logs it as before. The session is no longer in the bridge then, so this method neither asks the bridge nor
+    /// writes: it keeps the message until <see cref="TakeMessages"/> is called with an active session.
+    ///
+    /// Declared (I-64 F4-T3C2, D-T3-08): two bounded extensions of the advisor of F4-T2B2B. In <see cref="AdviseClose"/>, the in-memory
+    /// reading of the name and of the activity of the document and the write of the notice of the veto on the command line; in
+    /// <see cref="SessionDestroyed"/>, the in-memory reading of the risk and the deferred message. None of them reads or writes the drawing
+    /// or opens a dialog. The wrapper does not empty live text: the veto sees the pending text of a draft without touching it.
+    /// </summary>
+    public sealed class WorkspaceCloseAdvisorRelay : IWorkspaceLifecycleAdvisor
+    {
+        private const string ContextAdviseClose = "WorkspaceCloseAdvisorRelay.AdviseClose";
+        private const string ContextVetoMessage = "WorkspaceCloseAdvisorRelay.VetoMessage";
+        private const string ContextSessionDestroyed = "WorkspaceCloseAdvisorRelay.SessionDestroyed";
+
+        private readonly IWorkspaceLifecycleAdvisor _inner;
+        private readonly IWorkspacePilotEditPort _risks;
+        private readonly Func<SessionId, string?> _documentNameOf;
+        private readonly Func<SessionId, bool> _isActive;
+        private readonly Action<string> _writeNow;
+        private readonly Action<string, Exception>? _report;
+        private readonly object _gate = new();
+        private readonly List<string> _messages = new();
+
+        public WorkspaceCloseAdvisorRelay(
+            IWorkspaceLifecycleAdvisor inner,
+            IWorkspacePilotEditPort risks,
+            Func<SessionId, string?> documentNameOf,
+            Func<SessionId, bool> isActive,
+            Action<string> writeNow,
+            Action<string, Exception>? report)
+        {
+            _inner = inner ?? throw new ArgumentNullException(nameof(inner));
+            _risks = risks ?? throw new ArgumentNullException(nameof(risks));
+            _documentNameOf = documentNameOf ?? throw new ArgumentNullException(nameof(documentNameOf));
+            _isActive = isActive ?? throw new ArgumentNullException(nameof(isActive));
+            _writeNow = writeNow ?? throw new ArgumentNullException(nameof(writeNow));
+            _report = report;
+        }
+
+        public CloseDecision AdviseClose(SessionId session)
+        {
+            var decision = CloseDecision.Veto;
+            try
+            {
+                decision = _inner.AdviseClose(session) == CloseDecision.Allow ? CloseDecision.Allow : CloseDecision.Veto;
+            }
+            catch (Exception ex)
+            {
+                Report(ContextAdviseClose, ex);
+            }
+
+            if (decision == CloseDecision.Veto) WriteVetoMessage(session);
+            return decision;
+        }
+
+        public void SessionDestroyed(SessionId session, bool closeSequenceIntact)
+        {
+            RememberLoss(session);
+            _inner.SessionDestroyed(session, closeSequenceIntact);
+        }
+
+        /// <summary>
+        /// The messages that were kept for the user, in order. Without an active session it answers nothing and keeps them; with one it
+        /// answers all of them and empties the list.
+        /// </summary>
+        public IReadOnlyList<string> TakeMessages(SessionId? activeSession)
+        {
+            if (!activeSession.HasValue) return Array.Empty<string>();
+
+            lock (_gate)
+            {
+                var taken = _messages.ToArray();
+                _messages.Clear();
+                return taken;
+            }
+        }
+
+        private void WriteVetoMessage(SessionId session)
+        {
+            try
+            {
+                string? name = null;
+                try
+                {
+                    name = ShortName(_documentNameOf(session));
+                }
+                catch (Exception ex)
+                {
+                    Report(ContextVetoMessage, ex);
+                }
+
+                var active = true;
+                try
+                {
+                    active = _isActive(session);
+                }
+                catch (Exception ex)
+                {
+                    Report(ContextVetoMessage, ex);
+                }
+
+                var document = string.IsNullOrWhiteSpace(name) ? "el documento" : "«" + name + "»";
+                var way = active
+                    ? "Descártalos en el panel con \"Descartar borradores de este documento\" o con el comando RACKPANELDESCARTAR, y vuelve a cerrarlo."
+                    : "Actívalo primero; después descártalos en el panel con \"Descartar borradores de este documento\" o con el comando RACKPANELDESCARTAR, y vuelve a cerrarlo.";
+                _writeNow(
+                    "RackCad: No se cerró " + document + ": puede tener borradores del panel Workspace con trabajo sin aplicar. " + way);
+            }
+            catch (Exception ex)
+            {
+                Report(ContextVetoMessage, ex);
+            }
+        }
+
+        // The risk is read before the delegation, because afterwards the host answers "nothing at risk". Whatever fails here is reported
+        // and never prevents the delegation.
+        private void RememberLoss(SessionId session)
+        {
+            try
+            {
+                var risk = default(PilotRiskView);
+                try
+                {
+                    risk = _risks.GetRacksAtRisk(new WorkspaceRequest(session));
+                }
+                catch (Exception ex)
+                {
+                    Report(ContextSessionDestroyed, ex);
+                }
+
+                var message = LossMessage(risk);
+                if (message == null) return;
+
+                lock (_gate)
+                {
+                    _messages.Add(message);
+                }
+            }
+            catch (Exception ex)
+            {
+                Report(ContextSessionDestroyed, ex);
+            }
+        }
+
+        private static string? LossMessage(PilotRiskView risk)
+        {
+            if (!risk.IsKnown)
+                return "RackCad: Al cerrarse un documento no se pudo decidir si se perdió trabajo de los borradores del panel Workspace.";
+
+            if (risk.RackIds.Count > 0)
+            {
+                var text = "RackCad: Al cerrarse un documento se perdió el trabajo sin aplicar de los borradores del panel Workspace: "
+                    + string.Join(", ", risk.RackIds) + ".";
+                if (risk.UncertainRackIds.Count > 0) text = text + " Sin decidir: " + string.Join(", ", risk.UncertainRackIds) + ".";
+                return text;
+            }
+
+            if (risk.UncertainRackIds.Count > 0)
+            {
+                return "RackCad: Al cerrarse un documento no se pudo decidir si se perdió trabajo de los borradores del panel Workspace: "
+                    + string.Join(", ", risk.UncertainRackIds) + ".";
+            }
+
+            return null;
+        }
+
+        // The last segment after a backslash or a slash, with string operations only.
+        private static string? ShortName(string? name)
+        {
+            if (name == null) return null;
+            var cut = name.LastIndexOfAny(new[] { '\\', '/' });
+            return cut < 0 ? name : name.Substring(cut + 1);
+        }
+
+        // A report that throws is ignored, like the report of the host.
+        private void Report(string context, Exception exception)
+        {
+            try
+            {
+                _report?.Invoke(context, exception);
+            }
+            catch (Exception)
+            {
+            }
+        }
+    }
+}
diff --git a/src/RackCad.Application/Workspace/WorkspaceDocumentDiscardCommand.cs b/src/RackCad.Application/Workspace/WorkspaceDocumentDiscardCommand.cs
new file mode 100644
index 00000000..7bf55842
--- /dev/null
+++ b/src/RackCad.Application/Workspace/WorkspaceDocumentDiscardCommand.cs
@@ -0,0 +1,228 @@
+#nullable enable
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+
+namespace RackCad.Application.Workspace
+{
+    /// <summary>
+    /// I-64 F4-T3C2 (D-T3C2-02): the pure core of the command that discards, on explicit confirmation, the drafts of the workspace panel
+    /// of the active document, without ever creating the controller. The command of the Plugin only supplies the five delegates:
+    /// this class holds every decision and every text.
+    ///
+    /// The target (C-F4-03) is the active session that the bridge follows, provided it authorizes against the document that runs the
+    /// command (<c>isTarget</c>). Without it, or when it is ambiguous, nothing is read, nothing is asked and nothing is discarded.
+    /// The scope is the whole document, like the button of the panel: every rack at risk and every uncertain one is listed by its
+    /// RackId and none is chosen alone.
+    ///
+    /// The core calls only two operations of the port: <see cref="IWorkspacePilotEditPort.GetRacksAtRisk"/> (twice, before and after the
+    /// question) and, after a yes and an equal second look, <see cref="IWorkspacePilotEditPort.DiscardDocument"/>. It writes nothing of
+    /// the drawing, reads no intention and opens no dialog. The unknown is never "nothing at risk": it is an explicit failure.
+    /// An exception of a delegate is not contained here: the command reports it. Before the discard it changed nothing; if the write of
+    /// the final text throws, the discard already happened.
+    /// </summary>
+    public static class WorkspaceDocumentDiscardCommand
+    {
+        /// <summary>The question of the confirmation (the text of the keywords is up to the command).</summary>
+        public const string Question = "¿Descartar los borradores de este documento?";
+
+        private const string NoController =
+            "RackCad: No hay borradores del panel Workspace en esta sesión de AutoCAD; no se descartó nada.";
+
+        private const string NoActiveSession =
+            "RackCad: El panel Workspace no sigue ningún documento activo en este momento; no se descartó nada.";
+
+        private const string UnknownRisk =
+            "RackCad: No se pudo decidir qué borradores están en riesgo; no se descartó nada.";
+
+        private const string NothingAtRisk = "RackCad: No hay borradores en riesgo en este documento; no se descartó nada.";
+
+        private const string NotConfirmed = "RackCad: No se descartó nada.";
+
+        private const string ActiveChanged = "RackCad: El documento activo cambió; no se descartó nada.";
+
+        private const string UnknownSecondRisk =
+            "RackCad: No se pudieron volver a comprobar los borradores en riesgo; no se descartó nada.";
+
+        private const string RisksChanged =
+            "RackCad: Los borradores en riesgo cambiaron; no se descartó nada. Vuelve a ejecutar RACKPANELDESCARTAR para revisarlos.";
+
+        private const string AmbiguousTarget =
+            "RackCad: El panel Workspace no sigue el documento activo en este momento; no se descartó nada.";
+
+        private const string NotDiscarded = "RackCad: No se descartaron los borradores del documento: ";
+
+        /// <summary>Runs the command. See the class remarks for the flow; every text is the one of the closed table of the package.</summary>
+        /// <param name="port">The edit port of the panel, or null when there is no controller.</param>
+        /// <param name="activeSession">The active session that the bridge follows, or null.</param>
+        /// <param name="isTarget">Whether the session authorizes against the document that runs the command.</param>
+        /// <param name="confirm">The question; true only for an explicit yes.</param>
+        /// <param name="write">Writes one line for the user.</param>
+        public static void Run(
+            IWorkspacePilotEditPort? port,
+            Func<SessionId?> activeSession,
+            Func<SessionId, bool> isTarget,
+            Func<string, bool> confirm,
+            Action<string> write)
+        {
+            if (activeSession == null) throw new ArgumentNullException(nameof(activeSession));
+            if (isTarget == null) throw new ArgumentNullException(nameof(isTarget));
+            if (confirm == null) throw new ArgumentNullException(nameof(confirm));
+            if (write == null) throw new ArgumentNullException(nameof(write));
+
+            if (port == null)
+            {
+                write(NoController);
+                return;
+            }
+
+            var found = activeSession();
+            if (!found.HasValue)
+            {
+                write(NoActiveSession);
+                return;
+            }
+
+            var session = found.Value;
+            if (!isTarget(session))
+            {
+                write(AmbiguousTarget);
+                return;
+            }
+
+            var first = ReadRisks(port, session);
+            if (!first.IsKnown)
+            {
+                write(UnknownRisk);
+                return;
+            }
+
+            if (first.RackIds.Count == 0 && first.UncertainRackIds.Count == 0)
+            {
+                write(NothingAtRisk);
+                return;
+            }
+
+            if (first.RackIds.Count > 0)
+                write("RackCad: Borradores con trabajo sin aplicar: " + string.Join(", ", first.RackIds) + ".");
+            if (first.UncertainRackIds.Count > 0)
+                write("RackCad: No se pudo decidir si tienen trabajo sin aplicar: " + string.Join(", ", first.UncertainRackIds) + ".");
+
+            if (!confirm(Question))
+            {
+                write(NotConfirmed);
+                return;
+            }
+
+            var again = activeSession();
+            if (!again.HasValue || again.Value != session)
+            {
+                write(ActiveChanged);
+                return;
+            }
+
+            if (!isTarget(session))
+            {
+                write(AmbiguousTarget);
+                return;
+            }
+
+            var second = ReadRisks(port, session);
+            if (!second.IsKnown)
+            {
+                write(UnknownSecondRisk);
+                return;
+            }
+
+            if (!SameList(first.RackIds, second.RackIds) || !SameList(first.UncertainRackIds, second.UncertainRackIds))
+            {
+                write(RisksChanged);
+                return;
+            }
+
+            EditDiscardOutcome outcome;
+            try
+            {
+                outcome = port.DiscardDocument(new WorkspaceRequest(session));
+            }
+            catch (Exception ex)
+            {
+                write(NotDiscarded + "falló. " + ReasonOrDefault(ex.Message, "sin detalle."));
+                return;
+            }
+
+            write(OutcomeText(outcome, first));
+        }
+
+        // A read that throws counts as the unknown, which the default value of the view stands for.
+        private static PilotRiskView ReadRisks(IWorkspacePilotEditPort port, SessionId session)
+        {
+            try
+            {
+                return port.GetRacksAtRisk(new WorkspaceRequest(session));
+            }
+            catch (Exception)
+            {
+                return default;
+            }
+        }
+
+        private static string OutcomeText(EditDiscardOutcome outcome, PilotRiskView risks)
+        {
+            switch (outcome.Status)
+            {
+                case EditDiscardStatus.Discarded:
+                    return DiscardedText(outcome, risks);
+                case EditDiscardStatus.Busy:
+                    return NotDiscarded + ReasonOrDefault(outcome.Reason, "hay una lectura en curso.");
+                case EditDiscardStatus.Failed:
+                    return NotDiscarded + "falló. " + ReasonOrDefault(outcome.Reason, "sin detalle.");
+                default:
+                    return NotDiscarded + "se rechazó. " + ReasonOrDefault(outcome.Reason, "sin detalle.");
+            }
+        }
+
+        private static string DiscardedText(EditDiscardOutcome outcome, PilotRiskView risks)
+        {
+            var text = "RackCad: ";
+            text = text + (risks.RackIds.Count > 0
+                ? "Se descartaron los borradores en riesgo: " + string.Join(", ", risks.RackIds) + "."
+                : "Se descartaron los borradores del documento.");
+            if (risks.UncertainRackIds.Count > 0)
+                text = text + " Sin decidir, también descartados: " + string.Join(", ", risks.UncertainRackIds) + ".";
+
+            var clean = 0;
+            foreach (var removed in outcome.RemovedRackIds)
+            {
+                if (!Contains(risks.RackIds, removed) && !Contains(risks.UncertainRackIds, removed)) clean++;
+            }
+
+            return text + " Borradores limpios retirados además: " + clean.ToString(CultureInfo.InvariantCulture) + ".";
+        }
+
+        private static string ReasonOrDefault(string? reason, string fallback) =>
+            string.IsNullOrWhiteSpace(reason) ? fallback : reason!;
+
+        private static bool Contains(IReadOnlyList<string> list, string rackId)
+        {
+            foreach (var item in list)
+            {
+                if (string.Equals(item, rackId, StringComparison.Ordinal)) return true;
+            }
+
+            return false;
+        }
+
+        // The same racks in the same order, compared by ordinal text.
+        private static bool SameList(IReadOnlyList<string> first, IReadOnlyList<string> second)
+        {
+            if (first.Count != second.Count) return false;
+            for (var i = 0; i < first.Count; i++)
+            {
+                if (!string.Equals(first[i], second[i], StringComparison.Ordinal)) return false;
+            }
+
+            return true;
+        }
+    }
+}
