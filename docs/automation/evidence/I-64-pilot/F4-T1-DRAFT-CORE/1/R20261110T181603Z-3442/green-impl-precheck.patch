diff --git a/src/RackCad.Application/Workspace/Drafts/DraftApplyOutcome.cs b/src/RackCad.Application/Workspace/Drafts/DraftApplyOutcome.cs
new file mode 100644
index 00000000..1075d269
--- /dev/null
+++ b/src/RackCad.Application/Workspace/Drafts/DraftApplyOutcome.cs
@@ -0,0 +1,137 @@
+#nullable enable
+using System;
+using System.Collections.Generic;
+
+namespace RackCad.Application.Workspace.Drafts
+{
+    /// <summary>
+    /// Classification of how an Update ended, by frontier (I-64 D-13). These are values the caller reports: the core
+    /// reads nothing and writes nothing.
+    /// </summary>
+    public enum DraftApplyOutcomeKind
+    {
+        /// <summary>Failed before the commit: the re-read inside the write found an external change. The draft goes to Conflict.</summary>
+        NotAppliedConflict,
+
+        /// <summary>Failed before the commit: the admission no longer holds. The draft keeps its previous status.</summary>
+        NotAppliedAdmission,
+
+        /// <summary>Failed before the commit: a preflight check refused. The draft keeps its previous status.</summary>
+        NotAppliedPreflight,
+
+        /// <summary>Failed before the commit for any other reason. The draft keeps its previous status.</summary>
+        NotAppliedFailure,
+
+        /// <summary>The commit threw: nothing is known about what was written. The draft is Unknown (origin CommitThrew).</summary>
+        CommitThrew,
+
+        /// <summary>The commit returned and the re-read of POST succeeded: rebased and Clean.</summary>
+        Applied,
+
+        /// <summary>As Applied, but POST failed or reported missing pieces: rebased and Clean, with the warnings kept.</summary>
+        AppliedWithWarnings,
+
+        /// <summary>The commit returned and the re-read of POST failed: Unknown (origin PostReread).</summary>
+        AppliedPostRereadFailed,
+    }
+
+    /// <summary>The outcome of one Update, built only through its factories.</summary>
+    public sealed class DraftApplyOutcome<TState>
+    {
+        private DraftApplyOutcome(
+            DraftApplyOutcomeKind kind,
+            string? cause,
+            IReadOnlyList<DraftDifference> differences,
+            IReadOnlyList<string> warnings,
+            DraftIntentRead<TState>? postRead)
+        {
+            Kind = kind;
+            Cause = cause;
+            Differences = differences;
+            Warnings = warnings;
+            PostRead = postRead;
+        }
+
+        public DraftApplyOutcomeKind Kind { get; }
+
+        public string? Cause { get; }
+
+        /// <summary>What changed, for NotAppliedConflict.</summary>
+        public IReadOnlyList<DraftDifference> Differences { get; }
+
+        /// <summary>The warnings of AppliedWithWarnings.</summary>
+        public IReadOnlyList<string> Warnings { get; }
+
+        /// <summary>The re-read of POST, which Applied and AppliedWithWarnings require.</summary>
+        public DraftIntentRead<TState>? PostRead { get; }
+
+        public static DraftApplyOutcome<TState> NotAppliedConflict(IReadOnlyList<DraftDifference> differences)
+        {
+            if (differences == null) throw new ArgumentNullException(nameof(differences));
+            return new(DraftApplyOutcomeKind.NotAppliedConflict, null, differences, Array.Empty<string>(), null);
+        }
+
+        public static DraftApplyOutcome<TState> NotAppliedAdmission(string cause) => WithCause(DraftApplyOutcomeKind.NotAppliedAdmission, cause);
+
+        public static DraftApplyOutcome<TState> NotAppliedPreflight(string cause) => WithCause(DraftApplyOutcomeKind.NotAppliedPreflight, cause);
+
+        public static DraftApplyOutcome<TState> NotAppliedFailure(string cause) => WithCause(DraftApplyOutcomeKind.NotAppliedFailure, cause);
+
+        public static DraftApplyOutcome<TState> CommitThrew(string cause) => WithCause(DraftApplyOutcomeKind.CommitThrew, cause);
+
+        public static DraftApplyOutcome<TState> AppliedPostRereadFailed(string cause) => WithCause(DraftApplyOutcomeKind.AppliedPostRereadFailed, cause);
+
+        /// <summary>Applied: the re-read of POST is required, since nothing is assumed applied without it.</summary>
+        public static DraftApplyOutcome<TState> Applied(DraftIntentRead<TState> postRead)
+        {
+            if (postRead == null) throw new ArgumentNullException(nameof(postRead));
+            return new(DraftApplyOutcomeKind.Applied, null, Array.Empty<DraftDifference>(), Array.Empty<string>(), postRead);
+        }
+
+        public static DraftApplyOutcome<TState> AppliedWithWarnings(DraftIntentRead<TState> postRead, IReadOnlyList<string> warnings)
+        {
+            if (postRead == null) throw new ArgumentNullException(nameof(postRead));
+            if (warnings == null) throw new ArgumentNullException(nameof(warnings));
+            return new(DraftApplyOutcomeKind.AppliedWithWarnings, null, Array.Empty<DraftDifference>(), warnings, postRead);
+        }
+
+        private static DraftApplyOutcome<TState> WithCause(DraftApplyOutcomeKind kind, string cause)
+        {
+            if (string.IsNullOrEmpty(cause)) throw new ArgumentException("A cause is required.", nameof(cause));
+            return new(kind, cause, Array.Empty<DraftDifference>(), Array.Empty<string>(), null);
+        }
+    }
+
+    public enum DraftApplyRefusal
+    {
+        None,
+
+        /// <summary>The draft was discarded or its session retired.</summary>
+        NotRegistered,
+
+        /// <summary>The draft is not Clean or Dirty (Conflict, Applying, Unknown or Error).</summary>
+        InvalidStatus,
+
+        /// <summary>There is pending text: the Update boundary must commit it first.</summary>
+        PendingText,
+
+        /// <summary>Another draft of the registry is already Applying.</summary>
+        AnotherUpdateInProgress,
+    }
+
+    /// <summary>The answer to TryBeginApply: whether it started, and the status the draft had before.</summary>
+    public readonly record struct DraftApplyStart(bool IsStarted, DraftStatus PreviousStatus, DraftApplyRefusal Refusal)
+    {
+        internal static DraftApplyStart Started(DraftStatus previous) => new(true, previous, DraftApplyRefusal.None);
+
+        internal static DraftApplyStart Refused(DraftStatus previous, DraftApplyRefusal refusal) => new(false, previous, refusal);
+    }
+
+    /// <summary>What CompleteApply did: the effective kind, the status afterwards and whether the draft was rebased.</summary>
+    public readonly record struct DraftApplyResult(bool Accepted, DraftApplyOutcomeKind Kind, DraftStatus Status, bool Rebased)
+    {
+        internal static DraftApplyResult Closed(DraftApplyOutcomeKind kind, DraftStatus status, bool rebased) => new(true, kind, status, rebased);
+
+        internal static DraftApplyResult NotApplying(DraftStatus status, DraftApplyOutcomeKind kind) => new(false, kind, status, false);
+    }
+}
diff --git a/src/RackCad.Application/Workspace/Drafts/DraftClosePolicy.cs b/src/RackCad.Application/Workspace/Drafts/DraftClosePolicy.cs
new file mode 100644
index 00000000..c5296703
--- /dev/null
+++ b/src/RackCad.Application/Workspace/Drafts/DraftClosePolicy.cs
@@ -0,0 +1,52 @@
+#nullable enable
+using System;
+using System.Collections.Generic;
+
+namespace RackCad.Application.Workspace.Drafts
+{
+    public enum DraftCloseVerdict
+    {
+        Allow,
+        Veto,
+    }
+
+    /// <summary>The decision on one attempt to close a document, with the racks that cause a veto.</summary>
+    public sealed class DraftCloseDecision
+    {
+        internal DraftCloseDecision(DraftCloseVerdict verdict, IReadOnlyList<string> rackIds)
+        {
+            Verdict = verdict;
+            RackIds = rackIds;
+        }
+
+        public DraftCloseVerdict Verdict { get; }
+
+        public bool IsVeto => Verdict == DraftCloseVerdict.Veto;
+
+        /// <summary>The racks whose draft is Dirty or has pending text, ordered (ordinal); empty for Allow.</summary>
+        public IReadOnlyList<string> RackIds { get; }
+    }
+
+    /// <summary>
+    /// The veto policy for closing a document (D-17, INV-20), decided from the in-memory drafts only. Every attempt is
+    /// evaluated anew: repeating an attempt is never consent, and only discarding the drafts lets the next close through.
+    /// The decision does not depend on the degraded mode of the session.
+    /// </summary>
+    public sealed class DraftClosePolicy
+    {
+        private readonly DraftRegistry _registry;
+
+        public DraftClosePolicy(DraftRegistry registry)
+        {
+            _registry = registry ?? throw new ArgumentNullException(nameof(registry));
+        }
+
+        public DraftCloseDecision EvaluateClose(SessionId session)
+        {
+            var atRisk = _registry.RacksAtRiskOf(session);
+            return atRisk.Count > 0
+                ? new DraftCloseDecision(DraftCloseVerdict.Veto, atRisk)
+                : new DraftCloseDecision(DraftCloseVerdict.Allow, Array.Empty<string>());
+        }
+    }
+}
diff --git a/src/RackCad.Application/Workspace/Drafts/DraftRegistry.cs b/src/RackCad.Application/Workspace/Drafts/DraftRegistry.cs
new file mode 100644
index 00000000..a6557175
--- /dev/null
+++ b/src/RackCad.Application/Workspace/Drafts/DraftRegistry.cs
@@ -0,0 +1,204 @@
+#nullable enable
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace RackCad.Application.Workspace.Drafts
+{
+    public enum DraftBeginStatus
+    {
+        Created,
+
+        /// <summary>The (session, rack) pair already has a draft: it is returned untouched and nothing is replaced.</summary>
+        AlreadyExists,
+
+        /// <summary>The read was not admitted: no draft was created and the admission carries the diagnostic.</summary>
+        NotAdmitted,
+
+        /// <summary>The session was retired: a retired session is never resurrected.</summary>
+        SessionRetired,
+    }
+
+    /// <summary>What Begin did. <see cref="Draft"/> is set for Created, and for AlreadyExists when the existing draft has the same state type.</summary>
+    public sealed class DraftBeginResult<TState>
+    {
+        internal DraftBeginResult(DraftBeginStatus status, DraftSession<TState>? draft, DraftAdmission admission)
+        {
+            Status = status;
+            Draft = draft;
+            Admission = admission;
+        }
+
+        public DraftBeginStatus Status { get; }
+
+        public DraftSession<TState>? Draft { get; }
+
+        public DraftAdmission Admission { get; }
+    }
+
+    /// <summary>What Discard did: whether a draft was removed and whether it was Dirty or had pending text.</summary>
+    public readonly record struct DraftDiscardResult(bool Removed, bool WasDirty);
+
+    /// <summary>What DiscardAll did: the racks whose drafts were removed, ordered by rack id (ordinal).</summary>
+    public sealed class DraftDiscardAllResult
+    {
+        internal DraftDiscardAllResult(IReadOnlyList<string> removedRackIds, IReadOnlyList<string> dirtyRackIds)
+        {
+            RemovedRackIds = removedRackIds;
+            DirtyRackIds = dirtyRackIds;
+        }
+
+        public IReadOnlyList<string> RemovedRackIds { get; }
+
+        /// <summary>The removed drafts that were Dirty or had pending text.</summary>
+        public IReadOnlyList<string> DirtyRackIds { get; }
+    }
+
+    /// <summary>The visible notice of loss (D-17, INV-20): the racks whose Dirty or pending drafts disappeared with the session.</summary>
+    public sealed class DraftLossNotice
+    {
+        internal DraftLossNotice(SessionId session, IReadOnlyList<string> lostRackIds)
+        {
+            Session = session;
+            LostRackIds = lostRackIds;
+        }
+
+        public SessionId Session { get; }
+
+        public IReadOnlyList<string> LostRackIds { get; }
+
+        public bool HasLoss => LostRackIds.Count > 0;
+    }
+
+    /// <summary>
+    /// The drafts of the workspace by (SessionId, RackId), in memory only (D-10, D-17). The rack id compares ordinally.
+    /// The same rack id in two sessions gives two independent drafts. Nothing here depends on any surface: a draft outlives
+    /// its dematerialization. Discarding or retiring never writes anything.
+    /// </summary>
+    public sealed class DraftRegistry
+    {
+        private readonly Dictionary<SessionId, Dictionary<string, IDraftEntry>> _bySession = new();
+        private readonly HashSet<SessionId> _retired = new();
+        private IDraftEntry? _applying;
+
+        /// <summary>
+        /// The only way a draft is born (INV-F4T1-03): from the result of ONE read of the edit intention that brings the
+        /// stale base, the admission and the initial state together. A read that is not admitted creates nothing.
+        /// </summary>
+        public DraftBeginResult<TState> Begin<TState>(SessionId session, string rackId, DraftIntentRead<TState> read, IEqualityComparer<TState> comparer)
+        {
+            if (string.IsNullOrEmpty(rackId)) throw new ArgumentException("A rack id is required.", nameof(rackId));
+            if (read == null) throw new ArgumentNullException(nameof(read));
+            if (comparer == null) throw new ArgumentNullException(nameof(comparer));
+
+            if (_retired.Contains(session))
+                return new DraftBeginResult<TState>(DraftBeginStatus.SessionRetired, null, read.Admission);
+            if (!read.IsAdmitted)
+                return new DraftBeginResult<TState>(DraftBeginStatus.NotAdmitted, null, read.Admission);
+
+            if (_bySession.TryGetValue(session, out var racks) && racks.TryGetValue(rackId, out var existing))
+                return new DraftBeginResult<TState>(DraftBeginStatus.AlreadyExists, existing as DraftSession<TState>, read.Admission);
+
+            if (racks == null)
+            {
+                racks = new Dictionary<string, IDraftEntry>(StringComparer.Ordinal);
+                _bySession[session] = racks;
+            }
+
+            var draft = new DraftSession<TState>(this, session, rackId, read.StaleBase!, read.InitialState!, comparer);
+            racks[rackId] = draft;
+            return new DraftBeginResult<TState>(DraftBeginStatus.Created, draft, read.Admission);
+        }
+
+        public DraftSession<TState>? Find<TState>(SessionId session, string rackId)
+        {
+            if (string.IsNullOrEmpty(rackId)) throw new ArgumentException("A rack id is required.", nameof(rackId));
+            return _bySession.TryGetValue(session, out var racks) && racks.TryGetValue(rackId, out var entry)
+                ? entry as DraftSession<TState>
+                : null;
+        }
+
+        public bool Contains(SessionId session, string rackId)
+        {
+            if (string.IsNullOrEmpty(rackId)) throw new ArgumentException("A rack id is required.", nameof(rackId));
+            return _bySession.TryGetValue(session, out var racks) && racks.ContainsKey(rackId);
+        }
+
+        public int CountOf(SessionId session) => _bySession.TryGetValue(session, out var racks) ? racks.Count : 0;
+
+        /// <summary>The rack ids that have a draft in the session, ordered (ordinal).</summary>
+        public IReadOnlyList<string> RackIdsOf(SessionId session) =>
+            _bySession.TryGetValue(session, out var racks)
+                ? racks.Keys.OrderBy(k => k, StringComparer.Ordinal).ToArray()
+                : Array.Empty<string>();
+
+        /// <summary>The rack ids of the session whose draft is Dirty or has pending text, ordered (ordinal).</summary>
+        public IReadOnlyList<string> RacksAtRiskOf(SessionId session) =>
+            _bySession.TryGetValue(session, out var racks)
+                ? racks.Values.Where(e => e.IsDirty || e.HasPendingText).Select(e => e.RackId).OrderBy(k => k, StringComparer.Ordinal).ToArray()
+                : Array.Empty<string>();
+
+        /// <summary>True while some draft of the whole registry is Applying (at most one can be).</summary>
+        public bool HasUpdateInProgress => _applying != null;
+
+        /// <summary>True once the session was retired.</summary>
+        public bool IsRetired(SessionId session) => _retired.Contains(session);
+
+        /// <summary>Removes one draft without writing anything. The session stays alive.</summary>
+        public DraftDiscardResult Discard(SessionId session, string rackId)
+        {
+            if (string.IsNullOrEmpty(rackId)) throw new ArgumentException("A rack id is required.", nameof(rackId));
+            if (!_bySession.TryGetValue(session, out var racks) || !racks.TryGetValue(rackId, out var entry))
+                return new DraftDiscardResult(false, false);
+
+            var wasDirty = entry.IsDirty || entry.HasPendingText;
+            racks.Remove(rackId);
+            if (racks.Count == 0) _bySession.Remove(session);
+            entry.Detach();
+            return new DraftDiscardResult(true, wasDirty);
+        }
+
+        /// <summary>The explicit discard of the panel: removes every draft of the session without writing anything. The session stays alive.</summary>
+        public DraftDiscardAllResult DiscardAll(SessionId session)
+        {
+            if (!_bySession.TryGetValue(session, out var racks))
+                return new DraftDiscardAllResult(Array.Empty<string>(), Array.Empty<string>());
+
+            var removed = racks.Keys.OrderBy(k => k, StringComparer.Ordinal).ToArray();
+            var dirty = racks.Values.Where(e => e.IsDirty || e.HasPendingText).Select(e => e.RackId).OrderBy(k => k, StringComparer.Ordinal).ToArray();
+            _bySession.Remove(session);
+            foreach (var entry in racks.Values) entry.Detach();
+            return new DraftDiscardAllResult(removed, dirty);
+        }
+
+        /// <summary>
+        /// Retires a destroyed session: removes all its drafts, never resurrects it, and reports the loss with the list
+        /// of racks that were Dirty or had pending text.
+        /// </summary>
+        public DraftLossNotice RetireSession(SessionId session)
+        {
+            _retired.Add(session);
+            if (!_bySession.TryGetValue(session, out var racks))
+                return new DraftLossNotice(session, Array.Empty<string>());
+
+            var lost = racks.Values.Where(e => e.IsDirty || e.HasPendingText).Select(e => e.RackId).OrderBy(k => k, StringComparer.Ordinal).ToArray();
+            _bySession.Remove(session);
+            foreach (var entry in racks.Values) entry.Detach();
+            return new DraftLossNotice(session, lost);
+        }
+
+        // ---------------------------------------------------------------- the single Applying slot
+
+        internal bool TryAcquireApplySlot(IDraftEntry entry)
+        {
+            if (_applying != null) return false;
+            _applying = entry;
+            return true;
+        }
+
+        internal void ReleaseApplySlot(IDraftEntry entry)
+        {
+            if (ReferenceEquals(_applying, entry)) _applying = null;
+        }
+    }
+}
diff --git a/src/RackCad.Application/Workspace/Drafts/DraftSession.cs b/src/RackCad.Application/Workspace/Drafts/DraftSession.cs
new file mode 100644
index 00000000..9a7b1fd8
--- /dev/null
+++ b/src/RackCad.Application/Workspace/Drafts/DraftSession.cs
@@ -0,0 +1,549 @@
+#nullable enable
+using System;
+using System.Collections.Generic;
+
+namespace RackCad.Application.Workspace.Drafts
+{
+    /// <summary>Verdict of the admission evaluated by the one logical read of the edit intention (D-11). Carried as a value.</summary>
+    public readonly record struct DraftAdmission(bool IsAdmitted, string? Diagnostic)
+    {
+        public static DraftAdmission Admitted => new(true, null);
+
+        public static DraftAdmission Rejected(string diagnostic)
+        {
+            if (string.IsNullOrEmpty(diagnostic)) throw new ArgumentException("An admission diagnostic is required.", nameof(diagnostic));
+            return new DraftAdmission(false, diagnostic);
+        }
+    }
+
+    /// <summary>
+    /// The result of ONE logical read of the edit intention (D-10): the stale base, the admission and the initial draft
+    /// state all come from the same read. It can only be built through <see cref="Admitted"/> or <see cref="NotAdmitted"/>;
+    /// a navigation preview has no way to produce one.
+    /// </summary>
+    public sealed class DraftIntentRead<TState>
+    {
+        private DraftIntentRead(DraftAdmission admission, DraftStaleBase? staleBase, TState? initialState)
+        {
+            Admission = admission;
+            StaleBase = staleBase;
+            InitialState = initialState;
+        }
+
+        public DraftAdmission Admission { get; }
+
+        public bool IsAdmitted => Admission.IsAdmitted;
+
+        /// <summary>The base of the read; null when the read was not admitted.</summary>
+        public DraftStaleBase? StaleBase { get; }
+
+        /// <summary>The editable state materialized from the same read; default when the read was not admitted.</summary>
+        public TState? InitialState { get; }
+
+        public static DraftIntentRead<TState> Admitted(DraftStaleBase staleBase, TState initialState)
+        {
+            if (staleBase == null) throw new ArgumentNullException(nameof(staleBase));
+            return new DraftIntentRead<TState>(DraftAdmission.Admitted, staleBase, initialState);
+        }
+
+        public static DraftIntentRead<TState> NotAdmitted(string diagnostic) =>
+            new(DraftAdmission.Rejected(diagnostic), null, default);
+    }
+
+    /// <summary>
+    /// Status of a draft (D-10). Clean and Dirty are derived; the other four are explicit. "Possibly stale" is NOT a
+    /// status: it is an orthogonal mark (<see cref="DraftSession{TState}.IsPossiblyStale"/>).
+    /// </summary>
+    public enum DraftStatus
+    {
+        Clean,
+        Dirty,
+        Conflict,
+        Applying,
+        Unknown,
+        Error,
+    }
+
+    /// <summary>Why a draft is Unknown (D-13): the commit threw, or the re-read after the write failed.</summary>
+    public enum DraftUnknownOrigin
+    {
+        CommitThrew,
+        PostReread,
+    }
+
+    /// <summary>Internal boundaries of the panel (D-10). The first three are blocking, the rest are not.</summary>
+    public enum DraftBoundary
+    {
+        TabChange,
+        RackChange,
+        Update,
+        DocumentChange,
+        HidePanel,
+        Dematerialize,
+        DocumentClose,
+    }
+
+    public static class DraftBoundaries
+    {
+        /// <summary>True for the user-initiated boundaries that run the two-phase commit of the pending text (ADR-0032 D6).</summary>
+        public static bool IsBlocking(DraftBoundary boundary) =>
+            boundary == DraftBoundary.TabChange || boundary == DraftBoundary.RackChange || boundary == DraftBoundary.Update;
+    }
+
+    /// <summary>Verdict of the adapter's validator for one pending field.</summary>
+    public readonly record struct DraftFieldValidation(bool IsValid, string? Message)
+    {
+        public static DraftFieldValidation Valid => new(true, null);
+
+        public static DraftFieldValidation Invalid(string message) => new(false, message);
+    }
+
+    /// <summary>A pending field that failed validation at a blocking boundary.</summary>
+    public readonly record struct DraftInvalidField(string FieldKey, string? Message);
+
+    /// <summary>
+    /// What the adapter of a system contributes to the two-phase commit (ADR-0032 D6). The core never interprets the text.
+    /// </summary>
+    public interface IDraftPendingTextAdapter<TState>
+    {
+        /// <summary>Phase one: validates one pending text without mutating anything.</summary>
+        DraftFieldValidation Validate(string fieldKey, string text);
+
+        /// <summary>Phase two: builds the next state from ALL the pending text, which is already known to be valid.</summary>
+        TState Apply(TState current, IReadOnlyDictionary<string, string> pendingText);
+    }
+
+    public enum DraftBoundaryDecision
+    {
+        /// <summary>A blocking boundary: nothing was pending, or all the pending text was valid and was applied in one step.</summary>
+        Proceeded,
+
+        /// <summary>A blocking boundary with an invalid field: nothing was applied and all the pending text is untouched.</summary>
+        Aborted,
+
+        /// <summary>The pending text was kept as is: a non-blocking boundary (never commits, never repairs), or a draft that cannot commit now.</summary>
+        Kept,
+    }
+
+    /// <summary>What happened when a boundary was crossed.</summary>
+    public sealed class DraftBoundaryResult
+    {
+        internal DraftBoundaryResult(DraftBoundary boundary, DraftBoundaryDecision decision, bool stateChanged, IReadOnlyList<DraftInvalidField> invalidFields)
+        {
+            Boundary = boundary;
+            Decision = decision;
+            CurrentStateChanged = stateChanged;
+            InvalidFields = invalidFields;
+        }
+
+        public DraftBoundary Boundary { get; }
+
+        public DraftBoundaryDecision Decision { get; }
+
+        /// <summary>True when the pending text was applied to the current draft state.</summary>
+        public bool CurrentStateChanged { get; }
+
+        public IReadOnlyList<DraftInvalidField> InvalidFields { get; }
+    }
+
+    public enum DraftEditStatus
+    {
+        Updated,
+
+        /// <summary>The draft is Applying, Unknown, in Error or no longer registered, so nothing changed.</summary>
+        NotEditable,
+    }
+
+    /// <summary>Result of an edit: whether it was taken and whether the draft is Dirty afterwards.</summary>
+    public readonly record struct DraftEditResult(DraftEditStatus Status, bool IsDirty);
+
+    public enum DraftReloadStatus
+    {
+        Reloaded,
+
+        /// <summary>The read was not admitted: nothing changed and the admission carries the diagnostic.</summary>
+        NotAdmitted,
+
+        /// <summary>KeepMineOnCurrentVersion without confirmation: nothing changed.</summary>
+        NotConfirmed,
+
+        /// <summary>The draft is Applying, no longer registered or in a status this operation does not serve: nothing changed.</summary>
+        NotAllowed,
+    }
+
+    public readonly record struct DraftReloadResult(DraftReloadStatus Status, DraftAdmission Admission);
+
+    public enum DraftMarkResult
+    {
+        Marked,
+        AlreadyMarked,
+        NotRegistered,
+    }
+
+    /// <summary>A status change reported by an operation.</summary>
+    public readonly record struct DraftTransition(DraftStatus From, DraftStatus To)
+    {
+        public bool Changed => From != To;
+    }
+
+    public enum DraftCheckStatus
+    {
+        /// <summary>The draft is not Unknown with origin CommitThrew: nothing changed.</summary>
+        NotApplicable,
+
+        /// <summary>The re-read matches the base before the attempt: the draft recovered its previous status and content.</summary>
+        Recovered,
+
+        /// <summary>The re-read differs: the draft is now in Conflict.</summary>
+        Conflict,
+    }
+
+    public readonly record struct DraftCheckResult(DraftCheckStatus Status, DraftStatus DraftStatus, IReadOnlyList<DraftDifference> Differences);
+
+    internal interface IDraftEntry
+    {
+        SessionId Session { get; }
+
+        string RackId { get; }
+
+        bool IsDirty { get; }
+
+        bool HasPendingText { get; }
+
+        DraftStatus Status { get; }
+
+        void Detach();
+    }
+
+    /// <summary>
+    /// The draft of one rack in one session (D-10): stale base, initial and current draft state, pending text and status,
+    /// all in memory. It is generic over the editable state that already exists in Application; the core defines no
+    /// state of any system. It can only be born through <c>DraftRegistry.Begin</c>.
+    /// </summary>
+    public sealed class DraftSession<TState> : IDraftEntry
+    {
+        private readonly IEqualityComparer<TState> _comparer;
+        private readonly SortedDictionary<string, string> _pending = new(StringComparer.Ordinal);
+        private DraftRegistry? _owner;
+        private DraftStatus? _explicitStatus;
+        private DraftStatus _statusBeforeAttempt;
+
+        internal DraftSession(DraftRegistry owner, SessionId session, string rackId, DraftStaleBase staleBase, TState initialState, IEqualityComparer<TState> comparer)
+        {
+            _owner = owner;
+            Session = session;
+            RackId = rackId;
+            StaleBase = staleBase;
+            InitialDraftState = initialState;
+            CurrentDraftState = initialState;
+            _comparer = comparer;
+        }
+
+        public SessionId Session { get; }
+
+        public string RackId { get; }
+
+        public DraftStaleBase StaleBase { get; private set; }
+
+        public TState InitialDraftState { get; private set; }
+
+        public TState CurrentDraftState { get; private set; }
+
+        /// <summary>The pending text by field key, kept exactly as given. A snapshot ordered by key (ordinal).</summary>
+        public IReadOnlyDictionary<string, string> PendingText => new Dictionary<string, string>(_pending, StringComparer.Ordinal);
+
+        public bool HasPendingText => _pending.Count > 0;
+
+        /// <summary>True when the comparator says the current state differs from the initial one, or there is pending text (INV-26).</summary>
+        public bool IsDirty => _pending.Count > 0 || !_comparer.Equals(CurrentDraftState, InitialDraftState);
+
+        public DraftStatus Status => _explicitStatus ?? (IsDirty ? DraftStatus.Dirty : DraftStatus.Clean);
+
+        /// <summary>The orthogonal "possibly stale" mark. It changes neither the editable state, nor dirty, nor the pending text.</summary>
+        public bool IsPossiblyStale { get; private set; }
+
+        /// <summary>True only for a Clean, marked draft: it reloads lazily when it is activated (O-01).</summary>
+        public bool NeedsLazyReload => IsPossiblyStale && Status == DraftStatus.Clean;
+
+        /// <summary>False once the draft was discarded or its session retired.</summary>
+        public bool IsRegistered => _owner != null;
+
+        public DraftUnknownOrigin? UnknownOrigin { get; private set; }
+
+        /// <summary>What changed, when the draft is in Conflict.</summary>
+        public IReadOnlyList<DraftDifference> ConflictDifferences { get; private set; } = Array.Empty<DraftDifference>();
+
+        /// <summary>The cause of the last attempt that did not apply, or of an Unknown outcome.</summary>
+        public string? LastApplyCause { get; private set; }
+
+        /// <summary>The warnings of the last AppliedWithWarnings outcome.</summary>
+        public IReadOnlyList<string> Warnings { get; private set; } = Array.Empty<string>();
+
+        public string? ErrorReason { get; private set; }
+
+        private bool CanEdit => _owner != null
+            && (_explicitStatus == null || _explicitStatus == DraftStatus.Conflict);
+
+        // ---------------------------------------------------------------- edits
+
+        public DraftEditResult SetCurrentDraftState(TState state)
+        {
+            if (!CanEdit) return new DraftEditResult(DraftEditStatus.NotEditable, IsDirty);
+            CurrentDraftState = state;
+            return new DraftEditResult(DraftEditStatus.Updated, IsDirty);
+        }
+
+        /// <summary>Keeps the text of one field exactly as given (D-10). Empty text is a legitimate pending text.</summary>
+        public DraftEditResult SetPendingText(string fieldKey, string text)
+        {
+            if (string.IsNullOrEmpty(fieldKey)) throw new ArgumentException("A field key is required.", nameof(fieldKey));
+            if (text == null) throw new ArgumentNullException(nameof(text));
+            if (!CanEdit) return new DraftEditResult(DraftEditStatus.NotEditable, IsDirty);
+            _pending[fieldKey] = text;
+            return new DraftEditResult(DraftEditStatus.Updated, IsDirty);
+        }
+
+        public DraftEditResult RemovePendingText(string fieldKey)
+        {
+            if (string.IsNullOrEmpty(fieldKey)) throw new ArgumentException("A field key is required.", nameof(fieldKey));
+            if (!CanEdit) return new DraftEditResult(DraftEditStatus.NotEditable, IsDirty);
+            _pending.Remove(fieldKey);
+            return new DraftEditResult(DraftEditStatus.Updated, IsDirty);
+        }
+
+        // ---------------------------------------------------------------- boundaries
+
+        /// <summary>
+        /// Crosses a boundary (D-10, ADR-0032 D6). Blocking: validate ALL the pending text without mutating; if any field is
+        /// invalid, abort and leave everything as it was; otherwise apply all of it in one step to the current state and
+        /// clear the pending text. Non-blocking: keep the pending text as is, neither committing nor repairing.
+        /// </summary>
+        public DraftBoundaryResult CrossBoundary(DraftBoundary boundary, IDraftPendingTextAdapter<TState> adapter)
+        {
+            if (adapter == null) throw new ArgumentNullException(nameof(adapter));
+            var none = Array.Empty<DraftInvalidField>();
+            if (!DraftBoundaries.IsBlocking(boundary))
+                return new DraftBoundaryResult(boundary, DraftBoundaryDecision.Kept, false, none);
+            if (_pending.Count == 0)
+                return new DraftBoundaryResult(boundary, DraftBoundaryDecision.Proceeded, false, none);
+            if (!CanEdit)
+                return new DraftBoundaryResult(boundary, DraftBoundaryDecision.Kept, false, none);
+
+            var snapshot = new Dictionary<string, string>(_pending, StringComparer.Ordinal);
+            var invalid = new List<DraftInvalidField>();
+            foreach (var pair in _pending)
+            {
+                var verdict = adapter.Validate(pair.Key, pair.Value);
+                if (!verdict.IsValid) invalid.Add(new DraftInvalidField(pair.Key, verdict.Message));
+            }
+
+            if (invalid.Count > 0)
+                return new DraftBoundaryResult(boundary, DraftBoundaryDecision.Aborted, false, invalid.ToArray());
+
+            var next = adapter.Apply(CurrentDraftState, snapshot);
+            CurrentDraftState = next;
+            _pending.Clear();
+            return new DraftBoundaryResult(boundary, DraftBoundaryDecision.Proceeded, true, none);
+        }
+
+        // ---------------------------------------------------------------- possibly stale
+
+        public DraftMarkResult MarkPossiblyStale()
+        {
+            if (_owner == null) return DraftMarkResult.NotRegistered;
+            if (IsPossiblyStale) return DraftMarkResult.AlreadyMarked;
+            IsPossiblyStale = true;
+            return DraftMarkResult.Marked;
+        }
+
+        // ---------------------------------------------------------------- reloads and reconciliation
+
+        /// <summary>
+        /// Replaces the stale base, the initial state AND the current state from one read, and empties the pending text.
+        /// Allowed from every status except Applying.
+        /// </summary>
+        public DraftReloadResult DiscardAndReload(DraftIntentRead<TState> read)
+        {
+            if (read == null) throw new ArgumentNullException(nameof(read));
+            if (_owner == null || _explicitStatus == DraftStatus.Applying)
+                return new DraftReloadResult(DraftReloadStatus.NotAllowed, read.Admission);
+            if (!read.IsAdmitted)
+                return new DraftReloadResult(DraftReloadStatus.NotAdmitted, read.Admission);
+
+            Rebase(read);
+            CurrentDraftState = InitialDraftState;
+            _pending.Clear();
+            return new DraftReloadResult(DraftReloadStatus.Reloaded, read.Admission);
+        }
+
+        /// <summary>
+        /// Replaces the stale base and the initial state from one read and KEEPS the current state and the pending text,
+        /// only with an explicit confirmation. Served in Dirty and Conflict. There is no automatic merge.
+        /// </summary>
+        public DraftReloadResult KeepMineOnCurrentVersion(DraftIntentRead<TState> read, bool confirmed)
+        {
+            if (read == null) throw new ArgumentNullException(nameof(read));
+            var status = Status;
+            if (_owner == null || (status != DraftStatus.Dirty && status != DraftStatus.Conflict))
+                return new DraftReloadResult(DraftReloadStatus.NotAllowed, read.Admission);
+            if (!confirmed)
+                return new DraftReloadResult(DraftReloadStatus.NotConfirmed, read.Admission);
+            if (!read.IsAdmitted)
+                return new DraftReloadResult(DraftReloadStatus.NotAdmitted, read.Admission);
+
+            Rebase(read);
+            return new DraftReloadResult(DraftReloadStatus.Reloaded, read.Admission);
+        }
+
+        private void Rebase(DraftIntentRead<TState> read)
+        {
+            StaleBase = read.StaleBase!;
+            InitialDraftState = read.InitialState!;
+            IsPossiblyStale = false;
+            _explicitStatus = null;
+            UnknownOrigin = null;
+            ConflictDifferences = Array.Empty<DraftDifference>();
+            LastApplyCause = null;
+            Warnings = Array.Empty<string>();
+            ErrorReason = null;
+        }
+
+        // ---------------------------------------------------------------- Update as a state machine
+
+        /// <summary>
+        /// Starts an Update. Only from Clean, or from Dirty without pending text, and only when no other Update is in
+        /// progress in the whole registry. It reports the previous status.
+        /// </summary>
+        public DraftApplyStart TryBeginApply()
+        {
+            var previous = Status;
+            if (_owner == null) return DraftApplyStart.Refused(previous, DraftApplyRefusal.NotRegistered);
+            if (previous != DraftStatus.Clean && previous != DraftStatus.Dirty)
+                return DraftApplyStart.Refused(previous, DraftApplyRefusal.InvalidStatus);
+            if (_pending.Count > 0) return DraftApplyStart.Refused(previous, DraftApplyRefusal.PendingText);
+            if (!_owner.TryAcquireApplySlot(this)) return DraftApplyStart.Refused(previous, DraftApplyRefusal.AnotherUpdateInProgress);
+
+            _statusBeforeAttempt = previous;
+            _explicitStatus = DraftStatus.Applying;
+            LastApplyCause = null;
+            return DraftApplyStart.Started(previous);
+        }
+
+        /// <summary>
+        /// Closes the Update that is in progress with its outcome (D-13 table). Nothing is ever assumed applied: only the
+        /// re-read of POST rebases the draft and leaves it Clean.
+        /// </summary>
+        public DraftApplyResult CompleteApply(DraftApplyOutcome<TState> outcome)
+        {
+            if (outcome == null) throw new ArgumentNullException(nameof(outcome));
+            if (_owner == null || _explicitStatus != DraftStatus.Applying)
+                return DraftApplyResult.NotApplying(Status, outcome.Kind);
+
+            _owner.ReleaseApplySlot(this);
+            _explicitStatus = null;
+            switch (outcome.Kind)
+            {
+                case DraftApplyOutcomeKind.NotAppliedConflict:
+                    _explicitStatus = DraftStatus.Conflict;
+                    ConflictDifferences = outcome.Differences;
+                    LastApplyCause = outcome.Cause;
+                    return DraftApplyResult.Closed(outcome.Kind, Status, false);
+
+                case DraftApplyOutcomeKind.NotAppliedAdmission:
+                case DraftApplyOutcomeKind.NotAppliedPreflight:
+                case DraftApplyOutcomeKind.NotAppliedFailure:
+                    LastApplyCause = outcome.Cause;
+                    return DraftApplyResult.Closed(outcome.Kind, Status, false);
+
+                case DraftApplyOutcomeKind.CommitThrew:
+                    _explicitStatus = DraftStatus.Unknown;
+                    UnknownOrigin = DraftUnknownOrigin.CommitThrew;
+                    LastApplyCause = outcome.Cause;
+                    return DraftApplyResult.Closed(outcome.Kind, Status, false);
+
+                case DraftApplyOutcomeKind.Applied:
+                case DraftApplyOutcomeKind.AppliedWithWarnings:
+                {
+                    var read = outcome.PostRead;
+                    if (read == null || !read.IsAdmitted)
+                    {
+                        // The write happened but its re-read cannot rebase the draft: never assume it is clean.
+                        _explicitStatus = DraftStatus.Unknown;
+                        UnknownOrigin = DraftUnknownOrigin.PostReread;
+                        LastApplyCause = read?.Admission.Diagnostic;
+                        return DraftApplyResult.Closed(DraftApplyOutcomeKind.AppliedPostRereadFailed, Status, false);
+                    }
+
+                    Rebase(read);
+                    CurrentDraftState = InitialDraftState;
+                    _pending.Clear();
+                    if (outcome.Kind == DraftApplyOutcomeKind.AppliedWithWarnings) Warnings = outcome.Warnings;
+                    return DraftApplyResult.Closed(outcome.Kind, Status, true);
+                }
+
+                default:
+                    _explicitStatus = DraftStatus.Unknown;
+                    UnknownOrigin = DraftUnknownOrigin.PostReread;
+                    LastApplyCause = outcome.Cause;
+                    return DraftApplyResult.Closed(DraftApplyOutcomeKind.AppliedPostRereadFailed, Status, false);
+            }
+        }
+
+        /// <summary>
+        /// "Check now" (D-13, O3-06), only for Unknown with origin CommitThrew. If the re-read matches the base from before
+        /// the attempt, the draft recovers exactly its previous status and content; otherwise it goes to Conflict.
+        /// </summary>
+        public DraftCheckResult CheckNow(DraftStaleBase reread)
+        {
+            if (reread == null) throw new ArgumentNullException(nameof(reread));
+            if (_owner == null || _explicitStatus != DraftStatus.Unknown || UnknownOrigin != DraftUnknownOrigin.CommitThrew)
+                return new DraftCheckResult(DraftCheckStatus.NotApplicable, Status, Array.Empty<DraftDifference>());
+
+            var comparison = StaleBase.CompareWith(reread);
+            UnknownOrigin = null;
+            if (comparison.IsMatch)
+            {
+                _explicitStatus = null;
+                LastApplyCause = null;
+                return new DraftCheckResult(DraftCheckStatus.Recovered, Status, Array.Empty<DraftDifference>());
+            }
+
+            _explicitStatus = DraftStatus.Conflict;
+            ConflictDifferences = comparison.Differences;
+            return new DraftCheckResult(DraftCheckStatus.Conflict, Status, comparison.Differences);
+        }
+
+        /// <summary>The status the draft had when the current or last attempt began.</summary>
+        public DraftStatus StatusBeforeAttempt => _statusBeforeAttempt;
+
+        // ---------------------------------------------------------------- error
+
+        /// <summary>
+        /// Puts the draft in Error keeping the current state, the pending text and the stale base. It leaves Error only
+        /// through DiscardAndReload or Discard.
+        /// </summary>
+        public DraftTransition EnterError(string reason)
+        {
+            if (string.IsNullOrEmpty(reason)) throw new ArgumentException("A reason is required.", nameof(reason));
+            var from = Status;
+            if (_owner == null) return new DraftTransition(from, from);
+            if (_explicitStatus == DraftStatus.Applying) _owner.ReleaseApplySlot(this);
+            _explicitStatus = DraftStatus.Error;
+            ErrorReason = reason;
+            return new DraftTransition(from, DraftStatus.Error);
+        }
+
+        // ---------------------------------------------------------------- registry plumbing
+
+        void IDraftEntry.Detach()
+        {
+            if (_owner != null && _explicitStatus == DraftStatus.Applying)
+            {
+                _owner.ReleaseApplySlot(this);
+                _explicitStatus = null;
+            }
+
+            _owner = null;
+        }
+    }
+}
diff --git a/src/RackCad.Application/Workspace/Drafts/DraftStaleBase.cs b/src/RackCad.Application/Workspace/Drafts/DraftStaleBase.cs
