+        private static HashSet<object> Mutable(IEnumerable<object> objects)
+        {
+            var set = new HashSet<object>(ReferenceEqualityComparer.Instance);
+            foreach (var item in objects)
+            {
+                if (!IsImmutable(item.GetType())) set.Add(item);
+            }
+
+            return set;
+        }
