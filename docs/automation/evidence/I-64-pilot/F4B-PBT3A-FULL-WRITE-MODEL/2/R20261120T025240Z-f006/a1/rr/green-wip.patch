--- /dev/null
+++ b/src/RackCad.Application/Systems/PushBack/Draft/PushBackEditableStateSeat.cs
@@ -0,0 +1,56 @@
+using System;
+using RackCad.Application.Catalogs;
+using RackCad.Domain.Systems.PushBack;
+
+namespace RackCad.Application.Systems.PushBack.Draft
+{
+    /// <summary>
+    /// I-64 F4B PB-T3a (D-PBT3-03) — the seat of the editable state: the recompute pass of the window and the sequence of
+    /// its LoadExisting, as product code. Until the window uses it (PB-T4, A-T3-9) the same sequence lives in two places,
+    /// and only CT-PBT3A-01 ties them.
+    /// </summary>
+    public static class PushBackEditableStateSeat
+    {
+        /// <summary>
+        /// The adoption of a recompute pass as the window runs it, adapted to the state: build the design from the editor and
+        /// the inputs, and, when the computation is valid, accept it into side A, commit the consumption of the dormant tail,
+        /// clear the module commit and restore the advanced parameters when a standard restore landed. An exception of the
+        /// assembly gives <c>null</c>, as the catch of the window does.
+        /// </summary>
+        public static PushBackEditorComputation Pass(
+            PushBackEditableState state, PushBackEditorDesignAssembler assembler,
+            PushBackCompositeEditorAssembler compositeAssembler, PushBackSide frontalSide)
+        {
+            PushBackEditorComputation computation;
+            try { computation = assembler.BuildFrom(compositeAssembler.BuildDesign(state.Editor, state.BuildInputs(assembler)), frontalSide); }
+            catch (Exception) { return null; }
+            if (!computation.IsValid) return computation;
+            assembler.AcceptComputation(state.Editor.SideA, computation);
+            state.Editor.CommitDormantTailConsumption();
+            var standardRestoreLanded = state.Editor.SideA.ModuleCommit?.StandardRestoreRequested == true;
+            state.Editor.SideA.ClearModuleCommit();
+            if (standardRestoreLanded) state.Editor.Active.RestoreAdvancedRackParameters(state.Advanced);
+            _ = state.Editor.SideA.ModuleSession;
+            return computation;
+        }
+
+        /// <summary>
+        /// The state the window would hold after opening that rack: the new window (LoadNew, pass, default safety, pass),
+        /// then the design (LoadDesign, pass). Always with the frontal side A.
+        /// </summary>
+        public static PushBackEditableState LoadExisting(PushBackDesign design, string rackName, RackCatalog catalog)
+        {
+            if (design == null) throw new ArgumentNullException(nameof(design));
+            var state = new PushBackEditableState();
+            var assembler = new PushBackEditorDesignAssembler(catalog);
+            var compositeAssembler = new PushBackCompositeEditorAssembler(catalog);
+            state.LoadNew(catalog);
+            Pass(state, assembler, compositeAssembler, PushBackSide.A);
+            state.SeedDefaultSafety(catalog);
+            Pass(state, assembler, compositeAssembler, PushBackSide.A);
+            state.LoadDesign(design, rackName, assembler.Resolver);
+            Pass(state, assembler, compositeAssembler, PushBackSide.A);
+            return state;
+        }
+    }
+}
diff --git a/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullComposition.cs b/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullComposition.cs
new file mode 100644
index 00000000..c80ede88
--- /dev/null
+++ b/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullComposition.cs
@@ -0,0 +1,97 @@
+using System;
+using RackCad.Application.Catalogs;
+using RackCad.Application.Systems.PushBack.Pilot;
+
+namespace RackCad.Application.Systems.PushBack.Draft
+{
+    /// <summary>
+    /// I-64 F4B PB-T3a (D-PBT3-05) — the pair <see cref="PushBackCompositeEditorAssembler.BuildDesign"/> consumes, with the
+    /// name of the draft, or the reason the draft cannot be composed. The objects of a composition belong to the caller:
+    /// they are fresh objects, never one of the states of a draft.
+    /// </summary>
+    public sealed class PushBackFullWriteComposition
+    {
+        private PushBackFullWriteComposition(PushBackCompositeEditorState editor, PushBackEditorInputs inputs, string name, string reason)
+        {
+            Editor = editor;
+            Inputs = inputs;
+            Name = name;
+            Reason = reason;
+        }
+
+        public bool IsComposed => Editor != null && Inputs != null;
+
+        /// <summary>The composite state to hand to the assembler; null when the composition was rejected.</summary>
+        public PushBackCompositeEditorState Editor { get; }
+
+        /// <summary>The rack-wide inputs to hand to the assembler; null when the composition was rejected.</summary>
+        public PushBackEditorInputs Inputs { get; }
+
+        /// <summary>The name of the draft, as it is (it can be null or blank).</summary>
+        public string Name { get; }
+
+        /// <summary>Why the composition was rejected; null when it was composed.</summary>
+        public string Reason { get; }
+
+        public static PushBackFullWriteComposition Composed(PushBackCompositeEditorState editor, PushBackEditorInputs inputs, string name)
+            => new PushBackFullWriteComposition(
+                editor ?? throw new ArgumentNullException(nameof(editor)),
+                inputs ?? throw new ArgumentNullException(nameof(inputs)),
+                name,
+                null);
+
+        public static PushBackFullWriteComposition Rejected(string reason)
+            => new PushBackFullWriteComposition(null, null, null, reason);
+    }
+
+    /// <summary>
+    /// I-64 F4B PB-T3a (D-PBT3-05) — the composition to write and the composition of "keep my draft" for the FULL model,
+    /// not connected to the panel. In the full model every editable field comes from the draft: nothing is compared with
+    /// what "the editor does not edit", because there is nothing like that.
+    /// </summary>
+    public static class PushBackFullComposition
+    {
+        /// <summary>
+        /// The composition to write. Pure and total: it mutates neither state and never throws. It is only safe AFTER the base
+        /// matched a re-read (H-06): the plan of an update calls it then. A scale that is not finite or not greater than zero is
+        /// rejected, and so is a base that, materialized again, no longer equals the initial state. The editor, the carriers
+        /// and the name come from a copy of <paramref name="current"/>.
+        /// </summary>
+        public static PushBackFullWriteComposition ForFullWrite(PushBackFullDraftState initial, PushBackFullDraftState current, RackCatalog catalog)
+        {
+            try
+            {
+                if (initial == null || current == null) return PushBackFullWriteComposition.Rejected("Falta el estado inicial o el actual.");
+                if (catalog == null) return PushBackFullWriteComposition.Rejected(PushBackPilotMaterializer.CatalogRequiredDiagnostic);
+
+                var scale = current.Editable.AnnotationScale;
+                if (double.IsNaN(scale) || double.IsInfinity(scale) || scale <= 0.0)
+                    return PushBackFullWriteComposition.Rejected(PushBackPilotMaterializer.InvalidScaleReason);
+
+                var fresh = PushBackFullDraftMaterializer.Materialize(initial.Origin, catalog);
+                if (!fresh.IsAdmitted)
+                    return PushBackFullWriteComposition.Rejected(fresh.Reason ?? PushBackPilotMaterializer.UnreadableOrFutureDiagnostic);
+                if (!PushBackFullDraftStateComparer.Instance.Equals(initial, fresh.State))
+                    return PushBackFullWriteComposition.Rejected(PushBackPilotMaterializer.BaseChangedReason);
+
+                var copy = PushBackEditableStateComparer.Copy(current.Editable);
+                return PushBackFullWriteComposition.Composed(copy.Editor, copy.BuildInputs(new PushBackEditorDesignAssembler(catalog)), copy.Name);
+            }
+            catch (Exception ex)
+            {
+                return PushBackFullWriteComposition.Rejected(PushBackPilotMaterializer.ComposeFailurePrefix + ex.Message);
+            }
+        }
+
+        /// <summary>
+        /// After the user keeps the draft on a newer version, the current state is a copy of the editable state of
+        /// <paramref name="current"/> over the origin of <paramref name="newInitial"/>. Pure: it mutates neither argument.
+        /// </summary>
+        public static PushBackFullDraftState KeepOn(PushBackFullDraftState newInitial, PushBackFullDraftState current)
+        {
+            if (newInitial == null) throw new ArgumentNullException(nameof(newInitial));
+            if (current == null) throw new ArgumentNullException(nameof(current));
+            return new PushBackFullDraftState(PushBackEditableStateComparer.Copy(current.Editable), newInitial.Origin);
+        }
+    }
+}
diff --git a/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullDraftMaterializer.cs b/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullDraftMaterializer.cs
new file mode 100644
index 00000000..89494db3
--- /dev/null
+++ b/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullDraftMaterializer.cs
@@ -0,0 +1,78 @@
+using System;
+using RackCad.Application.Catalogs;
+using RackCad.Application.Persistence;
+using RackCad.Application.Systems.PushBack.Pilot;
+
+namespace RackCad.Application.Systems.PushBack.Draft
+{
+    /// <summary>
+    /// I-64 F4B PB-T3a (D-PBT3-03) — the typed result of <see cref="PushBackFullDraftMaterializer.Materialize"/>:
+    /// Admitted(state), OutOfPilot(reason) or Failed(reason). Nothing is ever thrown to the caller.
+    /// </summary>
+    public sealed class PushBackFullDraftMaterialization
+    {
+        private PushBackFullDraftMaterialization(PushBackPilotMaterializationKind kind, PushBackFullDraftState state, string reason)
+        {
+            Kind = kind;
+            State = state;
+            Reason = reason;
+        }
+
+        public PushBackPilotMaterializationKind Kind { get; }
+
+        public bool IsAdmitted => Kind == PushBackPilotMaterializationKind.Admitted;
+
+        /// <summary>The materialized state; null unless the result is Admitted.</summary>
+        public PushBackFullDraftState State { get; }
+
+        /// <summary>Why the result is not Admitted; null for Admitted.</summary>
+        public string Reason { get; }
+
+        public static PushBackFullDraftMaterialization Admitted(PushBackFullDraftState state)
+            => new PushBackFullDraftMaterialization(PushBackPilotMaterializationKind.Admitted, state ?? throw new ArgumentNullException(nameof(state)), null);
+
+        public static PushBackFullDraftMaterialization OutOfPilot(string reason)
+            => new PushBackFullDraftMaterialization(PushBackPilotMaterializationKind.OutOfPilot, null, reason);
+
+        public static PushBackFullDraftMaterialization Failed(string reason)
+            => new PushBackFullDraftMaterialization(PushBackPilotMaterializationKind.Failed, null, reason);
+    }
+
+    /// <summary>
+    /// I-64 F4B PB-T3a (D-PBT3-03) — materializes the FULL draft state from the raw text of an authored envelope. It reads
+    /// through the existing path of RACKEDITAR and owns no parser; the texts are the constants of the pilot. Unlike the
+    /// pilot, a two-sided (A/B) design is admitted; a parked composite tail is still outside.
+    /// </summary>
+    public static class PushBackFullDraftMaterializer
+    {
+        public static PushBackFullDraftMaterialization Materialize(string originText, RackCatalog catalog)
+        {
+            try
+            {
+                if (string.IsNullOrWhiteSpace(originText)) return PushBackFullDraftMaterialization.Failed(PushBackPilotMaterializer.UnreadableOrFutureDiagnostic);
+                if (catalog == null) return PushBackFullDraftMaterialization.Failed(PushBackPilotMaterializer.CatalogRequiredDiagnostic);
+
+                var embed = new RackEmbedStore().Deserialize(originText);
+                if (embed == null) return PushBackFullDraftMaterialization.Failed(PushBackPilotMaterializer.UnreadableOrFutureDiagnostic);
+                if (!string.Equals(embed.Kind, RackEmbedDocument.KindPushBack, StringComparison.Ordinal))
+                    return PushBackFullDraftMaterialization.Failed(PushBackPilotMaterializer.KindDivergentDiagnostic);
+
+                if (!new RackProjectStore().TryDeserialize(embed.Design, out var project, out _))
+                    return PushBackFullDraftMaterialization.Failed(PushBackPilotMaterializer.UnreadableOrFutureDiagnostic);
+
+                var design = project?.PushBackDesign;
+                if (design == null) return PushBackFullDraftMaterialization.Failed(PushBackPilotMaterializer.NoDesignDiagnostic);
+
+                if (PushBackEditableState.SupportOf(design) == PushBackEditableSupport.DormantCompositeTail)
+                    return PushBackFullDraftMaterialization.OutOfPilot(PushBackPilotMaterializer.DormantTailOutOfPilotReason);
+
+                return PushBackFullDraftMaterialization.Admitted(
+                    new PushBackFullDraftState(PushBackEditableStateSeat.LoadExisting(design, embed.Name, catalog), originText));
+            }
+            catch (Exception ex)
+            {
+                return PushBackFullDraftMaterialization.Failed(PushBackPilotMaterializer.MaterializeFailurePrefix + ex.Message);
+            }
+        }
+    }
+}
diff --git a/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullDraftReader.cs b/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullDraftReader.cs
new file mode 100644
index 00000000..d60d1658
--- /dev/null
+++ b/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullDraftReader.cs
@@ -0,0 +1,119 @@
+using System;
+using RackCad.Application.Catalogs;
+using RackCad.Application.Systems.PushBack.Pilot;
+using RackCad.Application.Workspace.Drafts;
+
+namespace RackCad.Application.Systems.PushBack.Draft
+{
+    /// <summary>
+    /// I-64 F4B PB-T3a (D-PBT3-04) — the result of ONE read of the edit intention of the FULL model: the stale base, the
+    /// read, the key of the origin, the technical detail and the hint to the classic editor.
+    /// </summary>
+    public sealed class PushBackFullIntentResult
+    {
+        internal PushBackFullIntentResult(
+            DraftStaleBase staleBase,
+            DraftIntentRead<PushBackFullDraftState> read,
+            string originKey,
+            string detail,
+            string classicEditorHint)
+        {
+            StaleBase = staleBase ?? throw new ArgumentNullException(nameof(staleBase));
+            Read = read ?? throw new ArgumentNullException(nameof(read));
+            OriginKey = originKey ?? string.Empty;
+            Detail = detail;
+            ClassicEditorHint = classicEditorHint;
+        }
+
+        /// <summary>The base of the read. Never null.</summary>
+        public DraftStaleBase StaleBase { get; }
+
+        /// <summary>Admitted with the base and the initial state, or not admitted with the unified diagnostic.</summary>
+        public DraftIntentRead<PushBackFullDraftState> Read { get; }
+
+        /// <summary>The key of the definition of origin of the input.</summary>
+        public string OriginKey { get; }
+
+        /// <summary>The technical detail behind the diagnostic; null when there is none.</summary>
+        public string Detail { get; }
+
+        /// <summary>Present if and only if the read is not admitted.</summary>
+        public string ClassicEditorHint { get; }
+    }
+
+    /// <summary>
+    /// I-64 F4B PB-T3a (D-PBT3-04) — the reader of the FULL model, on top of the reader of the pilot. It changes neither the
+    /// pilot reader nor its 14 rules nor AUTH-13: every rule decides first, and only a read the pilot admits, or refuses
+    /// exactly for being two-sided (A/B), is materialized again as a full state.
+    /// </summary>
+    public static class PushBackFullDraftReader
+    {
+        public static PushBackFullIntentResult Read(PushBackPilotIntentScan scan, RackCatalog catalog)
+        {
+            if (scan == null) throw new ArgumentNullException(nameof(scan));
+            try
+            {
+                var pilot = PushBackPilotIntentReader.Read(scan, catalog);
+                var isTwoSided = !pilot.Read.IsAdmitted
+                                 && string.Equals(pilot.Read.Admission.Diagnostic, PushBackPilotIntentReader.OutOfPilotDiagnostic, StringComparison.Ordinal)
+                                 && string.Equals(pilot.Detail, PushBackPilotMaterializer.CompositeOutOfPilotReason, StringComparison.Ordinal);
+                if (!pilot.Read.IsAdmitted && !isTwoSided)
+                {
+                    return new PushBackFullIntentResult(
+                        pilot.StaleBase,
+                        DraftIntentRead<PushBackFullDraftState>.NotAdmitted(pilot.Read.Admission.Diagnostic),
+                        pilot.OriginKey,
+                        pilot.Detail,
+                        pilot.ClassicEditorHint);
+                }
+
+                var full = PushBackFullDraftMaterializer.Materialize(scan.RawEnvelopes[scan.OriginKey], catalog);
+                if (full.IsAdmitted)
+                {
+                    return new PushBackFullIntentResult(
+                        pilot.StaleBase,
+                        DraftIntentRead<PushBackFullDraftState>.Admitted(pilot.StaleBase, full.State),
+                        pilot.OriginKey,
+                        null,
+                        null);
+                }
+
+                if (full.Kind == PushBackPilotMaterializationKind.OutOfPilot)
+                {
+                    return new PushBackFullIntentResult(
+                        pilot.StaleBase,
+                        DraftIntentRead<PushBackFullDraftState>.NotAdmitted(PushBackPilotIntentReader.OutOfPilotDiagnostic),
+                        pilot.OriginKey,
+                        full.Reason,
+                        PushBackPilotIntentReader.ClassicEditorHint);
+                }
+
+                if (string.Equals(full.Reason, PushBackPilotMaterializer.UnreadableOrFutureDiagnostic, StringComparison.Ordinal))
+                {
+                    return new PushBackFullIntentResult(
+                        pilot.StaleBase,
+                        DraftIntentRead<PushBackFullDraftState>.NotAdmitted(PushBackPilotIntentReader.UnreadableDiagnostic),
+                        pilot.OriginKey,
+                        null,
+                        PushBackPilotIntentReader.ClassicEditorHint);
+                }
+
+                return new PushBackFullIntentResult(
+                    pilot.StaleBase,
+                    DraftIntentRead<PushBackFullDraftState>.NotAdmitted(PushBackPilotIntentReader.MaterializeDiagnostic),
+                    pilot.OriginKey,
+                    full.Reason,
+                    PushBackPilotIntentReader.ClassicEditorHint);
+            }
+            catch (Exception ex)
+            {
+                return new PushBackFullIntentResult(
+                    PushBackPilotIntentReader.BuildStaleBase(scan),
+                    DraftIntentRead<PushBackFullDraftState>.NotAdmitted(PushBackPilotIntentReader.MaterializeDiagnostic),
+                    scan.OriginKey,
+                    ex.Message,
+                    PushBackPilotIntentReader.ClassicEditorHint);
+            }
+        }
+    }
+}
diff --git a/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullDraftState.cs b/src/RackCad.Application/Systems/PushBack/Draft/PushBackFullDraftState.cs
