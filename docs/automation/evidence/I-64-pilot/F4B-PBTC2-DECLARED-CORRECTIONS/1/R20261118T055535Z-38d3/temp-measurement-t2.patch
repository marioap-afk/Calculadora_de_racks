+        {
+            var lineas = new List<string>();
+            var stops = new List<string>();
+            Sta(() =>
+            {
+                var filas = new List<Fila>
+                {
+                    new Fila
+                    {
+                        Nombre = "T2-1", Fixture = "pb-20-ab", Ruta = "Composite.Gap", Valor = 54.00044,
