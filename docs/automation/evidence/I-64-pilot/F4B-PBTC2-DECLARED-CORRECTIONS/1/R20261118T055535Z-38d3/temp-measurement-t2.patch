+                        Mano = j => N(j, "Structure.ManualHeaderHeightOverride"), Esperado = "150",
+                        LeeGreen = j => N(j, "Structure.ManualHeaderHeightOverride"), Green = "150.00044",
+                    },
+                    new Fila
+                    {
+                        Nombre = "T2-4", Fixture = "pb-06-seguridad", Ruta = "Structure.SeparatorSpacingOverride", Valor = 18.00044, Avanzada = true,
+                        Gesto = w => Lost(w, "RackSeparatorCountBox"),
+                        Mano = j => N(j, "Structure.SeparatorSpacingOverride"), Esperado = "18",
+                        LeeGreen = j => N(j, "Structure.SeparatorSpacingOverride"), Green = "18.00044",
+                    },
+                    new Fila
+                    {
+                        Nombre = "T2-5", Fixture = "pb-07-combinado", Ruta = "Structure.DerivedPostHeight", Valor = 140.00044, Avanzada = true,
+                        Gesto = w => Lost(w, "DerivedPostHeightBox"),
+                        Mano = j => N(j, "Structure.DerivedPostHeight"), Esperado = "140",
+                        LeeGreen = j => N(j, "Structure.DerivedPostHeight"), Green = "140.00044",
+                    },
+                    new Fila
+                    {
+                        Nombre = "T2-6", Fixture = "pb-07-combinado", Ruta = "Structure.DerivedPostReinforcementHeight", Valor = 24.00044, Avanzada = true,
+                        Gesto = w => Lost(w, "DerivedPostHeightBox"),
+                        Mano = j => N(j, "Structure.DerivedPostReinforcementHeight"), Esperado = "24",
+                        LeeGreen = j => N(j, "Structure.DerivedPostReinforcementHeight"), Green = "24.00044",
+                    },
+                };
+
+                foreach (var fila in filas)
+                {
+                    try
+                    {
+                        Medir(fila, lineas, stops);
+                    }
+                    catch (Exception ex)
+                    {
+                        lineas.Add(fila.Nombre + " EXCEPCION " + ex.GetType().FullName + ": " + ex.Message);
+                        stops.Add(fila.Nombre + " excepcion");
+                    }
+                }
+            });
+
+            lineas.Add("STOPS=[" + string.Join(" | ", stops) + "]");
+            Assert.Fail(string.Join("\n", lineas));
+        }
+    }
