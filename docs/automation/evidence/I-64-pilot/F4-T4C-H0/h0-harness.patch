+
+        /// <summary>«H0: contexto vacío»: the reporter of a later text.</summary>
+        public static Func<Action<string>, string> EmptyContext { get; set; }
+
+        /// <summary>Whether the next probe counts the frames of WPF (row 1). Off, for a comparison run without forced rendering (review H-16).</summary>
+        public static bool CountFrames { get; set; } = true;
+    }
+
+    /// <summary>The section of the probe in the panel, built in code so the XAML of the product does not change.</summary>
+    public partial class WorkspacePanelView
+    {
+        internal const string H0UpdateLabel = "H0: Actualizar (sonda)";
+        internal const string H0EmptyLabel = "H0: contexto vacío";
+
+        private TextBlock _h0Status;
+
+        // Right after the surface of the browser: a bordered section with the two buttons and one line of status.
+        private void AttachH0Probe()
+        {
+            try
+            {
+                if (!(BrowserSurface.Parent is Panel host)) return;
+
+                var title = new TextBlock
+                {
+                    Text = "Sonda H0 (solo Debug; diagnóstico, no es producto)",
+                    FontWeight = FontWeights.SemiBold,
+                    TextWrapping = TextWrapping.Wrap,
+                };
+
+                var update = NewH0Button(H0UpdateLabel);
+                update.Click += OnH0UpdateClick;
+                var empty = NewH0Button(H0EmptyLabel);
+                empty.Click += OnH0EmptyClick;
+
+                var buttons = new WrapPanel { Margin = new Thickness(0, 4, 0, 0) };
+                buttons.Children.Add(update);
+                buttons.Children.Add(empty);
+
+                // Review H-16: the frames of WPF (row 1) force a render per frame while a probe runs; this switch allows a run without them.
+                var frames = new CheckBox
+                {
+                    Content = "Contar fotogramas de WPF (fila 1)",
+                    IsChecked = WorkspaceH0Hooks.CountFrames,
+                    Margin = new Thickness(0, 4, 0, 0),
+                    Focusable = false,
+                    IsTabStop = false,
+                };
+                frames.Click += (sender, args) => Contained(() => WorkspaceH0Hooks.CountFrames = frames.IsChecked == true);
+                AutomationProperties.SetName(frames, "Contar fotogramas de WPF");
+
+                _h0Status = new TextBlock { TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 4, 0, 0), Text = "H0: sin sondas todavía." };
+
+                var content = new StackPanel();
+                content.Children.Add(title);
+                content.Children.Add(buttons);
+                content.Children.Add(frames);
+                content.Children.Add(_h0Status);
+
+                var section = new Border
+                {
+                    Margin = new Thickness(0, 8, 0, 0),
+                    Padding = new Thickness(8),
+                    BorderThickness = new Thickness(2),
+                    Child = content,
+                };
+                if (TryFindResource("ShellStatusWarningBrush") is System.Windows.Media.Brush brush) section.BorderBrush = brush;
+                AutomationProperties.SetName(section, "Sonda H0");
+
+                host.Children.Insert(host.Children.IndexOf(BrowserSurface) + 1, section);
+            }
+            catch (System.Exception ex)
+            {
+                _viewModel.ShowError(ex);
+            }
+        }
+
+        private Button NewH0Button(string label)
+        {
+            // Review H-02: the palette keeps the focus (KeepFocus = true) and a focused button is pressed again by Enter or Space, so a
+            // «U» + Enter typed afterwards could launch another probe. These buttons never take the focus of the keyboard.
+            var button = new Button
+            {
+                Content = label,
+                Margin = new Thickness(0, 2, 6, 0),
+                Padding = new Thickness(10, 3, 10, 3),
+                Focusable = false,
+                IsTabStop = false,
+            };
+            if (TryFindResource("SecondaryButtonStyle") is Style style) button.Style = style;
+            AutomationProperties.SetName(button, label);
+            return button;
+        }
+
+        private void OnH0UpdateClick(object sender, RoutedEventArgs e) => Contained(() =>
+        {
+            var hook = WorkspaceH0Hooks.Update;
+            if (hook == null)
+            {
+                ShowH0("H0: el Plugin no asignó el gancho de la sonda.");
+                return;
+            }
+
+            var field = _viewModel.Browser.Field;
+            ShowH0(hook(field.H0Session, field.H0Rack, ShowH0));
+        });
+
+        private void OnH0EmptyClick(object sender, RoutedEventArgs e) => Contained(() =>
+        {
+            var hook = WorkspaceH0Hooks.EmptyContext;
+            if (hook == null)
+            {
+                ShowH0("H0: el Plugin no asignó el gancho de la sonda.");
+                return;
+            }
+
+            ShowH0(hook(ShowH0));
+        });
+
+        // Only on the thread of the panel; a later text from another thread is dropped (the trace has it anyway).
+        private void ShowH0(string text)
+        {
+            if (_h0Status == null || !Dispatcher.CheckAccess()) return;
+            _h0Status.Text = text ?? string.Empty;
+        }
+    }
+}
+#endif
