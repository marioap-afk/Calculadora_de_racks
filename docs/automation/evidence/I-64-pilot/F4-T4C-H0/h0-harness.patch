+#if DEBUG
+using System;
+using System.Windows;
+using System.Windows.Automation;
+using System.Windows.Controls;
+using RackCad.Application.Workspace;
+
+namespace RackCad.UI.Workspace
+{
+    /// <summary>
+    /// I-64 F4-T4C-H0 — the Debug hooks of the host probe. DEBUG ONLY and NOT PRODUCT: this file compiles to nothing in Release. The UI
+    /// cannot name AutoCAD, so the two buttons of the probe call these static delegates, which the Plugin assigns when it creates the
