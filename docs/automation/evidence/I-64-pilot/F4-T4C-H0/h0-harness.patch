         private static void LogFault(string context, System.Exception exception) => RackLog.Exception(context, exception);
+
+#if DEBUG
+        // I-64 F4-T4C-H0 (Debug only, not product): ONE line per event, written BEFORE the core handles it, with the hint that the core
+        // maps the source to, the distinct kinds already pending in the session, and whether the session is degraded. It opens nothing.
+        // Each handler also wraps the call in its own try (review H-15), so not even a load failure of a mixed set of DLL reaches AutoCAD.
+        private void H0Event(SourceAttachment a, Func<string> detail)
+        {
+            try
+            {
+                H0Trace.Log("event." + a.Source, H0EventDetail(a, detail == null ? null : H0HostTrace.Safe(detail)));
+            }
+            catch (System.Exception ex)
+            {
+                H0Trace.Exception("event.trace-threw", ex);
+            }
+        }
+
+        // The events of objects (review H-08): written one by one up to the cap of the segment, then only counted by source and type. The
+        // type is the managed wrapper of the object that AutoCAD already holds open for the notice; nothing is opened.
+        private void H0ObjectEvent(SourceAttachment a, DBObject dbObject, bool? erased)
+        {
+            try
+            {
+                var type = H0HostTrace.Safe(() => dbObject == null ? "null" : dbObject.GetType().Name);
+                H0Trace.ObjectEvent(
+                    "event." + a.Source,
+                    a.Source + "/" + type,
+                    () => H0EventDetail(a, H0HostTrace.ObjectFacts(dbObject) + (erased.HasValue ? " erased=" + erased.Value : string.Empty)));
+            }
+            catch (System.Exception ex)
+            {
+                H0Trace.Exception("event.trace-threw", ex);
+            }
+        }
+
+        private string H0EventDetail(SourceAttachment a, string detail)
+        {
+            var pending = _core.TryGetSession(a.Session, out var live) && live != null ? live.PendingHintCount.ToString() : "-";
+            return "session=" + a.Session.Value + " doc=" + a.NativeInstanceId + (string.IsNullOrEmpty(detail) ? string.Empty : " " + detail)
+                + " hint=" + H0HintOf(a.Source) + " pendingKindsBefore=" + pending + " degraded=" + _core.IsDegraded(a.Session)
+                + " cmdActiveInActiveSession=" + _core.IsCommandActiveInActiveSession;
+        }
+
+        // The hint that EventBridgeCore.OnSourceEvent queues for each source (the two command-state sources queue none).
+        private static string H0HintOf(BridgeSource source)
+        {
+            switch (source)
+            {
+                case BridgeSource.CommandWillStart: return "none(SetQuiescent:false)";
+                case BridgeSource.EnteringQuiescentState: return "none(SetQuiescent:true)";
+                case BridgeSource.ImpliedSelectionChanged: return "ImpliedSelectionChanged";
+                case BridgeSource.CommandEnded:
+                case BridgeSource.CommandCancelled:
+                case BridgeSource.CommandFailed: return "CommandEnded";
+                case BridgeSource.ObjectAppended:
+                case BridgeSource.ObjectErased:
+                case BridgeSource.ObjectModified:
+                case BridgeSource.ObjectUnappended:
+                case BridgeSource.ObjectReappended: return "DatabaseObjectChanged";
+                default: return "none";
+            }
+        }
+
+        // One line per outcome of the idle pass, before the subscribers of the drain see it.
+        private static void H0Drain(DrainOutcome outcome)
+        {
+            try
+            {
+                var result = outcome.Result;
+                H0Trace.Log(
