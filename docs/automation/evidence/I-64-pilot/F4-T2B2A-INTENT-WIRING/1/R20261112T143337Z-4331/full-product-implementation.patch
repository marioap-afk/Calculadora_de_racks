+                // 8: the base of the read only goes to Begin, with the comparer and the copier of the pilot.
+                var begun = _drafts.Begin(
+                    request.Session,
+                    request.RackId,
+                    pilot.Read,
+                    PushBackPilotStateComparer.Instance,
