{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rackcad-binding/v1",
  "description": "Binding de un rol a un runtime por capacidad acreditada (Proposal V14 §5 y Anexo B.5). Consume una observación (preflight/v1); nunca se infiere de un proveedor, un modelo, una fila del catálogo, un runtime solicitado ni una autodeclaración. Subordinado: no crea requisitos de evidencia, estados, gates, reglas Git ni decisiones del Owner. Inactivo hasta I62_EFFECTIVE_SHA (AUTOMATION_PLAN 16.14).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Schema": {
      "type": "string",
      "enum": [
        "rackcad-binding/v1"
      ]
    },
    "BindingId": {
      "type": "string",
      "pattern": "^B[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "UnitId": {
      "type": "string",
      "minLength": 1
    },
    "Scope": {
      "type": "string",
      "enum": [
        "UNIT",
        "TASK"
      ]
    },
    "TaskId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Nullable = no aplica, solo con Scope UNIT."
    },
    "Role": {
      "type": "string",
      "enum": [
        "PRINCIPAL_COORDINATOR",
        "ARCHITECT",
        "EXECUTION_CONTROLLER",
        "WORKER",
        "REVIEWER"
      ]
    },
    "ProtocolSet": {
      "type": "string",
      "enum": [
        "rackcad-protocol/I61",
        "rackcad-protocol/I62"
      ]
    },
    "Actor": {
      "type": "object",
      "description": "ActorRef (B.2).",
      "additionalProperties": false,
      "properties": {
        "AdapterId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "InstanceId": {
          "type": "string",
          "minLength": 1
        },
        "InstanceIdSource": {
          "type": "string",
          "minLength": 1
        },
        "Assurance": {
          "type": "string",
          "enum": [
            "REQUESTED",
            "CONFIGURED",
            "RUNTIME_OBSERVED",
            "SERVICE_ATTESTED",
            "NONE"
          ]
        }
      },
      "required": [
        "AdapterId",
        "InstanceId",
        "InstanceIdSource",
        "Assurance"
      ]
    },
    "Session": {
      "type": "object",
      "description": "SessionRef (B.2).",
      "additionalProperties": false,
      "properties": {
        "AdapterId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "SessionId": {
          "type": "string",
          "minLength": 1
        },
        "Assurance": {
          "type": "string",
          "enum": [
            "REQUESTED",
            "CONFIGURED",
            "RUNTIME_OBSERVED",
            "SERVICE_ATTESTED",
            "NONE"
          ]
        }
      },
      "required": [
        "AdapterId",
        "SessionId",
        "Assurance"
      ]
    },
    "Cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "CellId": {
          "type": "string",
          "minLength": 1
        },
        "CatalogBlob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "AdapterId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "Model": {
          "type": [
            "string",
            "null"
          ],
          "description": "null = el adapter no lo controla."
        },
        "EffortSemantic": {
          "type": "string",
          "enum": [
            "Routine",
            "Balanced",
            "Deep",
            "Long-horizon",
            "Maximum"
          ]
        },
        "EffortProvider": {
          "type": [
            "string",
            "null"
          ],
          "description": "null = el adapter no lo controla."
        }
      },
      "required": [
        "CellId",
        "CatalogBlob",
        "AdapterId",
        "Model",
        "EffortSemantic",
        "EffortProvider"
      ]
    },
    "PreflightRef": {
      "type": "object",
      "description": "PreflightRef (B.2).",
      "additionalProperties": false,
      "properties": {
        "PreflightId": {
          "type": "string",
          "pattern": "^P[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
        },
        "Location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Kind": {
              "type": "string",
              "enum": [
                "TRANSIENT",
                "CUSTODIED"
              ]
            },
            "Path": {
              "type": "string",
              "minLength": 1
            },
            "Commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$",
              "description": "Nullable = no aplica, solo con TRANSIENT."
            },
            "Blob": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$",
              "description": "Nullable = no aplica, solo con TRANSIENT."
            }
          },
          "required": [
            "Kind",
            "Path",
            "Commit",
            "Blob"
          ]
        },
        "Sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "PreflightId",
        "Location",
        "Sha256"
      ]
    },
    "Eligibility": {
      "type": "object",
      "description": "Elegible solo con MEASURED, cobertura distinta de UNKNOWN y Stale false (ADR-0046 #4).",
      "additionalProperties": false,
      "properties": {
        "MeasuredInvocation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "State": {
              "type": "string",
              "enum": [
                "MEASURED",
                "NOT_MEASURED"
              ]
            },
            "RunRef": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "State",
            "RunRef"
          ]
        },
        "ConsumptionCovered": {
          "type": "string",
          "enum": [
            "OFFICIAL",
            "MEASURED",
            "UNKNOWN"
          ]
        },
        "CatalogVerifiedOn": {
          "type": "string",
          "minLength": 1
        },
        "Stale": {
          "type": "boolean"
        }
      },
      "required": [
        "MeasuredInvocation",
        "ConsumptionCovered",
        "CatalogVerifiedOn",
        "Stale"
      ]
    },
    "Independence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ReferenceRole": {
                "type": "string",
                "enum": [
                  "PRINCIPAL_COORDINATOR",
                  "ARCHITECT",
                  "EXECUTION_CONTROLLER",
                  "WORKER",
                  "REVIEWER",
                  "AUTHOR",
                  "PROPOSER",
                  "EVIDENCE_AUTHOR"
                ]
              },
              "ReferenceActor": {
                "type": "object",
                "description": "ActorRef (B.2).",
                "additionalProperties": false,
                "properties": {
                  "AdapterId": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "InstanceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "InstanceIdSource": {
                    "type": "string",
                    "minLength": 1
                  },
                  "Assurance": {
                    "type": "string",
                    "enum": [
                      "REQUESTED",
                      "CONFIGURED",
                      "RUNTIME_OBSERVED",
                      "SERVICE_ATTESTED",
                      "NONE"
                    ]
                  }
                },
                "required": [
                  "AdapterId",
                  "InstanceId",
                  "InstanceIdSource",
                  "Assurance"
                ]
              },
              "Actor": {
                "type": "string",
                "enum": [
                  "REQUIRED",
                  "PREFERRED",
                  "NOT_REQUIRED"
                ]
              },
              "Session": {
                "type": "string",
                "enum": [
                  "REQUIRED",
                  "PREFERRED",
                  "NOT_REQUIRED"
                ]
              },
              "Context": {
                "type": "string",
                "enum": [
                  "REQUIRED",
                  "PREFERRED",
                  "NOT_REQUIRED"
                ]
              },
              "Provider": {
                "type": "string",
                "enum": [
                  "REQUIRED",
                  "PREFERRED",
                  "NOT_REQUIRED"
                ]
              }
            },
            "required": [
              "ReferenceRole",
              "ReferenceActor",
              "Actor",
              "Session",
              "Context",
              "Provider"
            ]
          }
        },
        "Satisfaction": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ReferenceRole": {
                "type": "string",
                "enum": [
                  "PRINCIPAL_COORDINATOR",
                  "ARCHITECT",
                  "EXECUTION_CONTROLLER",
                  "WORKER",
                  "REVIEWER",
                  "AUTHOR",
                  "PROPOSER",
                  "EVIDENCE_AUTHOR"
                ]
              },
              "Dimension": {
                "type": "string",
                "enum": [
                  "Actor",
                  "Session",
                  "Context",
                  "Provider"
                ]
              },
              "Result": {
                "type": "string",
                "enum": [
                  "SATISFIED",
                  "NOT_SATISFIED",
                  "UNKNOWN"
                ]
              },
              "Evidence": {
                "type": "string"
              }
            },
            "required": [
              "ReferenceRole",
              "Dimension",
              "Result",
              "Evidence"
            ]
          },
          "description": "Único por (ReferenceRole, Dimension)."
        }
      },
      "required": [
        "Requirements",
        "Satisfaction"
      ]
    },
    "RejectedAlternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "RoutingReason": {
      "type": "string"
    },
    "EscalationConditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "CountersSnapshot": {
      "type": "object",
      "description": "Copia de §9.3.",
      "additionalProperties": false,
      "properties": {
        "Attempts": {
          "type": "integer",
          "minimum": 0
        },
        "CorrectionLaunches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "TaskId": {
                "type": "string"
              },
              "FailureClass": {
                "type": "string"
              },
              "Count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "TaskId",
              "FailureClass",
              "Count"
            ]
          }
        },
        "BlockedReruns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "TaskId": {
                "type": "string"
              },
              "Phase": {
                "type": "string"
              },
              "Count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "TaskId",
              "Phase",
              "Count"
            ]
          }
        },
        "RebaseRecoveries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "TaskId": {
                "type": "string"
              },
              "Count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "TaskId",
              "Count"
            ]
          }
        },
        "Invocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Scope": {
                "type": "string"
              },
              "Launched": {
                "type": "integer",
                "minimum": 0
              },
              "Uncertain": {
                "type": "integer",
                "minimum": 0
              },
              "Cap": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "Scope",
              "Launched",
              "Uncertain",
              "Cap"
            ]
          }
        }
      },
      "required": [
        "Attempts",
        "CorrectionLaunches",
        "BlockedReruns",
        "RebaseRecoveries",
        "Invocations"
      ]
    },
    "Custody": {
      "type": "object",
      "description": "null = no aplica en el primer binding.",
      "additionalProperties": false,
      "properties": {
        "FromBindingId": {
          "type": [
            "string",
            "null"
          ]
        },
        "CessionRunId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "FromBindingId",
        "CessionRunId"
      ]
    },
    "Acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "State": {
          "type": "string",
          "enum": [
            "PENDING",
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "Basis": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "INDIVIDUAL_DECISION",
            "AUTHORIZED_MATERIALIZATION",
            null
          ]
        },
        "DecisionRef": {
          "type": [
            "object",
            "null"
          ],
          "description": "Con INDIVIDUAL_DECISION: ruta de decisiones y marcador, sin blob.",
          "additionalProperties": false,
          "properties": {
            "Path": {
              "type": "string",
              "minLength": 1
            },
            "Marker": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "Path",
            "Marker"
          ]
        },
        "AuthorizationRef": {
          "type": [
            "object",
            "null"
          ],
          "description": "AuthorizationRef (B.2): Commit = un ancestro del punto que custodia el binding; nunca el propio commit de custodia.",
          "additionalProperties": false,
          "properties": {
            "Path": {
              "type": "string",
              "minLength": 1
            },
            "Marker": {
              "type": "string",
              "minLength": 1
            },
            "AuthorizationId": {
              "type": "string",
              "minLength": 1
            },
            "Commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "Blob": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "Path",
            "Marker",
            "AuthorizationId",
            "Commit",
            "Blob"
          ]
        },
        "MaterializationCheck": {
          "type": [
            "object",
            "null"
          ],
          "description": "Con AUTHORIZED_MATERIALIZATION: todos los criterios en SATISFIED; un UNKNOWN cuenta como NOT_SATISFIED.",
          "additionalProperties": false,
          "properties": {
            "Criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "CriterionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "Required": {
                    "type": "string"
                  },
                  "Observed": {
                    "type": "string"
                  },
                  "Result": {
                    "type": "string",
                    "enum": [
                      "SATISFIED",
                      "NOT_SATISFIED",
                      "UNKNOWN"
                    ]
                  },
                  "Evidence": {
                    "type": "string"
                  }
                },
                "required": [
                  "CriterionId",
                  "Required",
                  "Observed",
                  "Result",
                  "Evidence"
                ]
              }
            }
          },
          "required": [
            "Criteria"
          ]
        },
        "Utc": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      },
      "required": [
        "State",
        "Basis",
        "DecisionRef",
        "AuthorizationRef",
        "MaterializationCheck",
        "Utc"
      ]
    }
  },
  "required": [
    "Schema",
    "BindingId",
    "UnitId",
    "Scope",
    "TaskId",
    "Role",
    "ProtocolSet",
    "Actor",
    "Session",
    "Cell",
    "PreflightRef",
    "Eligibility",
    "Independence",
    "RejectedAlternatives",
    "RoutingReason",
    "EscalationConditions",
    "CountersSnapshot",
    "Custody",
    "Acceptance"
  ]
}
