{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rackcad-adapter-codex-desktop-session-facts/v1",
  "description": "Hechos de la sesión de escritorio candidata a Principal: paquete de la app, fuente candidata del contexto por turno y configuración compartida. Esquema estricto del adapter (Proposal V14 Anexo B.3): define sus campos propios; lo valida la fase 2. Subordinado: no crea requisitos de evidencia, estados, gates, reglas Git ni decisiones del Owner. Inactivo hasta I62_EFFECTIVE_SHA (AUTOMATION_PLAN 16.14).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "SchemaId": {
      "type": "string",
      "enum": [
        "rackcad-adapter-codex-desktop-session-facts/v1"
      ]
    },
    "AuthState": {
      "type": "string",
      "enum": [
        "AUTHENTICATED",
        "NOT_AUTHENTICATED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "AppPackage": {
      "type": "object",
      "description": "Paquete de la app instalado.",
      "additionalProperties": false,
      "properties": {
        "State": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "NOT_OBSERVED"
          ]
        },
        "Value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "State",
        "Value"
      ]
    },
    "TurnContextSource": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "UNAVAILABLE"
      ]
    },
    "SharesConfigFile": {
      "type": "string",
      "enum": [
        "YES",
        "NO",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "SchemaId",
    "AuthState",
    "AppPackage",
    "TurnContextSource",
    "SharesConfigFile"
  ]
}
