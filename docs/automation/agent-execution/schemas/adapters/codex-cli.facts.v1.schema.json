{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rackcad-adapter-codex-cli-facts/v1",
  "description": "Hechos de la CLI: binario por ruta verificada, autenticación sin credenciales, modo del sandbox y registro de sesión. Esquema estricto del adapter (Proposal V14 Anexo B.3): define sus campos propios; lo valida la fase 2. Subordinado: no crea requisitos de evidencia, estados, gates, reglas Git ni decisiones del Owner. Inactivo hasta I62_EFFECTIVE_SHA (AUTOMATION_PLAN 16.14).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "SchemaId": {
      "type": "string",
      "enum": [
        "rackcad-adapter-codex-cli-facts/v1"
      ]
    },
    "AuthState": {
      "type": "string",
      "enum": [
        "AUTHENTICATED",
        "NOT_AUTHENTICATED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "BinaryLabel": {
      "type": "string",
      "pattern": "^([0-9a-f]{16}|UNKNOWN)$",
      "description": "Directorio de versión del binario bajo la instalación del runtime."
    },
    "BinarySha256": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|UNKNOWN)$"
    },
    "CliVersion": {
      "type": "object",
      "description": "Versión de la CLI; solo se observa invocándola.",
      "additionalProperties": false,
      "properties": {
        "State": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "NOT_OBSERVED"
          ]
        },
        "Value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "State",
        "Value"
      ]
    },
    "SandboxMode": {
      "type": "string",
      "enum": [
        "read-only",
        "workspace-write",
        "UNKNOWN"
      ]
    },
    "SessionLog": {
      "type": "string",
      "enum": [
        "PERSISTED",
        "EPHEMERAL",
        "UNKNOWN"
      ],
      "description": "Sin --ephemeral, el registro de sesión da modelo y effort efectivos."
    },
    "RuntimeShellFirstInPath": {
      "type": "string",
      "enum": [
        "YES",
        "NO",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "SchemaId",
    "AuthState",
    "BinaryLabel",
    "BinarySha256",
    "CliVersion",
    "SandboxMode",
    "SessionLog",
    "RuntimeShellFirstInPath"
  ]
}
