{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rackcad-adapter-claude-subagent-facts/v1",
  "description": "Hechos de un subagente de la sesión: hereda la sesión del padre y se observa por su transcripción. Esquema estricto del adapter (Proposal V14 Anexo B.3): define sus campos propios; lo valida la fase 2. Subordinado: no crea requisitos de evidencia, estados, gates, reglas Git ni decisiones del Owner. Inactivo hasta I62_EFFECTIVE_SHA (AUTOMATION_PLAN 16.14).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "SchemaId": {
      "type": "string",
      "enum": [
        "rackcad-adapter-claude-subagent-facts/v1"
      ]
    },
    "AuthState": {
      "type": "string",
      "enum": [
        "AUTHENTICATED",
        "NOT_AUTHENTICATED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "ParentSessionState": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "UNOBSERVED"
      ]
    },
    "TranscriptSource": {
      "type": "string",
      "enum": [
        "TRANSCRIPT",
        "NOT_STARTED",
        "UNAVAILABLE"
      ]
    },
    "CallTimeoutMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "CompletionNotified": {
      "type": "string",
      "enum": [
        "YES",
        "NO",
        "NOT_STARTED"
      ]
    }
  },
  "required": [
    "SchemaId",
    "AuthState",
    "ParentSessionState",
    "TranscriptSource",
    "CallTimeoutMinutes",
    "CompletionNotified"
  ]
}
