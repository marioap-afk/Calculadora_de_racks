{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rackcad-preflight/v1",
  "description": "Observación de capacidad de un runtime candidato para un rol y una acción (Proposal V14 §6 y Anexo B.4). Existe aunque no haya binding: el binding la consume y ella no depende del binding. Subordinado: no crea requisitos de evidencia, estados, gates, reglas Git ni decisiones del Owner. Inactivo hasta I62_EFFECTIVE_SHA (AUTOMATION_PLAN 16.14).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Schema": {
      "type": "string",
      "enum": [
        "rackcad-preflight/v1"
      ]
    },
    "PreflightId": {
      "type": "string",
      "pattern": "^P[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "UnitId": {
      "type": "string",
      "minLength": 1
    },
    "Role": {
      "type": "string",
      "enum": [
        "PRINCIPAL_COORDINATOR",
        "ARCHITECT",
        "EXECUTION_CONTROLLER",
        "WORKER",
        "REVIEWER"
      ]
    },
    "Action": {
      "type": "string",
      "enum": [
        "RESUME_DECISION",
        "CUSTODY",
        "LOCAL_EVIDENCE",
        "REVIEW_DESIGN",
        "REVIEW_CHANGE",
        "PLAN",
        "VERIFY",
        "IMPLEMENT"
      ],
      "description": "RESUME_DECISION, CUSTODY o LOCAL_EVIDENCE para el Principal (AUTOMATION_PLAN 16.15); la acción del rol para los demás (B.9)."
    },
    "ProtocolSet": {
      "type": "string",
      "enum": [
        "rackcad-protocol/I61",
        "rackcad-protocol/I62"
      ]
    },
    "Profile": {
      "type": "object",
      "description": "El perfil existe aunque no haya binding.",
      "additionalProperties": false,
      "properties": {
        "ProfileId": {
          "type": "string",
          "minLength": 1
        },
        "RoutingBlob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "ProfileId",
        "RoutingBlob"
      ]
    },
    "Host": {
      "type": "object",
      "description": "HostRef (B.2).",
      "additionalProperties": false,
      "properties": {
        "HostLabelHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 del hostname en minúsculas: solo etiqueta, nunca acredita exclusividad."
        },
        "HostInstanceHash": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|UNKNOWN)$",
          "description": "SHA-256 del identificador de instalación del SO (en Windows, MachineGuid)."
        },
        "HostInstanceState": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "UNOBSERVED"
          ]
        },
        "Os": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "HostLabelHash",
        "HostInstanceHash",
        "HostInstanceState",
        "Os"
      ]
    },
    "ObservedUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "Actor": {
      "type": "object",
      "description": "ActorRef (Proposal V14 Anexo B.2).",
      "additionalProperties": false,
      "properties": {
        "AdapterId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "InstanceId": {
          "type": "string",
          "minLength": 1,
          "description": "Instancia observada del runtime; sin fuente, \"UNOBSERVED\"; candidata sin sesión, \"NOT_STARTED\" (B.2, B.4)."
        },
        "InstanceIdSource": {
          "type": "string",
          "minLength": 1
        },
        "Assurance": {
          "type": "string",
          "enum": [
            "REQUESTED",
            "CONFIGURED",
            "RUNTIME_OBSERVED",
            "SERVICE_ATTESTED",
            "NONE"
          ]
        }
      },
      "required": [
        "AdapterId",
        "InstanceId",
        "InstanceIdSource",
        "Assurance"
      ]
    },
    "Session": {
      "type": "object",
      "description": "SessionRef (B.2).",
      "additionalProperties": false,
      "properties": {
        "AdapterId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "SessionId": {
          "type": "string",
          "minLength": 1
        },
        "Assurance": {
          "type": "string",
          "enum": [
            "REQUESTED",
            "CONFIGURED",
            "RUNTIME_OBSERVED",
            "SERVICE_ATTESTED",
            "NONE"
          ]
        }
      },
      "required": [
        "AdapterId",
        "SessionId",
        "Assurance"
      ]
    },
    "Adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "AdapterId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "AdapterVersion": {
          "type": "string",
          "minLength": 1
        },
        "BinaryPathHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 de la ruta del binario en minúsculas; nullable = no aplica para sesiones y subagentes."
        },
        "DescriptorRef": {
          "type": "object",
          "description": "Descriptor derivado del id por patrón fijo (B.2).",
          "additionalProperties": false,
          "properties": {
            "Path": {
              "type": "string",
              "pattern": "^adapters/[a-z0-9-]+\\.md$"
            },
            "Blob": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "Path",
            "Blob"
          ]
        }
      },
      "required": [
        "AdapterId",
        "AdapterVersion",
        "BinaryPathHash",
        "DescriptorRef"
      ]
    },
    "AdapterFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SchemaRef": {
          "type": "object",
          "description": "Esquema estricto del adapter, derivado del id y de la versión del descriptor; sin URLs ni descargas (B.2).",
          "additionalProperties": false,
          "properties": {
            "SchemaId": {
              "type": "string",
              "pattern": "^rackcad-adapter-[a-z0-9-]+-facts/v[0-9]+$"
            },
            "Path": {
              "type": "string",
              "pattern": "^schemas/adapters/[a-z0-9-]+\\.facts\\.v[0-9]+\\.schema\\.json$"
            },
            "Blob": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "SchemaId",
            "Path",
            "Blob"
          ]
        },
        "Facts": {
          "type": "object",
          "description": "Único punto abierto del núcleo: lo valida la fase 2 contra SchemaRef (B.3)."
        }
      },
      "required": [
        "SchemaRef",
        "Facts"
      ]
    },
    "Fingerprint": {
      "type": "object",
      "description": "Huella de configuración (Proposal V14 §7; generaliza ConfigToml* de /v1).",
      "additionalProperties": false,
      "properties": {
        "Kind": {
          "type": "string",
          "enum": [
            "CONFIG_FILE",
            "NONE",
            "UNVERIFIED"
          ],
          "description": "Lo declara el descriptor: CONFIG_FILE (archivo de configuración del runtime), NONE (solo con la aceptación del Coordinator en F2) o UNVERIFIED."
        },
        "Sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "description": "Nullable = no aplica, salvo con Kind CONFIG_FILE."
        },
        "KeyNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Nombres ordenados de secciones y claves, sin valores y saneados (README §13)."
        },
        "AcceptanceDecisionRef": {
          "type": [
            "object",
            "null"
          ],
          "description": "Decisión del Coordinator que acepta la huella NONE; nullable = no aplica con otro Kind.",
          "additionalProperties": false,
          "properties": {
            "Path": {
              "type": "string",
              "minLength": 1
            },
            "CommitSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "Blob": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "Path",
            "CommitSha",
            "Blob"
          ]
        }
      },
      "required": [
        "Kind",
        "Sha256",
        "KeyNames",
        "AcceptanceDecisionRef"
      ]
    },
    "Requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "RequirementId": {
            "type": "string",
            "pattern": "^[A-Z_]+\\.[a-z0-9-]+$"
          },
          "Mandatory": {
            "type": "boolean"
          },
          "Required": {
            "type": "string",
            "minLength": 1
          },
          "Observation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "State": {
                "type": "string",
                "enum": [
                  "OBSERVED",
                  "NOT_OBSERVED"
                ]
              },
              "Value": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Nullable = no aplica solo con State NOT_OBSERVED."
              },
              "Source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Nullable = no aplica solo con State NOT_OBSERVED."
              },
              "Assurance": {
                "type": "string",
                "enum": [
                  "REQUESTED",
                  "CONFIGURED",
                  "RUNTIME_OBSERVED",
                  "SERVICE_ATTESTED",
                  "NONE"
                ]
              },
              "ObservedUtc": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                "description": "Nullable = no aplica solo con State NOT_OBSERVED."
              }
            },
            "required": [
              "State",
              "Value",
              "Source",
              "Assurance",
              "ObservedUtc"
            ]
          },
          "Status": {
            "type": "string",
            "enum": [
              "MATCH",
              "ABOVE_REQUIRED",
              "BELOW_REQUIRED",
              "UNKNOWN"
            ]
          },
          "Contradiction": {
            "type": "boolean"
          },
          "ContradictionEvidence": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nullable = no aplica solo con Contradiction false."
          }
        },
        "required": [
          "RequirementId",
          "Mandatory",
          "Required",
          "Observation",
          "Status",
          "Contradiction",
          "ContradictionEvidence"
        ]
      },
      "description": "Único por RequirementId; un obligatorio de la acción ausente se añade con NOT_OBSERVED y UNKNOWN."
    },
    "ConfigurationStatus": {
      "type": "string",
      "enum": [
        "MATCH",
        "ABOVE_REQUIRED",
        "BELOW_REQUIRED",
        "UNKNOWN"
      ],
      "description": "Agregado de AUTOMATION_PLAN 16.16 para la acción."
    },
    "Causes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z_]+\\.[a-z0-9-]+$"
      },
      "description": "Obligatorios distintos de MATCH, más las contradicciones."
    },
    "Disposition": {
      "type": "string",
      "enum": [
        "ELIGIBLE",
        "NOT_ELIGIBLE",
        "STOP"
      ]
    },
    "StopConditions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[PS]-[0-9]{2}$"
      }
    },
    "Invalidators": {
      "type": "object",
      "description": "Un cambio en cualquiera invalida la observación (§6). El binding y el SHA de la rama no la invalidan.",
      "additionalProperties": false,
      "properties": {
        "HostInstanceHash": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|UNKNOWN)$"
        },
        "AdapterVersion": {
          "type": "string",
          "minLength": 1
        },
        "BinaryPathHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "AuthState": {
          "type": "string",
          "enum": [
            "AUTHENTICATED",
            "NOT_AUTHENTICATED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "FingerprintSha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|NONE|UNKNOWN)$"
        },
        "CatalogEntryBlob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Blob de model-catalog.md en la observación."
        },
        "RoutingBlob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "HostInstanceHash",
        "AdapterVersion",
        "BinaryPathHash",
        "AuthState",
        "FingerprintSha256",
        "CatalogEntryBlob",
        "RoutingBlob"
      ]
    }
  },
  "required": [
    "Schema",
    "PreflightId",
    "UnitId",
    "Role",
    "Action",
    "ProtocolSet",
    "Profile",
    "Host",
    "ObservedUtc",
    "Actor",
    "Session",
    "Adapter",
    "AdapterFacts",
    "Fingerprint",
    "Requirements",
    "ConfigurationStatus",
    "Causes",
    "Disposition",
    "StopConditions",
    "Invalidators"
  ]
}
