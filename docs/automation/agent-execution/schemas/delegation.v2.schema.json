            "Low",
            "Medium",
            "High"
          ]
        },
        "ArchitecturalSensitivity": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "Breadth": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "ToolUse": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "FailureCost": {
          "type": "string",
