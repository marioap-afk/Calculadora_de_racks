    "ExpectedEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "StopConditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Id": {
            "type": "string"
          },
          "Text": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Text"
        ]
      }
    },
    "MaxReworkLoops": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "AttemptsRemaining": {
      "type": "integer"
    },
    "ChainBaseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ChainRedSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "ChainRedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "CorrectionOf": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "RunId": {
          "type": "string",
          "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
        },
        "FailureClass": {
          "type": "string",
          "enum": [
            "Termination",
            "Handoff",
            "Authority",
            "Contract",
            "Identity",
            "Remote",
            "Scope",
            "CleanTree",
            "Ci",
            "Tests",
            "Trailer",
            "Routing",
            "FreeText",
            "Denials",
            "StopCondition"
          ]
        },
        "AnalysisSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "RunId",
        "FailureClass",
        "AnalysisSha256"
      ]
