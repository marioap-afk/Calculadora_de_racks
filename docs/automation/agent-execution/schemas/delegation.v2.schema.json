              "UNIT_CHANGE",
              "EXTERNAL"
            ]
          }
        },
        "required": [
          "Path",
          "Section",
          "Class"
        ]
      }
    },
    "Objective": {
      "type": "string"
    },
    "AllowedWriteScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ForbiddenWriteScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "AcceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "RequiredTests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Project": {
            "type": "string"
