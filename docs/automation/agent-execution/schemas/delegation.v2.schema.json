                    "PRINCIPAL_COORDINATOR",
                    "ARCHITECT",
                    "EXECUTION_CONTROLLER",
                    "WORKER",
                    "REVIEWER",
                    "AUTHOR",
                    "PROPOSER",
                    "EVIDENCE_AUTHOR"
                  ]
                },
                "Actor": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "PREFERRED",
                    "NOT_REQUIRED"
                  ]
                },
                "Session": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "PREFERRED",
                    "NOT_REQUIRED"
                  ]
                },
                "Context": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "PREFERRED",
                    "NOT_REQUIRED"
                  ]
                },
                "Provider": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "PREFERRED",
                    "NOT_REQUIRED"
                  ]
