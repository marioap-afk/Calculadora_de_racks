            "TaskId": {
              "type": [
                "string",
                "null"
              ],
              "description": "Nullable = no aplica, solo con Scope UNIT."
            },
            "Role": {
              "type": "string",
              "enum": [
                "PRINCIPAL_COORDINATOR",
                "ARCHITECT",
                "EXECUTION_CONTROLLER",
                "WORKER",
                "REVIEWER"
              ]
            },
            "BindingId": {
              "type": "string",
              "pattern": "^B[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
            },
            "Sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "Location": {
              "type": "object",
