    "ExpectedHandoffPath": {
      "type": "string",
      "pattern": "^artifacts/orchestration/.+/\\{WorkRunId\\}/worker-handoff\\.json$"
    },
    "IssuedBy": {
      "type": "string"
    },
    "RoleRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Role": {
            "type": "string",
            "enum": [
              "PRINCIPAL_COORDINATOR",
              "ARCHITECT",
              "EXECUTION_CONTROLLER",
              "WORKER",
              "REVIEWER"
