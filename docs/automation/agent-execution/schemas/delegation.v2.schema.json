            "High"
          ]
        },
        "MechanicalRepetition": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "Horizon": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        }
      },
      "required": [
        "Ambiguity",
        "ArchitecturalSensitivity",
        "Breadth",
        "ToolUse",
        "FailureCost",
        "MechanicalRepetition",
        "Horizon"
      ]
    },
    "Executor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Provider": {
          "type": "string"
        },
        "Transport": {
          "type": "string"
        },
        "Role": {
          "type": "string"
        },
        "Cell": {
          "type": "string"
        },
        "BindingRef": {
          "type": "object",
