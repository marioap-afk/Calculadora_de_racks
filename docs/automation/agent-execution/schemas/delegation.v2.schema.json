{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rackcad-delegation/v2",
  "description": "Delegación del Controller de planificación en una unidad I62 (Proposal V14 Anexo B.7 sobre rackcad-delegation/v1): Owner.Kind neutral, BindingRef del ejecutor, RoleRequirements y SupersededCommits copiados del contrato. Subordinado: no crea requisitos de evidencia, estados, gates, reglas Git ni decisiones del Owner. Inactivo hasta I62_EFFECTIVE_SHA (AUTOMATION_PLAN 16.14).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Schema": {
      "type": "string",
      "enum": [
        "rackcad-delegation/v2"
      ]
    },
    "TaskId": {
      "type": "string"
    },
    "RunId": {
      "type": "string",
      "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "Initiative": {
      "type": "string"
    },
    "Unit": {
      "type": "string"
    },
    "Gate": {
      "type": "string"
    },
    "Attempt": {
      "type": "integer"
    },
    "AuthorityRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "MainSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "BaseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ExpectedBranch": {
      "type": "string"
    },
    "ExpectedWorktree": {
