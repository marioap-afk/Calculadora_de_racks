          },
          "Profile": {
            "type": "string",
            "minLength": 1
          },
          "Action": {
            "type": "string",
            "enum": [
              "RESUME_DECISION",
              "CUSTODY",
              "LOCAL_EVIDENCE",
              "REVIEW_DESIGN",
