                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "Nullable = no aplica, solo con TRANSIENT."
                },
                "Blob": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "Nullable = no aplica, solo con TRANSIENT."
                }
              },
              "required": [
                "Kind",
                "Path",
                "Commit",
                "Blob"
              ]
            }
          },
          "required": [
            "UnitId",
            "Scope",
            "TaskId",
            "Role",
            "BindingId",
            "Sha256",
            "Location"
          ]
        }
      },
      "required": [
        "Provider",
        "Transport",
        "Role",
        "Cell",
        "BindingRef"
      ]
    },
    "Model": {
      "type": "string"
    },
    "Effort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Semantic": {
          "type": "string",
          "enum": [
            "Routine",
            "Balanced",
            "Deep",
            "Long-horizon",
            "Maximum"
          ]
        },
        "Provider": {
          "type": "string"
        }
      },
      "required": [
        "Semantic",
        "Provider"
      ]
    },
    "PromptProfile": {
      "type": "string",
      "enum": [
        "ROUTINE_IMPLEMENTATION",
        "DEBUGGING",
        "LONG_HORIZON_IMPLEMENTATION",
        "ARCHITECTURE_REVIEW",
        "CHARACTERIZATION",
        "DOCUMENTATION",
        "CONTROLLER_PLANNING",
        "CONTROLLER_VERIFICATION"
