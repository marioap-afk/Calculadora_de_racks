                  "build-server",
                  "participant",
                  "unattributable",
                  "session-descendant",
                  "orphan"
                ]
              }
            },
            "required": [
              "Pid",
              "ParentPid",
              "Name",
              "CreationDateUtc",
              "Classification"
            ]
          }
        }
      },
      "required": [
        "HeadSha",
        "LsRemoteSha",
        "CleanTree",
        "Fingerprint",
        "FingerprintChanged",
