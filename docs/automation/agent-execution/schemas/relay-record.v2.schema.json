            "properties": {
              "RunRef": {
                "type": "string"
              },
              "Name": {
                "type": "string"
              },
              "Sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "Selected": {
                "type": "integer"
              },
              "Passed": {
                "type": "integer"
              },
              "Failed": {
                "type": "integer"
              },
              "Skipped": {
                "type": "integer"
