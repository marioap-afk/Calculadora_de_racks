{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rackcad-controller-verification/v2",
  "description": "Verificación del Controller en una unidad I62 (Proposal V14 Anexo B.7 sobre rackcad-controller-verification/v1). EXECUTION_VERIFIED solo con las 14 comprobaciones en pass; STOP = EXECUTION_BLOCKED + Disposition STOP. No es evidencia de gate. Subordinado: no crea requisitos de evidencia, estados, gates, reglas Git ni decisiones del Owner. Inactivo hasta I62_EFFECTIVE_SHA (AUTOMATION_PLAN 16.14).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Schema": {
      "type": "string",
      "enum": [
        "rackcad-controller-verification/v2"
      ]
    },
    "TaskId": {
      "type": "string"
    },
    "RunId": {
      "type": "string",
      "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "DelegationRunId": {
      "type": "string",
      "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "WorkRunId": {
      "type": "string",
      "pattern": "^R[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "Attempt": {
      "type": "integer"
    },
    "VerifiedSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "Verifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Role": {
          "type": "string",
          "enum": [
            "EXECUTION_CONTROLLER"
          ]
        },
        "BindingRef": {
          "type": "object",
          "description": "BindingRef (B.2). Lo produce el binding (F3); aquí solo su forma.",
          "additionalProperties": false,
          "properties": {
            "UnitId": {
              "type": "string",
              "minLength": 1
            },
            "Scope": {
              "type": "string",
              "enum": [
                "UNIT",
                "TASK"
              ]
            },
            "TaskId": {
              "type": [
                "string",
                "null"
              ],
              "description": "Nullable = no aplica, solo con Scope UNIT."
            },
            "Role": {
              "type": "string",
              "enum": [
                "PRINCIPAL_COORDINATOR",
                "ARCHITECT",
                "EXECUTION_CONTROLLER",
                "WORKER",
                "REVIEWER"
              ]
            },
            "BindingId": {
              "type": "string",
              "pattern": "^B[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
            },
            "Sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "Location": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "Kind": {
                  "type": "string",
                  "enum": [
                    "TRANSIENT",
                    "CUSTODIED"
                  ]
                },
                "Path": {
                  "type": "string",
                  "minLength": 1
                },
                "CommitSha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "Nullable = no aplica, solo con Kind TRANSIENT."
                },
                "Blob": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "Nullable = no aplica, solo con Kind TRANSIENT."
                }
              },
              "required": [
                "Kind",
                "Path",
                "CommitSha",
                "Blob"
              ]
            }
          },
          "required": [
            "UnitId",
            "Scope",
            "TaskId",
            "Role",
            "BindingId",
            "Sha256",
            "Location"
          ]
        },
        "Actor": {
          "type": "object",
          "description": "ActorRef (Proposal V14 Anexo B.2).",
          "additionalProperties": false,
          "properties": {
            "AdapterId": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "InstanceId": {
              "type": "string",
              "minLength": 1,
              "description": "Instancia observada del runtime; sin fuente, \"UNOBSERVED\"; candidata sin sesión, \"NOT_STARTED\" (B.2, B.4)."
            },
            "InstanceIdSource": {
              "type": "string",
              "minLength": 1
            },
            "Assurance": {
              "type": "string",
              "enum": [
                "REQUESTED",
                "CONFIGURED",
                "RUNTIME_OBSERVED",
                "SERVICE_ATTESTED",
                "NONE"
              ]
            }
          },
          "required": [
            "AdapterId",
            "InstanceId",
            "InstanceIdSource",
            "Assurance"
          ]
        }
      },
      "required": [
        "Role",
        "BindingRef",
        "Actor"
      ]
    },
    "Checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Termination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "Handoff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "Authority": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "Contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "Identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "Remote": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "Scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "CleanTree": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "Ci": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "RedPart": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_applicable"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "RedPart",
            "Evidence"
          ]
        },
        "Tests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "RedPart": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_applicable"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "RedPart",
            "Evidence"
          ]
        },
        "Trailer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "Routing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "FreeText": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        },
        "Denials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Result": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "not_run"
              ]
            },
            "Evidence": {
              "type": "string"
            }
          },
          "required": [
            "Result",
            "Evidence"
          ]
        }
      },
      "required": [
        "Termination",
        "Handoff",
        "Authority",
        "Contract",
        "Identity",
        "Remote",
        "Scope",
        "CleanTree",
        "Ci",
        "Tests",
        "Trailer",
        "Routing",
        "FreeText",
        "Denials"
      ]
    },
    "AuthorityResolution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Path": {
            "type": "string",
            "minLength": 1
          },
          "Section": {
            "type": "string",
            "minLength": 1
          },
          "Class": {
            "type": "string",
            "enum": [
              "UNIT_DOC",
              "UNIT_CHANGE",
              "EXTERNAL"
            ]
          },
          "Mode": {
            "type": "string",
            "enum": [
              "NORMAL",
              "COMPAT",
              "COMPUESTA",
              "ENTRY"
            ]
          },
          "RevisionSha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$",
            "description": "Nullable = no aplica solo con Mode COMPUESTA, que resuelve por partes."
          },
          "Parts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "Section": {
                  "type": "string",
                  "minLength": 1
                },
                "RevisionSha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "required": [
                "Section",
                "RevisionSha"
              ]
            },
            "description": "Partes de una lectura compuesta; vacío en otro modo."
          },
          "EffectiveSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "I62_EFFECTIVE_SHA."
          },
          "ClauseMapBlob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "UnitProtocol": {
            "type": "string",
            "enum": [
              "rackcad-protocol/I61",
              "rackcad-protocol/I62"
            ]
          }
        },
        "required": [
          "Path",
          "Section",
          "Class",
          "Mode",
          "RevisionSha",
          "Parts",
          "EffectiveSha",
          "ClauseMapBlob",
          "UnitProtocol"
        ]
      },
      "description": "Registro del paso 5 de Resolve (Proposal V14 Anexo E.3.1), en el orden de las citas del contrato."
    },
    "Classification": {
      "type": "string",
      "enum": [
        "EXECUTION_VERIFIED",
        "EXECUTION_REWORK_REQUIRED",
        "EXECUTION_BLOCKED"
      ]
    },
    "Disposition": {
      "type": "string",
      "enum": [
        "NONE",
        "REWORK",
        "BLOCKED",
        "STOP"
      ]
    },
    "FailureClass": {
      "type": "string",
      "enum": [
        "NONE",
        "Termination",
        "Handoff",
        "Authority",
        "Contract",
        "Identity",
        "Remote",
        "Scope",
        "CleanTree",
        "Ci",
        "Tests",
        "Trailer",
        "Routing",
        "FreeText",
        "Denials",
        "StopCondition"
      ]
    },
    "TriggeredStopConditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "RecommendedNextAction": {
      "type": "string"
    }
  },
  "required": [
    "Schema",
    "TaskId",
    "RunId",
    "DelegationRunId",
    "WorkRunId",
    "Attempt",
    "VerifiedSha",
    "Verifier",
    "Checks",
    "AuthorityResolution",
    "Classification",
    "Disposition",
    "FailureClass",
    "TriggeredStopConditions",
    "Findings",
    "RecommendedNextAction"
  ]
}
