{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rackcad-gate-contract/v2",
  "description": "Contrato de gate de una unidad I62 (Proposal V14 Anexo B.7 sobre rackcad-gate-contract/v1): EligibleCells pasa a RoleRequirements[]; se añaden ProtocolSet, MaterializationCloseSha y SupersededCommits. Un contrato /v1 nunca se reemite como /v2. Subordinado: no crea requisitos de evidencia, estados, gates, reglas Git ni decisiones del Owner. Inactivo hasta I62_EFFECTIVE_SHA (AUTOMATION_PLAN 16.14).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Schema": {
      "type": "string",
      "enum": [
        "rackcad-gate-contract/v2"
      ]
    },
    "Unit": {
      "type": "string"
    },
    "Gate": {
      "type": "string"
    },
    "TaskId": {
      "type": "string"
    },
    "Objective": {
      "type": "string"
    },
    "AuthorityRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "MainSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "Authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Path": {
            "type": "string"
          },
          "Section": {
            "type": "string"
          },
          "Class": {
            "type": "string",
            "enum": [
              "UNIT_DOC",
              "UNIT_CHANGE",
              "EXTERNAL"
            ]
          }
        },
        "required": [
          "Path",
          "Section",
          "Class"
        ]
      }
    },
    "AllowedWriteScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ForbiddenWriteScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "RequiredTests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Project": {
            "type": "string"
          },
          "Filter": {
            "type": "string"
          },
          "MinSelected": {
            "type": "integer"
          },
          "ExpectRed": {
            "type": "boolean"
          }
        },
        "required": [
          "Project",
          "Filter",
          "MinSelected",
          "ExpectRed"
        ]
      }
    },
    "ExpectedEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "StopConditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Id": {
            "type": "string"
          },
          "Text": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Text"
        ]
      }
    },
    "RoutingEnforcement": {
      "type": "string",
      "enum": [
        "required",
        "advisory"
      ]
    },
    "CorrectionsAuthorized": {
      "type": "boolean"
    },
    "IssuedBy": {
      "type": "string"
    },
    "IssuedUtc": {
      "type": "string"
    },
    "RoleRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Role": {
            "type": "string",
            "enum": [
              "PRINCIPAL_COORDINATOR",
              "ARCHITECT",
              "EXECUTION_CONTROLLER",
              "WORKER",
              "REVIEWER"
            ]
          },
          "Profile": {
            "type": "string",
            "minLength": 1
          },
          "Action": {
            "type": "string",
            "enum": [
              "RESUME_DECISION",
              "CUSTODY",
              "LOCAL_EVIDENCE",
              "REVIEW_DESIGN",
              "REVIEW_CHANGE",
              "PLAN",
              "VERIFY",
              "IMPLEMENT"
            ]
          },
          "Mandatory": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z_]+\\.[a-z0-9-]+$"
            }
          },
          "Independence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ReferenceRole": {
                  "type": "string",
                  "enum": [
                    "PRINCIPAL_COORDINATOR",
                    "ARCHITECT",
                    "EXECUTION_CONTROLLER",
                    "WORKER",
                    "REVIEWER",
                    "AUTHOR",
                    "PROPOSER",
                    "EVIDENCE_AUTHOR"
                  ]
                },
                "Actor": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "PREFERRED",
                    "NOT_REQUIRED"
                  ]
                },
                "Session": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "PREFERRED",
                    "NOT_REQUIRED"
                  ]
                },
                "Context": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "PREFERRED",
                    "NOT_REQUIRED"
                  ]
                },
                "Provider": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "PREFERRED",
                    "NOT_REQUIRED"
                  ]
                }
              },
              "required": [
                "ReferenceRole",
                "Actor",
                "Session",
                "Context",
                "Provider"
              ]
            }
          },
          "EligibleCells": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Celda con la forma de gate-contract/v1.",
              "additionalProperties": false,
              "properties": {
                "Cell": {
                  "type": "string"
                },
                "Provider": {
                  "type": "string"
                },
                "Model": {
                  "type": "string"
                },
                "Transport": {
                  "type": "string"
                },
                "Capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "TestedEfforts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "Source": {
                  "type": "string"
                },
                "VerifiedOn": {
                  "type": "string"
                }
              },
              "required": [
                "Cell",
                "Provider",
                "Model",
                "Transport",
                "Capabilities",
                "TestedEfforts",
                "Source",
                "VerifiedOn"
              ]
            }
          },
          "Materialization": {
            "type": [
              "object",
              "null"
            ],
            "description": "Autorización de materialización del REVIEWER con los campos de §20.5.1; null = no aplica (otros roles o sin autorización).",
            "additionalProperties": false,
            "properties": {
              "Role": {
                "type": "string",
                "enum": [
                  "REVIEWER"
                ]
              },
              "AuthorizedActions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "REVIEW_CHANGE"
                  ]
                }
              },
              "MinimumCapabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "RequirementId": {
                      "type": "string",
                      "pattern": "^[A-Z_]+\\.[a-z0-9-]+$"
                    },
                    "Required": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "RequirementId",
                    "Required"
                  ]
                }
              },
              "RequiredIndependence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ReferenceRole": {
                      "type": "string",
                      "enum": [
                        "PRINCIPAL_COORDINATOR",
                        "ARCHITECT",
                        "EXECUTION_CONTROLLER",
                        "WORKER",
                        "REVIEWER",
                        "AUTHOR",
                        "PROPOSER",
                        "EVIDENCE_AUTHOR"
                      ]
                    },
                    "Actor": {
                      "type": "string",
                      "enum": [
                        "REQUIRED",
                        "PREFERRED",
                        "NOT_REQUIRED"
                      ]
                    },
                    "Session": {
                      "type": "string",
                      "enum": [
                        "REQUIRED",
                        "PREFERRED",
                        "NOT_REQUIRED"
                      ]
                    },
                    "Context": {
                      "type": "string",
                      "enum": [
                        "REQUIRED",
                        "PREFERRED",
                        "NOT_REQUIRED"
                      ]
                    },
                    "Provider": {
                      "type": "string",
                      "enum": [
                        "REQUIRED",
                        "PREFERRED",
                        "NOT_REQUIRED"
                      ]
                    }
                  },
                  "required": [
                    "ReferenceRole",
                    "Actor",
                    "Session",
                    "Context",
                    "Provider"
                  ]
                }
              },
              "EligibleCells": {
                "type": "object",
                "description": "Lista cerrada de celdas, o el criterio cerrado de ADR-0046 #4 (Cells vacía).",
                "additionalProperties": false,
                "properties": {
                  "Mode": {
                    "type": "string",
                    "enum": [
                      "LIST",
                      "CRITERION"
                    ]
                  },
                  "Cells": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "Mode",
                  "Cells"
                ]
              },
              "ModelEffortBounds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "MinLevel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "MinEffort": {
                    "type": "string",
                    "enum": [
                      "Routine",
                      "Balanced",
                      "Deep",
                      "Long-horizon",
                      "Maximum"
                    ]
                  },
                  "MaxLevel": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "MaxEffort": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "Routine",
                      "Balanced",
                      "Deep",
                      "Long-horizon",
                      "Maximum",
                      null
                    ]
                  }
                },
                "required": [
                  "MinLevel",
                  "MinEffort",
                  "MaxLevel",
                  "MaxEffort"
                ]
              },
              "Permissions": {
                "type": "string",
                "enum": [
                  "READ_ONLY"
                ]
              },
              "Budget": {
                "type": "object",
                "description": "Topes menores o iguales que los congelados (§20.6).",
                "additionalProperties": false,
                "properties": {
                  "MaxReviewRounds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "MaxLogicalRequests": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "MaxTransportRerunsPerRequest": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "MaxCorrectionsPerLineage": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "MaxReviewRounds",
                  "MaxLogicalRequests",
                  "MaxTransportRerunsPerRequest",
                  "MaxCorrectionsPerLineage"
                ]
              },
              "ObjectFamily": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "Unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "PathPattern": {
                    "type": "string",
                    "minLength": 1
                  },
                  "InitialVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "CorrectionScope": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "Unit",
                  "PathPattern",
                  "InitialVersion",
                  "CorrectionScope"
                ]
              },
              "Validity": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "FromRecordVersion": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "Until": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
                  }
                },
                "required": [
                  "FromRecordVersion",
                  "Until"
                ]
              }
            },
            "required": [
              "Role",
              "AuthorizedActions",
              "MinimumCapabilities",
              "RequiredIndependence",
              "EligibleCells",
              "ModelEffortBounds",
              "Permissions",
              "Budget",
              "ObjectFamily",
              "Validity"
            ]
          }
        },
        "required": [
          "Role",
          "Profile",
          "Action",
          "Mandatory",
          "Independence",
          "EligibleCells",
          "Materialization"
        ]
      },
      "description": "Único por Role (B.7)."
    },
    "ProtocolSet": {
      "type": "string",
      "enum": [
        "rackcad-protocol/I61",
        "rackcad-protocol/I62"
      ]
    },
    "MaterializationCloseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "SupersededCommits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "WindowSeq": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "Sha",
          "WindowSeq"
        ]
      },
      "description": "Commits sin verificar sustituidos (B.8.6)."
    },
    "SupersededBaseSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$",
      "description": "null = no aplica si SupersededCommits está vacío."
    }
  },
  "required": [
    "Schema",
    "Unit",
    "Gate",
    "TaskId",
    "Objective",
    "AuthorityRevision",
    "MainSha",
    "Authorities",
    "AllowedWriteScope",
    "ForbiddenWriteScope",
    "Invariants",
    "RequiredTests",
    "ExpectedEvidence",
    "StopConditions",
    "RoutingEnforcement",
    "CorrectionsAuthorized",
    "IssuedBy",
    "IssuedUtc",
    "RoleRequirements",
    "ProtocolSet",
    "MaterializationCloseSha",
    "SupersededCommits",
    "SupersededBaseSha"
  ]
}
