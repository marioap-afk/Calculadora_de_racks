<Project Sdk="Microsoft.NET.Sdk">
  <!-- I-52-AUTH15 host-validation harness. TEMPORARY and NON-PRODUCT: not in RackCad.sln, not in deploy/, not
       referenced by src/ or tests/, and removed by a revert commit before Candidate. It defines exactly one AutoCAD
       command, I52AUTH15_HOSTVAL. The product Plugin is never NETLOADed: RackCad.Plugin.dll is loaded only as a
       dependency from the versioned run folder, and the internal AUTH-15 surface is called by reflection (no
       InternalsVisibleTo anywhere). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <AssemblyName>I52Auth15.HostHarness</AssemblyName>
    <RootNamespace>I52Auth15.HostHarness</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The AutoCAD reference assemblies pin an older Microsoft.VisualBasic; the host supplies its own at run time. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <AutoCADInstallDir Condition="'$(AutoCADInstallDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AutoCADInstallDir>
    <!-- The exact RackCad assemblies built from the implementation content (build-hostval.ps1 passes this). -->
    <RackCadBin Condition="'$(RackCadBin)' == ''">$(MSBuildThisFileDirectory)..\..\..\src\RackCad.Plugin\bin\Debug\net8.0-windows\</RackCadBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADInstallDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADInstallDir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCADInstallDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RackCad.Domain"><HintPath>$(RackCadBin)RackCad.Domain.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RackCad.Application"><HintPath>$(RackCadBin)RackCad.Application.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RackCad.Plugin"><HintPath>$(RackCadBin)RackCad.Plugin.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
