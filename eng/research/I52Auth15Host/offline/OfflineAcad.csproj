<Project Sdk="Microsoft.NET.Sdk">
  <!-- OFFLINE CHARACTERIZATION ONLY. A stand-in for acad.exe that runs the real run.scr through a mini script/LISP interpreter and
       writes evidence with the real Evidence.cs. It exercises the launcher and the FILEDIA logic without AutoCAD. Nothing it
       produces is host evidence, and it is never copied into a package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>offlineacad</AssemblyName>
    <RootNamespace>I52Auth15.Offline</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Evidence.cs" Link="Evidence.cs" />
  </ItemGroup>
</Project>
