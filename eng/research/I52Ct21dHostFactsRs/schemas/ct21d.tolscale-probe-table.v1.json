{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ct21d.tolscale-probe-table.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rows"],
  "properties": {
    "schema": { "const": "ct21d.tolscale-probe-table.v1" },
    "rows": {
      "type": "array",
      "minItems": 147,
      "maxItems": 147,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "signPattern", "component", "k", "inScope", "intended"],
        "properties": {
          "id": { "type": "string", "pattern": "^PF[12]-[0-9]{4}$" },
          "family": { "enum": ["PF1", "PF2"] },
          "signPattern": { "enum": ["++", "-+", "+-", "--"] },
          "component": { "enum": ["X", "Y", "Z", "ALL"] },
          "k": { "oneOf": [ { "type": "integer", "minimum": 20, "maximum": 52 }, { "type": "null" } ] },
          "inScope": { "type": "boolean" },
          "intended": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "pattern": "^[0-9A-F]{16}$" } }
        }
      }
    }
  }
}
