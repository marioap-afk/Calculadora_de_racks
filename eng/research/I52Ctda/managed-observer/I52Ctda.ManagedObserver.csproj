<Project Sdk="Microsoft.NET.Sdk">
  <!-- R-MANAGED-OBSERVER (EXEC-CATALOG-V35-1): research-only host of RR-MANAGED-CMD. Not referenced by src/, not in deploy/. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>I52Ctda.ManagedObserver</AssemblyName>
    <RootNamespace>I52Ctda.ManagedObserver</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The AutoCAD reference assemblies pin an older Microsoft.VisualBasic; the host supplies its own at run time. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <ObjectArxSdkRoot Condition="'$(ObjectArxSdkRoot)' == ''">D:\CDROM1</ObjectArxSdkRoot>
    <!-- The AutoCAD 2025 assemblies are provided by the host; the reference assemblies come from the ObjectARX SDK inc folder. -->
    <AutoCadReferenceMissing Condition="!Exists('$(ObjectArxSdkRoot)\inc\AcCoreMgd.dll')">true</AutoCadReferenceMissing>
  </PropertyGroup>
  <ItemGroup Condition="'$(AutoCadReferenceMissing)' != 'true'">
    <Reference Include="AcCoreMgd"><HintPath>$(ObjectArxSdkRoot)\inc\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(ObjectArxSdkRoot)\inc\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(ObjectArxSdkRoot)\inc\AcMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(AutoCadReferenceMissing)' == 'true'">
    <!-- Without the SDK only the AutoCAD-independent interop and record logic compiles (managed observer tests). -->
    <Compile Remove="ObserverApplication.cs" />
  </ItemGroup>
</Project>
