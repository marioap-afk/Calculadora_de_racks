{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ct21d:phase2:expected-inputs:v1",
  "title": "ct21d.phase2.expected-inputs.v1",
  "description": "The expected build-tuple inputs the CAD manager takes from the signed PHASE 1 tuple record, supplied to Validate-Phase2.ps1 independently of the capture record (so the record cannot vouch for itself).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session", "sessionId", "runId", "declaredSetSha256", "acadExeSha256", "profileExpected", "requireTranscript", "requireModuleBaseline", "moduleBaselineSha256"],
  "properties": {
    "schema": { "const": "ct21d.phase2.expected-inputs.v1" },
    "session": { "enum": ["S1-A", "S1-B", "S1-C", "S2", "S3", "S4"] },
    "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "runId": { "type": "string", "pattern": "^HGP-H[0-9]+-[0-9]{8}T[0-9]{6}Z-[0-9]{2}$" },
    "declaredSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "acadExeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profileExpected": { "type": "string", "minLength": 1, "maxLength": 256 },
    "requireTranscript": { "type": "boolean" },
    "requireModuleBaseline": { "type": "boolean" },
    "moduleBaselineSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  }
}
