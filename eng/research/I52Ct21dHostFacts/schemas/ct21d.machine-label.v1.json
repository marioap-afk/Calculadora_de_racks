{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ct21d.machine-label.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fact",
    "gate",
    "governing",
    "label",
    "serializationSha256",
    "attributes"
  ],
  "properties": {
    "schema": {
      "const": "ct21d.machine-label.v1"
    },
    "fact": {
      "const": "HF-M7"
    },
    "gate": {
      "const": "HOST_GATE_BA11_3_3"
    },
    "governing": {
      "const": false
    },
    "label": {
      "$ref": "#/$defs/label"
    },
    "serializationSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "attributes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "status",
          "reason",
          "characters"
        ],
        "properties": {
          "key": {
            "enum": [
              "AutoCadProduct",
              "AutoCadProfile",
              "MachineGuid",
              "OsVersionBuild",
              "SECURELOAD",
              "TRUSTEDPATHS"
            ]
          },
          "status": {
            "enum": [
              "OBSERVED",
              "UNKNOWN"
            ]
          },
          "reason": {
            "type": "string"
          },
          "characters": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blob": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9A-F]{16}$"
    },
    "hex3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hex64"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "label": {
      "type": "string",
      "pattern": "^(MC-[0-9a-f]{12}|UNSET)$"
    },
    "runId": {
      "type": "string",
      "pattern": "^HGP-H[0-9]+-[0-9]{8}T[0-9]{6}Z-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "OBSERVED",
        "OBSERVED_DIFFERS",
        "NOT_OBSERVED",
        "NOT_OBSERVABLE",
        "UNKNOWN",
        "INVALID"
      ]
    }
  }
}
