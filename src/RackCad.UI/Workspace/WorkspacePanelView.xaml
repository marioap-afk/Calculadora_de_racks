<UserControl x:Class="RackCad.UI.Workspace.WorkspacePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Workspace"
             FontFamily="Segoe UI"
             FontSize="12"
             Background="{DynamicResource WindowBackgroundBrush}">
    <!-- The shared styles are merged HERE, in the control's own resources: there is no App.xaml and no application
         resource dictionary in the host, so the control resolves everything it needs by itself. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <!-- A text block that disappears while it has nothing to say. -->
            <Style x:Key="OptionalText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <TextBlock x:Name="RootLabelText" Text="{Binding Label}" FontSize="16"
                       Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

            <!-- State of the panel. -->
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock x:Name="StateTitleText" Text="{Binding StateTitle}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource ShellTextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StateDetail}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock Text="{Binding SessionText}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Contained failure of the panel: message and retry. The classic commands keep working. -->
            <StackPanel x:Name="ErrorPanel" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ShellStatusErrorBrush}" />
                <Button x:Name="RetryButton" Content="Reintentar" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="Collapsed"
                        Click="OnRetryClick" />
            </StackPanel>

            <!-- Availability of the actions and the reason when they are blocked. -->
            <TextBlock Text="Acciones" Style="{StaticResource SectionTitle}" />
            <CheckBox Content="Leer el dibujo" IsChecked="{Binding CanReadDrawing, Mode=OneWay}"
                      IsHitTestVisible="False" Focusable="False" />
            <CheckBox Content="Escribir en el dibujo" IsChecked="{Binding CanWriteDrawing, Mode=OneWay}"
                      IsHitTestVisible="False" Focusable="False" Margin="0,2,0,0" />
            <TextBlock x:Name="ActionBlockTextBlock" Text="{Binding ActionBlockText}" Style="{StaticResource OptionalText}"
                       Foreground="{DynamicResource ShellStatusWarningBrush}" />

            <!-- PICKFIRST notice. -->
            <Border Margin="0,8,0,0" Padding="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ShellStatusWarningBrush}"
                    Visibility="{Binding PickFirstNoticeVisible, Converter={StaticResource FlagToVisibility}}">
                <TextBlock x:Name="PickFirstText" Text="{Binding PickFirstNotice}" TextWrapping="Wrap"
                           Foreground="{DynamicResource ShellStatusWarningBrush}" />
            </Border>

            <!-- Selection context of the snapshot (never a total of the project). -->
            <TextBlock Text="Selección" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="ContextTitleText" Text="{Binding ContextTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <TextBlock x:Name="ContextTextBlock" Text="{Binding ContextText}" Style="{StaticResource OptionalText}"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />

            <!-- Browser of racks (I-64 F3-T2): the tab strip and ONE live surface (K = 1), before the navigation. Memory only: no control
                 here writes the drawing. No control has a fixed size: the strip wraps with the width of the surface, from a narrow bar to
                 a wide window, and the one surface is reused by every tab. -->
            <TextBlock Text="Navegador de racks" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="BrowserEmptyText" Text="{Binding Browser.EmptyText}" Style="{StaticResource OptionalText}"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            <ItemsControl x:Name="BrowserTabStrip" ItemsSource="{Binding Browser.Tabs}" Margin="0,6,0,0"
                          AutomationProperties.Name="Pestañas de racks">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,6,6" Padding="2">
                            <Border.Style>
                                <!-- The default border lives in setters of the style, never as attributes of the Border: a value set
                                     directly on the element outranks the trigger and the active tab would look like the others. -->
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ShellSelectionPrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <WrapPanel>
                                <Button Margin="0,0,4,0" Padding="8,2" Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="Activar pestaña" Click="OnBrowserTabActivateClick"
                                        MouseDoubleClick="OnBrowserTabActivateDoubleClick">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                </Button>
                                <Button Content="Fijar" Margin="0,0,4,0" Padding="8,2" Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="Fijar pestaña"
                                        Visibility="{Binding IsPreview, Converter={StaticResource FlagToVisibility}}"
                                        Click="OnBrowserTabPinClick" />
                                <Button Content="Cerrar" Padding="8,2" Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="Cerrar pestaña" Click="OnBrowserTabCloseClick" />
                            </WrapPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Closing and discarding (I-64 F4-T3B2): between the strip and the surface, outside the strip. The confirmation is inline, with
                 exactly Descartar and Cancelar, no subdialog and no default or cancel button; the notices are rows with their own buttons.
                 Memory only: no control here writes the drawing. No control has a fixed size. -->
            <Button x:Name="BrowserDiscardDocumentButton" Content="Descartar borradores de este documento" HorizontalAlignment="Left"
                    Margin="0,6,0,0" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.Name="Descartar borradores de este documento"
                    Visibility="{Binding Browser.CanDiscardDocument, Converter={StaticResource FlagToVisibility}}"
                    Click="OnBrowserDiscardDocumentClick" />
            <Border x:Name="BrowserConfirmationPanel" Margin="0,6,0,0" Padding="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ShellStatusWarningBrush}"
                    Visibility="{Binding Browser.HasConfirmation, Converter={StaticResource FlagToVisibility}}">
                <StackPanel>
                    <TextBlock x:Name="BrowserConfirmationText" Text="{Binding Browser.ConfirmationText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="BrowserConfirmDiscardButton" Content="Descartar" Margin="0,0,6,0" Padding="10,3"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="Confirmar el descarte"
                                Click="OnBrowserConfirmDiscardClick" />
                        <Button x:Name="BrowserCancelDiscardButton" Content="Cancelar" Padding="10,3"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="Cancelar el descarte"
                                Click="OnBrowserCancelDiscardClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="BrowserNoticeText" Text="{Binding Browser.NoticeText}" Style="{StaticResource OptionalText}"
                       Margin="0,6,0,0" Foreground="{DynamicResource ShellStatusWarningBrush}" />
            <ItemsControl x:Name="BrowserNoticeList" ItemsSource="{Binding Browser.Notices}" Margin="0,4,0,0"
                          AutomationProperties.Name="Avisos del navegador">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ShellStatusWarningBrush}" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="Descartar borradores de este documento" Margin="0,0,6,0" Padding="10,3"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="Descartar los borradores del documento del aviso"
                                        Visibility="{Binding CanDiscardDocument, Converter={StaticResource FlagToVisibility}}"
                                        Click="OnBrowserNoticeDiscardDocumentClick" />
                                <Button Content="Entendido" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="Quitar el aviso"
                                        Click="OnBrowserNoticeDismissClick" />
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="BrowserSurface" Padding="10" BorderThickness="1" Margin="0,2,0,0"
                    Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}"
                    Visibility="{Binding Browser.HasSurface, Converter={StaticResource FlagToVisibility}}">
                <StackPanel>
                    <TextBlock x:Name="BrowserSurfaceTitleText" Text="{Binding Browser.SurfaceTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ShellTextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="BrowserSurfaceKindText" Text="{Binding Browser.SurfaceKindText}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock x:Name="BrowserSurfaceViewsText" Text="{Binding Browser.SurfaceViewsText}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock x:Name="BrowserSurfaceStatusText" Text="{Binding Browser.SurfaceStatusText}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <!-- The field of the bounded pilot (I-64 F4-T3B1): ONE box on the ONE surface, shown only with the edit port. The text
                         is edited only through the setter of the bound property; the gestures that open it and the keys Enter and
                         Esc of the editable box are handled in the code-behind; no handler of the bubble KeyDown is attached to the box. Nothing here writes the drawing. -->
                    <StackPanel x:Name="BrowserFieldPanel" Margin="0,8,0,0"
                                Visibility="{Binding Browser.Field.IsAvailable, Converter={StaticResource FlagToVisibility}}">
                        <TextBlock Text="Escala de anotación" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <TextBox x:Name="BrowserFieldBox" Margin="0,2,0,0" TextWrapping="Wrap"
                                 AutomationProperties.Name="Escala de anotación"
                                 Text="{Binding Browser.Field.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding Browser.Field.IsReadOnly, Mode=OneWay}"
                                 PreviewMouseLeftButtonDown="OnBrowserFieldBoxPreviewMouseLeftButtonDown"
                                 PreviewKeyDown="OnBrowserFieldBoxPreviewKeyDown"
                                 LostFocus="OnBrowserFieldBoxLostFocus" />
                        <TextBlock x:Name="BrowserFieldStateText" Text="{Binding Browser.Field.StateText}" Style="{StaticResource OptionalText}"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <TextBlock x:Name="BrowserFieldMessageText" Text="{Binding Browser.Field.MessageText}" Style="{StaticResource OptionalText}"
                                   Foreground="{DynamicResource ShellStatusErrorBrush}" />
                        <TextBlock x:Name="BrowserFieldNoticeText" Text="{Binding Browser.Field.NoticeText}" Style="{StaticResource OptionalText}"
                                   Foreground="{DynamicResource ShellStatusWarningBrush}" />
                        <TextBlock x:Name="BrowserFieldNotEditableText" Text="{Binding Browser.Field.NotEditableText}" Style="{StaticResource OptionalText}"
                                   Foreground="{DynamicResource ShellStatusWarningBrush}" />
                        <TextBlock x:Name="BrowserFieldHintText" Text="{Binding Browser.Field.ClassicEditorHintText}" Style="{StaticResource OptionalText}"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="BrowserFieldEditButton" Content="Editar" Margin="0,2,6,0" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.Name="Editar el campo"
                                    Visibility="{Binding Browser.Field.ShowEditButton, Converter={StaticResource FlagToVisibility}}"
                                    Click="OnBrowserFieldEditClick" />
                            <Button x:Name="BrowserFieldReloadButton" Content="Recargar" Margin="0,2,6,0" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.Name="Recargar el campo"
                                    Visibility="{Binding Browser.Field.ShowReloadButton, Converter={StaticResource FlagToVisibility}}"
                                    Click="OnBrowserFieldReloadClick" />
                            <Button x:Name="BrowserFieldDiscardButton" Content="Descartar" Margin="0,2,6,0" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.Name="Descartar el borrador"
                                    Visibility="{Binding Browser.Field.ShowDiscardButton, Converter={StaticResource FlagToVisibility}}"
                                    Click="OnBrowserFieldDiscardClick" />
                        </WrapPanel>
                    </StackPanel>
                    <!-- Explicit reread of the summary of the active tab, from any state of the surface. It is the surface's own button:
                         there is still one surface and it is reused by every tab. -->
                    <Button x:Name="BrowserSurfaceReloadButton" Content="Volver a leer" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="Volver a leer el resumen"
                            Click="OnBrowserSurfaceReloadClick" />
                </StackPanel>
            </Border>

            <!-- Navigation of the rack of the context (I-64 F2-T2B). Explicit actions only. No control here has a fixed width:
                 the WrapPanels reflow with the width of the surface, from a narrow bar to a wide window. -->
            <TextBlock Text="Navegación" Style="{StaticResource SectionTitle}" />
            <TextBlock x:Name="NavigationBlockedText" Text="{Binding Navigation.BlockedReason}" Style="{StaticResource OptionalText}"
                       Foreground="{DynamicResource ShellStatusWarningBrush}" />
            <WrapPanel x:Name="NavigationActionsPanel" Margin="0,6,0,0">
                <Button x:Name="NavigationSelectButton" Content="Seleccionar" Margin="0,0,6,6" Padding="10,3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding Navigation.CanNavigate}" Click="OnNavigationSelectClick" />
                <Button x:Name="NavigationViewButton" Content="Ver" Margin="0,0,6,6" Padding="10,3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding Navigation.CanNavigate}" Click="OnNavigationViewClick" />
                <Button x:Name="NavigationCenterButton" Content="Centrar" Margin="0,0,6,6" Padding="10,3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding Navigation.CanNavigate}" Click="OnNavigationCenterClick" />
            </WrapPanel>
            <WrapPanel x:Name="NavigationCopyPanel">
                <Button x:Name="NavigationNextCopyButton" Content="Siguiente copia" Margin="0,0,6,6" Padding="10,3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding Navigation.CanNextCopy}" Click="OnNavigationNextCopyClick" />
                <TextBlock x:Name="NavigationCopyText" Text="{Binding Navigation.CopyText}" VerticalAlignment="Center"
                           Margin="0,0,6,6" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            </WrapPanel>
            <WrapPanel x:Name="NavigationLocatePanel">
                <TextBlock Text="Localizar vista" VerticalAlignment="Center" Margin="0,0,6,6"
                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                <ComboBox x:Name="NavigationViewSelector" Margin="0,0,6,6" VerticalAlignment="Center"
                          AutomationProperties.Name="Vista a localizar"
                          ItemsSource="{Binding Navigation.ViewChoices}" DisplayMemberPath="Label" SelectedValuePath="Order"
                          SelectedValue="{Binding Navigation.SelectedView, Mode=TwoWay}" />
                <CheckBox x:Name="NavigationLocateCenteredCheck" VerticalAlignment="Center"
                          Margin="0,0,6,6" IsChecked="{Binding Navigation.LocateCentered, Mode=TwoWay}">
                    <TextBlock Text="Centrar en vez de ajustar" TextWrapping="Wrap" />
                </CheckBox>
                <Button x:Name="NavigationLocateButton" Content="Localizar" Margin="0,0,6,6" Padding="10,3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding Navigation.CanNavigate}" Click="OnNavigationLocateClick" />
            </WrapPanel>
            <TextBlock x:Name="NavigationResultText" Text="{Binding Navigation.ResultText}" Style="{StaticResource OptionalText}"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />

            <!-- In-memory instrumentation: read-only presentation of the report and its switch. -->
            <TextBlock Text="Instrumentación" Style="{StaticResource SectionTitle}" />
            <CheckBox x:Name="InstrumentationToggle" Content="Medir en memoria (no escribe en el registro)"
                      IsChecked="{Binding InstrumentationEnabled, Mode=OneWay}" Click="OnInstrumentationClick" />
            <TextBlock Text="{Binding InstrumentationSummary}" Style="{StaticResource OptionalText}"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            <TextBlock Text="{Binding ProcessMemoryText}" Style="{StaticResource OptionalText}"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            <ItemsControl x:Name="MeasurementList" ItemsSource="{Binding Measurements}" Margin="0,6,0,0" FontSize="11">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Sequence}" />
                            <TextBlock Grid.Column="1" Text="{Binding Point}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding MillisecondsText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding MemoryText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding Count}" TextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
