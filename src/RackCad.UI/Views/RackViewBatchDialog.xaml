<Window x:Class="RackCad.UI.Views.RackViewBatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insertar varias vistas" Width="650" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Agrega las vistas en el orden en que deseas colocarlas." Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Vistas disponibles" Margin="0,0,10,0">
                <ListBox x:Name="AvailableList" ItemsSource="{Binding Available}" MouseDoubleClick="Add_Click"/>
            </GroupBox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Content="Agregar →" Click="Add_Click" Margin="0,3" Padding="10,5"/>
                <Button Content="← Quitar" Click="Remove_Click" Margin="0,3" Padding="10,5"/>
            </StackPanel>
            <GroupBox Grid.Column="2" Header="Cola de colocación">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Subir" Click="Up_Click" Margin="3" Padding="10,5"/>
                        <Button Content="Bajar" Click="Down_Click" Margin="3" Padding="10,5"/>
                    </StackPanel>
                    <ListBox x:Name="SelectedList" ItemsSource="{Binding Selected}"/>
                </DockPanel>
            </GroupBox>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0" Padding="14,6"/>
            <Button Content="Insertar cola" IsDefault="True" Click="Accept_Click" Padding="14,6"/>
        </StackPanel>
    </Grid>
</Window>
