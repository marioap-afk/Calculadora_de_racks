<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- I-64 A-14, fourth batch, part «ut»: the styles of the pages of the utilities of the RackCad window (Biblioteca de diseños, Configuración,
         Órdenes y atajos and the additions of Nuevo). The same tokens of the shell as the window; every brush is a DynamicResource of
         AppStyles, merged here so it resolves inside these controls too (a DynamicResource does not fall back to the theme dictionary). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="UtFlagToVisibility" />

    <Style x:Key="UtPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
    </Style>
    <Style x:Key="UtBlockTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,12,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
    </Style>
    <Style x:Key="UtText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
    </Style>
    <Style x:Key="UtPlain" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
    </Style>
    <!-- A line that disappears when it has nothing to say. -->
    <Style x:Key="UtOptional" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="UtError" TargetType="TextBlock" BasedOn="{StaticResource UtOptional}">
        <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
    </Style>
    <Style x:Key="UtMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
    </Style>
    <Style x:Key="UtBanner" TargetType="Border">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
    </Style>
    <Style x:Key="UtWarning" TargetType="Border" BasedOn="{StaticResource UtBanner}">
        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
    </Style>
    <!-- A link of the page: a flat button with the text of information. -->
    <Style x:Key="UtLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource ShellStatusInfoBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ShellWindowBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A row of a list of the page (a design of the library): flat, the whole width; the chosen one is marked by its own data. -->
    <Style x:Key="UtRowButton" TargetType="Button">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ShellSelectionPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- The pill of an alias of the help. -->
    <Style x:Key="UtAliasPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource ShellStatusInfoBrush}" />
    </Style>
    <!-- A button of danger (the approved drafts): the shell has none, so the secondary one with the error token. -->
    <Style x:Key="UtDangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusErrorBrush}" />
    </Style>
</ResourceDictionary>
