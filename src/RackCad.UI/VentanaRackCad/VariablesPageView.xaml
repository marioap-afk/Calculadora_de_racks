<UserControl x:Class="RackCad.UI.VentanaRackCad.VariablesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RackCad.UI.VentanaRackCad"
             AutomationProperties.Name="Variables"
             FontFamily="Segoe UI"
             FontSize="12"
             Background="{DynamicResource WindowBackgroundBrush}">
    <!-- The page «Variables» of the RackCad window (I-64 A-14, cuarta tanda, va; prototype «variables»): the register of the drawing, its
         broken references and the custom properties of the project in a second tab. Everything goes to the draft of the page; nothing here
         writes the drawing: «Actualizar» hands the whole draft to the window, which writes it with one order of its door. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <Style x:Key="OptionalText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
            <Style x:Key="GroupTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
            <Style x:Key="ColumnHead" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,8,4" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
            </Style>
            <Style x:Key="Alert" TargetType="Border">
                <Setter Property="Margin" Value="0,6,0,6" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
                <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- The head of the page: the state, «Actualizar», «Descartar» and «Más». -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ShellBorderBrush}"
                Background="{DynamicResource ShellSurfaceBrush}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Variables" FontSize="16" FontWeight="SemiBold" Margin="0,4,12,4" VerticalAlignment="Center"
                               Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    <Border Margin="0,4,12,4" Padding="8,2" CornerRadius="8" BorderThickness="1" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="DiffText" Text="{Binding DiffText}" Margin="0,4,12,4" VerticalAlignment="Center"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <Button x:Name="UpdateButton" Content="Actualizar" Margin="0,4,8,4" Padding="14,4" Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanUpdate}" AutomationProperties.Name="Actualizar el dibujo con el borrador de Variables" Click="OnUpdateClick" />
                    <Button x:Name="DiscardButton" Content="Descartar" Margin="0,4,8,4" Padding="12,4" Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CanDiscard}" AutomationProperties.Name="Descartar el borrador de Variables" Click="OnDiscardClick" />
                    <Button x:Name="MoreButton" Content="Más…" Margin="0,4,8,4" Padding="12,4" Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="Más acciones de Variables" Click="OnMoreClick" />
                </WrapPanel>
                <WrapPanel x:Name="MorePanel" Visibility="Collapsed" Margin="0,2,0,2">
                    <Button x:Name="CheckButton" Content="Comprobar" Margin="0,0,8,4" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding IsLoaded}" AutomationProperties.Name="Comprobar el borrador de Variables" Click="OnCheckClick" />
                    <Button x:Name="RereadButton" Content="Volver a leer del dibujo" Margin="0,0,8,4" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding CanRead}" AutomationProperties.Name="Volver a leer las variables del dibujo" Click="OnReadClick" />
                    <!-- T6 rl: RACKVARIABLES opens this page; the classic window stays in the classic menu. -->
                    <Button x:Name="ClassicButton" Content="Abrir el menú clásico (RACKMENU), con la ventana clásica de Variables" Margin="0,0,8,4" Padding="10,3"
                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Abrir la ventana clásica de Variables" Click="OnClassicClick" />
                </WrapPanel>
                <TextBlock x:Name="UpdateBlockedText" Text="{Binding UpdateBlockedText}" Style="{StaticResource HintText}" />
                <TextBlock x:Name="WritingText" Text="{Binding WritingText}" Style="{StaticResource HintText}" FontWeight="SemiBold" />
                <TextBlock x:Name="MessageText" Text="{Binding Message}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                            <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Note}" Style="{StaticResource HintText}" />
            </StackPanel>
        </Border>

        <Grid>
            <!-- Not read yet (or reading). -->
            <StackPanel x:Name="NotLoadedPanel" Margin="14,10" Visibility="{Binding IsNotLoaded, Converter={StaticResource FlagToVisibility}}">
                <TextBlock x:Name="NotLoadedText" Text="{Binding NotLoadedText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                <Button x:Name="ReadButton" Content="Leer las variables del dibujo" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanRead}"
                        AutomationProperties.Name="Leer las variables del dibujo" Click="OnReadClick" />
            </StackPanel>

            <TabControl x:Name="Tabs" Margin="8,6,8,8" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                        Visibility="{Binding IsLoaded, Converter={StaticResource FlagToVisibility}}">
                <!-- ======================================== Variables de proyecto -->
                <TabItem x:Name="VariablesTab" Header="{Binding VariablesTabHeader}" AutomationProperties.Name="Variables de proyecto">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnVariablesTabSizeChanged">
                        <StackPanel Margin="6">
                            <Border x:Name="BlockedPanel" Style="{StaticResource Alert}" BorderBrush="{DynamicResource ShellStatusErrorBrush}"
                                    Visibility="{Binding IsBlocked, Converter={StaticResource FlagToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="No se puede administrar el registro de variables" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                    <TextBlock x:Name="BlockedText" Text="{Binding BlockedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Grid x:Name="VariablesGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="InspectorRow" Height="0" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0">
                                    <!-- The register. -->
                                    <StackPanel Visibility="{Binding IsNotBlocked, Converter={StaticResource FlagToVisibility}}">
                                        <WrapPanel>
                                            <TextBlock Text="Variables de proyecto" Style="{StaticResource GroupTitle}" />
                                            <TextBlock x:Name="CountText" Text="{Binding CountText}" Margin="8,12,8,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                            <Button x:Name="NewVariableButton" Content="Nueva variable" Margin="0,8,0,4" Padding="10,3"
                                                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEditVariables}"
                                                    AutomationProperties.Name="Nueva variable" Click="OnNewVariableClick" />
                                        </WrapPanel>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="0.7*" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Nombre" Style="{StaticResource ColumnHead}" />
                                            <TextBlock Grid.Column="1" Text="Valor o fórmula" Style="{StaticResource ColumnHead}" />
                                            <TextBlock Grid.Column="2" Text="Valor" Style="{StaticResource ColumnHead}" />
                                            <TextBlock Grid.Column="3" Text="Racks" Style="{StaticResource ColumnHead}" />
                                            <TextBlock Grid.Column="4" Text="Estado" Style="{StaticResource ColumnHead}" />
                                        </Grid>
                                        <ItemsControl x:Name="VariableRows" ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:VariableRowItem}">
                                                    <Button Margin="0,0,0,2" Padding="4,3" HorizontalContentAlignment="Stretch" Click="OnRowClick"
                                                            AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.ItemStatus="{Binding Tag}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <!-- Smoke T4 (F-3): the template of SecondaryButtonStyle centres its content, so the row shrank to
                                                                     its text in the middle and its columns did not line up with the headings. This template
                                                                     stretches it. -->
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                                  VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource ShellSelectionPrimaryBrush}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ShellSelectionPrimaryBrush}" />
                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="1.5*" />
                                                                <ColumnDefinition Width="0.7*" />
                                                                <ColumnDefinition Width="1.2*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DefinitionShown}" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" TextTrimming="CharacterEllipsis" Margin="4,0" />
                                                            <TextBlock Grid.Column="3" Text="{Binding RacksText}" Margin="4,0" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Tag}" Margin="4,0" FontStyle="Italic" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="El dibujo no tiene variables todavía. «Nueva variable» crea la primera." Style="{StaticResource HintText}"
                                                   Visibility="{Binding HasNoVariables, Converter={StaticResource FlagToVisibility}}" />
                                        <TextBlock Text="{Binding FormulaHelp}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                                    </StackPanel>

                                    <!-- Referencias rotas: only when there is any (dolor 11). -->
                                    <StackPanel x:Name="BrokenPanel" Visibility="{Binding HasBroken, Converter={StaticResource FlagToVisibility}}">
                                        <TextBlock Text="Referencias rotas" Style="{StaticResource GroupTitle}" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="Racks con una propiedad que apunta a una variable que ya no está en el dibujo. No se abren en su editor, y RACKEDITAR tampoco los abre." />
                                        <ItemsControl x:Name="BrokenRows" ItemsSource="{Binding Broken}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:BrokenRackItem}">
                                                    <Border Margin="0,0,0,4" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource ShellBorderBrush}" CornerRadius="4">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding RackName}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}">
                                                                <Run Text="{Binding PropertiesText, Mode=OneWay}" /><Run Text=" · quedará en " /><Run Text="{Binding KeepsText, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <WrapPanel Margin="0,4,0,0">
                                                                <Button Content="Reparar…" Padding="10,3" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"
                                                                        IsEnabled="{Binding CanRepair}" Click="OnRepairAskClick" AutomationProperties.Name="{Binding RepairAccessibleText}"
                                                                        Visibility="{Binding IsNotQueued, Converter={StaticResource FlagToVisibility}}" />
                                                                <TextBlock Text="Se reparará" FontWeight="SemiBold" Margin="0,3,8,0"
                                                                           Visibility="{Binding IsQueued, Converter={StaticResource FlagToVisibility}}" />
                                                                <Button Content="No reparar" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}" Click="OnRepairUndoClick"
                                                                        AutomationProperties.Name="{Binding UndoAccessibleText}"
                                                                        Visibility="{Binding IsQueued, Converter={StaticResource FlagToVisibility}}" />
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding BlockingReason}" Style="{StaticResource HintText}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border x:Name="RepairAskPanel" Style="{StaticResource Alert}"
                                                Visibility="{Binding IsAskingRepair, Converter={StaticResource FlagToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RepairTitle}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                <TextBlock x:Name="RepairText" Text="{Binding RepairText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button x:Name="RepairYesButton" Content="{Binding RepairYesLabel}" Margin="0,0,6,0" Padding="10,3"
                                                            Style="{StaticResource SecondaryButtonStyle}" Click="OnRepairYesClick" />
                                                    <Button x:Name="RepairNoButton" Content="Cancelar" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                                                            AutomationProperties.Name="Cancelar la reparación" Click="OnAskNoClick" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Lo que escribirá «Actualizar». -->
                                    <StackPanel x:Name="ChangesPanel" Visibility="{Binding HasChanges, Converter={StaticResource FlagToVisibility}}">
                                        <TextBlock Text="Lo que escribirá «Actualizar»" Style="{StaticResource GroupTitle}" />
                                        <ItemsControl x:Name="ChangesList" ItemsSource="{Binding Changes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,0,0,2"
                                                               Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="RedrawText" Text="{Binding RedrawText}" Style="{StaticResource HintText}" />
                                        <ItemsControl x:Name="ConflictsList" ItemsSource="{Binding Conflicts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:VariablesConflictItem}">
                                                    <Border Style="{StaticResource Alert}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                            <Button Content="{Binding GoLabel}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
                                                                    Style="{StaticResource SecondaryButtonStyle}" Click="OnConflictGoClick" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>

                                <!-- The inspector of the chosen variable. -->
                                <Border x:Name="InspectorPanel" Grid.Column="1" Width="340" Margin="10,0,0,0" Padding="10" BorderThickness="1" CornerRadius="6"
                                        BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}" VerticalAlignment="Top"
                                        AutomationProperties.Name="Variable elegida"
                                        Visibility="{Binding IsNotBlocked, Converter={StaticResource FlagToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding NoSelectionText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                                   Visibility="{Binding HasNoSelection, Converter={StaticResource FlagToVisibility}}" />
                                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource FlagToVisibility}}">
                                            <WrapPanel>
                                                <TextBlock x:Name="InspectorTitle" Text="{Binding InspectorTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,4"
                                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding InspectorTag}" FontStyle="Italic" Margin="0,2,0,4" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                            </WrapPanel>
                                            <Border Style="{StaticResource Alert}" Visibility="{Binding IsSelectedRemoved, Converter={StaticResource FlagToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock x:Name="RemovedText" Text="{Binding RemovedText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                    <Button x:Name="UndoDeleteButton" Content="No eliminar" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
                                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEdit}" Click="OnUndoDeleteClick" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Nombre" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                            <TextBox x:Name="NameBox" Margin="0,2,0,0" Padding="4,3" IsReadOnly="{Binding InspectorReadOnly}"
                                                     AutomationProperties.Name="Nombre de la variable"
                                                     Text="{Binding InspectorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="OnNameKeyDown" LostFocus="OnNameLostFocus" />
                                            <TextBlock x:Name="NameError" Text="{Binding InspectorNameError}" Style="{StaticResource ErrorText}" />
                                            <TextBlock Text="Valor o fórmula" Margin="0,8,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding InspectorUnit}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                                <TextBox x:Name="DefinitionBox" Padding="4,3" IsReadOnly="{Binding InspectorReadOnly}"
                                                         AutomationProperties.Name="Valor o fórmula de la variable"
                                                         Text="{Binding InspectorDefinition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         KeyDown="OnDefinitionKeyDown" LostFocus="OnDefinitionLostFocus" />
                                            </DockPanel>
                                            <TextBlock x:Name="DefinitionError" Text="{Binding InspectorDefinitionError}" Style="{StaticResource ErrorText}" />
                                            <TextBlock Style="{StaticResource HintText}"
                                                       Text="Un número en pulgadas, o «=» y una fórmula. Lo escrito va al borrador al salir del campo o con Enter." />
                                            <TextBlock Text="Valor" Margin="0,8,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                            <TextBlock x:Name="ValueText" Text="{Binding InspectorValueText}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                            <TextBlock Text="{Binding InspectorValueHint}" Style="{StaticResource HintText}" />
                                            <TextBlock Text="Racks que la usan" Style="{StaticResource GroupTitle}" />
                                            <ItemsControl x:Name="ConsumersList" ItemsSource="{Binding Consumers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:VariableConsumerItem}">
                                                        <DockPanel Margin="0,0,0,2">
                                                            <Button DockPanel.Dock="Right" Content="Abrir" Padding="8,2" Style="{StaticResource SecondaryButtonStyle}"
                                                                    AutomationProperties.Name="{Binding OpenAccessibleText}" Click="OnConsumerOpenClick" />
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="NoConsumersText" Text="{Binding NoConsumersText}" Style="{StaticResource HintText}"
                                                       Visibility="{Binding HasNoConsumers, Converter={StaticResource FlagToVisibility}}" />
                                            <TextBlock Text="Fórmulas que la usan" Style="{StaticResource GroupTitle}"
                                                       Visibility="{Binding HasDependents, Converter={StaticResource FlagToVisibility}}" />
                                            <TextBlock x:Name="DependentsText" Text="{Binding DependentsText}" Style="{StaticResource OptionalText}"
                                                       Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button x:Name="DeleteButton" Content="{Binding DeleteLabel}" Margin="0,0,8,4" Padding="10,3"
                                                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanDelete}"
                                                        AutomationProperties.Name="Eliminar la variable" Click="OnDeleteClick" />
                                                <Button x:Name="UnlinkButton" Content="Desvincular todos y eliminar…" Margin="0,0,8,4" Padding="10,3"
                                                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanUnlink}"
                                                        AutomationProperties.Name="Desvincular todos y eliminar la variable" Click="OnUnlinkClick"
                                                        Visibility="{Binding ShowUnlink, Converter={StaticResource FlagToVisibility}}" />
                                            </WrapPanel>
                                            <TextBlock x:Name="DeleteWhy" Text="{Binding DeleteWhy}" Style="{StaticResource HintText}" />
                                            <Border x:Name="UnlinkAskPanel" Style="{StaticResource Alert}"
                                                    Visibility="{Binding IsAskingUnlink, Converter={StaticResource FlagToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding UnlinkTitle}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                    <TextBlock x:Name="UnlinkText" Text="{Binding UnlinkText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button x:Name="UnlinkYesButton" Content="Desvincular y eliminar" Margin="0,0,6,0" Padding="10,3"
                                                                Style="{StaticResource SecondaryButtonStyle}" Click="OnUnlinkYesClick" />
                                                        <Button x:Name="UnlinkNoButton" Content="Cancelar" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                                                                AutomationProperties.Name="Cancelar desvincular" Click="OnAskNoClick" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding RenameNote}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ======================================== Propiedades del proyecto (VA-06) -->
                <TabItem x:Name="PropertiesTab" Header="{Binding PropertiesTabHeader}" AutomationProperties.Name="Propiedades del proyecto">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <local:CustomPropertiesTableView x:Name="ProjectPropertiesTable" Margin="6" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
