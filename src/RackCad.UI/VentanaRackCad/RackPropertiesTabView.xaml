<UserControl x:Class="RackCad.UI.VentanaRackCad.RackPropertiesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RackCad.UI.VentanaRackCad"
             FontFamily="Segoe UI"
             FontSize="12">
    <!-- The tab «Propiedades» of an editor of the RackCad window (cuarta tanda, va; VA-07, VA-08): the custom properties of the rack, as a
         draft of the editor written by its «Actualizar». Views with different properties are unified into the draft from the view chosen,
         after a confirmation. The data context is a RackPropertiesTabViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <Style x:Key="OptionalText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="6">
        <TextBlock x:Name="ReadOnlyText" Text="{Binding ReadOnlyText}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
        <StackPanel x:Name="DivergentPanel" Visibility="{Binding IsDivergent, Converter={StaticResource FlagToVisibility}}">
            <Border Padding="8" BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource ShellStatusWarningBrush}" Background="{DynamicResource ShellSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Las vistas de este rack tienen propiedades distintas" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                               Text="No hay una colección del rack que editar. Revisa el contenido de cada vista y, si quieres, unifícalas desde la que elijas: todas pasarán a tener el de esa vista." />
                </StackPanel>
            </Border>
            <TextBlock Text="Contenido de cada vista" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,6" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <ItemsControl x:Name="ViewsList" ItemsSource="{Binding Views}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:RackPropertiesSourceItem}">
                        <DockPanel Margin="0,0,0,4">
                            <RadioButton DockPanel.Dock="Right" Content="Usar esta" GroupName="UnifySource" Margin="8,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding IsChosen, Mode=OneWay}" IsEnabled="{Binding CanBeSource}"
                                         AutomationProperties.Name="{Binding AutomationName}" Checked="OnSourceChecked" />
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox x:Name="ConfirmBox" Margin="0,6,0,0" IsChecked="{Binding Confirmed, Mode=TwoWay}" IsEnabled="{Binding CanConfirm}"
                      AutomationProperties.Name="Confirmar que revisé el contenido de cada vista">
                <TextBlock TextWrapping="Wrap" Text="He revisado el contenido de cada vista y entiendo que todas pasarán a tener el de la vista elegida." />
            </CheckBox>
            <Button x:Name="UnifyButton" Content="Unificar en el borrador" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanUnify}" AutomationProperties.Name="Unificar las vistas en el borrador"
                    Click="OnUnifyClick" />
            <TextBlock x:Name="UnifyWhy" Text="{Binding UnifyWhy}" Style="{StaticResource OptionalText}" Margin="0,4,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Visibility="{Binding IsNotDivergent, Converter={StaticResource FlagToVisibility}}">
            <TextBlock x:Name="UnifiedText" Text="{Binding UnifiedText}" Style="{StaticResource OptionalText}" Margin="0,0,0,6" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <local:CustomPropertiesTableView x:Name="Table" />
        </StackPanel>
    </StackPanel>
</UserControl>
