<UserControl x:Class="RackCad.UI.VentanaRackCad.CustomPropertiesTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RackCad.UI.VentanaRackCad"
             FontFamily="Segoe UI"
             FontSize="12">
    <!-- A table of custom properties (cuarta tanda, va): name, value of several lines, its state and «Quitar», by row, and «Nueva propiedad».
         The data context is an ICustomPropertiesTable. What is written goes to the draft when the box is left; nothing here writes the drawing. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <Style x:Key="OptionalText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="Root">
        <WrapPanel>
            <TextBlock Text="{Binding PropertiesTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,4,8,6" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <TextBlock x:Name="CountText" Text="{Binding PropertiesCount}" Margin="0,6,8,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            <Button x:Name="AddButton" Content="Nueva propiedad" Margin="0,2,0,4" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding CanAddProperty}" AutomationProperties.Name="Nueva propiedad" Click="OnAddClick" />
        </WrapPanel>
        <TextBlock x:Name="NoteText" Text="{Binding PropertiesNote}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Nombre" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Valor" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Estado y quitar" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
        </Grid>
        <ItemsControl x:Name="Rows" ItemsSource="{Binding Properties}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:CustomPropertyRowItem}">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBox Padding="4,3" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding DataContext.CanEditProperties, ElementName=Root, Converter={x:Static local:CustomPropertiesTableView.Not}}"
                                     AutomationProperties.Name="{Binding NameAutomationName}" LostFocus="OnBoxLostFocus" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="{Binding NameError}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource ShellStatusErrorBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBox Padding="4,3" MinHeight="40" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding DataContext.CanEditProperties, ElementName=Root, Converter={x:Static local:CustomPropertiesTableView.Not}}"
                                     AutomationProperties.Name="{Binding ValueAutomationName}" LostFocus="OnBoxLostFocus" />
                            <TextBlock Text="{Binding ValueError}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource ShellStatusErrorBrush}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Tag}" FontStyle="Italic" Margin="0,4,8,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <Button Content="Quitar" Padding="8,2" Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding DataContext.CanEditProperties, ElementName=Root}"
                                    AutomationProperties.Name="{Binding RemoveAutomationName}" Click="OnRemoveClick" />
                        </WrapPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="vacío / sin propiedades" Margin="0,6,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                   Visibility="{Binding HasNoProperties, Converter={StaticResource FlagToVisibility}}" />
        <TextBlock x:Name="RemovedText" Text="{Binding PropertiesRemovedText}" Style="{StaticResource OptionalText}" Margin="0,6,0,0"
                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
        <TextBlock Text="{Binding PropertiesHelp}" Style="{StaticResource OptionalText}" Margin="0,6,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
    </StackPanel>
</UserControl>
