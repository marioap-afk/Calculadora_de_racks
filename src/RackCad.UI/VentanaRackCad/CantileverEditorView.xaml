<UserControl x:Class="RackCad.UI.VentanaRackCad.CantileverEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RackCad.UI.VentanaRackCad"
             AutomationProperties.Name="Editor de Cantilever"
             FontFamily="Segoe UI"
             FontSize="12"
             Background="{DynamicResource WindowBackgroundBrush}">
    <!-- T5 ct (I-64, fifth batch; prototype «cantilever», CT-01..CT-12): the editor of ONE Cantilever line in the RackCad window, with the tabs
         Línea, Brazos (the first one), Componentes, Arriostramiento and Propiedades. The same styles and tokens as the editors of Selectivo,
         Dinámico and Cabecera; what is written in a field goes to the draft when the field is left or with Enter. Nothing is modal: the four
         configurators of the classic editor are panels of «Componentes», the section is searched in a list inside the page, and every question
         is inline. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <Style x:Key="OptionalText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReservedText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Hidden" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="GroupTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
            </Style>
            <Style x:Key="HeadButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Margin" Value="0,12,8,4" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Margin" Value="0,0,6,4" />
                <Setter Property="Padding" Value="10,3" />
            </Style>
            <Style x:Key="QuestionPanel" TargetType="Border">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
            </Style>
            <!-- A row of a list (a section of the catalogue, «Ir a …»): its content stretched to the left (F-3 of the smoke). -->
            <Style x:Key="RowButton" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- One segment of a choice: marked when it is the value of the draft. -->
            <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Padding" Value="10,3" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <ItemsPanelTemplate x:Key="WrapItems">
                <WrapPanel />
            </ItemsPanelTemplate>
            <DataTemplate DataType="{x:Type local:DynamicFieldItem}">
                <StackPanel Width="200" Margin="0,0,12,10">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <TextBox Padding="4,3" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 AutomationProperties.Name="{Binding Label}"
                                 AutomationProperties.HelpText="{Binding Hint}"
                                 KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" />
                    </DockPanel>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource OptionalText}" FontStyle="Italic"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellStatusErrorBrush}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:CantileverChoiceItem}">
                <StackPanel MinWidth="200" MaxWidth="420" Margin="0,0,12,10">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                    <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Options}" IsEnabled="{Binding IsEnabled}"
                                  ItemsPanel="{StaticResource WrapItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Style="{StaticResource SegmentButton}" Click="OnChoiceOptionClick"
                                        AutomationProperties.Name="{Binding AutomationName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource OptionalText}" FontStyle="Italic"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellStatusErrorBrush}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:CabeceraCheckItem}">
                <StackPanel Width="200" Margin="0,16,12,10">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                              AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellStatusErrorBrush}" />
                </StackPanel>
            </DataTemplate>
            <!-- CT-04: the section is searched in a list inside the page (no drop-down, O-D of Selectivo); the id goes in the help. -->
            <DataTemplate DataType="{x:Type local:CantileverSectionPickerItem}">
                <StackPanel Width="260" Margin="0,0,12,10">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                    <DockPanel Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Content="{Binding ToggleText}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                IsEnabled="{Binding IsEnabled}" Click="OnPickerToggleClick"
                                AutomationProperties.Name="{Binding Label, StringFormat={}Elegir la sección: {0}}" />
                        <TextBlock Text="{Binding ShownText}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding SectionId}"
                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource OptionalText}" FontStyle="Italic"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellStatusErrorBrush}" />
                    <Border Margin="0,4,0,0" Padding="6" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource ShellBorderBrush}"
                            Visibility="{Binding IsOpen, Converter={StaticResource FlagToVisibility}}">
                        <StackPanel>
                            <TextBox Padding="4,3" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding Label, StringFormat={}Buscar la sección: {0}}" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" Margin="0,2,0,2" FontSize="11" />
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Click="OnSectionChoiceClick" ToolTip="{Binding Id}"
                                                    AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding Id}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Family}" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Designation}" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- The status band: what the line is. -->
        <Border DockPanel.Dock="Bottom" Padding="12,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ShellBorderBrush}"
                Background="{DynamicResource ShellSurfaceBrush}">
            <TextBlock x:Name="StatusLineText" Text="{Binding StatusLine}" Style="{StaticResource Muted}" />
        </Border>

        <!-- The head of the line: name, state, the writes, «Descartar», «Restaurar layout…», «Cerrar el editor» and «Más». -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ShellBorderBrush}"
                Background="{DynamicResource ShellSurfaceBrush}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Nombre de la línea" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <TextBox x:Name="NameBox" Width="220" Padding="4,3" AutomationProperties.Name="Nombre de la línea"
                                 AutomationProperties.HelpText="{Binding NamePlaceholder}" ToolTip="{Binding NamePlaceholder}"
                                 IsReadOnly="{Binding IsNameReadOnly}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <Border Margin="0,14,12,4" Padding="8,2" CornerRadius="8" BorderThickness="1" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    </Border>
                    <Button x:Name="UpdateButton" Content="Actualizar" Margin="0,12,8,4" Padding="14,4" VerticalAlignment="Top"
                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanUpdate}"
                            Visibility="{Binding ShowInsertView, Converter={StaticResource FlagToVisibility}}"
                            AutomationProperties.Name="Actualizar el dibujo con la línea" Click="OnUpdateClick" />
                    <Button x:Name="InsertNewButton" Content="Insertar en el dibujo…" Margin="0,12,8,4" Padding="14,4" VerticalAlignment="Top"
                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanOpenInsertPanel}"
                            Visibility="{Binding IsNewRack, Converter={StaticResource FlagToVisibility}}"
                            AutomationProperties.ItemStatus="{Binding InsertPanelStatus}"
                            AutomationProperties.Name="Insertar la línea nueva en el dibujo" Click="OnInsertViewClick" />
                    <Button x:Name="InsertViewButton" Content="Insertar vista…" Style="{StaticResource HeadButton}" IsEnabled="{Binding CanOpenInsertPanel}"
                            Visibility="{Binding ShowInsertView, Converter={StaticResource FlagToVisibility}}"
                            AutomationProperties.ItemStatus="{Binding InsertPanelStatus}"
                            ToolTip="Escribe el borrador en las vistas del dibujo y después inserta las vistas que elijas, enlazadas a la línea."
                            AutomationProperties.Name="Insertar vistas de la línea" Click="OnInsertViewClick" />
                    <Button x:Name="DiscardButton" Content="Descartar" Style="{StaticResource HeadButton}" IsEnabled="{Binding CanDiscard}"
                            AutomationProperties.Name="Descartar el borrador de la línea" Click="OnDiscardClick" />
                    <Button x:Name="RestoreButton" Content="Restaurar layout…" Style="{StaticResource HeadButton}" IsEnabled="{Binding CanRestore}"
                            AutomationProperties.Name="Restaurar el layout de la línea" Click="OnRestoreClick" />
                    <Button x:Name="CloseEditorButton" Content="Cerrar el editor" Style="{StaticResource HeadButton}" IsEnabled="{Binding CanEdit}"
                            AutomationProperties.Name="Cerrar el editor de esta línea" Click="OnCloseEditorClick" />
                    <StackPanel x:Name="MoreBlock" Margin="0,12,8,4" VerticalAlignment="Top">
                        <Button x:Name="MoreButton" Content="Más" Padding="12,4" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="Más acciones de la línea" AutomationProperties.ItemStatus="{Binding MoreItemStatus}"
                                Click="OnMoreClick" />
                        <Border x:Name="MorePanel" Margin="0,4,0,0" Padding="6" BorderThickness="1" CornerRadius="4" MaxWidth="280"
                                BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}"
                                Visibility="{Binding IsMoreOpen, Converter={StaticResource FlagToVisibility}}">
                            <StackPanel>
                                <!-- Correction 6 of the review: an entry of «Más» reads from the left (the row template; SecondaryButtonStyle centers). -->
                                <Button x:Name="SaveToLibraryButton" Content="Guardar en biblioteca…" HorizontalContentAlignment="Left" Padding="10,3"
                                        Style="{StaticResource RowButton}" BorderBrush="{DynamicResource ShellBorderBrush}"
                                        AutomationProperties.Name="Guardar la línea en la biblioteca de diseños"
                                        Click="OnSaveToLibraryClick" />
                                <TextBlock x:Name="SaveToLibraryBlockedText" Text="{Binding SaveToLibraryBlockedText}" Style="{StaticResource OptionalText}"
                                           Margin="0,4,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="SubLineText" Text="{Binding SubLine}" Style="{StaticResource Muted}" />
                <TextBlock x:Name="DiffText" Text="{Binding DiffText}" Style="{StaticResource Muted}" />
                <TextBlock x:Name="UpdateBlockedText" Text="{Binding UpdateBlockedText}" Style="{StaticResource ReservedText}"
                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                <TextBlock x:Name="WritingText" Text="{Binding WritingText}" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{DynamicResource ShellStatusWarningBrush}"
                           Visibility="{Binding IsWriting, Converter={StaticResource FlagToVisibility}}" />
                <TextBlock x:Name="MessageText" Text="{Binding Message}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                            <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- T6 st (O-5, M-16): «El dibujo cambió desde que se leyó», «Volver a leer del dibujo» and the question of «Actualizar». -->
                <local:RackEditorDrawingChangePanel x:Name="DrawingChangePanel" DataContext="{Binding DrawingChange}" />
                <!-- «Cerrar el editor» with changes: the inline question. -->
                <Border x:Name="CloseConfirmPanel" Style="{StaticResource QuestionPanel}"
                        Visibility="{Binding IsConfirmingClose, Converter={StaticResource FlagToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding CloseQuestion}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="CloseYesButton" Content="Descartar y cerrar" Style="{StaticResource SmallButton}"
                                    AutomationProperties.Name="Descartar los cambios y cerrar el editor" Click="OnCloseYesClick" />
                            <Button x:Name="CloseNoButton" Content="Cancelar" Style="{StaticResource SmallButton}"
                                    AutomationProperties.Name="Cancelar el cierre del editor" Click="OnCloseNoClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- «Restaurar layout…» (CT-07): the boxes, all marked, what is lost and «Restaurar lo marcado». -->
                <Border x:Name="RestorePanel" Style="{StaticResource QuestionPanel}"
                        Visibility="{Binding IsRestoreOpen, Converter={StaticResource FlagToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Restaurar layout: lo marcado vuelve a la regla en el borrador. «Descartar» lo deshace." TextWrapping="Wrap"
                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <ItemsControl x:Name="RestoreBoxList" ItemsSource="{Binding RestoreBoxes}" Margin="0,6,0,0" ItemsPanel="{StaticResource WrapItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                              Margin="0,0,14,4" AutomationProperties.Name="{Binding Label, StringFormat={}Restaurar: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="LossToggleButton" Content="{Binding LossCountText}" HorizontalAlignment="Left" Style="{StaticResource SmallButton}"
                                AutomationProperties.Name="Ver lo que se pierde al restaurar" Click="OnLossToggleClick" />
                        <ItemsControl ItemsSource="{Binding LossLines}" Visibility="{Binding IsLossOpen, Converter={StaticResource FlagToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay, StringFormat={}• {0}}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="RestoreConfirmButton" Content="Restaurar lo marcado" Style="{StaticResource SmallButton}" IsEnabled="{Binding CanRestoreMarked}"
                                    AutomationProperties.Name="Restaurar lo marcado del layout" Click="OnRestoreConfirmClick" />
                            <Button x:Name="RestoreCancelButton" Content="Cancelar" Style="{StaticResource SmallButton}"
                                    AutomationProperties.Name="Cancelar la restauración del layout" Click="OnRestoreCancelClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- CT-05: what the line lacks, each with «Ir a …». -->
                <Border x:Name="MissingPanel" Style="{StaticResource QuestionPanel}" Visibility="{Binding HasMissing, Converter={StaticResource FlagToVisibility}}">
                    <StackPanel>
                        <TextBlock x:Name="MissingTitle" Text="{Binding MissingTitle}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <ItemsControl x:Name="MissingList" ItemsSource="{Binding MissingItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,0">
                                        <Button DockPanel.Dock="Right" Content="{Binding GoLabel}" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                Click="OnMissingGoClick" AutomationProperties.Name="{Binding AutomationName}" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- «Insertar vista…» (DG-01 to DG-08): the reusable panel of the views. -->
                <ScrollViewer x:Name="InsertPanelScroll" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsInsertPanelOpen, Converter={StaticResource FlagToVisibility}}">
                    <local:RackViewInsertPanelView x:Name="InsertPanelView" DataContext="{Binding InsertPanel}" Inserting="OnInsertPanelInserting" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Margin="8,6,8,8">
            <!-- Línea: «Lo esencial» of the whole line, the computed values, the levels and the drawing folded. -->
            <TabItem x:Name="LineTab" Header="Línea">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <TextBlock Text="Lo esencial" Style="{StaticResource GroupTitle}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                   Text="Escribe en toda la línea. El brazo de una celda, en «Brazos»; el detalle de cada pieza, en «Componentes»." />
                        <TextBlock Text="Estructura" Style="{StaticResource GroupTitle}" />
                        <ItemsControl x:Name="StructureList" ItemsSource="{Binding StructureItems}" ItemsPanel="{StaticResource WrapItems}" />
                        <TextBlock Text="Caras y altura" Style="{StaticResource GroupTitle}" />
                        <ItemsControl x:Name="FaceList" ItemsSource="{Binding FaceItems}" ItemsPanel="{StaticResource WrapItems}" />
                        <TextBlock Text="Piezas mínimas" Style="{StaticResource GroupTitle}" />
                        <ItemsControl x:Name="PieceList" ItemsSource="{Binding PieceItems}" ItemsPanel="{StaticResource WrapItems}" />
                        <TextBlock Text="Calculado" Style="{StaticResource GroupTitle}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4" Text="Lo que resuelve la línea con el borrador. Las cotas de nivel, en otra entrega." />
                        <ItemsControl x:Name="CalcList" ItemsSource="{Binding CalcItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4" MaxWidth="560" HorizontalAlignment="Left">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Margin="16,0,0,0"
                                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource OptionalText}" FontStyle="Italic" FontSize="11"
                                                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander x:Name="LevelsExpander" Margin="0,10,0,0" Header="{Binding LevelsSummary}" AutomationProperties.Name="Niveles"
                                  IsExpanded="{Binding LevelsOpen, Mode=TwoWay}">
                            <ItemsControl x:Name="LevelList" Margin="0,6,0,0" ItemsSource="{Binding LevelItems}" ItemsPanel="{StaticResource WrapItems}" />
                        </Expander>
                        <Expander x:Name="DrawingExpander" Margin="0,10,0,0" Header="{Binding DrawingSummary}" AutomationProperties.Name="Dibujo">
                            <StackPanel>
                                <ItemsControl x:Name="DrawingList" ItemsSource="{Binding DrawingItems}" ItemsPanel="{StaticResource WrapItems}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Se guardan con la línea y cambian la planta del dibujo; no cambian el BOM. Por omisión, apagadas (ronda 3 de I-37D)." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Brazos (the first tab): the compact matrix and the inspector of the selection. -->
            <TabItem x:Name="ArmsTab" Header="Brazos">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="ArmsGrid" Margin="10" SizeChanged="OnArmsGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="InspectorRow" Height="0" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="MatrixPanel">
                            <TextBlock x:Name="MatrixTitle" Text="{Binding MatrixTitle}" Style="{StaticResource GroupTitle}" Margin="0,0,0,4" />
                            <CheckBox x:Name="DetailCheck" Content="Ver detalle en celdas" IsChecked="{Binding ShowCellDetail, Mode=TwoWay}" Margin="0,0,0,6"
                                      AutomationProperties.Name="Ver la sección en las celdas" />
                            <ScrollViewer x:Name="MatrixScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SelectAllButton" Content="Todo" Width="64" Height="28" Margin="0,0,2,2" Style="{StaticResource SecondaryButtonStyle}"
                                        IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Seleccionar toda la línea" Click="OnSelectAllClick" />
                                <ItemsControl x:Name="ColumnHeadList" ItemsSource="{Binding ColumnHeads}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Title}" Width="60" Height="28" Margin="0,0,2,2" Style="{StaticResource SecondaryButtonStyle}"
                                                    AutomationProperties.Name="{Binding AutomationName}" Click="OnStationHeadClick" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                                <ItemsControl x:Name="MatrixRowList" ItemsSource="{Binding MatrixRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Label}" Width="64" Height="38" Margin="0,0,2,2" Style="{StaticResource SecondaryButtonStyle}"
                                                        AutomationProperties.Name="{Binding AutomationName}" Click="OnLevelHeadClick" />
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="60" MinHeight="38" Margin="0,0,2,2" Padding="2" Click="OnCellClick"
                                                                    AutomationProperties.Name="{Binding AccessibleText}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                                                                        <TextBlock Text=" E" FontWeight="Bold" Foreground="{DynamicResource ShellStatusInfoBrush}"
                                                                                   Visibility="{Binding HasException, Converter={StaticResource FlagToVisibility}}" />
                                                                        <TextBlock Text=" T" FontWeight="Bold" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                                                                   Visibility="{Binding HasStop, Converter={StaticResource FlagToVisibility}}" />
                                                                        <TextBlock Text=" •" FontWeight="Bold" Foreground="{DynamicResource ShellStatusWarningBrush}"
                                                                                   Visibility="{Binding IsModified, Converter={StaticResource FlagToVisibility}}" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Detail}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                                                               Visibility="{Binding DataContext.ShowCellDetail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource FlagToVisibility}}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="11"
                                       Text="La celda dice la longitud de corte de su brazo, en pulgadas. «E»: con excepción · «T»: placa con tope · «•»: cambiada en el borrador." />
                            <TextBlock Text="Brazo por omisión" Style="{StaticResource GroupTitle}" />
                            <TextBlock x:Name="DefaultArmSummaryText" Text="{Binding DefaultArmSummary}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                            <TextBlock Text="{Binding DefaultArmText}" Style="{StaticResource Muted}" />
                            <Button x:Name="GoDefaultArmButton" Content="Cambiar el brazo por omisión" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Style="{StaticResource SmallButton}" AutomationProperties.Name="Cambiar el brazo por omisión en Componentes" Click="OnGoDefaultArmClick" />
                        </StackPanel>
                        <StackPanel x:Name="InspectorPanel" Grid.Column="1" Width="420" Margin="10,0,0,0">
                            <TextBlock x:Name="InspectorTitle" Text="{Binding InspectorTitle}" Style="{StaticResource GroupTitle}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TargetText}" Style="{StaticResource Muted}" />
                            <ContentControl x:Name="ScopeHost" Content="{Binding ScopeChoice}" Margin="0,6,0,0" Focusable="False" />
                            <TextBlock Text="Brazo de la selección" Style="{StaticResource GroupTitle}" />
                            <ItemsControl x:Name="InspectorList" ItemsSource="{Binding InspectorItems}" ItemsPanel="{StaticResource WrapItems}" />
                            <Expander x:Name="PlateExpander" Header="Placa de montaje" Margin="0,4,0,0" AutomationProperties.Name="Placa de montaje de la selección">
                                <ItemsControl ItemsSource="{Binding InspectorPlateItems}" ItemsPanel="{StaticResource WrapItems}" Margin="0,6,0,0" />
                            </Expander>
                            <Expander x:Name="EndExpander" Header="Placa de extremo" Margin="0,4,0,0" AutomationProperties.Name="Placa de extremo de la selección">
                                <ItemsControl ItemsSource="{Binding InspectorEndItems}" ItemsPanel="{StaticResource WrapItems}" Margin="0,6,0,0" />
                            </Expander>
                            <TextBlock x:Name="ExceptionText" Text="{Binding ExceptionText}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                            <Button x:Name="RestoreCellsButton" Content="Volver al brazo por omisión" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Style="{StaticResource SmallButton}" IsEnabled="{Binding CanRestoreCells}"
                                    AutomationProperties.Name="Volver al brazo por omisión en la selección" Click="OnRestoreCellsClick" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="11"
                                       Text="Una excepción igual al brazo por omisión no se guarda. Lo que escribes va al borrador al salir del campo o con Enter." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Componentes (CT-03): the four configurators of the classic editor as panels, without «Aceptar» or «Cancelar». -->
            <TabItem x:Name="ComponentsTab" Header="Componentes">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <ItemsControl x:Name="ComponentTabList" ItemsSource="{Binding ComponentTabs}" ItemsPanel="{StaticResource WrapItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SegmentButton}" Click="OnComponentTabClick" AutomationProperties.Name="{Binding AutomationName}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text=" ●" Foreground="{DynamicResource ShellStatusErrorBrush}"
                                                       Visibility="{Binding HasError, Converter={StaticResource FlagToVisibility}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ComponentTitle" Text="{Binding ComponentTitle}" Style="{StaticResource GroupTitle}" />
                        <TextBlock Text="{Binding ComponentSubtitle}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                        <StackPanel x:Name="ColumnPanel" Visibility="{Binding ShowColumnPanel, Converter={StaticResource FlagToVisibility}}">
                            <TextBlock Text="Columna" Style="{StaticResource GroupTitle}" />
                            <ItemsControl ItemsSource="{Binding ColumnItems}" ItemsPanel="{StaticResource WrapItems}" />
                            <TextBlock Text="Base" Style="{StaticResource GroupTitle}" />
                            <ItemsControl ItemsSource="{Binding BaseItems}" ItemsPanel="{StaticResource WrapItems}" />
                            <TextBlock Text="Espesores de la base" Style="{StaticResource GroupTitle}" />
                            <ItemsControl ItemsSource="{Binding BaseThicknessItems}" ItemsPanel="{StaticResource WrapItems}" />
                            <Expander Header="Troqueles" Margin="0,6,0,0" AutomationProperties.Name="Troqueles de la columna">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding PunchItems}" ItemsPanel="{StaticResource WrapItems}" Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="No hay márgenes de extremo que escribir: el patrón conserva todos los agujeros enteros que caben. La altura de la columna la decide la línea («Línea» › «Altura de columna»)." />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel x:Name="ArmPanel" Visibility="{Binding ShowArmPanel, Converter={StaticResource FlagToVisibility}}">
                            <TextBlock Text="Cuerpo" Style="{StaticResource GroupTitle}" />
                            <ItemsControl ItemsSource="{Binding DefaultArmBodyItems}" ItemsPanel="{StaticResource WrapItems}" />
                            <TextBlock Text="Placa de montaje" Style="{StaticResource GroupTitle}" />
                            <ItemsControl ItemsSource="{Binding DefaultArmPlateItems}" ItemsPanel="{StaticResource WrapItems}" />
                            <TextBlock Text="Placa de extremo" Style="{StaticResource GroupTitle}" />
                            <ItemsControl ItemsSource="{Binding DefaultArmEndItems}" ItemsPanel="{StaticResource WrapItems}" />
                            <TextBlock Text="{Binding ColumnReferenceText}" Style="{StaticResource Muted}" />
                        </StackPanel>
                        <StackPanel x:Name="SeparatorPanel" Visibility="{Binding ShowSeparatorPanel, Converter={StaticResource FlagToVisibility}}">
                            <ItemsControl ItemsSource="{Binding SeparatorItems}" ItemsPanel="{StaticResource WrapItems}" />
                            <TextBlock Text="{Binding SeparatorNote}" Style="{StaticResource Muted}" />
                        </StackPanel>
                        <StackPanel x:Name="BracePanel" Visibility="{Binding ShowBracePanel, Converter={StaticResource FlagToVisibility}}">
                            <ItemsControl ItemsSource="{Binding BraceItems}" ItemsPanel="{StaticResource WrapItems}" />
                            <TextBlock Text="{Binding BraceNote}" Style="{StaticResource Muted}" />
                        </StackPanel>
                        <TextBlock Text="Receta" Style="{StaticResource GroupTitle}" />
                        <ItemsControl x:Name="RecipeList" ItemsSource="{Binding Recipe}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,1" Foreground="{DynamicResource ShellTextPrimaryBrush}">
                                        <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Diagnóstico" Style="{StaticResource GroupTitle}" />
                        <TextBlock Text="{Binding ComponentOkText}" Style="{StaticResource Muted}"
                                   Visibility="{Binding ComponentResolves, Converter={StaticResource FlagToVisibility}}" />
                        <ItemsControl x:Name="ComponentDiagnosticList" ItemsSource="{Binding ComponentDiagnostics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneWay, StringFormat={}• {0}}" TextWrapping="Wrap" Foreground="{DynamicResource ShellStatusErrorBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Pieza suelta" Style="{StaticResource GroupTitle}" />
                        <TextBlock x:Name="PieceNoteText" Text="{Binding PieceNote}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Arriostramiento (CT-10): the panels, the derived values and the sequence of one interval, automatic or advanced. -->
            <TabItem x:Name="BracingTab" Header="Arriostramiento">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <TextBlock Text="Paneles" Style="{StaticResource GroupTitle}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="BracingList" ItemsSource="{Binding BracingItems}" ItemsPanel="{StaticResource WrapItems}" />
                        <TextBlock x:Name="DerivedText" Text="{Binding DerivedText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <DockPanel Margin="0,4,0,0">
                            <Button x:Name="GoSeparatorButton" DockPanel.Dock="Right" Content="Cambiar en «Componentes»" Style="{StaticResource SmallButton}"
                                    AutomationProperties.Name="Cambiar el separador o el tensor en Componentes" Click="OnGoSeparatorClick" />
                            <TextBlock Text="{Binding PiecesText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Secuencia de un intervalo" Style="{StaticResource GroupTitle}" />
                        <ContentControl x:Name="LayoutHost" Content="{Binding LayoutChoice}" Focusable="False" />
                        <TextBlock Text="{Binding LayoutHint}" Style="{StaticResource Muted}" />
                        <Border x:Name="ToAutomaticPanel" Style="{StaticResource QuestionPanel}"
                                Visibility="{Binding IsAskingToAutomatic, Converter={StaticResource FlagToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ToAutomaticText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button x:Name="ToAutomaticYesButton" Content="Volver a la regla" Style="{StaticResource SmallButton}"
                                            AutomationProperties.Name="Volver la secuencia a la regla" Click="OnToAutomaticYesClick" />
                                    <Button x:Name="ToAutomaticNoButton" Content="Cancelar" Style="{StaticResource SmallButton}"
                                            AutomationProperties.Name="Seguir con la secuencia avanzada" Click="OnLayoutQuestionNoClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RecoverPanel" Style="{StaticResource QuestionPanel}"
                                Visibility="{Binding IsAskingRecover, Converter={StaticResource FlagToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding RecoverText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button x:Name="RecoverButton" Content="Recuperar mis tramos" Style="{StaticResource SmallButton}"
                                            AutomationProperties.Name="Recuperar los tramos guardados" Click="OnRecoverClick" />
                                    <Button x:Name="StartFromRuleButton" Content="Empezar desde la regla" Style="{StaticResource SmallButton}"
                                            AutomationProperties.Name="Empezar la secuencia avanzada desde la regla" Click="OnStartFromRuleClick" />
                                    <Button x:Name="RecoverNoButton" Content="Cancelar" Style="{StaticResource SmallButton}"
                                            AutomationProperties.Name="Seguir con la secuencia automática" Click="OnLayoutQuestionNoClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SequenceMessage}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource ShellTextSecondaryBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding SequenceTop}" FontWeight="SemiBold" Margin="0,6,0,2" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <ItemsControl x:Name="SequenceList" ItemsSource="{Binding SequenceItems}" AutomationProperties.Name="Secuencia del intervalo de arriba abajo">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,1" Padding="6,2" BorderThickness="2,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBraced}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="AdvancedPanel" Margin="0,8,0,0" Visibility="{Binding IsAdvanced, Converter={StaticResource FlagToVisibility}}">
                            <TextBlock Text="Tramos (de abajo arriba)" Style="{StaticResource GroupTitle}" />
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="1" Text="Desde (in)" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="2" Text="Hasta (in)" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="3" Text="Alto" Style="{StaticResource Muted}" />
                                <TextBlock Grid.Column="4" Text="Con tensores" Style="{StaticResource Muted}" />
                            </Grid>
                            <ItemsControl x:Name="SegmentList" ItemsSource="{Binding SegmentRows}" IsEnabled="{Binding CanEditSegments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Margin="0,0,6,0" Padding="3,2" Text="{Binding From, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{Binding FromName}" />
                                            <TextBox Grid.Column="2" Margin="0,0,6,0" Padding="3,2" Text="{Binding To, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{Binding ToName}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Height}" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="4" IsChecked="{Binding Braced, Mode=TwoWay}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding BracedName}" />
                                            <WrapPanel Grid.Column="5">
                                                <Button Content="Dividir" Style="{StaticResource SmallButton}" Click="OnSplitSegmentClick"
                                                        AutomationProperties.Name="{Binding SplitName}" />
                                                <Button Content="Quitar" Style="{StaticResource SmallButton}" Click="OnRemoveSegmentClick"
                                                        AutomationProperties.Name="{Binding RemoveName}" />
                                            </WrapPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="AddSegmentButton" Content="Agregar tramo arriba" Style="{StaticResource SmallButton}" IsEnabled="{Binding CanEditSegments}"
                                        AutomationProperties.Name="Agregar un tramo arriba" Click="OnAddSegmentClick" />
                                <Button x:Name="ApplySegmentsButton" Content="Aplicar secuencia" Style="{StaticResource SmallButton}" IsEnabled="{Binding CanApplySegments}"
                                        AutomationProperties.Name="Aplicar la secuencia al borrador" Click="OnApplySegmentsClick" />
                                <Button x:Name="DiscardSegmentsButton" Content="Descartar cambios de la tabla" Style="{StaticResource SmallButton}" IsEnabled="{Binding CanApplySegments}"
                                        AutomationProperties.Name="Descartar los cambios de la tabla de tramos" Click="OnDiscardSegmentsClick" />
                            </WrapPanel>
                            <TextBlock x:Name="SegmentErrorText" Text="{Binding SegmentError}" Style="{StaticResource OptionalText}"
                                       Foreground="{DynamicResource ShellStatusErrorBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- VA-07: the tab «Propiedades» at the end of the editor: the custom properties of the rack, written by «Actualizar». -->
            <TabItem x:Name="RackPropertiesTabItem" Header="{Binding PropertiesTab.TabHeader}" AutomationProperties.Name="Propiedades">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <local:RackPropertiesTabView x:Name="RackPropertiesView" DataContext="{Binding PropertiesTab}" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
