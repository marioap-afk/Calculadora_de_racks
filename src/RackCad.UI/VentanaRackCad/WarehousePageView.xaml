<UserControl x:Class="RackCad.UI.VentanaRackCad.WarehousePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Almacén"
             FontFamily="Segoe UI"
             FontSize="12"
             Background="{DynamicResource WindowBackgroundBrush}">
    <!-- T5 al (I-64 A-14, line D; prototype «almacen»): the page «Almacén» of the RackCad window, RACKLAYOUT and RACKRELLENAR without a modal.
         The result and the scheme are computed here; AutoCAD reads the planta and the site (RACKALMACENLEER, no undo marker) and places
         only with «Colocar» (RACKALMACENCOLOCAR, one «U»). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <Style x:Key="OptionalText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PageText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,12,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
            <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
            </Style>
            <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
            </Style>
            <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Background" Value="{DynamicResource ShellWindowBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ShellStatusWarningBrush}" />
            </Style>
            <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
            </Style>
            <Style x:Key="Banner" TargetType="Border">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
            </Style>
            <Style x:Key="BannerTitle" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
            <Style x:Key="BannerText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Margin" Value="0,6,8,0" />
            </Style>
            <Style x:Key="HeadButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="8,0,0,4" />
            </Style>
            <Style x:Key="FieldBox" TargetType="TextBox">
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="MinWidth" Value="80" />
            </Style>
            <!-- A tab or a segmented choice: a flat button whose chosen state is set by its own trigger. -->
            <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
            <!-- The chip of the state of the reading, as the chips of the BOM page. -->
            <Style x:Key="ChipDot" TargetType="Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{DynamicResource ShellTextSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ChipKind}" Value="Limpio">
                        <Setter Property="Fill" Value="{DynamicResource ShellStatusSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ChipKind}" Value="Modificado">
                        <Setter Property="Fill" Value="{DynamicResource ShellStatusWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ChipKind}" Value="Escribiendo">
                        <Setter Property="Fill" Value="{DynamicResource ShellStatusInfoBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ChipKind}" Value="Error">
                        <Setter Property="Fill" Value="{DynamicResource ShellStatusErrorBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- One line of «Resultado»: an error, a warning or a note. -->
            <Style x:Key="ProblemBorder" TargetType="Border">
                <Setter Property="BorderThickness" Value="3,0,0,0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- A square of the scheme (and of its legend), by what it is. -->
            <Style x:Key="CellShape" TargetType="Rectangle">
                <Setter Property="RadiusX" Value="3" />
                <Setter Property="RadiusY" Value="3" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Fill" Value="{DynamicResource ShellSurfaceBrush}" />
                <Setter Property="Stroke" Value="{DynamicResource ShellStatusInfoBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Seed">
                        <Setter Property="Fill" Value="{DynamicResource ShellStatusInfoBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Out">
                        <Setter Property="Stroke" Value="{DynamicResource ShellStatusErrorBrush}" />
                        <Setter Property="StrokeDashArray" Value="3 2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Off">
                        <Setter Property="Stroke" Value="{DynamicResource ShellTextSecondaryBrush}" />
                        <Setter Property="StrokeDashArray" Value="3 2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Col">
                        <Setter Property="Fill" Value="{DynamicResource ShellSelectionPrimaryBrush}" />
                        <Setter Property="Stroke" Value="{DynamicResource ShellStatusWarningBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Seed">
                        <Setter Property="Foreground" Value="{DynamicResource ShellSurfaceBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Out">
                        <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Off">
                        <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,10">
            <!-- The head: the title, the chip of the reading and the three actions. -->
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button x:Name="PlaceButton" Content="{Binding PlaceText}" IsEnabled="{Binding CanPlace}" Padding="12,4" Margin="8,0,0,4"
                            Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Colocar los racks en el dibujo"
                            ToolTip="AutoCAD vuelve a leer la planta (y el sitio) y coloca lo que muestra el esquema. Un «U» lo deshace." Click="OnPlaceClick" />
                    <Button x:Name="ReadButton" Content="Volver a leer" IsEnabled="{Binding CanRead}" Style="{StaticResource HeadButton}"
                            AutomationProperties.Name="Volver a leer la planta y el sitio" Click="OnReadClick" />
                    <Button x:Name="ResetButton" Content="Restablecer valores" IsEnabled="{Binding CanReset}" Style="{StaticResource HeadButton}"
                            AutomationProperties.Name="Restablecer los valores de las ventanas clásicas" Click="OnResetClick" />
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Almacén" FontSize="18" FontWeight="SemiBold" Margin="0,0,10,4" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    <Border x:Name="ChipBorder" BorderThickness="1" CornerRadius="10" Padding="8,1" Margin="0,0,0,4" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource ChipDot}" />
                            <TextBlock x:Name="ChipText" Text="{Binding ChipText}" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </DockPanel>
            <TextBlock x:Name="PlaceBlockedText" Text="{Binding PlaceBlockedText}" Style="{StaticResource PageText}" />
            <TextBlock Style="{StaticResource PageText}"
                       Text="Replica la planta de un rack del dibujo en una rejilla, o rellena un área con ella. Lo que escribes aquí no toca el dibujo: AutoCAD solo coloca con «Colocar»." />

            <!-- AutoCAD writes: what it places, and «Dejar de esperar» until the command takes the request. -->
            <Border x:Name="WritingBanner" Style="{StaticResource Banner}" BorderBrush="{DynamicResource ShellStatusInfoBrush}"
                    Visibility="{Binding ShowWriting, Converter={StaticResource FlagToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Escribiendo en el dibujo" Style="{StaticResource BannerTitle}" />
                    <TextBlock x:Name="WritingText" Text="{Binding WritingText}" Style="{StaticResource BannerText}" />
                    <Button x:Name="StopWritingButton" Content="Dejar de esperar" HorizontalAlignment="Left" Style="{StaticResource SmallButton}"
                            AutomationProperties.Name="Dejar de esperar a AutoCAD (Almacén)"
                            Visibility="{Binding CanStopWriting, Converter={StaticResource FlagToVisibility}}" Click="OnStopWaitingClick" />
                    <TextBlock Text="{Binding WritingNote}" Style="{StaticResource FieldHint}" />
                </StackPanel>
            </Border>

            <!-- A grid that leaves its building asks in line (inventory §4, question 5 of RACKLAYOUT). -->
            <Border x:Name="FitQuestionBanner" Style="{StaticResource Banner}" BorderBrush="{DynamicResource ShellStatusWarningBrush}"
                    Visibility="{Binding ShowFitQuestion, Converter={StaticResource FlagToVisibility}}">
                <StackPanel>
                    <TextBlock Text="La rejilla no cabe en el edificio" Style="{StaticResource BannerTitle}" />
                    <TextBlock x:Name="FitQuestionText" Text="{Binding FitQuestionText}" Style="{StaticResource BannerText}" />
                    <WrapPanel>
                        <Button x:Name="PlaceAnywayButton" Content="Colocar de todos modos" Style="{StaticResource SmallButton}"
                                AutomationProperties.Name="Colocar la rejilla de todos modos" Click="OnPlaceAnywayClick" />
                        <Button x:Name="KeepAdjustingButton" Content="Seguir ajustando" Style="{StaticResource SmallButton}"
                                AutomationProperties.Name="Seguir ajustando la rejilla" Click="OnKeepAdjustingClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="StaleBanner" Style="{StaticResource Banner}" BorderBrush="{DynamicResource ShellStatusWarningBrush}"
                    Visibility="{Binding ShowStale, Converter={StaticResource FlagToVisibility}}">
                <StackPanel>
                    <TextBlock Text="El dibujo cambió desde la lectura" Style="{StaticResource BannerTitle}" />
                    <TextBlock Style="{StaticResource BannerText}"
                               Text="El esquema puede no estar al día. «Colocar» vuelve a leer antes de escribir: si la planta o el sitio cambiaron, no coloca nada y lo dice." />
                    <Button x:Name="ReadNowButton" Content="Volver a leer ahora" HorizontalAlignment="Left" Style="{StaticResource SmallButton}"
                            IsEnabled="{Binding CanRead}" AutomationProperties.Name="Volver a leer la planta ahora" Click="OnReadClick" />
                </StackPanel>
            </Border>

            <Border x:Name="MessageBanner" Style="{StaticResource Banner}" Visibility="{Binding HasMessage, Converter={StaticResource FlagToVisibility}}">
                <DockPanel>
                    <Button x:Name="DismissMessageButton" DockPanel.Dock="Right" Content="Cerrar aviso" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                            VerticalAlignment="Top" AutomationProperties.Name="Cerrar el aviso de Almacén" Click="OnDismissMessageClick" />
                    <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- The two tabs (today RACKLAYOUT and RACKRELLENAR), each marked when it has problems. -->
            <WrapPanel x:Name="TabsPanel" Margin="0,4,0,4">
                <Button x:Name="GridTabButton" Click="OnGridTabClick" AutomationProperties.Name="Pestaña Rejilla">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGridTab}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Rejilla" VerticalAlignment="Center" />
                        <TextBlock Text="hoy RACKLAYOUT" FontSize="10" FontWeight="Normal" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <TextBlock x:Name="GridTabProblems" Text="(con problemas)" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShellStatusErrorBrush}"
                                   Visibility="{Binding GridTabHasProblems, Converter={StaticResource FlagToVisibility}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="FillTabButton" Click="OnFillTabClick" AutomationProperties.Name="Pestaña Rellenar un área">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFillTab}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Rellenar un área" VerticalAlignment="Center" />
                        <TextBlock Text="hoy RACKRELLENAR" FontSize="10" FontWeight="Normal" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <TextBlock x:Name="FillTabProblems" Text="(con problemas)" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShellStatusErrorBrush}"
                                   Visibility="{Binding FillTabHasProblems, Converter={StaticResource FlagToVisibility}}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <TextBlock Text="{Binding TabNote}" Style="{StaticResource PageText}" />

            <Grid x:Name="ColumnsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FormColumn" Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============================ the values ============================ -->
                <StackPanel x:Name="FormPanel" Grid.Column="0" Grid.Row="0">
                    <TextBlock Text="Rack semilla" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="Rack" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SeedCombo" DisplayMemberPath="Label" SelectedValuePath="RackId"
                              IsEnabled="{Binding IsEditable}" AutomationProperties.Name="Rack semilla" SelectionChanged="OnSeedSelectionChanged" />
                    <TextBlock x:Name="NoPlantaText" Text="{Binding NoPlantaText}" Style="{StaticResource FieldHint}" />
                    <TextBlock x:Name="SeedLineText" Text="{Binding SeedLine}" Style="{StaticResource OptionalText}" Margin="0,6,0,0"
                               Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    <TextBlock x:Name="SeedProblemText" Text="{Binding SeedProblem}" Style="{StaticResource ErrorText}" />
                    <TextBlock x:Name="DraftWarningText" Text="{Binding DraftWarning}" Style="{StaticResource NoteText}" />
                    <TextBlock x:Name="MultiWarningText" Text="{Binding MultiWarning}" Style="{StaticResource NoteText}" />
                    <TextBlock x:Name="InsideWarningText" Text="{Binding InsideWarning}" Style="{StaticResource NoteText}" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                               Text="La huella es el rectángulo de la planta, con sus cotas y textos. Para girar la rejilla, gira la planta en el dibujo y vuelve a leer." />

                    <!-- Rejilla (RACKLAYOUT) -->
                    <StackPanel x:Name="GridSection" Visibility="{Binding IsGridTab, Converter={StaticResource FlagToVisibility}}">
                        <TextBlock Text="Rejilla" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="Filas (racks en paralelo)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RowsBox" Style="{StaticResource FieldBox}" IsEnabled="{Binding IsEditable}"
                                         Text="{Binding RowsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filas (racks en paralelo)" />
                                <TextBlock Text="{Binding RowsError}" Style="{StaticResource FieldError}" />
                                <TextBlock Text="A, B, C… a lo profundo (X)." Style="{StaticResource FieldHint}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Columnas (a lo largo de la hilera)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ColsBox" Style="{StaticResource FieldBox}" IsEnabled="{Binding IsEditable}"
                                         Text="{Binding ColsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Columnas (a lo largo de la hilera)" />
                                <TextBlock Text="{Binding ColsError}" Style="{StaticResource FieldError}" />
                                <TextBlock Text="1, 2, 3… a lo largo (Y)." Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="GridErrorText" Text="{Binding GridError}" Style="{StaticResource ErrorText}" />
                    </StackPanel>

                    <!-- Sitio (RACKRELLENAR) -->
                    <StackPanel x:Name="SiteSection" Visibility="{Binding IsFillTab, Converter={StaticResource FlagToVisibility}}">
                        <TextBlock Text="Sitio" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Capa del sitio" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="LayerCombo" IsEnabled="{Binding IsEditable}"
                                  AutomationProperties.Name="Capa del sitio" SelectionChanged="OnLayerSelectionChanged" />
                        <TextBlock Text="Las capas del dibujo, leídas por la puerta. Al cambiarla se lee su contorno." Style="{StaticResource FieldHint}" />
                        <TextBlock x:Name="SiteLineText" Text="{Binding SiteLine}" Style="{StaticResource OptionalText}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <TextBlock x:Name="SiteErrorText" Text="{Binding SiteError}" Style="{StaticResource ErrorText}" />
                        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,8"
                                   Text="El contorno es la polilínea cerrada más grande de la capa; sus arcos se muestrean en 16 cuerdas. Lo demás de la capa (círculos, rectángulos, bloques) son columnas u obstáculos, por su rectángulo envolvente; líneas, textos y cotas se ignoran." />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="Holgura a muros" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="in" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                    <TextBox x:Name="WallBox" Style="{StaticResource FieldBox}" IsEnabled="{Binding IsEditable}"
                                             Text="{Binding WallClearanceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Holgura a muros (in)" />
                                </DockPanel>
                                <TextBlock Text="{Binding WallClearanceError}" Style="{StaticResource FieldError}" />
                                <TextBlock Text="Distancia mínima de cada rack al contorno." Style="{StaticResource FieldHint}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Holgura a columnas" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="in" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                    <TextBox x:Name="ColumnClearanceBox" Style="{StaticResource FieldBox}" IsEnabled="{Binding IsEditable}"
                                             Text="{Binding ColumnClearanceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Holgura a columnas (in)" />
                                </DockPanel>
                                <TextBlock Text="{Binding ColumnClearanceError}" Style="{StaticResource FieldError}" />
                                <TextBlock Text="Alrededor del rectángulo de cada obstáculo." Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Pasillos (the two tabs, question 11) -->
                    <WrapPanel>
                        <TextBlock Text="Pasillos" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Valen para las dos pestañas." Style="{StaticResource FieldHint}" Margin="8,14,0,0" />
                    </WrapPanel>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Text="Pasillo entre filas" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="in" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                <TextBox x:Name="AisleRowsBox" Style="{StaticResource FieldBox}" IsEnabled="{Binding IsEditable}"
                                         Text="{Binding AisleRowsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pasillo entre filas (in)" />
                            </DockPanel>
                            <TextBlock Text="{Binding AisleRowsError}" Style="{StaticResource FieldError}" />
                            <TextBlock Text="De picking: entre las caras, a lo profundo (X)." Style="{StaticResource FieldHint}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Pasillo entre columnas" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="in" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                <TextBox x:Name="AisleColsBox" Style="{StaticResource FieldBox}" IsEnabled="{Binding IsEditable}"
                                         Text="{Binding AisleColsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pasillo entre columnas (in)" />
                            </DockPanel>
                            <TextBlock Text="{Binding AisleColsError}" Style="{StaticResource FieldError}" />
                            <TextBlock Text="A lo largo (Y)." Style="{StaticResource FieldHint}" />
                        </StackPanel>
                    </UniformGrid>
                    <CheckBox x:Name="BackToBackCheck" Content="Filas espalda con espalda (pasillo solo entre pares)" Margin="0,2,0,6"
                              IsChecked="{Binding BackToBack}" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="Filas espalda con espalda" />
                    <StackPanel Margin="0,0,0,4" HorizontalAlignment="Left" MinWidth="190">
                        <TextBlock Text="Hueco entre espaldas" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="in" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <TextBox x:Name="BackGapBox" Style="{StaticResource FieldBox}" IsEnabled="{Binding BackGapEnabled}"
                                     Text="{Binding BackGapText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hueco entre espaldas (in)" />
                        </DockPanel>
                        <TextBlock Text="{Binding BackGapError}" Style="{StaticResource FieldError}" />
                        <TextBlock Text="{Binding BackGapHint}" Style="{StaticResource FieldHint}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,2,0,6"
                               Text="Las filas van de dos en dos y comparten el hueco; el pasillo va solo entre pares. La fila pareja no se espejea: conserva la orientación de la semilla. Una última fila impar queda sola." />
                    <StackPanel Visibility="{Binding IsFillTab, Converter={StaticResource FlagToVisibility}}">
                        <CheckBox x:Name="TryRotatedCheck" Content="Probar también la orientación girada 90° (se usa la que quepa más)"
                                  IsChecked="{Binding TryRotatedShown}" IsEnabled="{Binding TryRotatedEnabled}"
                                  AutomationProperties.Name="Probar también la orientación girada 90 grados" />
                        <TextBlock x:Name="RotatedHintText" Text="{Binding RotatedHint}" Style="{StaticResource FieldHint}" />
                    </StackPanel>

                    <!-- Copias -->
                    <TextBlock Text="Copias" Style="{StaticResource SectionTitle}" />
                    <WrapPanel Visibility="{Binding IsGridTab, Converter={StaticResource FlagToVisibility}}" Margin="0,0,0,6">
                        <Button x:Name="LinkedButton" Content="Enlazadas" IsEnabled="{Binding IsEditable}" Click="OnLinkedClick"
                                AutomationProperties.Name="Copias enlazadas">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLinked}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="IndependentButton" Content="Independientes" IsEnabled="{Binding IsEditable}" Click="OnIndependentClick"
                                AutomationProperties.Name="Copias independientes">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIndependent}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="CopyText" Text="{Binding CopyText}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    <TextBlock Text="Cada rack lleva su etiqueta (A1, B1…) en la capa RACKCAD_LAYOUT." Style="{StaticResource FieldHint}" Margin="0,4,0,0" />

                    <!-- Verificar encaje (RACKLAYOUT) -->
                    <StackPanel Visibility="{Binding IsGridTab, Converter={StaticResource FlagToVisibility}}" Margin="0,12,0,0">
                        <Button x:Name="FitToggleButton" Click="OnFitToggleClick" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Verificar encaje (opcional)" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4">
                            <TextBlock>
                                <Run Text="Verificar encaje (opcional)" FontWeight="SemiBold" />
                                <Run Text=" · " />
                                <Run Text="{Binding FitSummary, Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                        <StackPanel x:Name="FitPanel" Visibility="{Binding FitOpen, Converter={StaticResource FlagToVisibility}}" Margin="0,8,0,0">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,8">
                                    <TextBlock Text="Edificio a lo profundo, donde crecen las filas (X)" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="in" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                        <TextBox x:Name="BuildingXBox" Style="{StaticResource FieldBox}" IsEnabled="{Binding IsEditable}"
                                                 Text="{Binding BuildingXText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Edificio a lo profundo (X, in)" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding BuildingXError}" Style="{StaticResource FieldError}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Edificio a lo largo, donde crecen las columnas (Y)" Style="{StaticResource FieldLabel}" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="in" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                        <TextBox x:Name="BuildingYBox" Style="{StaticResource FieldBox}" IsEnabled="{Binding IsEditable}"
                                                 Text="{Binding BuildingYText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Edificio a lo largo (Y, in)" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding BuildingYError}" Style="{StaticResource FieldError}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="Vacíos, no se verifica. La esquina del edificio es la de la planta semilla, y la rejilla crece hacia +X y +Y desde ella. Solo se miran los bordes: sin holguras ni columnas (eso es «Rellenar un área»)." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ============================ the result and the scheme ============================ -->
                <Border x:Name="ResultBorder" Grid.Column="1" Grid.Row="0" BorderThickness="1,0,0,0" Padding="16,0,0,0" Margin="16,0,0,0"
                        BorderBrush="{DynamicResource ShellBorderBrush}">
                    <StackPanel x:Name="ResultPanel">
                        <TextBlock Text="Resultado" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="StatList" ItemsSource="{Binding Stats}" Focusable="False" AutomationProperties.Name="Resultado"
                                      Visibility="{Binding HasStats, Converter={StaticResource FlagToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel MinWidth="120" MaxWidth="200" Margin="0,0,18,10" AutomationProperties.Name="{Binding AutomationName}">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                        <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Hint}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="ProblemList" ItemsSource="{Binding Problems}" Focusable="False" AutomationProperties.Name="Problemas"
                                      Visibility="{Binding HasProblems, Converter={StaticResource FlagToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProblemBorder}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="Esquema" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Una casilla por rack; no está a escala." Style="{StaticResource FieldHint}" Margin="8,14,0,0" />
                        </WrapPanel>
                        <ItemsControl x:Name="LegendList" ItemsSource="{Binding Legend}" Focusable="False" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                                        <Rectangle Width="12" Height="12" Style="{StaticResource CellShape}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Text}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="SchemeBox" BorderThickness="1" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource ShellBorderBrush}"
                                Background="{DynamicResource ShellSurfaceBrush}" Visibility="{Binding HasScheme, Converter={StaticResource FlagToVisibility}}">
                            <ScrollViewer x:Name="SchemeScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                                <StackPanel x:Name="SchemePanel" Orientation="Horizontal" AutomationProperties.Name="{Binding SchemeName}">
                                    <!-- The numbers of the columns, going up, and room for the letters under the rows. -->
                                    <StackPanel Margin="0,0,8,0">
                                        <ItemsControl ItemsSource="{Binding SchemeNumbers}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}" Height="{Binding Height}" MinWidth="18" TextAlignment="Right" FontSize="11"
                                                                   Padding="0,4,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                                        <Rectangle Height="{Binding GapBelow}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Rectangle Height="22" />
                                    </StackPanel>
                                    <ItemsControl x:Name="SchemeStripList" ItemsSource="{Binding SchemeStrips}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <Grid Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Tip}"
                                                                              AutomationProperties.Name="{Binding Tip}">
                                                                            <Rectangle Style="{StaticResource CellShape}" />
                                                                            <TextBlock Text="{Binding Text}" Style="{StaticResource CellText}" />
                                                                        </Grid>
                                                                        <Rectangle Height="{Binding GapBelow}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Height="18"
                                                                   Margin="0,4,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Rectangle Width="{Binding GapAfter}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="SchemeNoteText" Text="{Binding SchemeNote}" Style="{StaticResource FieldHint}" Margin="0,6,0,0" />
                        <TextBlock x:Name="NoSchemeText" Text="{Binding NoSchemeText}" Style="{StaticResource PageText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
