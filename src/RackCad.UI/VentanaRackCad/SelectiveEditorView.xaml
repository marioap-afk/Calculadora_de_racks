<UserControl x:Class="RackCad.UI.VentanaRackCad.SelectiveEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RackCad.UI.VentanaRackCad"
             AutomationProperties.Name="Editor de Selectivo"
             FontFamily="Segoe UI"
             FontSize="12"
             Background="{DynamicResource WindowBackgroundBrush}">
    <!-- The editor of ONE Selectivo rack in the RackCad window (I-64 A-14, line D, Selectivo E1-B), with the tabs Rack, Matriz and Avanzado
         and no preview (decision 11). The same styles, tokens and controls of the shell as the editor of Dinámico. What is written in a field
         goes to the draft when the field is left or with Enter; the scope is the fondos of the view and the selection of the matrix. Nothing
         here writes the drawing: «Actualizar» hands the draft to the host. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <Style x:Key="OptionalText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- O-8 of the smoke of Dinámico: an empty line keeps its height (hidden, not collapsed), so the content below does not move. -->
            <Style x:Key="ReservedText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Hidden" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="GroupTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
            <!-- One field of the draft: label, box with its unit, «Varía» (or why it is read only) and the error. -->
            <DataTemplate DataType="{x:Type local:DynamicFieldItem}">
                <StackPanel Width="190" Margin="0,0,12,10">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <TextBox Padding="4,3" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 AutomationProperties.Name="{Binding Label}"
                                 KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" />
                    </DockPanel>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource OptionalText}" FontStyle="Italic"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellStatusErrorBrush}" />
                </StackPanel>
            </DataTemplate>
            <!-- One value chosen from a list of the catalog: label, list, «Varía» and the error. -->
            <DataTemplate DataType="{x:Type local:SelectiveChoiceItem}">
                <StackPanel Width="190" Margin="0,0,12,10">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <ComboBox Margin="0,2,0,0" ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedValue, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                              AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource OptionalText}" FontStyle="Italic"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellStatusErrorBrush}" />
                </StackPanel>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="WrapItems">
                <WrapPanel />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- The head of the rack: name, state, and the one «Actualizar». -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ShellBorderBrush}"
                Background="{DynamicResource ShellSurfaceBrush}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Nombre del rack" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <TextBox x:Name="NameBox" Width="220" Padding="4,3" AutomationProperties.Name="Nombre del rack"
                                 IsReadOnly="{Binding IsNameReadOnly}"
                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <Border Margin="0,14,12,4" Padding="8,2" CornerRadius="8" BorderThickness="1" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    </Border>
                    <Button x:Name="UpdateButton" Content="Actualizar" Margin="0,12,8,4" Padding="14,4" VerticalAlignment="Top"
                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanUpdate}"
                            AutomationProperties.Name="Actualizar el dibujo con el borrador" Click="OnUpdateClick" />
                    <Button x:Name="DiscardButton" Content="Descartar" Margin="0,12,8,4" Padding="12,4" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanDiscard}"
                            AutomationProperties.Name="Descartar el borrador" Click="OnDiscardClick" />
                    <Button x:Name="CloseEditorButton" Content="Cerrar el editor" Margin="0,12,8,4" Padding="12,4" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanClose}"
                            AutomationProperties.Name="Cerrar el editor de este rack" Click="OnCloseEditorClick" />
                </WrapPanel>
                <!-- «Cerrar el editor» with changes: the inline question, with what is lost. -->
                <Border x:Name="CloseConfirmPanel" Margin="0,6,0,0" Padding="8" BorderThickness="1"
                        BorderBrush="{DynamicResource ShellStatusWarningBrush}"
                        Visibility="{Binding IsConfirmingClose, Converter={StaticResource FlagToVisibility}}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                   Text="El borrador tiene cambios que no están en el dibujo. Si cierras el editor, se pierden. ¿Descartarlos y cerrar?" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="CloseYesButton" Content="Descartar y cerrar" Margin="0,0,6,0" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseYesClick" />
                            <Button x:Name="CloseNoButton" Content="Cancelar" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseNoClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="UpdateBlockedText" Text="{Binding UpdateBlockedText}" Style="{StaticResource ReservedText}"
                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                <TextBlock x:Name="MessageText" Text="{Binding Message}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                            <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Margin="8,6,8,8">
            <!-- Rack: «Lo esencial» (the rack and the fondos of the view), the computed values, and the post and annotations folded. -->
            <TabItem x:Name="RackTab" Header="Rack">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <TextBlock Text="Lo esencial" Style="{StaticResource GroupTitle}" Margin="0,0,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   Text="Escribe en todo el rack; los frentes y las profundidades, en los fondos de la vista. Fondo = cada línea en profundidad; profundidad = la medida. Para un frente, un nivel o una celda, usa «Matriz»." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding HasFondos, Converter={StaticResource FlagToVisibility}}">
                            <TextBlock Text="Fondos de la vista:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <ComboBox x:Name="RackFondoScopeBox" MinWidth="160" ItemsSource="{Binding FondoOptions}"
                                      SelectedIndex="{Binding FondoScopeIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Fondos de la vista en la pestaña Rack" />
                        </StackPanel>
                        <ItemsControl x:Name="EssentialsList" ItemsSource="{Binding Essentials}" ItemsPanel="{StaticResource WrapItems}" />
                        <StackPanel Visibility="{Binding HasFondos, Converter={StaticResource FlagToVisibility}}">
                            <TextBlock Text="Separaciones entre fondos" FontWeight="SemiBold" Margin="0,2,0,4"
                                       Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                            <ItemsControl x:Name="SeparatorList" ItemsSource="{Binding SeparatorFields}" ItemsPanel="{StaticResource WrapItems}" />
                        </StackPanel>
                        <TextBlock Text="Calculado" Style="{StaticResource GroupTitle}" />
                        <ItemsControl x:Name="CalculatedList" ItemsSource="{Binding Calculated}" MaxWidth="520" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- O-6 of the smoke of Dinámico: the value keeps a gap from its label, and a long label wraps. -->
                                    <DockPanel Margin="0,1">
                                        <TextBlock x:Name="CalculatedValue" Text="{Binding Value}" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="16,0,0,0"
                                                   TextWrapping="Wrap" MaxWidth="300" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                        <TextBlock x:Name="CalculatedLabel" Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander x:Name="PostExpander" Header="Poste y anotaciones" Margin="0,12,0,0" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox x:Name="BasePlateCheck" Content="Dibujar placa base" Margin="0,2" IsChecked="{Binding DrawBasePlate, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <CheckBox Content="Numerar frentes" Margin="0,2" IsChecked="{Binding NumberFronts, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <CheckBox Content="Numerar niveles" Margin="0,2" IsChecked="{Binding NumberLevels, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <CheckBox Content="Colocar nombre de rack" Margin="0,2" IsChecked="{Binding DrawRackName, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <!-- Decision 10: an option of the drawing, with its note. -->
                                <CheckBox x:Name="DrawPalletsCheck" Content="Mostrar tarimas" Margin="0,2,0,0" IsChecked="{Binding DrawPallets, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <TextBlock Margin="20,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                           Text="Solo en la frontal, como referencia visual; no entra en el BOM." />
                                <ItemsControl x:Name="AnnotationList" ItemsSource="{Binding AnnotationFields}" ItemsPanel="{StaticResource WrapItems}" />
                                <TextBlock Text="Mostrar cotas en:" Margin="0,0,0,2" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                <WrapPanel>
                                    <CheckBox Content="Frontal" Margin="0,2,12,2" IsChecked="{Binding DimensionsFrontal, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                    <CheckBox Content="Lateral" Margin="0,2,12,2" IsChecked="{Binding DimensionsLateral, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                    <CheckBox Content="Planta" Margin="0,2,12,2" IsChecked="{Binding DimensionsPlanta, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Matriz: the matrix front × level (the pallet, width × height, decision 1) over the fondos of the view, and the inspector. -->
            <TabItem x:Name="MatrixTab" Header="Matriz">
                <!-- Wide, the inspector goes beside the matrix; narrow, below it (O-3 of the smoke of Dinámico): see OnMatrixTabSizeChanged. -->
                <Grid x:Name="MatrixTabGrid" Margin="8" SizeChanged="OnMatrixTabSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition x:Name="InspectorColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="InspectorRow" Height="0" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Column="0" LastChildFill="True">
                        <!-- Decision 2: «Todos los fondos / Fondo 1 / Fondo n»; what is seen is where it is written. -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                                    Visibility="{Binding HasFondos, Converter={StaticResource FlagToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Fondos de la vista:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                <ComboBox x:Name="FondoScopeBox" MinWidth="160" ItemsSource="{Binding FondoOptions}"
                                          SelectedIndex="{Binding FondoScopeIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="Fondos de la vista" />
                            </StackPanel>
                            <TextBlock x:Name="FondoScopeText" Text="{Binding FondoScopeText}" Style="{StaticResource OptionalText}" Margin="0,4,0,0"
                                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   Text="Cada celda muestra la tarima: ancho × alto (in). Clic: una celda · Mayús+clic: rango · Ctrl+clic: añadir o quitar. F1…, N1… y «Todo» seleccionan la columna, la fila o todo. ½: medio frente. La raya inferior en N1: la tarima en el piso, sin larguero." />
                        <CheckBox x:Name="ShowDetailCheck" DockPanel.Dock="Top" Margin="0,0,0,6" Content="Ver detalle en celdas (tarimas por nivel y peralte)"
                                  IsChecked="{Binding ShowDetail, Mode=TwoWay}" />
                        <ScrollViewer x:Name="MatrixScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SelectAllButton" Content="Todo" Width="48" Margin="0,0,2,2" Padding="2"
                                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Seleccionar todo el rack"
                                            Click="OnSelectAllClick" />
                                    <ItemsControl x:Name="ColumnHeads" ItemsSource="{Binding Columns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="70" Margin="0,0,2,2" Padding="2" Content="{Binding Title}" Click="OnColumnClick"
                                                        AutomationProperties.Name="{Binding AccessibleText}" ToolTip="{Binding AccessibleText}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPartial}" Value="True">
                                                                    <Setter Property="FontStyle" Value="Italic" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl x:Name="MatrixRows" ItemsSource="{Binding Rows}" AutomationProperties.Name="Matriz frente por nivel">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="48" Margin="0,0,2,2" Padding="2" Content="{Binding Label}"
                                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnRowClick"
                                                        AutomationProperties.Name="{Binding Label}" />
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="70" MinHeight="32" Margin="0,0,2,2" Padding="2" Click="OnCellClick"
                                                                    IsEnabled="{Binding Exists}"
                                                                    AutomationProperties.Name="{Binding Text}"
                                                                    AutomationProperties.HelpText="{Binding AccessibleText}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource ShellSelectionIncludedBrush}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource ShellSelectionPrimaryBrush}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Varies}" Value="True">
                                                                                <Setter Property="FontStyle" Value="Italic" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <Grid Width="62">
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Detail}" HorizontalAlignment="Center" FontSize="10"
                                                                                   Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                                                                   Visibility="{Binding ShowDetail, Converter={StaticResource FlagToVisibility}}" />
                                                                    </StackPanel>
                                                                    <!-- Decision 4: the floor line of N1 with no «Larguero a piso» (the pallet on the floor). -->
                                                                    <Border x:Name="FloorLine" Height="3" VerticalAlignment="Bottom" Margin="-2,0,-2,-2"
                                                                            Background="{DynamicResource ShellTextSecondaryBrush}" ToolTip="En el piso, sin larguero"
                                                                            Visibility="{Binding IsOnFloor, Converter={StaticResource FlagToVisibility}}" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- The inspector of the selection: what is written goes to every selected cell (or front) of the fondos of the view. -->
                    <Border x:Name="InspectorPanel" Grid.Column="1" Width="420" Margin="10,0,0,0" Padding="10" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="InspectorTitle" Text="{Binding InspectorTitle}" Style="{StaticResource GroupTitle}" Margin="0,0,0,6" />
                                <TextBlock x:Name="InspectorNote" Text="{Binding InspectorNote}" Style="{StaticResource OptionalText}" Margin="0,0,0,6"
                                           Foreground="{DynamicResource ShellStatusWarningBrush}" />
                                <TextBlock Text="Tarima y larguero de la selección" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <ItemsControl x:Name="CellFieldList" ItemsSource="{Binding CellFields}" ItemsPanel="{StaticResource WrapItems}" />
                                <TextBlock Text="Frentes de la selección" FontWeight="SemiBold" Margin="0,6,0,4"
                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <!-- S-20: with fronts that differ the box is indeterminate and says «varía»; a click puts it in all of them (the draft). -->
                                <CheckBox x:Name="FloorBeamCheck" Content="{Binding SelectionFloorBeamLabel}" Margin="0,0,0,8" IsThreeState="False"
                                          IsChecked="{Binding SelectionFloorBeam, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                                          AutomationProperties.Name="Larguero a piso en los frentes de la selección" />
                                <ItemsControl x:Name="FrontFieldList" ItemsSource="{Binding FrontFields}" ItemsPanel="{StaticResource WrapItems}" />

                                <!-- Decision 7: the tramos of «medio frente» here, with no dialog; the column of the matrix carries «½». -->
                                <TextBlock Text="Medio frente" FontWeight="SemiBold" Margin="0,6,0,4" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <TextBlock x:Name="SegmentNoteText" Text="{Binding SegmentNote}" Style="{StaticResource OptionalText}" Margin="0,0,0,4"
                                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                <ItemsControl x:Name="SegmentList" ItemsSource="{Binding SegmentRows}" IsEnabled="{Binding CanChangeSegments}"
                                              AutomationProperties.Name="Tramos del frente">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Title}" Width="66" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                <TextBox Width="80" Padding="4,3" Text="{Binding LengthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="{Binding Title}"
                                                         Visibility="{Binding HasLength, Converter={StaticResource FlagToVisibility}}" />
                                                <TextBlock Width="80" Text="(resto)" VerticalAlignment="Center" ToolTip="El último tramo se calcula: lo que sobra del frente."
                                                           Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                                           Visibility="{Binding IsRest, Converter={StaticResource FlagToVisibility}}" />
                                                <CheckBox Content="con largueros" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Loaded, Mode=TwoWay}" />
                                                <Button Content="Quitar" Margin="10,0,0,0" Padding="8,1" Style="{StaticResource SecondaryButtonStyle}"
                                                        AutomationProperties.Name="Quitar este tramo" Click="OnRemoveSegmentClick" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SegmentErrorText" Text="{Binding SegmentError}" Style="{StaticResource OptionalText}" Margin="0,2,0,0"
                                           Foreground="{DynamicResource ShellStatusErrorBrush}" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Button x:Name="StartSegmentsButton" Content="Partir en tramos" Margin="0,0,6,4" Padding="10,3"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanStartSegments}" Click="OnStartSegmentsClick" />
                                    <Button x:Name="AddSegmentButton" Content="+ Agregar tramo" Margin="0,0,6,4" Padding="10,3"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanChangeSegments}" Click="OnAddSegmentClick" />
                                    <Button x:Name="ApplySegmentsButton" Content="Aplicar tramos" Margin="0,0,6,4" Padding="10,3"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanChangeSegments}" Click="OnApplySegmentsClick" />
                                    <!-- S-21: the tramos written and not applied go back to those of the front in the draft. -->
                                    <Button x:Name="DiscardSegmentsButton" Content="Descartar tramos" Margin="0,0,6,4" Padding="10,3"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanDiscardSegments}" Click="OnDiscardSegmentsClick" />
                                    <Button x:Name="ClearSegmentsButton" Content="Sin medio frente" Margin="0,0,6,4" Padding="10,3"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEditSegments}" Click="OnClearSegmentsClick" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Avanzado: the own peralte of each post and its cabecera (seen, edited in the classic editor), and the fronts in tramos. -->
            <TabItem x:Name="AdvancedTab" Header="Avanzado">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <TextBlock Text="Postes y cabeceras" Style="{StaticResource GroupTitle}" Margin="0,0,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   Text="Peralte propio vacío = el del rack («Rack» › «Lo esencial»); uno igual al del rack se guarda como «el del rack»." />
                        <ItemsControl x:Name="PostRowList" ItemsSource="{Binding PostRows}" AutomationProperties.Name="Postes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Post}" Width="36" Margin="0,18,0,0" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                        <ContentPresenter DockPanel.Dock="Left" Content="{Binding Field}" />
                                        <TextBlock Text="{Binding Cabecera}" TextWrapping="Wrap" Margin="0,18,0,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   Text="Las cabeceras personalizadas se conservan y se ven aquí. Para editar una cabecera, usa RACKEDITAR (el editor clásico) mientras se migra." />
                        <TextBlock Text="Medio frente" Style="{StaticResource GroupTitle}" />
                        <TextBlock x:Name="HalfFrontsText" Text="{Binding HalfFrontsText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   Text="Los tramos se editan en «Matriz», en el inspector del frente." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
