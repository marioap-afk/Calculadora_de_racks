<UserControl x:Class="RackCad.UI.VentanaRackCad.RackCadHelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Órdenes y atajos"
             FontFamily="Segoe UI"
             FontSize="12">
    <!-- The page «Órdenes y atajos» of the RackCad window (I-64 A-14, line D, fourth batch, part «ut»; prototype «utilidades», UT-09 to UT-11),
         behind «Ayuda» of the header: the list of RACKAYUDA without blocking AutoCAD, with a search, «Ejecutar» and «En la ventana». Each
         command is a block of two or three lines, so the page reads at the width of a docked palette. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/VentanaRackCad/RackCadUtilityStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,10">
            <TextBlock Text="Órdenes y atajos" Style="{StaticResource UtPageTitle}" />
            <TextBlock Style="{StaticResource UtText}"
                       Text="Lo de RACKAYUDA, dentro de la ventana. AutoCAD sigue disponible: puedes tener esta lista abierta mientras escribes." />
            <TextBlock x:Name="HelpIntroText" Text="{Binding Help.Intro}" Style="{StaticResource UtPlain}" Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,4">
                <TextBox x:Name="HelpSearchBox" Width="260" Padding="4,3" Margin="0,0,10,4" VerticalAlignment="Center"
                         AutomationProperties.Name="Buscar orden, atajo o texto" ToolTip="Buscar orden, atajo o texto"
                         Text="{Binding Help.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock x:Name="HelpCountText" Text="{Binding Help.CountText}" VerticalAlignment="Center" Margin="0,0,0,4"
                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            </WrapPanel>

            <ItemsControl x:Name="HelpGroupList" ItemsSource="{Binding Help.Groups}" AutomationProperties.Name="Órdenes de RackCad">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource UtBlockTitle}" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="8,6" BorderThickness="1" CornerRadius="6"
                                                BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Ejecutar" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Top"
                                                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanRun}"
                                                        AutomationProperties.Name="{Binding RunAccessibleText}" Click="OnRunClick" />
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                                        <Border Style="{StaticResource UtAliasPill}"
                                                                Visibility="{Binding HasAlias, Converter={StaticResource UtFlagToVisibility}}">
                                                            <TextBlock Text="{Binding Alias}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="sin atajo" FontStyle="Italic" Foreground="{DynamicResource ShellTextSecondaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAlias}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                                    <WrapPanel Margin="0,3,0,0">
                                                        <TextBlock Text="En la ventana: " Foreground="{DynamicResource ShellTextSecondaryBrush}" VerticalAlignment="Center" />
                                                        <Button Content="{Binding WindowText}" Style="{StaticResource UtLinkButton}"
                                                                AutomationProperties.Name="{Binding WindowAccessibleText}" Click="OnWindowClick"
                                                                Visibility="{Binding HasWindowLink, Converter={StaticResource UtFlagToVisibility}}" />
                                                        <TextBlock Text="{Binding WindowText}" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                                                   Visibility="{Binding HasNoWindowLink, Converter={StaticResource UtFlagToVisibility}}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="HelpNoMatchText" Text="Ninguna orden coincide con la búsqueda." Style="{StaticResource UtPlain}"
                       Visibility="{Binding Help.NoMatch, Converter={StaticResource UtFlagToVisibility}}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource UtText}"
                       Text="No se listan las puertas de la ventana (RACKNUEVO, RACKBIBLIOTECA, RACKPANEL y las RACK…ABRIR, RACK…APLICAR de los editores): las usa la ventana. RACKAYUDA sigue abriendo su diálogo aparte." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
