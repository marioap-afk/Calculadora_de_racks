<UserControl x:Class="RackCad.UI.VentanaRackCad.DynamicEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RackCad.UI.VentanaRackCad"
             AutomationProperties.Name="Editor de Dinámico"
             FontFamily="Segoe UI"
             FontSize="12"
             Background="{DynamicResource WindowBackgroundBrush}">
    <!-- The editor of ONE Dinámico rack in the RackCad window (I-64 A-14, line D): the «versión despejada» the Owner approved, with the tabs
         Rack, Matriz, Extremos y seguridad and Avanzado. What is written in a field goes to the draft when the field is left or with Enter; the scope is the
         selection of the matrix. Nothing here writes the drawing: «Actualizar» hands the draft to the host. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <Style x:Key="OptionalText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- O-8 of the smoke: an empty line keeps its height (hidden, not collapsed), so the content below does not move. -->
            <Style x:Key="ReservedText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Hidden" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="GroupTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
            <!-- One field of the draft: label, box with its unit, «Varía» and the error. -->
            <DataTemplate x:Key="FieldTemplate">
                <StackPanel Width="190" Margin="0,0,12,10">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <DockPanel Margin="0,2,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <TextBox Padding="4,3" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 AutomationProperties.Name="{Binding Label}"
                                 KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" />
                    </DockPanel>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource OptionalText}" FontStyle="Italic"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource OptionalText}"
                               Foreground="{DynamicResource ShellStatusErrorBrush}" />
                </StackPanel>
            </DataTemplate>
            <ItemsPanelTemplate x:Key="WrapItems">
                <WrapPanel />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- The head of the rack: name, state, and the one «Actualizar». -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ShellBorderBrush}"
                Background="{DynamicResource ShellSurfaceBrush}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Nombre del rack" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <TextBox x:Name="NameBox" Width="220" Padding="4,3" AutomationProperties.Name="Nombre del rack"
                                 IsReadOnly="{Binding IsNameReadOnly}"
                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <Border Margin="0,14,12,4" Padding="8,2" CornerRadius="8" BorderThickness="1" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    </Border>
                    <!-- T6 ui (point 9): the buttons are ONE group, beside the name while they fit, or together on the next line (at about
                         950 px «Más» went alone to a second line). -->
                    <WrapPanel x:Name="HeadButtons">
                    <Button x:Name="UpdateButton" Content="Actualizar" Margin="0,12,8,4" Padding="14,4" VerticalAlignment="Top"
                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanUpdate}"
                            AutomationProperties.Name="Actualizar el dibujo con el borrador" Click="OnUpdateClick" />
                    <!-- Step 4 (decision 10 of the prototype): AutoCAD first writes the draft in the views that exist, then inserts the new ones. -->
                    <!-- T4 ins (DG-01, DG-05): it opens the panel under the head, also when the views cannot be inserted now; it is off only
                         while AutoCAD writes. -->
                    <Button x:Name="InsertViewButton" Content="{Binding InsertViewLabel}" Margin="0,12,8,4" Padding="12,4" VerticalAlignment="Top"
                            IsEnabled="{Binding CanOpenInsertPanel}"
                            ToolTip="Escribe el borrador en las vistas del dibujo y después inserta las vistas que elijas, enlazadas al rack."
                            AutomationProperties.ItemStatus="{Binding InsertPanelStatus}"
                            AutomationProperties.Name="Insertar vistas del rack" Click="OnInsertViewClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInsertPanelOpen}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="DiscardButton" Content="Descartar" Margin="0,12,8,4" Padding="12,4" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanDiscard}"
                            AutomationProperties.Name="Descartar el borrador" Click="OnDiscardClick" />
                    <Button x:Name="RestoreButton" Content="Restaurar layout…" Margin="0,12,8,4" Padding="12,4" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEdit}"
                            AutomationProperties.Name="Restaurar el layout estándar" Click="OnRestoreClick" />
                    <Button x:Name="CloseEditorButton" Content="Cerrar el editor" Margin="0,12,8,4" Padding="12,4" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEdit}"
                            AutomationProperties.Name="Cerrar el editor de este rack" Click="OnCloseEditorClick" />
                    <!-- T4 ut: «Más» (prototype «utilidades», UT-04): its entries open inline (no popup, O-D of the smoke), in a row under the head (T6 ui);
                         «Guardar en biblioteca…» takes the user to «Biblioteca de diseños» with a line for the name. -->
                    <StackPanel x:Name="MoreBlock" Margin="0,12,8,4" VerticalAlignment="Top">
                        <Button x:Name="MoreButton" Content="Más" Padding="12,4" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="Más acciones del rack" AutomationProperties.ItemStatus="{Binding MoreItemStatus}"
                                Click="OnMoreClick" />
                    </StackPanel>
                    </WrapPanel>
                </WrapPanel>
                <!-- T6 ui (correction 2 of the review): the entries of «Más» are a row of their own under the head, as the question of
                     «Cerrar el editor»: open, they no longer move the group of the buttons to another line. -->
                <Border x:Name="MorePanel" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="6" BorderThickness="1" CornerRadius="4" MaxWidth="280"
                        BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}"
                        Visibility="{Binding IsMoreOpen, Converter={StaticResource FlagToVisibility}}">
                    <StackPanel>
                        <Button x:Name="SaveToLibraryButton" Content="Guardar en biblioteca…" HorizontalContentAlignment="Left" Padding="10,3"
                                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Guardar el rack en la biblioteca de diseños"
                                Click="OnSaveToLibraryClick" />
                        <TextBlock x:Name="SaveToLibraryBlockedText" Text="{Binding SaveToLibraryBlockedText}" Style="{StaticResource OptionalText}"
                                   Margin="0,4,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <!-- «Cerrar el editor» with changes: the inline question, with what is lost. -->
                <Border x:Name="CloseConfirmPanel" Margin="0,6,0,0" Padding="8" BorderThickness="1"
                        BorderBrush="{DynamicResource ShellStatusWarningBrush}"
                        Visibility="{Binding IsConfirmingClose, Converter={StaticResource FlagToVisibility}}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                   Text="El borrador tiene cambios que no están en el dibujo. Si cierras el editor, se pierden. ¿Descartarlos y cerrar?" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="CloseYesButton" Content="Descartar y cerrar" Margin="0,0,6,0" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseYesClick" />
                            <Button x:Name="CloseNoButton" Content="Cancelar" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseNoClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- T6 st (O-5, M-16): «El dibujo cambió desde que se leyó», «Volver a leer del dibujo» and the question of «Actualizar». -->
                <local:RackEditorDrawingChangePanel x:Name="DrawingChangePanel" DataContext="{Binding DrawingChange}" />
                <TextBlock x:Name="UpdateBlockedText" Text="{Binding UpdateBlockedText}" Style="{StaticResource ReservedText}"
                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                <TextBlock x:Name="MessageText" Text="{Binding Message}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
                            <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- «Restaurar layout»: the inline confirmation, with what is lost. -->
                <Border x:Name="RestoreConfirmPanel" Margin="0,6,0,0" Padding="8" BorderThickness="1" Visibility="Collapsed"
                        BorderBrush="{DynamicResource ShellStatusWarningBrush}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                   Text="Restaurar el layout reconstruye la secuencia de módulos desde cero: se pierden las cabeceras personalizadas, los largos manuales y los separadores cambiados a mano. ¿Continuar?" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="RestoreYesButton" Content="Sí, restaurar" Margin="0,0,6,0" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OnRestoreYesClick" />
                            <Button x:Name="RestoreNoButton" Content="Cancelar" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OnRestoreNoClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <!-- T4 ins: the panel «Insertar vista…» (DG-01 to DG-08), the same view as the Selectivo (DG-07); it scrolls on its own. -->
                <ScrollViewer x:Name="InsertPanelScroll" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsInsertPanelOpen, Converter={StaticResource FlagToVisibility}}">
                    <local:RackViewInsertPanelView x:Name="InsertPanelView" DataContext="{Binding InsertPanel}" Inserting="OnInsertPanelInserting" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Margin="8,6,8,8">
            <!-- Rack: «Lo esencial» of the whole rack, the computed values, and the post and annotations folded. -->
            <TabItem x:Name="RackTab" Header="Rack">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <TextBlock Text="Lo esencial" Style="{StaticResource GroupTitle}" Margin="0,0,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   Text="Escribe en todo el rack. Para un frente, un nivel o una celda, usa «Matriz»." />
                        <ItemsControl x:Name="EssentialsList" ItemsSource="{Binding Essentials}" ItemTemplate="{StaticResource FieldTemplate}"
                                      ItemsPanel="{StaticResource WrapItems}" />
                        <TextBlock Text="Calculado" Style="{StaticResource GroupTitle}" />
                        <ItemsControl x:Name="CalculatedList" ItemsSource="{Binding Calculated}" MaxWidth="520" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- O-6 of the smoke: the value keeps a gap from its label, and a long label wraps. Guided test of the Owner
                                         (2026-11-27): with 10 fronts the value took the whole width and the label wrapped letter by letter. The label
                                         keeps its own width (up to 180) and the value takes the rest, wrapped, at the right. -->
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CalculatedLabel" Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="180"
                                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                        <TextBlock x:Name="CalculatedValue" Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" TextAlignment="Right"
                                                   HorizontalAlignment="Right" FontWeight="SemiBold" Margin="16,0,0,0" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander x:Name="PostExpander" Header="Poste y anotaciones" Margin="0,12,0,0" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding PostFields}" ItemTemplate="{StaticResource FieldTemplate}"
                                              ItemsPanel="{StaticResource WrapItems}" />
                                <CheckBox Content="Numerar frentes" Margin="0,2" IsChecked="{Binding NumberFronts, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <CheckBox Content="Numerar niveles" Margin="0,2" IsChecked="{Binding NumberLevels, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                                <CheckBox Content="Colocar nombre de rack" Margin="0,2" IsChecked="{Binding DrawRackName, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Matriz: the matrix front × level (one datum per cell: the pallet, width × height) and the inspector of the selection. -->
            <TabItem x:Name="MatrixTab" Header="Matriz">
                <!-- Wide, the inspector goes beside the matrix; narrow, below it (O-3 of the smoke): see OnMatrixTabSizeChanged. -->
                <Grid x:Name="MatrixTabGrid" Margin="8" SizeChanged="OnMatrixTabSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition x:Name="InspectorColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="InspectorRow" Height="0" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Column="0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   Text="Cada celda muestra la tarima: ancho × alto (in). Clic: una celda · Mayús+clic: rango · Ctrl+clic: añadir o quitar. F1…, N1… y «Todo» seleccionan la columna, la fila o todo." />
                        <ScrollViewer x:Name="MatrixScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SelectAllButton" Content="Todo" Width="48" Margin="0,0,2,2" Padding="2"
                                            Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Seleccionar todo el rack"
                                            Click="OnSelectAllClick" />
                                    <ItemsControl x:Name="ColumnHeads" ItemsSource="{Binding Columns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="70" Margin="0,0,2,2" Padding="2" Content="{Binding Title}"
                                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnColumnClick"
                                                        AutomationProperties.Name="{Binding Title}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl x:Name="MatrixRows" ItemsSource="{Binding Rows}" AutomationProperties.Name="Matriz frente por nivel">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Width="48" Margin="0,0,2,2" Padding="2" Content="{Binding Label}"
                                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnRowClick"
                                                        AutomationProperties.Name="{Binding Label}" />
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- A «G» in the corner: the cell carries an entrance guide (decision 6 of the prototype). -->
                                                            <Button Width="70" Height="32" Margin="0,0,2,2" Padding="2" Click="OnCellClick"
                                                                    IsEnabled="{Binding Exists}"
                                                                    AutomationProperties.Name="{Binding Text}"
                                                                    AutomationProperties.HelpText="{Binding AccessibleText}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource ShellSelectionIncludedBrush}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource ShellSelectionPrimaryBrush}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsBlankFront}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ShellTextSecondaryBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <Grid Width="62">
                                                                    <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <!-- O-7 of the smoke: an outlined badge in the color of «ok», not the color of the selection. -->
                                                                    <Border x:Name="GuideBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                                                            Padding="2,0" CornerRadius="3" BorderThickness="1" ToolTip="Guía de entrada"
                                                                            BorderBrush="{DynamicResource ShellStatusSuccessBrush}" Background="{DynamicResource ShellSurfaceBrush}"
                                                                            Visibility="{Binding HasGuide, Converter={StaticResource FlagToVisibility}}">
                                                                        <TextBlock Text="G" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ShellStatusSuccessBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- The inspector of the selection: what is written goes to every selected cell (or front). -->
                    <Border x:Name="InspectorPanel" Grid.Column="1" Width="420" Margin="10,0,0,0" Padding="10" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="InspectorTitle" Text="{Binding InspectorTitle}" Style="{StaticResource GroupTitle}" Margin="0,0,0,6" />
                                <TextBlock x:Name="InspectorNote" Text="{Binding InspectorNote}" Style="{StaticResource OptionalText}" Margin="0,0,0,6"
                                           Foreground="{DynamicResource ShellStatusWarningBrush}" />
                                <TextBlock Text="Tarima y largueros de la selección" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <ItemsControl x:Name="CellFieldList" ItemsSource="{Binding CellFields}" ItemTemplate="{StaticResource FieldTemplate}"
                                              ItemsPanel="{StaticResource WrapItems}" />
                                <!-- With a mixed selection the box is indeterminate and says so; a click puts the guide in every cell (I-01).
                                     Without an active cell in the selection it is disabled: there is nothing to write (M-01). -->
                                <CheckBox x:Name="SelectionGuideBox" Content="{Binding SelectionGuideLabel}" Margin="0,0,0,8" IsThreeState="False"
                                          IsChecked="{Binding SelectionGuide, Mode=TwoWay}" IsEnabled="{Binding CanEditSelectionGuide}"
                                          AutomationProperties.Name="Guía de entrada en las celdas de la selección" />
                                <TextBlock Text="Frentes de la selección" FontWeight="SemiBold" Margin="0,6,0,4"
                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <ItemsControl x:Name="FrontFieldList" ItemsSource="{Binding FrontFields}" ItemTemplate="{StaticResource FieldTemplate}"
                                              ItemsPanel="{StaticResource WrapItems}" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Button x:Name="BlankFrontButton" Content="Dejar el frente en blanco" Margin="0,0,6,0" Padding="10,3"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEdit}" Click="OnBlankFrontClick" />
                                    <Button x:Name="ActivateFrontButton" Content="Activar el frente" Padding="10,3"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEdit}" Click="OnActivateFrontClick" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- T4 seg (I-64, cuarta tanda; the prototype «seguridad», SG-01 to SG-07): «Extremos y seguridad» without the classic dialog. The
                 card of the guide of the entrance (its cells are chosen in «Matriz»; its head shows its family), «Seguridad por poste» EDITABLE
                 (RackCadSafetyTableView, with the defenses: an empty length is the automatic one) and «Extremos»; beside them, or below when the
                 tab is narrow, «Variante y medidas» (RackCadSafetyInspectorView). The sides are «Salida / Entrada» (SG-02). «Editar seguridad…»
                 is not offered any more; the classic dialog stays in RACKEDITAR. -->
            <TabItem x:Name="SafetyTab" Header="Extremos y seguridad">
                <Grid x:Name="SafetyLayout">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="En las celdas: frente × nivel" Style="{StaticResource GroupTitle}" Margin="0,0,0,2" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                       Text="Para elegir celdas, selecciónalas en «Matriz» y usa «Guía de entrada» del inspector. Las celdas con guía llevan una G." />
                            <Border Width="340" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="12,10" BorderThickness="1" CornerRadius="8"
                                    BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}"
                                    AutomationProperties.Name="Guía de entrada">
                                <StackPanel>
                                    <Button x:Name="GuidePickButton" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="4,2" Style="{StaticResource SecondaryButtonStyle}"
                                            AutomationProperties.Name="Guía de entrada: ver su variante y sus medidas" Click="OnGuidePickClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Margin="0,0,8,0" Padding="3,0" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                                                    BorderBrush="{DynamicResource ShellStatusSuccessBrush}">
                                                <TextBlock Text="G" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ShellStatusSuccessBrush}" />
                                            </Border>
                                            <TextBlock Text="Guía de entrada" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="GuideSummaryText" Text="{Binding GuideSummary}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                    <WrapPanel>
                                        <Button x:Name="GuideEverywhereButton" Content="En todas las celdas" Margin="0,0,6,0" Padding="10,3"
                                                Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEditGuide}"
                                                AutomationProperties.Name="Guía de entrada en todas las celdas" Click="OnGuideEverywhereClick" />
                                        <Button x:Name="GuideNowhereButton" Content="En ninguna" Padding="10,3"
                                                Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanEditGuide}"
                                                AutomationProperties.Name="Guía de entrada en ninguna celda" Click="OnGuideNowhereClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Seguridad por poste" Style="{StaticResource GroupTitle}" />
                            <TextBlock x:Name="SafetySummaryText" Text="{Binding SafetySummary}" Style="{StaticResource OptionalText}" Margin="0,0,0,6"
                                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <local:RackCadSafetyTableView x:Name="SafetyTable" DataContext="{Binding SafetyPanel}" />

                            <TextBlock Text="Extremos" Style="{StaticResource GroupTitle}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                       Text="Salida = extremo bajo · entrada = extremo alto." />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                       Text="La guía de entrada va por frente y nivel, solo en la entrada. Desviadores y defensas van en los extremos que diga su lado." />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                       Text="La pendiente y la cama de rodillos siguen en «Avanzado»." />
                        </StackPanel>
                    </ScrollViewer>
                    <local:RackCadSafetyInspectorView x:Name="SafetyInspector" Grid.Column="1" Width="380" Margin="0,10,10,10"
                                                      DataContext="{Binding SafetyPanel.Inspector}" />
                </Grid>
            </TabItem>

            <!-- Avanzado: the height, the separators, the derived post and the module sequence with Spanish labels. -->
            <TabItem x:Name="AdvancedTab" Header="Avanzado">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">
                        <ItemsControl x:Name="AdvancedFieldList" ItemsSource="{Binding AdvancedFields}" ItemTemplate="{StaticResource FieldTemplate}"
                                      ItemsPanel="{StaticResource WrapItems}" />
                        <CheckBox Content="Reforzar el poste derivado" Margin="0,2,0,8" IsChecked="{Binding DerivedPostReinforced, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                        <!-- Step 3 of Dinámico: the bed and the slope, by front (the fronts of the selection of «Matriz»). -->
                        <TextBlock Text="Cama y pendiente" Style="{StaticResource GroupTitle}" />
                        <TextBlock x:Name="BedScopeText" Text="{Binding BedScopeText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                        <ItemsControl x:Name="BedFieldList" ItemsSource="{Binding BedFields}" ItemTemplate="{StaticResource FieldTemplate}"
                                      ItemsPanel="{StaticResource WrapItems}" />
                        <TextBlock Text="Módulos" Style="{StaticResource GroupTitle}" />
                        <DataGrid x:Name="ModulesGrid" ItemsSource="{Binding Modules}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" MaxHeight="320" CanUserAddRows="False" AutomationProperties.Name="Módulos">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Módulo" Binding="{Binding Id}" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" />
                                <DataGridTextColumn Header="Largo (in)" Binding="{Binding Length}" />
                                <DataGridTextColumn Header="Inicio (in)" Binding="{Binding Start}" />
                                <DataGridTextColumn Header="Largo manual" Binding="{Binding Manual}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                   Text="Las cabeceras personalizadas se conservan. Para editar una cabecera, usa «Abrir en editor clásico» mientras se migra." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- T4 va: the tab «Propiedades» at the end of the editor (VA-07): the custom properties of the rack, written by «Actualizar». -->
            <TabItem x:Name="RackPropertiesTabItem" Header="{Binding PropertiesTab.TabHeader}" AutomationProperties.Name="Propiedades">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <vtab:RackPropertiesTabView x:Name="RackPropertiesView" DataContext="{Binding PropertiesTab}"
                                                xmlns:vtab="clr-namespace:RackCad.UI.VentanaRackCad" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
