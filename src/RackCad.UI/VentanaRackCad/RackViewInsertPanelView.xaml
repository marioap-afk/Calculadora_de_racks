<UserControl x:Class="RackCad.UI.VentanaRackCad.RackViewInsertPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RackCad.UI.VentanaRackCad"
             AutomationProperties.Name="{Binding Title}"
             FontFamily="Segoe UI"
             FontSize="12">
    <!-- The panel «Insertar vista…» of the RackCad window (I-64 A-14, line D, fourth batch, part «ins»; prototype «dialogos», DG-01 to
         DG-08): what replaces the classic dialog «Insertar varias vistas» inside the window, for every editor (DG-07). It is not modal: on
         the left the views of the rack in the groups Frontal · Lateral · Planta (a check box each, DG-03), on the right «Orden de
         colocación», the order of marking with «Subir», «Bajar» and «Quitar» (DG-02); below, «Insertar N vistas» with why it cannot insert
         now (DG-05). Its DataContext is a RackViewInsertPanelViewModel. Below InsertPanelStackWidth the order goes under the views. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <Style x:Key="OptionalText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ColumnTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,8,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
            <!-- A small link-like button («Todos los postes», «Ninguno», «Quitar»). -->
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <!-- «Todos los postes» / «Ninguno»: made only for the group with lateral cuts, so no hidden button repeats their names
                 (correction 8 of the review). Its DataContext is the group. -->
            <DataTemplate x:Key="CutsButtons" DataType="{x:Type local:RackViewInsertGroupItem}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding MarkAllLabel}" Style="{StaticResource SmallButton}" IsEnabled="{Binding CanMarkAll}"
                            AutomationProperties.Name="{Binding MarkAllName}" Click="OnMarkAllCutsClick" />
                    <Button Content="Ninguno" Style="{StaticResource SmallButton}" IsEnabled="{Binding CanMarkNone}"
                            AutomationProperties.Name="{Binding MarkNoneName}" Click="OnUnmarkAllCutsClick" />
                </StackPanel>
            </DataTemplate>
            <!-- «Subir» / «Bajar» of a row of the order: an arrow, its tooltip and its name; off at the ends. -->
            <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="MinWidth" Value="30" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="InsertPanelBorder" Margin="0,6,0,0" Padding="10" BorderThickness="1" CornerRadius="6"
            BorderBrush="{DynamicResource ShellStatusInfoBrush}" Background="{DynamicResource ShellSurfaceBrush}">
        <StackPanel>
            <TextBlock x:Name="InsertPanelTitleText" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <TextBlock x:Name="InsertPanelLeadText" Text="{Binding Lead}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />

            <Grid x:Name="InsertPanelColumns" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ViewsColumnDefinition" Width="1.25*" />
                    <ColumnDefinition x:Name="OrderColumnDefinition" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The views of the rack, in their groups. -->
                <StackPanel x:Name="ViewsColumn" Grid.Column="0" Grid.Row="0" Margin="0,0,16,0">
                    <TextBlock Text="Vistas de este rack" Style="{StaticResource ColumnTitle}" />
                    <ItemsControl x:Name="InsertGroupList" ItemsSource="{Binding Groups}" AutomationProperties.Name="Vistas de este rack">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:RackViewInsertGroupItem}">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                    <WrapPanel Margin="0,1,0,3">
                                        <TextBlock Text="{Binding Help}" Style="{StaticResource OptionalText}" Margin="0,0,8,2" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                        <!-- Smoke T4 (F-1): without its template the ContentControl showed the name of the type of the group
                                             («RackCad.UI.VentanaRackCad.RackViewInsertGroupItem») next to «Frontal» and «Planta»; it is collapsed
                                             and empty unless the group has lateral cuts. -->
                                        <ContentControl Focusable="False" IsTabStop="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Content" Value="{x:Null}" />
                                                    <Setter Property="ContentTemplate" Value="{x:Null}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCuts}" Value="True">
                                                            <Setter Property="Content" Value="{Binding}" />
                                                            <Setter Property="ContentTemplate" Value="{StaticResource CutsButtons}" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:RackViewInsertOptionItem}">
                                                <!-- A chip: the box with its short name and, marked, its place in the order. -->
                                                <Border Margin="0,0,6,6" Padding="8,3" CornerRadius="12" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusInfoBrush}" />
                                                                    <Setter Property="Background" Value="{DynamicResource ShellWindowBackgroundBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox Content="{Binding Chip}" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{Binding Label}"
                                                                  AutomationProperties.ItemStatus="{Binding NumberText}" />
                                                        <Border Margin="6,0,0,0" MinWidth="18" Height="18" CornerRadius="9" Padding="4,0"
                                                                Background="{DynamicResource ShellStatusInfoBrush}" VerticalAlignment="Center"
                                                                Visibility="{Binding HasNumber, Converter={StaticResource FlagToVisibility}}">
                                                            <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" Foreground="{DynamicResource ShellSurfaceBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="InsertPanelExistingText" Text="{Binding ExistingText}" Style="{StaticResource OptionalText}" FontStyle="Italic"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                </StackPanel>

                <!-- «Orden de colocación». -->
                <StackPanel x:Name="OrderColumn" Grid.Column="1" Grid.Row="0">
                    <TextBlock Text="Orden de colocación" Style="{StaticResource ColumnTitle}" />
                    <Border x:Name="InsertPanelEmptyBox" Padding="10,8" BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource ShellBorderBrush}"
                            Visibility="{Binding IsOrderEmpty, Converter={StaticResource FlagToVisibility}}">
                        <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    </Border>
                    <ItemsControl x:Name="InsertOrderList" ItemsSource="{Binding Order}" AutomationProperties.Name="Orden de colocación">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:RackViewInsertOrderItem}">
                                <Border Margin="0,0,0,4" Padding="6,4" BorderThickness="1" CornerRadius="6"
                                        AutomationProperties.Name="{Binding AccessibleText}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource ShellSurfaceBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGone}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Background="{DynamicResource ShellWindowBackgroundBrush}"
                                                Visibility="{Binding HasNumber, Converter={StaticResource FlagToVisibility}}">
                                            <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ArrowButton}" IsEnabled="{Binding CanMoveUp}" ToolTip="Subir"
                                                    AutomationProperties.Name="{Binding MoveUpName}" Click="OnMoveUpClick">
                                                <Path Data="M 0,6 L 5,0 L 10,6" Stroke="{DynamicResource ShellTextPrimaryBrush}" StrokeThickness="1.6" Width="10" Height="7" />
                                            </Button>
                                            <Button Style="{StaticResource ArrowButton}" IsEnabled="{Binding CanMoveDown}" ToolTip="Bajar"
                                                    AutomationProperties.Name="{Binding MoveDownName}" Click="OnMoveDownClick">
                                                <Path Data="M 0,0 L 5,6 L 10,0" Stroke="{DynamicResource ShellTextPrimaryBrush}" StrokeThickness="1.6" Width="10" Height="7" />
                                            </Button>
                                            <Button Content="Quitar" Style="{StaticResource SmallButton}" AutomationProperties.Name="{Binding RemoveName}"
                                                    Click="OnRemoveClick" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGone}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Foreground" Value="{DynamicResource ShellStatusWarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding GoneTag}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ShellStatusWarningBrush}"
                                                       Visibility="{Binding IsGone, Converter={StaticResource FlagToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="InsertPanelGoneText" Text="{Binding GoneText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource ShellStatusWarningBrush}"
                               Visibility="{Binding HasGone, Converter={StaticResource FlagToVisibility}}" />
                </StackPanel>
            </Grid>

            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="InsertPanelGoButton" Content="{Binding InsertLabel}" Margin="0,0,8,4" Padding="14,5"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanInsert}"
                        AutomationProperties.Name="{Binding InsertLabel}" Click="OnInsertClick" />
                <Button x:Name="InsertPanelCancelButton" Content="Cancelar" Margin="0,0,8,4" Padding="12,5"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Cancelar la inserción de vistas"
                        Click="OnCancelClick" />
                <TextBlock x:Name="InsertPanelReasonText" Text="{Binding Reason}" Style="{StaticResource OptionalText}" MaxWidth="460"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,4"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource ShellStatusWarningBrush}" />
            </WrapPanel>
            <TextBlock x:Name="InsertPanelNoteText" Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <TextBlock x:Name="InsertPanelCancelNoteText" Text="{Binding CancelNote}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            <TextBlock x:Name="InsertPanelFailureText" Text="{Binding FailureText}" Style="{StaticResource OptionalText}" Margin="0,2,0,0"
                       Foreground="{DynamicResource ShellStatusErrorBrush}" />
        </StackPanel>
    </Border>
</UserControl>
