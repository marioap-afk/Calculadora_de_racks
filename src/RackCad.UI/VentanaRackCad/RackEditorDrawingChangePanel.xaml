<UserControl x:Class="RackCad.UI.VentanaRackCad.RackEditorDrawingChangePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- T6 st (I-64, sexta tanda; O-5, M-16; the Owner: «Avisar y ofrecer releer»): the notice of an editor of the window after a command that
         is not of the window, «Volver a leer del dibujo», and the inline question of «Actualizar» with changes not written. Its data context is
         the RackEditorDrawingChange of the editor; the six editors show it under their head. Nothing shows without the mark. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="FlagToVisibility" />
            <!-- Review of 5114345e, M-6: the style of the inline questions of the editors (CantileverEditorView, CabeceraEditorView). -->
            <Style x:Key="QuestionPanel" TargetType="Border">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusWarningBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="NoticePanel" Margin="0,6,0,0" Padding="8" BorderThickness="1" CornerRadius="4"
            BorderBrush="{DynamicResource ShellStatusWarningBrush}" Background="{DynamicResource ShellSurfaceBrush}"
            AutomationProperties.Name="El dibujo cambió desde que se leyó"
            Visibility="{Binding IsChanged, Converter={StaticResource FlagToVisibility}}">
        <StackPanel>
            <TextBlock x:Name="NoticeText" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
            <WrapPanel Margin="0,6,0,0">
                <Button x:Name="RereadButton" Content="Volver a leer del dibujo" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanReread}" AutomationProperties.Name="Volver a leer este rack del dibujo"
                        ToolTip="Lee otra vez el rack del dibujo de AutoCAD, como «Editar aquí»." Click="OnRereadClick" />
            </WrapPanel>
            <!-- «Actualizar» with changes over a drawing that changed: the inline question. -->
            <Border x:Name="ConfirmPanel" Style="{StaticResource QuestionPanel}"
                    Visibility="{Binding IsConfirmingUpdate, Converter={StaticResource FlagToVisibility}}">
                <StackPanel>
                    <TextBlock x:Name="ConfirmLine" Text="{Binding ConfirmText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="OverwriteButton" Content="Escribir encima" Margin="0,0,6,0" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="Escribir el borrador encima del dibujo" Click="OnOverwriteClick" />
                        <Button x:Name="CancelOverwriteButton" Content="Cancelar" Padding="10,3" Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="No escribir encima del dibujo" Click="OnCancelOverwriteClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
