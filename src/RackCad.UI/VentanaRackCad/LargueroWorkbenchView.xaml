<UserControl x:Class="RackCad.UI.VentanaRackCad.LargueroWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RackCad.UI.VentanaRackCad"
             AutomationProperties.Name="Larguero"
             FontFamily="Segoe UI"
             FontSize="12">
    <!-- «Nuevo › Larguero» of the RackCad window (I-64 A-14, line D; quinta tanda, part «lg», LG-01 to LG-03; sexta tanda, part «lg», the answers
         of the Owner). A larguero is made from a section and a ménsula (LG-01); the section is chosen in this one page with a filter by catalog
         and by type (LG-02) and is called by its type. T6 lg: it is saved in the library («Guardar en la biblioteca…»), inserted in the drawing
         as a loose piece («Insertar en el dibujo…», RACKLARGUEROINSERTAR) and, with an AISC section, inserted as a bare profile as RACKSECCION
         does; its view is the sketch of the plan AutoCAD inserts, and «Más» exports its BOM. Its data context is LargueroWorkbenchViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/VentanaRackCad/RackCadUtilityStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="LgFieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,8,0,2" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,10">
            <!-- The crumb: «Nuevo › Larguero». -->
            <WrapPanel Margin="0,0,0,2">
                <Button x:Name="LargueroCrumbNuevoButton" Content="Nuevo" Style="{StaticResource UtLinkButton}"
                        AutomationProperties.Name="Volver a Nuevo" Click="OnHomeClick" />
                <TextBlock Text=" › Larguero" VerticalAlignment="Center" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
            </WrapPanel>

            <!-- One wrap for the title and the buttons: narrow, the buttons go to the next line and the title keeps its width. -->
            <WrapPanel>
                <TextBlock Text="Larguero" Style="{StaticResource UtPageTitle}" Margin="0,0,16,4" VerticalAlignment="Top" />
                <Button x:Name="LargueroSaveButton" Content="Guardar en la biblioteca…" Padding="10,3" Margin="0,0,8,4" VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanSaveToLibrary}"
                        AutomationProperties.Name="Guardar el larguero en la biblioteca de diseños" Click="OnSaveClick" />
                <!-- «Más»: its entries open under the button, inline (no popup, O-D of the smoke of the fourth batch). -->
                <StackPanel x:Name="LargueroMoreBlock" Margin="0,0,8,4" VerticalAlignment="Top">
                    <Button x:Name="LargueroMoreButton" Content="Más" Padding="12,3" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="Más acciones del larguero" AutomationProperties.ItemStatus="{Binding MoreItemStatus}"
                            Click="OnMoreClick" />
                    <Border x:Name="LargueroMorePanel" Margin="0,4,0,0" Padding="6" BorderThickness="1" CornerRadius="4" MaxWidth="300"
                            BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}"
                            Visibility="{Binding IsMoreOpen, Converter={StaticResource UtFlagToVisibility}}">
                        <StackPanel>
                            <Button x:Name="LargueroExportExcelButton" Content="Exportar el BOM a Excel…" HorizontalAlignment="Left" Padding="10,3"
                                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanExportBom}"
                                    AutomationProperties.Name="Exportar a Excel el BOM del larguero" Click="OnExportExcelClick" />
                            <Button x:Name="LargueroExportCsvButton" Content="Exportar el BOM a CSV…" HorizontalAlignment="Left" Padding="10,3"
                                    Margin="0,4,0,0" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanExportBom}"
                                    AutomationProperties.Name="Exportar a CSV el BOM del larguero" Click="OnExportCsvClick" />
                            <TextBlock x:Name="LargueroExportHint" Text="{Binding ExportBomHint}" Style="{StaticResource UtOptional}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button x:Name="LargueroResetButton" Content="Volver a los valores por defecto" Padding="10,3" Margin="0,0,8,4" VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Volver el larguero a los valores por defecto"
                        Click="OnResetClick" />
                <Button x:Name="LargueroClassicButton" Content="Abrir el editor clásico" Padding="10,3" Margin="0,0,8,4" VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Abrir el editor clásico del larguero"
                        ToolTip="El editor de siempre (RACKNUEVO Larguero), que sigue disponible." Click="OnClassicClick" />
            </WrapPanel>

            <TextBlock x:Name="LargueroIntroText" Style="{StaticResource UtText}" Margin="0,0,0,8"
                       Text="{x:Static local:LargueroWorkbenchViewModel.IntroText}" />

            <!-- A larguero opened from the library: what it is, and what could not be kept. -->
            <Border x:Name="LargueroLoadedPanel" Style="{StaticResource UtBanner}"
                    Visibility="{Binding HasLoadedNotice, Converter={StaticResource UtFlagToVisibility}}">
                <TextBlock x:Name="LargueroLoadedText" Text="{Binding LoadedNotice}" Style="{StaticResource UtPlain}" />
            </Border>

            <!-- A catalog that could not be read is said here, not simulated (dolor 7). -->
            <Border x:Name="LargueroCatalogNoticePanel" Style="{StaticResource UtWarning}"
                    Visibility="{Binding HasCatalogNotice, Converter={StaticResource UtFlagToVisibility}}">
                <TextBlock x:Name="LargueroCatalogNoticeText" Text="{Binding CatalogNotice}" Style="{StaticResource UtPlain}" />
            </Border>

            <!-- «Exportar el BOM»: the file written, with «Abrir», «Mostrar en la carpeta» and «Guardar como…», as the BOM of the window. -->
            <Border x:Name="LargueroExportedBanner" Visibility="{Binding HasExported, Converter={StaticResource UtFlagToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource UtBanner}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExportedFailed}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock x:Name="LargueroExportedTitle" Text="{Binding ExportedTitle}" FontWeight="SemiBold" Style="{StaticResource UtPlain}" />
                    <TextBlock x:Name="LargueroExportedDetail" Text="{Binding ExportedDetail}" Style="{StaticResource UtPlain}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="LargueroOpenExportedButton" Content="Abrir" Padding="10,2" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="{Binding CanOpenExported}" AutomationProperties.Name="Abrir el BOM exportado del larguero" Click="OnOpenExportedClick" />
                        <Button x:Name="LargueroShowExportedButton" Content="Mostrar en la carpeta" Padding="10,2" Margin="0,0,6,0"
                                Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanOpenExported}"
                                AutomationProperties.Name="Mostrar en su carpeta el BOM exportado del larguero" Click="OnShowExportedClick" />
                        <Button x:Name="LargueroSaveExportedAsButton" Content="Guardar como…" Padding="10,2" Margin="0,0,6,0"
                                Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Guardar como el BOM exportado del larguero"
                                Click="OnSaveExportedAsClick" />
                        <Button x:Name="LargueroCloseExportedButton" Content="Cerrar aviso" Padding="10,2" Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="Cerrar el aviso del BOM exportado del larguero" Click="OnCloseExportedClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Wide, the summary goes beside the sections; narrow, below them (see OnLayoutSizeChanged). -->
            <Grid x:Name="LargueroLayout" SizeChanged="OnLayoutSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SummaryColumn" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="SummaryRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- LG-01 / LG-02: the section, by catalog and by type; T6 lg: then its view and «Insertar en el dibujo…». -->
                <StackPanel x:Name="LargueroSectionPanel" Grid.Column="0">
                    <TextBlock Text="Sección" Style="{StaticResource UtBlockTitle}" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource UtText}"
                               Text="Elige el catálogo y el tipo. Cada sección se llama por su tipo («Escalón», «Tubo», «Canal»…); la ménsula se elige aparte." />
                    <WrapPanel>
                        <StackPanel Margin="0,0,10,4">
                            <TextBlock Text="Catálogo" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <ComboBox x:Name="LargueroCatalogFilter" MinWidth="200" Margin="0,2,0,0" AutomationProperties.Name="Catálogo de las secciones"
                                      ItemsSource="{Binding CatalogOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedCatalog, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,4">
                            <TextBlock Text="Tipo" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <ComboBox x:Name="LargueroTypeFilter" MinWidth="170" Margin="0,2,0,0" AutomationProperties.Name="Tipo de sección"
                                      ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedType, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,4">
                            <TextBlock Text="Buscar" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <TextBox x:Name="LargueroSearchBox" Width="170" Padding="4,3" Margin="0,2,0,0" AutomationProperties.Name="Buscar sección"
                                     ToolTip="Por nombre, por su nombre en el catálogo, por tipo o por id: «escalón», «tubo», «PTR», «CPS», «IPR», «w10x33», «hss4x4»…"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="LargueroShownText" Text="{Binding ShownText}" Margin="0,2,0,4" Foreground="{DynamicResource ShellTextSecondaryBrush}" />

                    <!-- One list with its own scroll, virtualized: «Perfiles AISC» has about a thousand sections. -->
                    <ListBox x:Name="LargueroSectionList" MaxHeight="320" AutomationProperties.Name="Secciones"
                             ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellSurfaceBrush}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="IsEnabled" Value="{Binding IsSection}" />
                                <Setter Property="Padding" Value="6,3" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ShellTextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Margin" Value="0,4,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="LargueroNoMatchText" Text="{Binding NoMatchText}" Style="{StaticResource UtOptional}" />
                    <TextBlock x:Name="LargueroOutsideFilterText" Text="{Binding OutsideFilterText}" Style="{StaticResource UtOptional}" />

                    <!-- T6 lg (points 2, 3 and 6): the view of what is inserted, and «Insertar en el dibujo…». -->
                    <TextBlock Text="Vista e inserción" Style="{StaticResource UtBlockTitle}" Margin="0,12,0,2" />
                    <WrapPanel>
                        <RadioButton x:Name="LargueroPieceLarguero" GroupName="LargueroPiece" Content="El larguero, con sus 2 ménsulas" Margin="0,2,16,2"
                                     AutomationProperties.Name="Insertar el larguero con sus dos ménsulas" IsChecked="{Binding IsLargueroPiece, Mode=TwoWay}" />
                        <RadioButton x:Name="LargueroPieceProfile" GroupName="LargueroPiece" Content="Solo el perfil (como RACKSECCION)" Margin="0,2,16,2"
                                     AutomationProperties.Name="Insertar solo el perfil, como RACKSECCION" IsEnabled="{Binding CanChooseProfile}"
                                     IsChecked="{Binding IsProfilePiece, Mode=TwoWay}" />
                    </WrapPanel>
                    <TextBlock x:Name="LargueroProfileHint" Text="{Binding ProfileHint}" Style="{StaticResource UtOptional}" />
                    <WrapPanel>
                        <StackPanel Margin="0,4,10,4" Visibility="{Binding ShowViewChoice, Converter={StaticResource UtFlagToVisibility}}">
                            <TextBlock Text="Vista del perfil" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <ComboBox x:Name="LargueroViewBox" MinWidth="150" Margin="0,2,0,0" AutomationProperties.Name="Vista del perfil"
                                      ItemsSource="{x:Static local:LargueroWorkbenchViewModel.ViewOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedView, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Margin="0,4,10,4" Visibility="{Binding ShowDetailChoice, Converter={StaticResource UtFlagToVisibility}}">
                            <TextBlock Text="Detalle" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <ComboBox x:Name="LargueroDetailBox" MinWidth="130" Margin="0,2,0,0" AutomationProperties.Name="Detalle de la sección"
                                      ItemsSource="{x:Static local:LargueroWorkbenchViewModel.DetailOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedDetail, Mode=TwoWay}" />
                        </StackPanel>
                    </WrapPanel>
                    <Border Margin="0,4,0,0" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource ShellBorderBrush}"
                            Background="{DynamicResource ShellSurfaceBrush}">
                        <local:LargueroSketchView x:Name="LargueroSketch" Sketch="{Binding Sketch}" AutomationProperties.Name="Vista del larguero" />
                    </Border>
                    <TextBlock x:Name="LargueroSketchCaption" Text="{Binding SketchCaption}" Style="{StaticResource UtOptional}" />
                    <Border x:Name="LargueroAuthorityPanel" Style="{StaticResource UtWarning}" Margin="0,4,0,4"
                            Visibility="{Binding HasAuthorityText, Converter={StaticResource UtFlagToVisibility}}">
                        <TextBlock x:Name="LargueroAuthorityText" Text="{Binding AuthorityText}" FontWeight="SemiBold" Style="{StaticResource UtPlain}" />
                    </Border>
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="LargueroInsertButton" Content="Insertar en el dibujo…" Padding="14,4" Margin="0,0,10,4" VerticalAlignment="Top"
                                Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanInsert}"
                                AutomationProperties.Name="{Binding InsertAutomationName}" Click="OnInsertClick" />
                        <TextBlock x:Name="LargueroInsertReason" Text="{Binding InsertReason}" Style="{StaticResource UtOptional}" MaxWidth="420"
                                   VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock x:Name="LargueroInsertHint" Text="{Binding InsertHint}" Style="{StaticResource UtOptional}" />
                    <TextBlock x:Name="LargueroInsertStatus" Text="{Binding InsertStatus}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource UtOptional}">
                                <Setter Property="Foreground" Value="{DynamicResource ShellTextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InsertFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ShellStatusErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- The name, the peralte, the length to cut, the ménsula and the summary. -->
                <StackPanel x:Name="LargueroSummaryPanel" Grid.Column="1" Width="340" Margin="12,0,0,0">
                    <TextBlock Text="Nombre, medidas y ménsula" Style="{StaticResource UtBlockTitle}" Margin="0,0,0,0" />

                    <TextBlock Text="Nombre del larguero" Style="{StaticResource LgFieldLabel}" />
                    <TextBox x:Name="LargueroNameBox" Padding="4,3" AutomationProperties.Name="Nombre del larguero"
                             Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="LargueroNameHint" Text="{Binding NameHint}" Style="{StaticResource UtOptional}" />
                    <Button x:Name="LargueroUseProposedButton" Content="Usar el nombre automático" Style="{StaticResource UtLinkButton}" HorizontalAlignment="Left"
                            AutomationProperties.Name="Usar el nombre automático del larguero" Click="OnUseProposedClick"
                            Visibility="{Binding CanUseProposedName, Converter={StaticResource UtFlagToVisibility}}" />

                    <TextBlock Text="Peralte (in)" Style="{StaticResource LgFieldLabel}" />
                    <ComboBox x:Name="LargueroPeralteBox" AutomationProperties.Name="Peralte del larguero"
                              ItemsSource="{Binding PeralteOptions}" SelectedItem="{Binding SelectedPeralte, Mode=TwoWay}"
                              Visibility="{Binding HasPeralteChoice, Converter={StaticResource UtFlagToVisibility}}" />
                    <TextBlock x:Name="LargueroPeralteHint" Text="{Binding PeralteHint}" Style="{StaticResource UtOptional}" />

                    <TextBlock Text="Longitud a corte (in)" Style="{StaticResource LgFieldLabel}" />
                    <TextBox x:Name="LargueroLengthBox" Padding="4,3" AutomationProperties.Name="Longitud a corte del larguero, en pulgadas"
                             Text="{Binding LengthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLengthError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ShellStatusErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock x:Name="LargueroLengthError" Text="{Binding LengthError}" Style="{StaticResource UtError}" />
                    <TextBlock Text="La medida del perfil, sin las ménsulas." Style="{StaticResource UtOptional}" />

                    <TextBlock Text="Ménsula" Style="{StaticResource LgFieldLabel}" />
                    <ComboBox x:Name="LargueroMensulaBox" AutomationProperties.Name="Ménsula del larguero"
                              ItemsSource="{Binding MensulaOptions}" DisplayMemberPath="Label" SelectedValuePath="Key"
                              SelectedValue="{Binding SelectedMensula, Mode=TwoWay}" />
                    <TextBlock x:Name="LargueroMensulaHint" Text="{Binding MensulaHint}" Style="{StaticResource UtOptional}" />

                    <TextBlock Text="Resumen" Style="{StaticResource UtBlockTitle}" />
                    <TextBlock x:Name="LargueroProposedName" Text="{Binding DisplayName}" FontWeight="SemiBold" Style="{StaticResource UtPlain}" />
                    <ItemsControl x:Name="LargueroSummaryLines" ItemsSource="{Binding SummaryLines}" Margin="0,4,0,0" Focusable="False"
                                  AutomationProperties.Name="Resumen del larguero">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label, Mode=OneTime}" Foreground="{DynamicResource ShellTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value, Mode=OneTime}" Foreground="{DynamicResource ShellTextPrimaryBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Lista de materiales" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                    <TextBlock x:Name="LargueroBomNote" Style="{StaticResource UtOptional}" Text="La receta del BOM de Selectivo (un perfil y 2 ménsulas por larguero), con los nombres de esta página." />
                    <ItemsControl x:Name="LargueroBomLines" ItemsSource="{Binding BomLines}" Focusable="False" AutomationProperties.Name="Lista de materiales del larguero">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" TextWrapping="Wrap" Foreground="{DynamicResource ShellTextPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPiece, Mode=OneTime}" Value="True">
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="Margin" Value="12,0,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Component, Mode=OneTime}" /><Run Text=": " /><Run Text="{Binding Description, Mode=OneTime}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding LengthText, Mode=OneTime}" TextAlignment="Right" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding QuantityText, Mode=OneTime}" TextAlignment="Right" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LargueroMissingText" Text="{Binding MissingText}" Style="{StaticResource UtError}" Margin="0,6,0,0" />
                    <TextBlock x:Name="LargueroCompleteText" Text="{Binding CompleteText}" Style="{StaticResource UtOptional}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
