<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:RackCad.UI.Controls"
                    xmlns:shell="clr-namespace:RackCad.UI.Shell">

    <!-- Shared tokens and styles (window background, buttons, field styles, shell tokens). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <shell:ShellSlotVisibilityConverter x:Key="ShellSlotVisibility" />
    <controls:SectionFamilyLabelConverter x:Key="SectionFamilyLabel" />

    <!-- I-37D ronda 2 (motivos 1 y 6), reapuntado por I-39A al arquetipo B: el shell comun de los editores
         ACOTADOS. Dividir el producto en una ventana por sujeto solo ayuda si esas ventanas son la misma ventana:
         los layouts escritos a mano divergirian en la primera correccion y el usuario aprenderia N dialogos en vez
         de uno. Izquierda: parametros propios + selector buscable, con scroll. Derecha: preview, que se queda con
         el espacio que los parametros no usan. Abajo: diagnosticos, receta y acciones, SIEMPRE visibles fuera del
         scroll.
         La plantilla NO cambio con I-39A: solo cambio el tipo al que se aplica. Aquella dejo una fachada derivada
         en la ruta vieja para no tocar cuatro XAML ya validados; I-39C los migro al tipo neutral y la retiro, de
         modo que este estilo tiene ya un solo destinatario y ningun shell del arquetipo B lleva nombre de sistema. -->
    <Style TargetType="{x:Type shell:RackBoundedEditorShell}">
        <Setter Property="Background" Value="{DynamicResource ShellWindowBackgroundBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ShellFontSizeBase}" />
        <Setter Property="FontFamily" Value="{DynamicResource ShellFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shell:RackBoundedEditorShell}">
                    <Border Background="{TemplateBinding Background}">
                        <DockPanel Margin="{DynamicResource ShellZoneSpacing}">

                            <ContentPresenter x:Name="PART_Header" DockPanel.Dock="Top" Margin="0,0,0,8"
                                              Content="{TemplateBinding Header}"
                                              Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ShellSlotVisibility}}" />

                            <ContentPresenter x:Name="PART_Actions" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                              Content="{TemplateBinding Actions}" />

                            <ContentPresenter x:Name="PART_Bom" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                              Content="{TemplateBinding BomSummary}"
                                              Visibility="{Binding BomSummary, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ShellSlotVisibility}}" />

                            <ContentPresenter x:Name="PART_Diagnostics" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                              Content="{TemplateBinding Diagnostics}"
                                              Visibility="{Binding Diagnostics, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ShellSlotVisibility}}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="330" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <ContentPresenter x:Name="PART_Parameters" Content="{TemplateBinding Parameters}" />
                                        <ContentPresenter x:Name="PART_Picker" Margin="0,8,0,0"
                                                          Content="{TemplateBinding SectionPicker}"
                                                          Visibility="{Binding SectionPicker, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ShellSlotVisibility}}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <ContentPresenter x:Name="PART_Preview" Grid.Column="2"
                                                  Content="{TemplateBinding Preview}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- I-37D ronda 2 (motivo 3 del rechazo): el selector estructural BUSCABLE. Un ComboBox sobre 983 filas es
         una barra de scroll, y quien sabe que la pieza se llama W10X33 no tenia como decirlo. La plantilla es
         composicion pura: caja de busqueda, filtro de familia y una lista VIRTUALIZADA — 983 filas bastan para
         que una lista sin virtualizar tartamudee en cada tecla. El control no resuelve nada: devuelve el id EXACTO
         de la fila elegida. -->
    <Style TargetType="{x:Type controls:StructuralSectionPicker}">
        <Setter Property="MinHeight" Value="180" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StructuralSectionPicker}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PART_Search" Grid.Column="0" Style="{StaticResource FieldBox}"
                                     ToolTip="Escribe la designación (W10X33), parte de ella (10X33) o el id completo (AISC-W-W10X33). Flechas para recorrer la lista." />
                            <ComboBox x:Name="PART_Family" Grid.Column="2" MinWidth="112"
                                      ToolTip="Filtra por familia. «Todas» quita el filtro.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SectionFamilyLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                            <Grid>
                                <ListBox x:Name="PART_List"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Id.Value}">
                                                <TextBlock Text="{Binding Designation}" FontSize="12" />
                                                <TextBlock Text="{Binding Id.Value}" FontSize="10"
                                                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="PART_Empty" Visibility="Collapsed" Margin="10"
                                           TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The default (lookless) template for RackEditorVisualShell. Composition only: five content zones + the four
         neutral action categories. Content is TemplateBound to the control's slots, so NAMED content injected by a
         consuming editor registers in the EDITOR's name scope, not the shell's. Optional zones collapse without a gap. -->
    <Style TargetType="{x:Type shell:RackEditorVisualShell}">
        <Setter Property="Background" Value="{DynamicResource ShellWindowBackgroundBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ShellFontSizeBase}" />
        <Setter Property="FontFamily" Value="{DynamicResource ShellFontFamily}" />
        <!-- The shell does NOT impose a control minimum: the CONSUMING WINDOW carries the contractual
             minimum size (EditorShellWindowStyle → ShellMinWidth/ShellMinHeight tokens). A content
             minimum here would exceed the window's client area at that minimum and clip; instead the
             sidebar scroll and the action bar's wrap absorb tight sizes. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shell:RackEditorVisualShell}">
                    <Border Background="{TemplateBinding Background}">
                        <DockPanel Margin="{DynamicResource ShellZoneSpacing}">

                            <!-- Action bar (bottom): wraps at the minimum width, never clips. -->
                            <shell:EditorActionBar x:Name="PART_ActionBar" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                                   LeadingActions="{TemplateBinding LeadingActions}"
                                                   SecondaryActions="{TemplateBinding SecondaryActions}"
                                                   PrimaryActions="{TemplateBinding PrimaryActions}"
                                                   TrailingActions="{TemplateBinding TrailingActions}" />

                            <!-- Status band (bottom, above the action bar): ALWAYS outside the sidebar scroll. -->
                            <ContentPresenter x:Name="PART_StatusHost" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                              Content="{TemplateBinding StatusContent}"
                                              Visibility="{Binding StatusContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ShellSlotVisibility}}" />

                            <!-- Sidebar (left): tokenized width; a neutral header (optional) over a vertical scroll. -->
                            <Grid DockPanel.Dock="Left" Width="{DynamicResource ShellSidebarWidth}" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ContentPresenter x:Name="PART_SidebarHeaderHost" Grid.Row="0"
                                                  Content="{TemplateBinding SidebarHeader}"
                                                  Visibility="{Binding SidebarHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ShellSlotVisibility}}" />
                                <ScrollViewer x:Name="PART_SidebarScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ContentPresenter x:Name="PART_SidePanelHost" Content="{TemplateBinding SidePanelContent}" />
                                </ScrollViewer>
                            </Grid>

                            <!-- Work area (fill): matrix on top (optional, collapses) + preview below (fills, tokenized min).
                                 ClipToBounds keeps the preview inside its zone: at a window client height near the contractual
                                 minimum (outer minus the non-client frame) the matrix's fixed height plus the preview's min
                                 height can exceed the fill slot, and without clipping the dark preview would paint a few pixels
                                 over the status band below it. Clipping contains it to its own zone (the preview simply loses a
                                 few pixels at the very bottom) instead of occluding the status. -->
                            <Grid x:Name="PART_WorkArea" ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="{DynamicResource ShellPreviewMinHeight}" />
                                </Grid.RowDefinitions>
                                <ContentPresenter x:Name="PART_MatrixHost" Grid.Row="0" Margin="0,0,0,8"
                                                  Content="{TemplateBinding MatrixContent}"
                                                  Visibility="{Binding MatrixContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ShellSlotVisibility}}" />
                                <ContentPresenter x:Name="PART_PreviewHost" Grid.Row="1"
                                                  Content="{TemplateBinding PreviewContent}"
                                                  Visibility="{Binding PreviewContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ShellSlotVisibility}}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
