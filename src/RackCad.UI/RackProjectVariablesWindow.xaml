<Window x:Class="RackCad.UI.RackProjectVariablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Variables de proyecto"
        Height="640"
        Width="800"
        MinHeight="520"
        MinWidth="660"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Variables de proyecto" FontSize="18" FontWeight="SemiBold" Foreground="#1F2933" />
            <TextBlock Text="Valores del DIBUJO. Un rack vinculado toma su valor de aquí; el literal que tenía queda congelado."
                       Foreground="#617080" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" x:Name="BlockedBanner" Background="#FDECEA" BorderBrush="#E0B4B0" BorderThickness="1"
                Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock x:Name="BlockedText" Foreground="#8A1F11" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" x:Name="EditorPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="VariablesList" SelectionChanged="VariablesList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Foreground="#617080" FontSize="11">
                                <Run Text="{Binding Type, Mode=OneWay}" />
                                <Run Text=" · valor " />
                                <Run Text="{Binding LiteralValue, Mode=OneWay}" />
                                <Run Text=" · racks: " />
                                <Run Text="{Binding ConsumerCount, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Nombre" Foreground="#617080" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" Margin="0,2,0,8" />

                <TextBlock Text="Valor (in)" Foreground="#617080" FontSize="12" FontWeight="SemiBold" />
                <TextBox x:Name="ValueBox" Margin="0,2,0,8" />

                <WrapPanel Margin="0,4,0,8">
                    <Button x:Name="NewButton" Content="Nueva" Width="112" Margin="0,0,8,6" Click="New_Click" />
                    <Button x:Name="RenameButton" Content="Renombrar" Width="112" Margin="0,0,8,6" Click="Rename_Click" />
                    <Button x:Name="ChangeValueButton" Content="Cambiar valor" Width="112" Margin="0,0,8,6" Click="ChangeValue_Click" />
                    <Button x:Name="DeleteButton" Content="Eliminar" Width="112" Margin="0,0,8,6" Click="Delete_Click" />
                </WrapPanel>

                <TextBlock Text="Racks que la usan" Foreground="#617080" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="ConsumersText" Foreground="#1F2933" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,10" />

                <CheckBox x:Name="UnlinkConfirmCheck" Margin="0,0,0,6" Checked="Confirm_Changed" Unchecked="Confirm_Changed" TextBlock.FontSize="12"
                          Content="Entiendo que se desvincularán TODOS los racks, conservando su valor actual, y la variable se eliminará." />
                <Button x:Name="UnlinkAllDeleteButton" Content="Desvincular todos y eliminar" HorizontalAlignment="Left"
                        Padding="12,4" Click="UnlinkAllDelete_Click" />
            </StackPanel>
        </Grid>

        <!-- Fuera de EditorPanel a propósito: una reparación tiene que seguir siendo posible cuando el
             alcance del dibujo es indeterminado, que es justo cuando hace falta. -->
        <StackPanel Grid.Row="3" x:Name="RepairPanel" Margin="0,14,0,0">
            <TextBlock Text="Referencias rotas" Foreground="#617080" FontSize="12" FontWeight="SemiBold" />
            <ListBox x:Name="BrokenList" Height="90" Margin="0,2,0,6" SelectionChanged="BrokenList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding RackName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding PropertyId, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="#617080" FontSize="11">
                                <Run Text="variable " />
                                <Run Text="{Binding VariableId, Mode=OneWay}" />
                                <Run Text=" · literal almacenado " />
                                <Run Text="{Binding StoredLiteral, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="RepairAuthorityText" Foreground="#8A5A11" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="RepairWarningText" Foreground="#8A5A11" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
            <CheckBox x:Name="RepairConfirmCheck" Margin="0,0,0,6" Checked="Confirm_Changed" Unchecked="Confirm_Changed" TextBlock.FontSize="12"
                      Content="Entiendo que se retirarán TODOS los vínculos rotos reparables de este rack y que la geometría puede cambiar." />
            <Button x:Name="RepairButton" Content="Reparar (quitar el vínculo)" HorizontalAlignment="Left"
                    Padding="12,4" Click="Repair_Click" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Content="Cerrar" Width="112" Padding="12,4"
                    DockPanel.Dock="Right" Click="Close_Click" />
            <TextBlock x:Name="StatusText" Foreground="#617080" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
