<Window x:Class="RackCad.UI.Systems.Selective.RackSelectiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:RackCad.UI.Shell"
        Title="RackCad – Rack selectivo: editor avanzado (vista frontal)"
        Style="{DynamicResource EditorShellWindowStyle}"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- I-31 (ADR-0019): the selective editor is now COMPOSED over RackEditorVisualShell, exactly as the dynamic editor
         (I-30). Every control keeps its x:Name, handler, parsing, LostFocus, single-cell selection + scope application,
         recompute, previews, fondo selector/matrices, insert/update, BOM, library, GUID and persistence unchanged; only
         the OUTER layout moved into the shell's slots (sidebar / matrix / preview / status / neutral action categories).
         Initial/minimum size, background and typography come from the shared EditorShellWindowStyle (shell tokens); the
         chrome brushes reuse the Shell* tokens (same hex as before). The code-behind is NOT touched. -->
    <shell:RackEditorVisualShell x:Name="Shell">

        <!-- SIDEBAR: global settings + selected-cell editor (the shell provides the scroll). -->
        <shell:RackEditorVisualShell.SidePanelContent>
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="1" Padding="{DynamicResource ShellPanelPadding}">
                <StackPanel>
                    <TextBlock Text="Rack" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                    <TextBlock Text="Nombre (Rack A)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}"
                             ToolTip="Nombre del rack como lo ve el cliente. Se guarda con el bloque para poder reabrirlo y editarlo." />

                    <TextBlock Text="Anotaciones y dibujo" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="DrawBasePlateCheck" Content="Dibujar placa base" IsChecked="True" Margin="0,4,0,0"
                              Foreground="#415161" Checked="DrawToggle_Changed" Unchecked="DrawToggle_Changed"
                              ToolTip="Dibuja las placas base bajo los postes (frontal y planta)." />
                    <CheckBox x:Name="NumberFrontsCheck" Content="Numerar frentes" Margin="0,4,0,0" Foreground="#415161"
                              ToolTip="Dibuja un número por frente (bahía) en frontal, planta y lateral." />
                    <CheckBox x:Name="NumberLevelsCheck" Content="Numerar niveles" Margin="0,4,0,0" Foreground="#415161"
                              ToolTip="Dibuja un número por nivel de carga en frontal y lateral (en planta no aplica)." />
                    <CheckBox x:Name="DrawRackNameCheck" Content="Colocar nombre de rack" Margin="0,4,0,0" Foreground="#415161"
                              ToolTip="Dibuja el nombre del rack como texto en las tres vistas." />
                    <CheckBox x:Name="DrawPalletsCheck" Content="Mostrar tarimas" Margin="0,4,0,0"
                              Foreground="#415161" Checked="DrawToggle_Changed" Unchecked="DrawToggle_Changed"
                              ToolTip="Dibuja una tarima por posición de carga como referencia visual (bloque TARIMA de la biblioteca; no entra en el BOM). Solo vista frontal." />
                    <TextBlock Text="Escala de texto (1 = 6&quot;)" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                    <TextBox x:Name="AnnotationScaleBox" Style="{StaticResource FieldBox}" Text="1"
                             ToolTip="Multiplica el tamaño del texto de las anotaciones (números y nombre) y de las cotas." />
                    <TextBlock Text="Cotas" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                    <ComboBox x:Name="DimensionsBox" SelectionChanged="Dimensions_Changed"
                              ToolTip="Cotas automáticas por vista. Ninguna = sin cotas. Mínimo = alto/ancho totales. Estándar = + ancho por frente y separaciones. Detallado = + elevación de cada nivel. Se dibujan en la capa RACKCAD_COTAS y escalan con la escala de texto.">
                        <ComboBoxItem Content="Ninguna" />
                        <ComboBoxItem Content="Mínimo" />
                        <ComboBoxItem Content="Estándar" />
                        <ComboBoxItem Content="Detallado" />
                    </ComboBox>
                    <TextBlock Text="Estilo de cota" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                    <ComboBox x:Name="DimStyleBox" SelectionChanged="Dimensions_Changed"
                              ToolTip="Estilo de cota tomado de la tabla de estilos del dibujo actual de AutoCAD. «(Automático)» usa el estilo vigente con el tamaño según la escala de texto; un estilo elegido se respeta tal cual." />
                    <TextBlock Text="La numeración y el nombre se dibujan en RACKCAD_ANOTACIONES; las cotas en RACKCAD_COTAS (las tres vistas)."
                               Foreground="#8B98A6" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0" />

                    <TextBlock Text="Seguridad" Style="{StaticResource SectionTitle}" />
                    <Button x:Name="SafetyButton" Content="Elementos de seguridad…" Click="Safety_Click"
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,2,0,0"
                            ToolTip="Protectores, desviadores, topes, guardas y parrillas. Entran a la lista de materiales; dibujarlos es una fase posterior (falta el bloque de cada uno)." />

                    <TextBlock Text="Cabecera" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Poste" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PostBox" SelectedValuePath="Id" DisplayMemberPath="DisplayName" SelectionChanged="Post_Changed" />
                    <TextBlock Text="Peralte poste (in)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PostPeralteBox" Style="{StaticResource FieldBox}" Text="3"
                             LostFocus="GlobalScalar_LostFocus" KeyDown="GlobalScalar_KeyDown"
                             ToolTip="Peralte (fondo) del poste en pulgadas; afecta la vista frontal y la planta. Se aplica al salir del campo." />

                    <TextBlock Text="Cabecera por poste (opcional)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Foreground="#8B98A6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PostSelectBox" Grid.Column="0" SelectionChanged="PostSelect_Changed" />
                        <Button x:Name="CustomizePostButton" Grid.Column="2" Content="Personalizar" Click="CustomizePost_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Abre el configurador de cabeceras para este poste (p. ej. peralte de placa)." />
                    </Grid>
                    <TextBlock Text="Peralte de este poste (in)" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                    <TextBox x:Name="PostPeralteOverrideBox" Style="{StaticResource FieldBox}" LostFocus="PostPeralteOverride_LostFocus"
                             KeyDown="PostPeralteOverride_KeyDown"
                             ToolTip="Peralte solo del poste seleccionado. Déjalo vacío para usar el peralte global de arriba." />
                    <TextBlock x:Name="PostCabeceraStatus" Foreground="#617080" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <Button Content="Restablecer poste" Click="ResetPost_Click" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,4,0,0"
                            ToolTip="Quita la cabecera personalizada de este poste (vuelve a la del tramo)." />

                    <!-- I-43: the SECOND axis of every operation. One selector for the whole editor. -->
                    <StackPanel x:Name="TargetFondosPanel" Margin="0,10,0,0">
                        <TextBlock Text="Fondos destino" Style="{StaticResource FieldLabel}" />
                        <ToggleButton x:Name="TargetFondosButton" HorizontalContentAlignment="Left" Content="Actual"
                                      Padding="8,3" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" Foreground="#1F2933"
                                      ToolTip="Dónde aplican los botones «Aplicar» y los campos que edites: el fondo actual, uno, varios o todos. No cambia lo que ves en la matriz." />
                        <Popup x:Name="TargetFondosPopup" PlacementTarget="{Binding ElementName=TargetFondosButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=TargetFondosButton, Mode=TwoWay}">
                            <Border Background="White" BorderBrush="#D8DEE6" BorderThickness="1" Padding="8">
                                <StackPanel x:Name="TargetFondosList" MinWidth="150" />
                            </Border>
                        </Popup>
                    </StackPanel>

                    <TextBlock Text="Tramo" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Frentes" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="BayCountBox" Style="{StaticResource FieldBox}" Text="2"
                             LostFocus="BayCount_LostFocus" KeyDown="BayCount_KeyDown"
                             ToolTip="Número de frentes (bahías) de los «Fondos destino»; cada fondo puede tener el suyo. Se aplica al salir del campo (o con 'Recalcular tramo')." />
                    <TextBlock Text="Cuántos niveles tiene cada frente y su larguero a piso se editan en «Frente seleccionado», con su propio alcance."
                               Foreground="#8B98A6" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Text="Tolerancias y medidas" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Horizontal (in)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ToleranceBox" Style="{StaticResource FieldBox}" Text="4"
                                     LostFocus="GlobalScalar_LostFocus" KeyDown="GlobalScalar_KeyDown"
                                     ToolTip="Tolerancia horizontal total entre tarimas y postes; define el largo del larguero. Se aplica al salir del campo." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Holgura vertical (in)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ClearanceBox" Style="{StaticResource FieldBox}" Text="6"
                                     LostFocus="GlobalScalar_LostFocus" KeyDown="GlobalScalar_KeyDown"
                                     ToolTip="Espacio libre sobre la tarima hasta el siguiente larguero. Se aplica al salir del campo." />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Fondo de tarima (in)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FondoBox" Style="{StaticResource FieldBox}" Text="48" LostFocus="FondoDepth_LostFocus" KeyDown="FondoDepth_KeyDown"
                             ToolTip="Profundidad de la TARIMA. Es una propiedad del FONDO: se aplica a los «Fondos destino» elegidos abajo. La cabecera se dibuja 6&quot; menos (regla: cabecera = tarima − 6&quot;)." />
                    <TextBlock Text="Fondo de cabecera (in, opcional)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CabeceraFondoBox" Style="{StaticResource FieldBox}" Text="" LostFocus="FondoDepth_LostFocus" KeyDown="FondoDepth_KeyDown"
                             ToolTip="Fondo de la CABECERA (marco). Propiedad del FONDO: se aplica a los «Fondos destino». Vacío = calculado de la tarima (tarima − 6&quot;)." />

                    <TextBlock Text="Número de fondos" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FondosBox" Style="{StaticResource FieldBox}" Text="1" LostFocus="Fondos_LostFocus"
                             ToolTip="Cabeceras en profundidad: 1 = sencillo; 2/3/4 = doble profundidad / espalda con espalda. Cada fondo tiene su propia matriz de niveles. Afecta lateral, planta y BOM (no la frontal)." />
                    <StackPanel x:Name="SeparatorsSection" Visibility="Collapsed" Margin="0,6,0,0">
                        <TextBlock Text="Separación por hueco (in)" Style="{StaticResource FieldLabel}" />
                        <StackPanel x:Name="SeparatorsHost" />
                    </StackPanel>

                    <!-- Sin IsDefault: como botón default, Enter en CUALQUIER caja de la ventana (editor de celda,
                         alturas por frente) lo disparaba y LoadCellEditor revertía lo recién tecleado. -->
                    <Button Content="Recalcular tramo" Click="Update_Click" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,12,0,0"
                            ToolTip="Fuerza el recálculo completo del tramo. Ya no es obligatorio: cada campo (frentes, poste, tolerancias…) se aplica al salir de él; el editor de celda usa 'Aplicar a:'." />

                    <Border Background="#F1F5F9" BorderBrush="#D8DEE6" BorderThickness="1" Margin="0,14,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="CellHeader" Text="Celda seleccionada" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="Larguero" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CellBeamBox" SelectedValuePath="Id" DisplayMemberPath="DisplayName" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Frente tarima (in)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="FrenteBox" Style="{StaticResource FieldBox}" Text="42"
                                             ToolTip="Ancho (frente) de la tarima de esta celda." />
                                    <TextBlock Text="Tarimas por nivel" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PalletCountBox" Style="{StaticResource FieldBox}" Text="2"
                                             ToolTip="Tarimas que caben lado a lado en el nivel; define el largo del larguero." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Alto tarima (in)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AltoBox" Style="{StaticResource FieldBox}" Text="60"
                                             ToolTip="Alto de la tarima con carga; define la separación entre niveles." />
                                    <TextBlock Text="Peralte larguero (in)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="BeamPeralteCombo" Margin="0,2,0,6"
                                              ToolTip="Peraltes permitidos por el larguero seleccionado (del catálogo)." />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Manual (opcional · vacío = auto)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"
                                       Foreground="#8B98A6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Long. larguero (in)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="BeamLenBox" Style="{StaticResource FieldBox}"
                                             ToolTip="Longitud del larguero (A corte). Vacío = automático. El frente usa el nivel más largo." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Claro debajo (in)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ClearBox" Style="{StaticResource FieldBox}"
                                             ToolTip="Claro/separación debajo de este larguero. Vacío = automático. Se ajusta al troquel." />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Aplicar a (celdas):" Style="{StaticResource FieldLabel}" Margin="0,6,0,2"
                                       ToolTip="Hasta dónde llega cada botón dentro de un fondo. Los fondos en los que escribe los decide «Fondos destino»." />
                            <WrapPanel>
                                <Button Content="Celda" Click="ApplyCell_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="66" Margin="0,0,6,6"
                                        ToolTip="Aplica los valores a la celda seleccionada." />
                                <Button x:Name="ApplySelectedButton" Content="Seleccionadas" Click="ApplySelected_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="96" Margin="0,0,6,6"
                                        ToolTip="Aplica a las celdas marcadas en la matriz (Ctrl+clic para marcar varias)." />
                                <Button Content="Nivel" Click="ApplyRow_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="60" Margin="0,0,6,6"
                                        ToolTip="Aplica a todo el nivel (misma fila, todos los frentes)." />
                                <Button Content="Frente" Click="ApplyColumn_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="72" Margin="0,0,6,6"
                                        ToolTip="Aplica a todo el frente (misma columna, todos los niveles)." />
                                <Button Content="Todas" Click="ApplyAll_Click" Style="{StaticResource SecondaryButtonStyle}" MinWidth="66" Margin="0,0,0,6"
                                        ToolTip="Aplica a todas las celdas de cada fondo destino." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- I-43 gate 8A: the properties whose authority is the FRENTE, not the cell. They live here, next
                         to the cell editor, so the editor has ONE model: select in the matrix, edit here, choose the
                         reach, choose the fondos, apply. -->
                    <Border Background="#F1F5F9" BorderBrush="#D8DEE6" BorderThickness="1" Margin="0,10,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="FrontHeader" Text="Frente seleccionado" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />

                            <!-- ONE reach for the three properties, and one Aplicar per property: what travels is
                                 exactly what its own button names, never the value that happened to be visible
                                 alongside it (I-43, gate 8A correction). -->
                            <TextBlock Text="Alcance (frentes):" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FrontScopeBox" SelectedIndex="0"
                                      ToolTip="A qué frentes llega cada «Aplicar» de esta sección, dentro de los «Fondos destino».">
                                <ComboBoxItem Content="Este frente" />
                                <ComboBoxItem Content="Frentes seleccionados" />
                                <ComboBoxItem Content="Todos los frentes" />
                            </ComboBox>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="FrontFloorBeamCheck" Grid.Column="0" Content="Larguero a piso" VerticalAlignment="Center" Foreground="#415161"
                                          ToolTip="El nivel de piso lleva larguero. No cambia nada por sí solo: se escribe con «Aplicar piso»." />
                                <Button x:Name="ApplyFrontFloorBeamButton" Grid.Column="2" Content="Aplicar piso" Click="ApplyFrontFloorBeam_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Escribe SOLO «Larguero a piso» en los frentes del alcance. Las elevaciones no se tocan." />
                            </Grid>

                            <TextBlock Text="Elevación del larguero a piso (in)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FrontRiseBox" Grid.Column="0" Style="{StaticResource FieldBox}" Text="4"
                                         ToolTip="Altura del larguero de piso de este frente. Valor propio del frente: no hay global ni herencia. Solo tiene efecto con «Larguero a piso» activo, pero se conserva si lo desmarcas." />
                                <Button x:Name="ApplyFrontRiseButton" Grid.Column="2" Content="Aplicar elevación" Click="ApplyFrontRise_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Escribe SOLO la elevación en los frentes del alcance. El «Larguero a piso» de cada frente no se toca." />
                            </Grid>

                            <TextBlock Text="Niveles" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FrontLevelsBox" Grid.Column="0" Style="{StaticResource FieldBox}" Text="2"
                                         ToolTip="Cuántos niveles de carga tiene el frente. Es una cantidad exacta, no un incremento: al aplicarla sobre varios frentes todos terminan con ese número. Mínimo 1." />
                                <Button x:Name="ApplyFrontLevelsButton" Grid.Column="2" Content="Aplicar niveles" Click="ApplyFrontLevels_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Escribe SOLO el número de niveles en los frentes del alcance." />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </shell:RackEditorVisualShell.SidePanelContent>

        <!-- STATUS: summary + status line, always visible outside the scroll (SetStatus/RunRecompute target these). -->
        <shell:RackEditorVisualShell.StatusContent>
            <StackPanel>
                <TextBlock x:Name="SummaryText" Foreground="#1F2933" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Foreground="#617080" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </shell:RackEditorVisualShell.StatusContent>

        <!-- MATRIX: bay × level grid + the fondo selector (doble profundidad), the central editing surface. -->
        <shell:RackEditorVisualShell.MatrixContent>
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Matriz frente × nivel — clic para seleccionar una celda, Ctrl+clic para marcar varias. Al cambiar de celda solo se guarda la celda visible; para escribir en los «Fondos destino» usa un botón «Aplicar» con su alcance. El único control propio de la columna es «Medio frente». Nivel 1 abajo."
                               Foreground="#617080" FontSize="11" TextWrapping="Wrap" Margin="10,8,10,0" />
                    <StackPanel x:Name="FondoSelectorPanel" Orientation="Horizontal" Margin="10,6,10,0" Visibility="Collapsed">
                        <TextBlock Text="Editando fondo:" Foreground="#415161" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="FondoSelectorBox" Width="120" SelectionChanged="FondoSelector_Changed" />
                        <TextBlock Text="(qué matriz ves; dónde se escribe lo decide «Fondos destino»)" Foreground="#8A97A4" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="230">
                        <Grid x:Name="MatrixGrid" Margin="10,8,10,10" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </shell:RackEditorVisualShell.MatrixContent>

        <!-- PREVIEW: frontal/lateral preview + view selector (the Canvas and painter are hosted as-is). -->
        <shell:RackEditorVisualShell.PreviewContent>
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="10,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton x:Name="PreviewFrontalRadio" Content="Frontal" IsChecked="True" GroupName="PreviewView"
                                         Checked="PreviewView_Changed" Foreground="#415161" FontSize="11" Margin="0,0,14,0" />
                            <RadioButton x:Name="PreviewLateralRadio" Content="Lateral" GroupName="PreviewView"
                                         Checked="PreviewView_Changed" Foreground="#415161" FontSize="11" />
                        </StackPanel>
                        <TextBlock x:Name="PreviewHint" Text="Vista frontal (X = ancho del tramo, Y = altura). Postes (cabeceras) + largueros por nivel."
                                   Foreground="#617080" FontSize="11" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Border Width="4" Height="14" Background="#3DC986" Margin="0,0,5,0" />
                                <TextBlock Text="poste (cabecera)" Foreground="#617080" FontSize="10.5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Border Width="16" Height="5" Background="#E08A2B" Margin="0,4,5,0" />
                                <TextBlock Text="larguero" Foreground="#617080" FontSize="10.5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Border Width="14" Height="6" Background="#B7C3CF" Margin="0,3,5,0" />
                                <TextBlock Text="placa base" Foreground="#617080" FontSize="10.5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="2" Background="#2E9C66" Margin="0,5,5,0" />
                                <TextBlock Text="celosía (lateral)" Foreground="#617080" FontSize="10.5" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                    <Canvas x:Name="PreviewCanvas" Grid.Row="1" Background="{DynamicResource ShellPreviewBackgroundBrush}" ClipToBounds="True"
                            SizeChanged="PreviewCanvas_SizeChanged" />
                </Grid>
            </Border>
        </shell:RackEditorVisualShell.PreviewContent>

        <!-- ACTIONS: neutral categories preserving the existing visual + functional order
             (Actualizar · Lista de materiales · Guardar en biblioteca · Insertar frontal · Insertar lateral ·
             Insertar planta · Cerrar). Leading = in-place update; Secondary = BOM/library; Primary = the three
             inserts (frontal is the CTA); Trailing = close. Disabled draw actions keep their reason + ShowOnDisabled. -->
        <shell:RackEditorVisualShell.LeadingActions>
            <Button x:Name="UpdateButton" Content="Actualizar" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" Margin="0,0,8,0"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Redibuja en sitio las vistas ya dibujadas de este rack con tus cambios (no inserta nada). Disponible al editar con RACKEDITAR." Click="UpdateExisting_Click" />
        </shell:RackEditorVisualShell.LeadingActions>
        <shell:RackEditorVisualShell.SecondaryActions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Lista de materiales" Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" Margin="0,0,8,0"
                        ToolTip="Genera el BOM por componentes (cabeceras + largueros) del selectivo actual." Click="ShowBom_Click" />
                <Button Content="Guardar en biblioteca" Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" Margin="0,0,8,0"
                        ToolTip="Guarda este diseño selectivo como archivo reutilizable en la biblioteca de diseños." Click="SaveToLibrary_Click" />
            </StackPanel>
        </shell:RackEditorVisualShell.SecondaryActions>
        <shell:RackEditorVisualShell.PrimaryActions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Insertar frontal" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" Margin="0,0,8,0"
                        ToolTip="Inserta una VISTA FRONTAL (postes + largueros) enlazada a este rack (mismo GUID) y refresca las demás vistas." Click="InsertFrontal_Click" />
                <Button x:Name="InsertLateralButton" Content="Insertar lateral" Style="{StaticResource SecondaryButtonStyle}" MinWidth="130" Margin="0,0,8,0"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Inserta una VISTA LATERAL (un corte de poste) enlazada a este rack (mismo GUID) y refresca las demás vistas." Click="InsertLateral_Click" />
                <Button x:Name="InsertPlantaButton" Content="Insertar planta" Style="{StaticResource SecondaryButtonStyle}" MinWidth="130" Margin="0,0,8,0"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Inserta una VISTA PLANTA (superior) enlazada a este rack (mismo GUID) y refresca las demás vistas." Click="InsertPlanta_Click" />
            </StackPanel>
        </shell:RackEditorVisualShell.PrimaryActions>
        <shell:RackEditorVisualShell.TrailingActions>
            <Button Content="Cerrar" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Click="Close_Click" IsCancel="True" />
        </shell:RackEditorVisualShell.TrailingActions>
    </shell:RackEditorVisualShell>
</Window>
