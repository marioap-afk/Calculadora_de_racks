<Window x:Class="RackCad.UI.Systems.Larguero.RackLargueroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:RackCad.UI.Shell"
        Title="Larguero (componente)"
        Style="{DynamicResource BoundedEditorWindowStyle}"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- I-39C. Ultima ventana del arquetipo B sin shell: su chrome estaba escrito a mano, con los colores
         literales que el censo de I-39A registro como el tercer chrome del proyecto. La migracion muda las
         MISMAS instancias, con los mismos manejadores y en el mismo orden, y sustituye cada literal por el
         token compartido de idéntico valor. El larguero no elige del catalogo estructural, asi que la ranura
         del selector queda vacia; y su lista de materiales se consulta en una ventana modal, no en linea,
         asi que la de la receta tambien. -->
    <shell:RackBoundedEditorShell x:Name="Shell">

        <shell:RackBoundedEditorShell.Header>
            <StackPanel>
                <TextBlock Text="Larguero (componente)" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Un larguero = un perfil + 2 ménsulas. Solo visual y para el BOM: aún no tiene bloque de AutoCAD."
                           Foreground="{DynamicResource ShellTextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </shell:RackBoundedEditorShell.Header>

        <shell:RackBoundedEditorShell.Parameters>
            <StackPanel>
                <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,10" />

                <TextBlock Text="Perfil (larguero)" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ProfileBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          SelectionChanged="Profile_Changed" Margin="0,0,0,10" />

                <TextBlock Text="Peralte" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="PeralteBox" SelectionChanged="Field_Changed" Margin="0,0,0,10" />

                <TextBlock Text="Longitud a corte (in)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LengthBox" Text="96" LostFocus="Field_Changed" Margin="0,0,0,10" />

                <TextBlock Text="Ménsula" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="MensulaBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          SelectionChanged="Field_Changed" />
            </StackPanel>
        </shell:RackBoundedEditorShell.Parameters>

        <shell:RackBoundedEditorShell.Preview>
            <!-- Superficie CLARA a proposito, y no la del preview oscuro del editor rico: este esquema se dibuja
                 con rotulos grises que sobre fondo oscuro serian ilegibles. El color es exactamente el que la
                 ventana ya tenia; lo unico que cambia es que ahora tiene nombre. -->
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Canvas x:Name="PreviewCanvas" ClipToBounds="True" Background="Transparent" SizeChanged="Preview_SizeChanged" />
            </Border>
        </shell:RackBoundedEditorShell.Preview>

        <shell:RackBoundedEditorShell.Diagnostics>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource ShellTextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" />
        </shell:RackBoundedEditorShell.Diagnostics>

        <shell:RackBoundedEditorShell.Actions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Ver lista de materiales" Style="{StaticResource SecondaryButtonStyle}" MinWidth="150"
                        Margin="0,0,8,0" Click="ViewBom_Click" />
                <Button Content="Guardar en biblioteca" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150"
                        Margin="0,0,8,0" Click="Save_Click" />
                <Button Content="Cerrar" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" IsCancel="True"
                        Click="Close_Click" />
            </StackPanel>
        </shell:RackBoundedEditorShell.Actions>
    </shell:RackBoundedEditorShell>
</Window>
