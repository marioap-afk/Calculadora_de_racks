<Window x:Class="RackCad.UI.Systems.Cantilever.RackCantileverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RackCad.UI.Controls"
        xmlns:shell="clr-namespace:RackCad.UI.Shell"
        Title="RackCad – Línea Cantilever: editor"
        Style="{DynamicResource EditorShellWindowStyle}"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- I-37D RONDA 2. La ventana principal edita la LÍNEA y nada más.
         El dueño rechazó la ronda 1 porque esta ventana estaba saturada, mezclaba propiedades de línea con
         propiedades internas de componentes, y su arquitectura no reflejaba el flujo real de configuración. Ahora
         la barra lateral lleva SOLO el agregado `CantileverLineDesign` —línea, topología compartida y distribución
         del arriostramiento— y los componentes se editan en su propia ventana, cada uno con sus parámetros, su
         preview, sus diagnósticos y su receta. Aquí sólo queda su RESUMEN y un botón. -->
    <shell:RackEditorVisualShell x:Name="Shell">

        <!-- ============================ SIDEBAR: SOLO la línea ============================ -->
        <shell:RackEditorVisualShell.SidePanelContent>
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="1" Padding="{DynamicResource ShellPanelPadding}">
                <StackPanel>

                    <TextBlock Text="Línea" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                    <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" TextChanged="Name_Changed"
                             ToolTip="Nombre de la línea como la ve el cliente. Se guarda con el bloque para reabrirla y editarla." />
                    <TextBlock Text="GUID" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="GuidText" Text="(se asigna al insertar)" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    <TextBlock Text="Estaciones" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="StationCountBox" LostFocus="Input_Changed" IntegerOnly="True" Minimum="2"
                                           ToolTip="Cuántas columnas tiene la línea. Mínimo dos: con una no hay intervalo, y sin intervalo no hay arriostramiento." />
                    <TextBlock Text="Separación entre centros (in)" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="SpacingBox" LostFocus="Input_Changed" Minimum="0" MinimumInclusive="False"
                                           ToolTip="Distancia centro a centro entre columnas. NO es el largo del separador: ese se deriva de los agujeros de las placas de columna." />

                    <TextBlock Text="Topología compartida" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Caras" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="FaceModeBox" SelectionChanged="Combo_Changed"
                              ToolTip="Sencilla: brazos de un solo lado. Doble: brazos de los dos lados, con las bases espejadas." />
                    <TextBlock Text="Lado (solo en sencilla)" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SingleSideBox" SelectionChanged="Combo_Changed" />
                    <TextBlock Text="Niveles" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="LevelCountBox" LostFocus="Input_Changed" IntegerOnly="True" Minimum="1" />
                    <TextBlock Text="Troquel del primer nivel (índice)" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="FirstPunchBox" LostFocus="Input_Changed" IntegerOnly="True" Minimum="0"
                                           ToolTip="Índice base cero del troquel regular de columna al que atornilla la fila inferior del primer nivel." />
                    <TextBlock Text="Claro solicitado entre niveles (in)" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="ClearHeightBox" LostFocus="Input_Changed" Minimum="0" />
                    <TextBlock Text="Factor de claro superior" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="TopClearFactorBox" LostFocus="Input_Changed" Minimum="0" />
                    <TextBlock Text="Altura de columna" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="HeightModeBox" SelectionChanged="Combo_Changed"
                              ToolTip="Automática: la línea resuelve una altura COMÚN, el máximo de las mínimas por estación. Manual: la altura que escribas, para todas." />
                    <TextBlock Text="Altura manual (in)" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="ManualHeightBox" LostFocus="Input_Changed" IsOptional="True" Minimum="0"
                                           MinimumInclusive="False" />

                    <TextBlock Text="Distribución de arriostramiento" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Cantidad de paneles" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PanelModeBox" SelectionChanged="Combo_Changed"
                              ToolTip="Automático: la regla de producto max(1, techo((H − 72)/60)). Manual: la cantidad que escribas." />
                    <TextBlock Text="Cantidad manual" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="ManualPanelCountBox" LostFocus="Input_Changed" IsOptional="True"
                                           IntegerOnly="True" Minimum="1" />
                    <TextBlock Text="Altura de panel (in)" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="PanelHeightBox" LostFocus="Input_Changed" Minimum="0" MinimumInclusive="False" />
                    <TextBlock Text="Altura de espacio central (in)" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="CentralSpaceBox" LostFocus="Input_Changed" Minimum="0" MinimumInclusive="False" />
                    <TextBlock x:Name="BracingSummaryText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />

                    <!-- ============ SECUENCIA DE PANELES: la regla, o tramo a tramo ============
                         La tabla sólo aparece en avanzado. En automático la secuencia la manda la regla y una
                         tabla editable que no gobierna nada sería una invitación a escribir en ella y no
                         entender por qué el dibujo no cambia. -->
                    <TextBlock Text="Secuencia de paneles" Style="{StaticResource SectionTitle}" />
                    <ComboBox x:Name="PanelLayoutModeBox" SelectionChanged="PanelLayoutMode_Changed"
                              ToolTip="Automática: la regla reparte los paneles en la altura. Avanzada: declaras tramo a tramo de qué cota a qué cota va cada uno y cuál lleva tensores." />

                    <StackPanel x:Name="AdvancedPanelArea" Visibility="Collapsed" Margin="0,6,0,0">
                        <DataGrid x:Name="PanelSegmentGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single" SelectionUnit="FullRow" MaxHeight="220"
                                  Background="Transparent" BorderBrush="{DynamicResource ShellBorderBrush}"
                                  BorderThickness="1" FontSize="11"
                                  CellEditEnding="PanelSegment_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="28" />
                                <DataGridTextColumn Header="Y1" Binding="{Binding Y1}" Width="*" />
                                <DataGridTextColumn Header="Y2" Binding="{Binding Y2}" Width="*" />
                                <!-- La altura es DERIVADA y por eso es de sólo lectura: se edita moviendo una
                                     cota, nunca escribiendo la altura, que sería una tercera autoridad. -->
                                <DataGridTextColumn Header="Alto" Binding="{Binding Height}" IsReadOnly="True" Width="*" />
                                <DataGridCheckBoxColumn Header="Tens." Binding="{Binding Braced}" Width="44" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="PanelAddButton" Content="Agregar" Click="PanelAdd_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,4" Padding="8,3" />
                            <Button x:Name="PanelRemoveButton" Content="Eliminar" Click="PanelRemove_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,4" Padding="8,3" />
                            <Button x:Name="PanelUpButton" Content="Subir" Click="PanelUp_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,4" Padding="8,3" />
                            <Button x:Name="PanelDownButton" Content="Bajar" Click="PanelDown_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,4" Padding="8,3" />
                            <Button x:Name="PanelSplitButton" Content="Dividir" Click="PanelSplit_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,4" Padding="8,3" />
                            <Button x:Name="PanelMergeButton" Content="Unir" Click="PanelMerge_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,4" Padding="8,3" />
                            <Button x:Name="PanelToggleButton" Content="Tensores" Click="PanelToggle_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,4" Padding="8,3" />
                            <Button x:Name="PanelMaterializeButton" Content="Materializar automático"
                                    Click="PanelMaterialize_Click" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,4,4" Padding="8,3" />
                        </WrapPanel>

                        <!-- Los errores se ven AQUI, en la misma ventana. Un editor que manda al usuario a
                             buscar el motivo en otro sitio es un editor que no dice lo que pasa. -->
                        <TextBlock x:Name="PanelLayoutErrorText" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,4,0,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource ShellStatusErrorBrush}" />
                    </StackPanel>

                    <!-- ============ COMPONENTES: resumen + botón. Sus parámetros viven en su ventana ============ -->
                    <TextBlock Text="Componentes" Style="{StaticResource SectionTitle}" />

                    <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" Padding="8" Margin="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Columna y base" FontSize="12"
                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <TextBlock x:Name="ColumnBaseSummary" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ConfigureColumnBaseButton" Grid.Column="1" Content="Configurar"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ConfigureColumnBase_Click" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Brazo (por omisión)" FontSize="12"
                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <TextBlock x:Name="ArmSummary" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ConfigureArmButton" Grid.Column="1" Content="Configurar"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ConfigureArm_Click" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Separador" FontSize="12"
                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <TextBlock x:Name="SeparatorSummary" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ConfigureSeparatorButton" Grid.Column="1" Content="Configurar"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ConfigureSeparator_Click" />
                        </Grid>
                    </Border>

                    <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tensor" FontSize="12"
                                           Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                                <TextBlock x:Name="BraceSummary" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ConfigureBraceButton" Grid.Column="1" Content="Configurar"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ConfigureBrace_Click" />
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>
        </shell:RackEditorVisualShell.SidePanelContent>

        <!-- ============================ MATRIZ estación × nivel × lado ============================ -->
        <shell:RackEditorVisualShell.MatrixContent>
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Matriz estación × nivel × lado — clic en una celda para verla; «Editar brazo» abre el configurador. Nivel 1 abajo."
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="10,8,10,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="170">
                        <Grid x:Name="MatrixGrid" Margin="10,8,10,6" />
                    </ScrollViewer>

                    <!-- El formulario COMPLETO del brazo ya no vive aquí: sólo el resumen de la celda y el acceso
                         a su configurador. Era la mitad de la saturación que el dueño rechazó. -->
                    <Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0" Padding="10,8,10,10">
                        <StackPanel>
                            <TextBlock x:Name="CellHeaderText" Text="Ninguna celda seleccionada" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="CellSummaryText" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="EditCellArmButton" Content="Editar brazo de la celda" MinWidth="180"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="EditCellArm_Click"
                                        ToolTip="Abre el configurador de brazo para el alcance elegido." />
                                <TextBlock Text="Aplicar a:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <ComboBox x:Name="ScopeBox" Width="150" VerticalAlignment="Center"
                                          ToolTip="Celda · toda la estación · ese nivel en toda la línea · ese lado en toda la línea · toda la línea." />
                                <Button x:Name="RestoreCellButton" Content="Restaurar" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="100" Margin="8,0,0,0" Click="RestoreCell_Click"
                                        ToolTip="Borra las excepciones del alcance elegido: esas celdas vuelven al brazo por omisión." />
                                <TextBlock x:Name="OverrideCountText" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </shell:RackEditorVisualShell.MatrixContent>

        <!-- ============================ VISTA PREVIA: tiene prioridad visual ============================ -->
        <shell:RackEditorVisualShell.PreviewContent>
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="10,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton x:Name="PreviewFrontalRadio" Content="Frontal" IsChecked="True" GroupName="PreviewView"
                                         Checked="PreviewView_Changed" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                         FontSize="11" Margin="0,0,14,0" />
                            <RadioButton x:Name="PreviewLateralRadio" Content="Lateral" GroupName="PreviewView"
                                         Checked="PreviewView_Changed" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                         FontSize="11" Margin="0,0,14,0" />
                            <RadioButton x:Name="PreviewPlantaRadio" Content="Planta" GroupName="PreviewView"
                                         Checked="PreviewView_Changed" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                         FontSize="11" Margin="0,0,14,0" />
                            <TextBlock Text="Estación de la lateral:" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="6,0,6,0" />
                            <controls:NumericField x:Name="LateralStationBox" Width="52" IntegerOnly="True" Minimum="1"
                                                   LostFocus="LateralStation_Changed"
                                                   ToolTip="Qué estación muestra la vista lateral. No cambia el BOM ni la firma física de la línea." />
                            <TextBlock Text="En planta:" Foreground="{DynamicResource ShellTextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="14,0,6,0" />
                            <CheckBox x:Name="PlantaShowArmsCheck" Content="Brazos"
                                      Click="PlantaVisibility_Changed" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                      FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                                      ToolTip="Dibuja los brazos en la vista en planta. Apagado por omisión: no cambia el BOM ni la firma física de la línea, y no afecta a la frontal ni a la lateral." />
                            <CheckBox x:Name="PlantaShowBracesCheck" Content="Tensores"
                                      Click="PlantaVisibility_Changed" Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                      FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"
                                      ToolTip="Dibuja los tensores y sus adaptadores en la vista en planta. Apagado por omisión: no cambia el BOM ni la firma física de la línea, y no afecta a la frontal ni a la lateral." />
                        </StackPanel>
                        <TextBlock x:Name="PreviewHint" Text="Vista frontal de la línea completa."
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                        <WrapPanel x:Name="LegendPanel" Margin="0,6,0,0" />
                    </StackPanel>
                    <Canvas x:Name="PreviewCanvas" Grid.Row="1" Background="{DynamicResource ShellPreviewBackgroundBrush}"
                            ClipToBounds="True" SizeChanged="PreviewCanvas_SizeChanged" />
                </Grid>
            </Border>
        </shell:RackEditorVisualShell.PreviewContent>

        <!-- ============================ ESTADO ============================ -->
        <shell:RackEditorVisualShell.StatusContent>
            <StackPanel>
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource ShellTextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource ShellTextSecondaryBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </shell:RackEditorVisualShell.StatusContent>

        <!-- ============ ACCIONES: lo que NO dibuja, separado de lo que dibuja ============ -->
        <shell:RackEditorVisualShell.LeadingActions>
            <Button x:Name="UpdateButton" Content="Actualizar" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120"
                    Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" Click="Update_Click"
                    ToolTip="Redibuja en sitio las vistas ya dibujadas de esta línea (no inserta nada). Disponible al editar con RACKEDITAR." />
        </shell:RackEditorVisualShell.LeadingActions>
        <shell:RackEditorVisualShell.SecondaryActions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BomButton" Content="Lista de materiales" Style="{StaticResource SecondaryButtonStyle}" MinWidth="150"
                        Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" Click="Bom_Click"
                        ToolTip="Genera el BOM por componentes de la línea: columna-base, brazos, separadores y tensores." />
                <Button x:Name="SaveLibraryButton" Content="Guardar en biblioteca" Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="150" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" Click="SaveLibrary_Click"
                        ToolTip="Guarda esta línea como archivo reutilizable en la biblioteca de diseños." />
            </StackPanel>
        </shell:RackEditorVisualShell.SecondaryActions>
        <shell:RackEditorVisualShell.PrimaryActions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="InsertFrontalButton" Content="Insertar frontal" Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="130" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" Click="InsertFrontal_Click"
                        ToolTip="Inserta la VISTA FRONTAL de la línea completa, ligada a esta línea (mismo GUID)." />
                <Button x:Name="InsertLateralButton" Content="Insertar lateral" Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="130" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" Click="InsertLateral_Click"
                        ToolTip="Inserta la VISTA LATERAL de la estación elegida, ligada a esta línea (mismo GUID)." />
                <Button x:Name="InsertPlantaButton" Content="Insertar planta" Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="130" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True" Click="InsertPlanta_Click"
                        ToolTip="Inserta la VISTA EN PLANTA de la línea completa, ligada a esta línea (mismo GUID)." />
            </StackPanel>
        </shell:RackEditorVisualShell.PrimaryActions>
        <shell:RackEditorVisualShell.TrailingActions>
            <Button Content="Cerrar" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Click="Close_Click" IsCancel="True" />
        </shell:RackEditorVisualShell.TrailingActions>
    </shell:RackEditorVisualShell>
</Window>
