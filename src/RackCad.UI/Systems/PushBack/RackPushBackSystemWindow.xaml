<Window x:Class="RackCad.UI.Systems.PushBack.RackPushBackSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RackCad.UI.Controls"
        xmlns:shell="clr-namespace:RackCad.UI.Shell"
        Title="Sistema Push Back - editor"
        Style="{DynamicResource EditorShellWindowStyle}"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RackCad.UI;component/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- I-42 (ronda post-5a73b92) — el RITMO de la barra de acciones, en dos tokens y no en margenes
                 sueltos. Antes convivian tres separaciones distintas (6, 8 y 14) escritas a mano en cada boton, y
                 la barra se veia desalineada. Son locales a esta ventana a proposito: la correccion es de
                 composicion, no del shell. -->
            <Thickness x:Key="ActionGap">0,0,6,4</Thickness>
            <Thickness x:Key="ActionGroupGap">0,0,16,4</Thickness>
            <Thickness x:Key="ActionLast">0,0,0,4</Thickness>
        </ResourceDictionary>
    </Window.Resources>

    <!-- I-18b (ADR-0019): the Push Back editor is COMPOSED over RackEditorVisualShell and adopts the COMMON visual
         contract — surfaces, borders, padding, typography, colors, action-button styles and the dark preview
         background all come from the shared Shell* tokens / AppStyles styles.

         PB-VAL-01 (owner retest): the INTERNAL composition now follows the structural pattern of the dynamic editor.
         The whole "Celda seleccionada" editor and its "Aplicar a" scopes live in the SIDEBAR (where the dynamic editor
         keeps them), so MatrixContent holds ONLY the toolbar and the cards; and the sidebar's
         dense WrapPanels are replaced by vertical sections of one/two-column grids with the same rhythm (SectionTitle +
         FieldLabel above each full-width control, 10px gutter) and width as the dynamic sidebar. Controls, x:Names,
         handlers, NumericField/CatalogCombo, selection and multi-selection are unchanged; the code-behind is NOT
         touched; the shell, the action bar, the status band and the technical preview stay exactly as they were. -->
    <shell:RackEditorVisualShell x:Name="Shell">

        <!-- ============================ SIDEBAR: settings, selected-cell editor and safety (the shell provides the scroll) ============================ -->
        <shell:RackEditorVisualShell.SidePanelContent>
            <Border Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}"
                    BorderThickness="1" Padding="{DynamicResource ShellPanelPadding}">
                <StackPanel>

                    <TextBlock Text="Rack" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                    <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" TextChanged="Name_Changed"
                             ToolTip="Nombre del rack como lo ve el cliente. Se guarda con el bloque para reabrirlo y editarlo." />
                    <TextBlock Text="GUID" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="GuidText" Text="(se asigna al insertar)" TextWrapping="Wrap"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />

                    <TextBlock Text="Anotaciones y dibujo" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="NumberFrontsCheck" Content="Numerar frentes" Margin="0,4,0,0"
                              Foreground="{DynamicResource ShellTextPrimaryBrush}" Click="Input_Changed" />
                    <CheckBox x:Name="NumberLevelsCheck" Content="Numerar niveles" Margin="0,4,0,0"
                              Foreground="{DynamicResource ShellTextPrimaryBrush}" Click="Input_Changed" />
                    <CheckBox x:Name="DrawRackNameCheck" Content="Dibujar nombre" Margin="0,4,0,0"
                              Foreground="{DynamicResource ShellTextPrimaryBrush}" Click="Input_Changed" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Escala anot." Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="AnnotationScaleBox" LostFocus="Input_Changed"
                                                   Minimum="0" MinimumInclusive="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cotas" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="DimensionsBox" SelectionChanged="Combo_Changed" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Estructura global" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Frentes" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="FrontCountBox" LostFocus="FrontCount_Changed"
                                                   IntegerOnly="True" Minimum="1" />
                            <TextBlock Text="Tolerancia" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="ToleranceBox" LostFocus="Input_Changed"
                                                   Minimum="0" MinimumInclusive="False" />
                            <TextBlock Text="Peralte IN/OUT base" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="BeamDepthBox" LostFocus="Input_Changed"
                                                   Minimum="0" MinimumInclusive="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fondos base" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="PalletsDeepBox" LostFocus="Input_Changed"
                                                   IntegerOnly="True" Minimum="2" />
                            <TextBlock Text="Peralte poste" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="PostPeralteBox" LostFocus="Input_Changed" Minimum="0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Poste" Style="{StaticResource FieldLabel}" />
                    <controls:CatalogCombo x:Name="PostBox" DisplayMemberPath="DisplayName" SelectionChanged="Combo_Changed" />

                    <!-- ==================== I-42 · PUSH BACK COMPUESTO (LADO A / LADO B) ====================
                         El rack pasa a tener DOS lados sobre UNA sola estructura fisica. Aqui vive todo lo que I-42
                         anade: declarar el lado B, elegir el lado ACTIVO (la matriz de abajo y los cinco alcances
                         trabajan sobre el, sin duplicar ni un control), el hueco de la interfaz con su separador
                         central, la topologia de cada celda con su sentido y la estructura efectiva de cada lado con
                         su restauracion. Retirar el lado B no borra su configuracion: queda dormante. -->
                    <TextBlock Text="Push Back compuesto (A/B)" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="SideBPresentCheck" Content="Rack de dos sentidos (lado B)" Margin="0,0,0,4"
                              Foreground="{DynamicResource ShellTextPrimaryBrush}"
                              Checked="SideBPresent_Changed" Unchecked="SideBPresent_Changed"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="Anade el lado B sobre la MISMA estructura fisica. Retirarlo no borra su configuraci&#243;n." />
                    <!-- Toda la configuracion EXCLUSIVA del compuesto vive dentro de este contenedor. Con el rack de
                         un solo sentido se COLAPSA (no solo se deshabilita), asi que no ocupa espacio ni satura la
                         barra lateral: el editor legacy queda exactamente como estaba antes de I-42. -->
                    <StackPanel x:Name="CompositeSection" Visibility="Collapsed">
                    <TextBlock Text="Lado activo" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SideSelectorBox" SelectionChanged="SideSelector_Changed"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="La matriz Frente x Nivel, la celda seleccionada y los cinco alcances trabajan sobre este lado." />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hueco (in)" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="GapBox" LostFocus="Gap_Changed" Minimum="0"
                                                   ToolTipService.ShowOnDisabled="True"
                                                   ToolTip="Separaci&#243;n F&#205;SICA entre la l&#237;nea terminal de A y la inicial de B. Puede ser 0: los dos extremos f&#237;sicos siguen existiendo." />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox x:Name="CentralSeparatorCheck" Content="Separador central" Margin="0,0,0,4"
                                      Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                      Checked="CentralSeparator_Changed" Unchecked="CentralSeparator_Changed"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="Coloca en el hueco el separador de cabecera que YA usa el rack. Necesita hueco mayor que cero." />
                        </StackPanel>
                    </Grid>

                    <!-- I-42 (ronda 7): la DEFENSA DE MONTACARGAS por lado. Un rack compuesto tiene dos pasillos y
                         cada uno se decide por separado. Es INTENCION: donde puede materializarse lo sigue
                         decidiendo la fisica (solo en una cara de ataque real, nunca en la interfaz). -->
                    <TextBlock Text="Defensa de montacargas" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="DefenseSideACheck" Content="Lado A" Margin="0,0,16,4"
                                  Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                  Checked="DefenseSide_Changed" Unchecked="DefenseSide_Changed"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Defensa en el pasillo del lado A. Solo se dibuja donde exista una cara de carga real." />
                        <CheckBox x:Name="DefenseSideBCheck" Content="Lado B" Margin="0,0,0,4"
                                  Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                  Checked="DefenseSide_Changed" Unchecked="DefenseSide_Changed"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Defensa en el pasillo del lado B. Solo se dibuja donde exista una cara de carga real." />
                    </StackPanel>

                    <!-- I-42 (ronda post-82e918b): aqui vivia «Frente presente en este lado», y competia con «En
                         blanco» por la MISMA decision — uno quitaba cabeceras donde no debia y el otro no. Ahora la
                         autoridad visible es una sola: la casilla «En blanco» de la cabecera de cada columna de la
                         matriz, que ya existia (I-33) y funciona igual en un rack de un sentido y en uno compuesto.
                         La presencia por lado se DERIVA de ella. -->
                    <TextBlock x:Name="SlotPresentText" Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <TextBlock Text="Topolog&#237;a de la celda" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ComboBox x:Name="CellTopologyBox"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="Solo A / Solo B = una cama. Encontradas = DOS camas independientes. Corrida = UNA cama que atraviesa A + hueco + B." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ComboBox x:Name="RunDirectionBox"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="Sentido de la cama corrida. Cambia f&#237;sicamente qu&#233; extremo es ALTO, no solo el dibujo." />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Alcance:" Style="{StaticResource FieldLabel}" Margin="0,6,0,2" />
                    <ComboBox x:Name="TopologyScopeBox" SelectedIndex="0"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="Los MISMOS cinco alcances del editor. &#171;Selecci&#243;n&#187; usa las celdas marcadas con Ctrl + clic.">
                        <ComboBoxItem Content="Celda" />
                        <ComboBoxItem Content="Selecci&#243;n" />
                        <ComboBoxItem Content="Nivel" />
                        <ComboBoxItem Content="Frente" />
                        <ComboBoxItem Content="Todo" />
                    </ComboBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="ApplyTopologyButton" Content="Aplicar topolog&#237;a"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="126" Margin="0,0,6,6"
                                Click="ApplyTopology_Click"
                                ToolTip="Escribe SOLO la topolog&#237;a y el sentido en las celdas del alcance." />
                    </WrapPanel>

                    <!-- I-42 (ronda Owner): los TOPES de los dos lados, visibles a la vez y editables sin salir de
                         aqui. Antes solo se llegaba a ellos desde Seguridad, que trabaja sobre el LADO ACTIVO, y el
                         usuario no tenia forma de ver «A si / B no» ni de decidirlo sin deducir el modo de la ventana.
                         La autoridad NO cambia: sigue siendo el RearTope de cada lado (PushBackRearTopeConfig y sus
                         OffCells). Esto es una superficie, no un segundo modelo. -->
                    <TextBlock Text="Tope posterior &#8212; extremo ALTO de cada cama" Style="{StaticResource FieldLabel}" Margin="0,10,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="TopeSideACheck" Grid.Column="0" Content="Tope lado A"
                                  Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Tope posterior de la cama del lado A en esta celda." />
                        <CheckBox x:Name="TopeSideBCheck" Grid.Column="2" Content="Tope lado B"
                                  Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Tope posterior de la cama del lado B en esta celda." />
                    </Grid>
                    <TextBlock Text="Alcance:" Style="{StaticResource FieldLabel}" Margin="0,6,0,2" />
                    <ComboBox x:Name="TopeScopeBox" SelectedIndex="0"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="Los MISMOS cinco alcances del editor.">
                        <ComboBoxItem Content="Celda" />
                        <ComboBoxItem Content="Selecci&#243;n" />
                        <ComboBoxItem Content="Nivel" />
                        <ComboBoxItem Content="Frente" />
                        <ComboBoxItem Content="Todo" />
                    </ComboBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="ApplyTopesButton" Content="Aplicar topes"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="112" Margin="0,0,6,6"
                                Click="ApplyTopes_Click"
                                ToolTip="Escribe SOLO los dos topes en las celdas del alcance." />
                    </WrapPanel>
                    <TextBlock x:Name="TopeApplicabilityText" Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" />

                    <!-- I-42 (ronda Owner): esto NO es «otro fondo». El fondo de almacenamiento es de la celda y del
                         frente («Fondos frente» y «Fondo celda»); esto es hasta donde llega la ESTRUCTURA longitudinal
                         del lado, que normalmente se deriva de la demanda de sus celdas y solo se fija a mano cuando
                         se quiere estructura de sobra. Por eso se ven la propuesta y la efectiva, y el campo se llama
                         ajuste manual: para que no parezcan dos campos que hacen lo mismo. -->
                    <TextBlock Text="Estructura longitudinal del lado" Style="{StaticResource SectionTitle}" Margin="0,12,0,2" />
                    <TextBlock Text="Hasta d&#243;nde llega la estructura de este lado. NO es el fondo de almacenamiento: ese se edita arriba, en &#171;Fondos frente&#187; y &#171;Fondo celda&#187;."
                               Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Propuesta (autom&#225;tica)" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="StructureProposedText" Text="&#8212;"
                                       Foreground="{DynamicResource ShellTextSecondaryBrush}" Margin="0,0,0,4" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Efectiva (la que se dibuja)" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="StructureEffectiveText" Text="&#8212;"
                                       Foreground="{DynamicResource ShellTextSecondaryBrush}" Margin="0,0,0,4" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Ajuste manual (fondos)" Style="{StaticResource FieldLabel}" />
                    <controls:NumericField x:Name="StructureOverrideBox" IsOptional="True" IntegerOnly="True" Minimum="2"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTip="Fuerza hasta d&#243;nde llega la estructura de este lado. Vac&#237;o = seguir la propuesta autom&#225;tica. No cambia el fondo de ninguna celda ni de ning&#250;n frente." />
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="ApplyStructureButton" Content="Aplicar ajuste"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="118" Margin="0,0,6,6"
                                Click="ApplyStructure_Click"
                                ToolTip="Fija el ajuste manual de este lado." />
                        <Button x:Name="RestoreStructureButton" Content="Volver a autom&#225;tico"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="148" Margin="0,0,6,6"
                                Click="RestoreStructure_Click"
                                ToolTip="Elimina el ajuste manual: el lado vuelve a seguir la propuesta ACTUAL." />
                    </WrapPanel>
                    <TextBlock x:Name="CompositeStructureText" Text=""
                               Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- PB-013 (I-32): Fondo and Unidad are RACK-WIDE and stay editable here. Frente, Alto and Peso
                         belong to the CELL, so this panel only MIRRORS the selected one: they used to be editable and
                         changed nothing, because the cell always wins. -->
                    <TextBlock Text="Tarima (datos generales)" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Frente, Alto y Peso son de la celda: aquí solo se muestran los de la celda seleccionada. Fondo y Unidad son de todo el rack."
                               Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,3" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Frente" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="FrontBox" IsEnabled="False"
                                                   Minimum="0" MinimumInclusive="False"
                                                   ToolTip="Se edita en «Celda seleccionada» → Tarima frente." />
                            <TextBlock Text="Alto" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="PalletHeightBox" IsEnabled="False"
                                                   Minimum="0" MinimumInclusive="False"
                                                   ToolTip="Se edita en «Celda seleccionada» → Tarima alto." />
                            <TextBlock Text="Unidad" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="WeightUnitBox" SelectionChanged="Combo_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fondo" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="DepthBox" LostFocus="Input_Changed"
                                                   Minimum="0" MinimumInclusive="False" />
                            <TextBlock Text="Peso" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField x:Name="WeightBox" IsEnabled="False" Minimum="0"
                                                   ToolTip="Se edita en «Celda seleccionada» → Tarima peso." />
                        </StackPanel>
                    </Grid>

                    <!-- Owner decision (2026-07-24): ONE highlighted panel, at the dynamic editor's visual pattern,
                         that SEPARATES what belongs to the whole FRENTE from what belongs to the selected CELL, each
                         with its own scopes. The front data reuse DynamicFrontMatrix.ApplyFrontValuesTo through the
                         existing state; no second authority is introduced. -->
                    <Border Background="#F1F4F8" BorderBrush="#D8DEE6" BorderThickness="1" Padding="10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="CellSelectionPrimaryText" Foreground="#1F2933" FontWeight="SemiBold"
                                       FontSize="12" TextWrapping="Wrap" />

                            <TextBlock Text="Frente seleccionado" Style="{StaticResource SectionTitle}" Margin="0,6,0,2" />
                            <TextBlock Text="Estos datos pertenecen al frente completo y no usan el alcance de celdas."
                                       Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,3" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Posiciones" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="PositionsBox" LostFocus="Input_Changed"
                                                           IntegerOnly="True" Minimum="1" />
                                    <TextBlock x:Name="FondosFrenteLabel" Text="Fondos frente" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="FondosBox" LostFocus="Input_Changed"
                                                           IntegerOnly="True" Minimum="2" />
                                    <TextBlock Text="Alto 1er nivel" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="FirstLevelHeightBox" LostFocus="Input_Changed" Minimum="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Niveles" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="LevelsBox" LostFocus="Input_Changed"
                                                           IntegerOnly="True" Minimum="1" />
                                    <TextBlock Text="Fondo inicial" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="DepthStartBox" LostFocus="Input_Changed"
                                                           IntegerOnly="True" Minimum="1" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,6,0,2">
                                <Button x:Name="ApplyFrontDataButton" Content="Este frente" Click="ApplyFrontData_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="88" Margin="0,0,6,6" />
                                <Button x:Name="ApplySelectedFrontDataButton" Content="Frentes seleccionados" Click="ApplySelectedFrontData_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" Margin="0,0,6,6"
                                        ToolTip="Aplica estos datos a los frentes que tengan al menos una celda seleccionada con Ctrl." />
                                <Button x:Name="ApplyAllFrontDataButton" Content="Todos los frentes" Click="ApplyAllFrontData_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="130" Margin="0,0,6,6" />
                            </WrapPanel>

                            <TextBlock Text="Celda seleccionada" Style="{StaticResource SectionTitle}" Margin="0,10,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tarima frente" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="CellPalletFrontBox" LostFocus="Input_Changed"
                                                           Minimum="0" MinimumInclusive="False" />
                                    <TextBlock Text="Tarima peso" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="CellPalletWeightBox" LostFocus="Input_Changed" Minimum="0" />
                                    <TextBlock Text="Claro" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="CellClearBox" LostFocus="Input_Changed" Minimum="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tarima alto" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="CellPalletHeightBox" LostFocus="Input_Changed"
                                                           Minimum="0" MinimumInclusive="False" />
                                    <TextBlock Text="Largo manual" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="CellBeamLengthOverrideBox" LostFocus="Input_Changed"
                                                           IsOptional="True" Minimum="0" MinimumInclusive="False" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Larguero IN/OUT" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CellInOutBeamBox" DisplayMemberPath="Label" SelectedValuePath="Id"
                                      SelectionChanged="InOutBeam_Changed" />
                            <TextBlock Text="Larguero intermedio" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CellIntermediateBeamBox" DisplayMemberPath="Label" SelectedValuePath="Id"
                                      SelectionChanged="IntermediateBeam_Changed" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Peralte IN/OUT" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CellInOutPeralteBox" SelectionChanged="Combo_Changed" />
                                    <TextBlock Text="Peralte posterior" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="RearPeralteBox" SelectionChanged="Combo_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Peralte interm." Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="CellIntermediatePeralteBox" SelectionChanged="Combo_Changed" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Aplicar a:" Style="{StaticResource FieldLabel}" Margin="0,7,0,2" />
                            <WrapPanel>
                                <Button x:Name="ApplyCellButton" Content="Celda" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="66" Margin="0,0,6,6" Click="ApplyCell_Click" />
                                <Button x:Name="ApplySelectedButton" Content="Selecci&#243;n" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="88" Margin="0,0,6,6" Click="ApplySelected_Click"
                                        ToolTip="Ctrl + clic agrega o quita celdas de la selecci&#243;n m&#250;ltiple." />
                                <Button x:Name="ApplyLevelButton" Content="Nivel" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="66" Margin="0,0,6,6" Click="ApplyLevel_Click" />
                                <Button x:Name="ApplyFrontButton" Content="Frente" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="66" Margin="0,0,6,6" Click="ApplyFront_Click" />
                                <Button x:Name="ApplyAllButton" Content="Todo" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="66" Margin="0,0,6,6" Click="ApplyAll_Click" />
                            </WrapPanel>
                            <TextBlock Text="Ctrl + clic selecciona varias celdas. Los alcances copian tarima, claro, largo y ambos largueros; el tope posterior NO viaja con ellos &#8212; se configura en Seguridad."
                                       Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" />

                            <!-- ==================== I-41 · FONDO Y TARIMA POR CELDA (PB-015 / PB-016) ====================
                                 Estas dos propiedades tienen sus PROPIOS botones a proposito. Los alcances de arriba
                                 aplican el buffer COMPLETO de la celda, asi que hacerlas viajar en el arrastraria de
                                 propina el claro, el largo y ambos largueros de la celda origen. Cada boton de aqui
                                 escribe UNA sola propiedad sobre el alcance elegido, y una sola vez: el recalculo se
                                 difiere hasta el final de la operacion. La seleccion y los cinco alcances son los MISMOS
                                 (Ctrl + clic en la matriz); no hay un segundo modelo de seleccion. -->
                            <TextBlock Text="Fondo y tarima por celda" Style="{StaticResource SectionTitle}" Margin="0,10,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <!-- I-42: la etiqueta y el significado del campo cambian cuando la celda
                                         seleccionada es una CAMA CORRIDA: entonces edita el fondo PROPIO de esa cama,
                                         que no es el de A, ni el de B, ni su suma. Es el MISMO control, con los
                                         MISMOS cinco alcances; lo que cambia es a que autoridad escribe. -->
                                    <TextBlock x:Name="CellFondoLabel" Text="Fondo celda" Style="{StaticResource FieldLabel}" />
                                    <controls:NumericField x:Name="CellFondoOverrideBox" LostFocus="CellFondo_Changed"
                                                           IsOptional="True" IntegerOnly="True" Minimum="2"
                                                           ToolTipService.ShowOnDisabled="True"
                                                           ToolTip="Fondo propio de esta celda. Vac&#237;o = hereda el «Fondos frente»." />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <CheckBox x:Name="CellDrawPalletCheck" Content="Dibujar tarima" Margin="0,0,0,4"
                                              Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                              Checked="CellDrawPallet_Changed" Unchecked="CellDrawPallet_Changed"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTip="Referencia VISUAL en el lateral y en los dos cortes frontales. Nunca entra al BOM." />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Alcance de estas dos:" Style="{StaticResource FieldLabel}" Margin="0,6,0,2" />
                            <ComboBox x:Name="CellPropertyScopeBox" SelectedIndex="0"
                                      ToolTip="A qu&#233; celdas aplican los botones de abajo. «Selecci&#243;n» usa las celdas marcadas con Ctrl + clic.">
                                <ComboBoxItem Content="Celda" />
                                <ComboBoxItem Content="Selecci&#243;n" />
                                <ComboBoxItem Content="Nivel" />
                                <ComboBoxItem Content="Frente" />
                                <ComboBoxItem Content="Todo" />
                            </ComboBox>
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="ApplyCellFondoButton" Content="Aplicar fondo" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="104" Margin="0,0,6,6" Click="ApplyCellFondo_Click"
                                        ToolTip="Escribe SOLO el fondo en las celdas del alcance." />
                                <Button x:Name="RestoreCellFondoButton" Content="Restaurar fondo" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="118" Margin="0,0,6,6" Click="RestoreCellFondo_Click"
                                        ToolTip="Elimina el fondo propio: las celdas del alcance vuelven a heredar el del frente." />
                                <Button x:Name="ApplyCellPalletButton" Content="Aplicar tarima" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="110" Margin="0,0,6,6" Click="ApplyCellPallet_Click"
                                        ToolTip="Escribe SOLO el estado de la tarima en las celdas del alcance." />
                                <Button x:Name="RestoreCellPalletButton" Content="Quitar tarimas" Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="112" Margin="0,0,6,6" Click="RestoreCellPallet_Click"
                                        ToolTip="Devuelve las celdas del alcance al valor por omisi&#243;n: sin tarima." />
                            </WrapPanel>
                            <TextBlock Text="El «Fondos frente» de arriba sigue siendo el valor que heredan las celdas sin fondo propio. La estructura del frente se dimensiona por el nivel m&#225;s profundo. Las tarimas son referencia visual y no entran al BOM."
                                       Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Seguridad (extremo bajo, sin guías)" Style="{StaticResource SectionTitle}" />
                    <Button x:Name="SafetyButton" Content="Configurar seguridad..." Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="180" HorizontalAlignment="Left" Click="Safety_Click"
                            ToolTip="Botas, protectores, desviadores, defensa y el TOPE POSTERIOR (SAQUE y celdas desactivadas)." />
                    <TextBlock x:Name="SafetySummary" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" />

                    <!-- ============================ AVANZADO: edicion por MODULO longitudinal (I-35 / PB-011) ============================
                         Los modulos son UNA sola secuencia longitudinal de RACK, compartida por todos los frentes y todos los
                         postes: personalizar un modulo personaliza el rack entero. NO hay modulo por frente ni por poste.
                         La seleccion es UNICA (un ComboBox). Toda edicion queda ESCENIFICADA en la sesion hasta Confirmar;
                         Cancelar la descarta entera. El configurador de cabecera compartido NO se modifica: se abre sobre una
                         COPIA y su resultado se acepta o se descarta desde aqui. -->
                    <TextBlock Text="Avanzado" Style="{StaticResource SectionTitle}" Margin="0,14,0,2" />
                    <CheckBox x:Name="AdvancedModulesToggle" Content="Editar modulos" Margin="0,2,0,0"
                              Foreground="{DynamicResource ShellTextPrimaryBrush}" FontWeight="SemiBold"
                              Checked="AdvancedModules_Changed" Unchecked="AdvancedModules_Changed"
                              ToolTipService.ShowOnDisabled="True"
                              ToolTip="Muestra la edicion por modulo longitudinal: cabeceras y separadores del rack." />

                    <StackPanel x:Name="AdvancedModulesPanel" Visibility="Collapsed" Margin="0,6,0,0">

                        <!-- ==================== PARAMETROS GLOBALES DEL RACK (I-35, ronda 2 del Owner) ====================
                             Altura de cabecera, refuerzo del poste derivado y los dos overrides de separadores son del
                             RACK ENTERO, NO propiedades del modulo Separator: por eso viven en su propia seccion, ANTES y
                             SEPARADA de «Modulo seleccionado». Reutilizan las autoridades que la estructura dinamica
                             compuesta ya posee; aqui no se declara ninguna regla nueva. -->
                        <TextBlock Text="Parametros globales del rack" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="Aplican a todo el rack, no al modulo seleccionado. Vacio = calculo vigente."
                                   Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,4" />

                        <TextBlock Text="Altura de cabecera (in)" Style="{StaticResource FieldLabel}" />
                        <controls:NumericField x:Name="RackHeaderHeightBox" LostFocus="AdvancedRackParameter_Changed"
                                               Minimum="0" MinimumInclusive="False" ToolTipService.ShowOnDisabled="True"
                                               ToolTip="Altura manual de la cabecera. Vacio = la altura derivada de los niveles de carga." />

                        <!-- I-40 (Owner): la ALTURA del poste derivado, junto a la de su refuerzo. Vacio = hereda la
                             altura de la cabecera, que es lo que este poste ha hecho siempre. -->
                        <TextBlock Text="Altura del poste derivado (in)" Style="{StaticResource FieldLabel}" />
                        <controls:NumericField x:Name="DerivedPostHeightBox" LostFocus="AdvancedRackParameter_Changed"
                                               Minimum="0" MinimumInclusive="False" ToolTipService.ShowOnDisabled="True"
                                               ToolTip="Altura del poste derivado. Vacio = hereda la altura de la cabecera." />
                        <TextBlock Text="Vacio = hereda la altura de la cabecera."
                                   Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <CheckBox x:Name="DerivedPostReinforcedCheck" Content="Reforzar poste derivado" Margin="0,8,0,0"
                                  Foreground="{DynamicResource ShellTextPrimaryBrush}"
                                  Click="AdvancedRackParameter_Changed" ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Desactivarlo elimina SOLO el refuerzo. El poste derivado es consecuencia de dos separadores consecutivos y sigue existiendo." />
                        <TextBlock Text="Altura del refuerzo (in)" Style="{StaticResource FieldLabel}" />
                        <controls:NumericField x:Name="DerivedPostReinforcementHeightBox" LostFocus="AdvancedRackParameter_Changed"
                                               Minimum="0" MinimumInclusive="False" ToolTipService.ShowOnDisabled="True"
                                               ToolTip="Vacio = refuerzo a toda la altura del poste derivado." />
                        <TextBlock Text="Vacio = refuerzo a toda la altura del poste derivado."
                                   Foreground="#7A8794" FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Separadores (cantidad)" Style="{StaticResource FieldLabel}" />
                                <controls:NumericField x:Name="RackSeparatorCountBox" LostFocus="AdvancedRackParameter_Changed"
                                                       IntegerOnly="True" Minimum="0" MinimumInclusive="False"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       ToolTip="Cantidad de separadores por cabecera. Vacio = calculo automatico." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Separacion (in)" Style="{StaticResource FieldLabel}" />
                                <controls:NumericField x:Name="RackSeparatorSpacingBox" LostFocus="AdvancedRackParameter_Changed"
                                                       Minimum="0" MinimumInclusive="False" ToolTipService.ShowOnDisabled="True"
                                                       ToolTip="Separacion entre separadores. Vacio = calculo automatico. Independiente de la cantidad." />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="RestoreRackParametersButton" Content="Restaurar parametros globales"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="200" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Click="RestoreRackParameters_Click" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Devuelve los cuatro parametros globales a su calculo o default vigente." />

                        <Border Height="1" Background="{DynamicResource ShellBorderBrush}" Margin="0,12,0,10" />

                        <TextBlock Text="Modulo seleccionado" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="Modulo (secuencia longitudinal del rack)" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ModuleBox" SelectionChanged="Module_SelectionChanged"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Cabeceras y separadores en orden de profundidad. La seleccion es de una sola pieza." />

                        <TextBlock x:Name="ModuleInfoText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />

                        <TextBlock Text="Longitud consumida (in)" Style="{StaticResource FieldLabel}" />
                        <controls:NumericField x:Name="ModuleLengthBox" LostFocus="ModuleLength_Changed" Minimum="0"
                                               ToolTipService.ShowOnDisabled="True"
                                               ToolTip="Corrida longitudinal que ocupa este modulo. En una cabecera es su FONDO." />

                        <StackPanel x:Name="ModuleHeaderPanel" Margin="0,8,0,0">
                            <TextBlock x:Name="HeaderConfigureGroupTitle" Text="Configuracion"
                                       Style="{StaticResource FieldLabel}" />
                            <RadioButton x:Name="ModuleCalculatedRadio" Content="Calculada" GroupName="PushBackModuleConfig"
                                         Foreground="{DynamicResource ShellTextPrimaryBrush}" Margin="0,2,0,0"
                                         Checked="ModuleCalculated_Checked" ToolTipService.ShowOnDisabled="True"
                                         ToolTip="La cabecera se deriva de los datos del rack y se regenera en cada recalculo." />
                            <RadioButton x:Name="ModuleCustomRadio" Content="Personalizada" GroupName="PushBackModuleConfig"
                                         Foreground="{DynamicResource ShellTextPrimaryBrush}" Margin="0,2,0,0"
                                         IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                         ToolTip="Se activa sola al configurar la cabecera; un recalculo la conserva." />
                            <Button x:Name="ConfigureModuleHeaderButton" Content="Configurar cabecera..."
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="180" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Click="ConfigureModuleHeader_Click" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Abre el configurador sobre una COPIA. Al cerrarlo, el cambio queda pendiente de Confirmar." />

                            <!-- ==================== REUTILIZAR Y ALCANCE (I-40: PBH-03 y PBH-02) ====================
                                 Tres operaciones DISTINTAS y visualmente separadas, en el orden en que se piensan:
                                 CONFIGURACION (que cabecera quiero), REUTILIZAR (de donde la saco) y ALCANCE (a
                                 cuantas va). Ronda 2 del Owner: el alcance se dice en palabras del usuario -«Solo esta
                                 cabecera» / «Todas las cabeceras»-, nunca con el termino arquitectonico «aplicables»;
                                 las cabeceras que ningun corte dibuja (I-33) se excluyen POR DENTRO y la linea de
                                 estado explica cuantas cambiaron y cuantas se omitieron.

                                 Como ORIGEN solo aparecen cabeceras PERSONALIZADAS: copiar una calculada seria
                                 propagar el estandar mientras el usuario cree estar copiando lo suyo.

                                 El alcance NO es por frente ni por poste: los modulos siguen siendo UNA sola secuencia
                                 longitudinal. La operacion es ATOMICA -valida todos los destinos antes de tocar nada-
                                 y cada destino recibe su PROPIA copia, asi que modificar una despues jamas alcanza a
                                 las otras. No hay biblioteca ni referencia persistente. -->
                            <!-- ==================== ORIGEN Y DESTINOS (I-40, ronda 5 del Owner) ====================
                                 El alcance dejo de ser un enum de tres opciones acopladas a «Configurar cabecera».
                                 Ahora hay DOS EJES INDEPENDIENTES —CABECERAS destino y LINEAS destino— y los destinos
                                 son su PRODUCTO CARTESIANO. Configurar produce la configuracion ORIGEN; «Aplicar
                                 configuracion a la seleccion» la reparte. Elegir destinos no modifica nada por si
                                 mismo, y no hay que volver a abrir el configurador para cambiar la seleccion. -->
                            <TextBlock x:Name="HeaderReuseGroupTitle" Text="Reutilizar"
                                       Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <TextBlock Text="Copiar configuracion de:" Foreground="#7A8794" FontSize="9.5"
                                       TextWrapping="Wrap" Margin="0,0,0,2" />
                            <ComboBox x:Name="CopyHeaderFromBox" ToolTipService.ShowOnDisabled="True"
                                      ToolTip="Otra cabecera PERSONALIZADA de este rack. Se toma su configuracion como origen; no se guarda en ninguna biblioteca." />
                            <Button x:Name="CopyHeaderFromButton" Content="Tomar como origen"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="150" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Click="CopyHeaderFrom_Click" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Toma esa configuracion como origen y la aplica a la seleccion de destinos. Cada destino recibe una copia independiente." />

                            <TextBlock x:Name="HeaderTargetsGroupTitle" Text="Destino — cabeceras"
                                       Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <ListBox x:Name="HeaderTargetsList" SelectionMode="Extended" MaxHeight="110"
                                     SelectionChanged="HeaderDestinations_Changed"
                                     ToolTipService.ShowOnDisabled="True"
                                     ToolTip="Las cabeceras que recibiran la configuracion. Se pueden elegir varias." />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="HeaderTargetsThisButton" Content="Esta" MinWidth="64" Margin="0,0,6,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="HeaderTargetsThis_Click"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="Selecciona solo la cabecera del selector de modulo." />
                                <Button x:Name="HeaderTargetsAllButton" Content="Todas" MinWidth="72"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="HeaderTargetsAll_Click"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="Selecciona todas las cabeceras del rack." />
                            </WrapPanel>

                            <TextBlock x:Name="HeaderLinesGroupTitle" Text="Destino — lineas"
                                       Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <ListBox x:Name="HeaderLinesList" SelectionMode="Extended" MaxHeight="110"
                                     SelectionChanged="HeaderDestinations_Changed"
                                     ToolTipService.ShowOnDisabled="True"
                                     ToolTip="Las lineas transversales de postes —los cortes— que recibiran la configuracion. Se pueden elegir varias." />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="HeaderLinesThisButton" Content="Esta" MinWidth="64" Margin="0,0,6,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="HeaderLinesThis_Click"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="Selecciona solo la linea de origen." />
                                <Button x:Name="HeaderLinesAllButton" Content="Todas" MinWidth="72"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="HeaderLinesAll_Click"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="Selecciona todas las lineas del rack." />
                            </WrapPanel>

                            <TextBlock x:Name="HeaderSourceText" TextWrapping="Wrap" FontSize="10" Margin="0,10,0,0"
                                       Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                            <Button x:Name="ApplyHeaderSelectionButton" Content="Aplicar configuracion a la seleccion"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="240" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Click="ApplyHeaderSelection_Click" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Aplica la configuracion de origen a todas las combinaciones cabecera x linea seleccionadas. Queda pendiente de Confirmar." />

                            <TextBlock Text="Altura del poste derivado en las lineas seleccionadas (in)"
                                       Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                            <controls:NumericField x:Name="DerivedPostLineHeightBox" Minimum="0" MinimumInclusive="False"
                                                   ToolTipService.ShowOnDisabled="True"
                                                   ToolTip="Vacio = esas lineas vuelven a la altura del rack. El poste derivado pertenece a la LINEA, no a una cabecera." />
                            <Button x:Name="ApplyDerivedPostLinesButton" Content="Aplicar a las lineas seleccionadas"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="240" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Click="ApplyDerivedPostLines_Click" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Fija la altura del poste derivado en las lineas seleccionadas. Queda pendiente de Confirmar." />
                        </StackPanel>

                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="ConfirmModuleButton" Content="Confirmar" Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="96" Margin="0,0,6,6" Click="ConfirmModule_Click" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Aplica los cambios pendientes de modulo y recalcula." />
                            <Button x:Name="CancelModuleButton" Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="90" Margin="0,0,6,6" Click="CancelModule_Click" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Descarta los cambios pendientes de modulo; el diseno queda como estaba." />
                            <Button x:Name="RestoreModuleButton" Content="Restaurar modulo" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="140" Margin="0,0,6,6" Click="RestoreModule_Click" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Devuelve ESTE modulo a sus valores calculados. Queda pendiente de Confirmar." />
                            <Button x:Name="RestoreAllModulesButton" Content="Restaurar estandar" Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="150" Margin="0,0,0,6" Click="RestoreAllModules_Click" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Descarta TODAS las personalizaciones de modulo y vuelve a la estructura estandar. Queda pendiente de Confirmar." />
                        </WrapPanel>

                        <TextBlock x:Name="ModuleStatusText" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </shell:RackEditorVisualShell.SidePanelContent>

        <!-- ============================ STATUS: summary + messages + status line, always visible outside the scroll ============================
             The last valid computation's summary and its error/warning messages live HERE (SetStatus/RenderPreview target
             these x:Names); there is no second status inside the sidebar. -->
        <shell:RackEditorVisualShell.StatusContent>
            <StackPanel>
                <TextBlock x:Name="PreviewSummary" Foreground="{DynamicResource ShellTextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="PreviewHint" Foreground="{DynamicResource ShellTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource ShellTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </shell:RackEditorVisualShell.StatusContent>

        <!-- ============================ MATRIX: toolbar + card matrix ONLY ============================
             PB-VAL-01: the cell editor moved to the sidebar, so this surface holds only the structural toolbar, the
             informative frente × nivel cards. The rear tope is configured only from Seguridad. -->
        <shell:RackEditorVisualShell.MatrixContent>
            <Border x:Name="MatrixZone" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                <StackPanel Margin="10,8,10,10">

                    <TextBlock Text="Matriz frente × nivel — superficie principal de edición. Clic = celda primaria, Ctrl+clic = multiselección. Los datos se editan en el panel izquierdo; los topes posteriores, en Seguridad."
                               Style="{StaticResource FieldLabel}" Margin="0,0,0,6"
                               Foreground="{DynamicResource ShellTextSecondaryBrush}" TextWrapping="Wrap" />

                    <WrapPanel Margin="0,0,0,6">
                        <Button x:Name="AddFrontButton" Content="+ frente" MinWidth="74" Margin="0,0,4,4" Click="AddFront_Click" />
                        <Button x:Name="RemoveFrontButton" Content="- frente" MinWidth="74" Margin="0,0,12,4" Click="RemoveFront_Click" />
                        <Button x:Name="AddLevelButton" Content="+ nivel" MinWidth="74" Margin="0,0,4,4" Click="AddLevel_Click" />
                        <Button x:Name="RemoveLevelButton" Content="- nivel" MinWidth="74" Margin="0,0,12,4" Click="RemoveLevel_Click" />
                        <TextBlock Text="Frente" VerticalAlignment="Center" Margin="0,0,4,4" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <ComboBox x:Name="SelectedFrontBox" Width="64" Margin="0,0,10,4" SelectionChanged="SelectedFront_Changed" />
                        <TextBlock Text="Nivel" VerticalAlignment="Center" Margin="0,0,4,4" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <ComboBox x:Name="SelectedLevelBox" Width="64" Margin="0,0,10,4" SelectionChanged="SelectedLevel_Changed" />
                    </WrapPanel>

                    <!-- THE central editing surface: one informative card per frente x nivel (clic = primaria,
                         Ctrl+clic = multiselección). Built imperatively from PushBackMatrixCardModel; the authority
                         is PushBackEditorState.Structure — the grid stores nothing. -->
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid x:Name="PushBackMatrixGrid" Margin="0,2,4,2" />
                    </ScrollViewer>

                </StackPanel>
            </Border>
        </shell:RackEditorVisualShell.MatrixContent>

        <!-- ============================ PREVIEW: technical role-lines preview on the shared DARK surface + view selector ============================ -->
        <shell:RackEditorVisualShell.PreviewContent>
            <Border x:Name="PreviewZone" Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="10,8,10,6">
                        <TextBlock Text="Vista" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <ComboBox x:Name="ViewBox" Width="196" Margin="0,0,12,0" SelectionChanged="View_Changed" />
                        <TextBlock x:Name="LateralSectionLabel" Text="Corte" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource ShellTextPrimaryBrush}" />
                        <ComboBox x:Name="LateralSectionBox" Width="84" SelectionChanged="View_Changed" />
                        <TextBlock x:Name="PreviewLegend" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource ShellTextSecondaryBrush}" />
                    </WrapPanel>
                    <Canvas x:Name="PreviewCanvas" Grid.Row="1" Background="{DynamicResource ShellPreviewBackgroundBrush}" ClipToBounds="True"
                            SizeChanged="PreviewCanvas_SizeChanged" />
                </Grid>
            </Border>
        </shell:RackEditorVisualShell.PreviewContent>

        <!-- ============================ ACTIONS: neutral categories + common button styles ============================
             Leading = Restaurar (Secondary); Secondary = BOM/biblioteca (Secondary); Primary = Actualizar (Primary CTA) +
             las cuatro inserciones por vista (Secondary, vistas secundarias) + Insertar vista actual (Primary, acción
             primaria de inserción); Trailing = Cerrar (Secondary). Los estados IsEnabled y los tooltips (incluidos los
             motivos de indisponibilidad) los fija el code-behind por x:Name; ToolTipService.ShowOnDisabled los muestra
             cuando la acción está deshabilitada. -->
        <shell:RackEditorVisualShell.LeadingActions>
            <Button x:Name="RestoreButton" Content="Restaurar" Style="{StaticResource SecondaryButtonStyle}" MinWidth="88" Margin="{StaticResource ActionLast}"
                    ToolTipService.ShowOnDisabled="True" Click="Restore_Click" ToolTip="Vuelve a los valores calculados del sistema." />
        </shell:RackEditorVisualShell.LeadingActions>
        <shell:RackEditorVisualShell.SecondaryActions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="BomButton" Content="BOM" Style="{StaticResource SecondaryButtonStyle}" MinWidth="72" Margin="{StaticResource ActionGap}"
                        ToolTipService.ShowOnDisabled="True" Click="Bom_Click" ToolTip="Lista de materiales del sistema actual." />
                <Button x:Name="SaveLibraryButton" Content="Guardar en biblioteca" Style="{StaticResource SecondaryButtonStyle}" MinWidth="152" Margin="{StaticResource ActionLast}"
                        ToolTipService.ShowOnDisabled="True" Click="SaveLibrary_Click" ToolTip="Guarda este diseño Push Back en la biblioteca." />
            </StackPanel>
        </shell:RackEditorVisualShell.SecondaryActions>
        <shell:RackEditorVisualShell.PrimaryActions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="UpdateButton" Content="Actualizar" Style="{StaticResource PrimaryButtonStyle}" MinWidth="104" Margin="{StaticResource ActionGroupGap}"
                        ToolTipService.ShowOnDisabled="True" Click="Update_Click" ToolTip="Redibuja en sitio todas las vistas ligadas de este rack." />
                <Button x:Name="InsertLateralButton" Content="Insertar lateral" Style="{StaticResource SecondaryButtonStyle}" MinWidth="120" Margin="{StaticResource ActionGap}"
                        ToolTipService.ShowOnDisabled="True" Click="InsertLateral_Click" ToolTip="Inserta el corte lateral seleccionado." />
                <Button x:Name="InsertFrontalEntradaButton" Content="Frontal entrada/salida" Style="{StaticResource SecondaryButtonStyle}" MinWidth="160" Margin="{StaticResource ActionGap}"
                        ToolTipService.ShowOnDisabled="True" Click="InsertFrontalEntrada_Click" ToolTip="Inserta el corte frontal del extremo bajo." />
                <Button x:Name="InsertFrontalPosteriorButton" Content="Frontal posterior" Style="{StaticResource SecondaryButtonStyle}" MinWidth="128" Margin="{StaticResource ActionGap}"
                        ToolTipService.ShowOnDisabled="True" Click="InsertFrontalPosterior_Click" ToolTip="Inserta el corte frontal del extremo alto." />
                <!-- I-42: en un rack de DOS sentidos «entrada/salida» y «posterior» no dicen de que lado son. Este
                     selector aparece solo con el compuesto encendido y CALIFICA a los dos botones de al lado, de modo
                     que los cuatro cortes —entrada/salida y posterior de cada lado— son pedibles y visibles sin
                     conocer ningun modo interno. Con el compuesto apagado no existe y la barra es la de siempre.
                     Cuatro botones no caben: la barra de acciones ya lleva doce y se recortarian. -->
                <ComboBox x:Name="FrontalSideBox" Width="104" VerticalContentAlignment="Center"
                          Margin="{StaticResource ActionGap}" Visibility="Collapsed"
                          SelectionChanged="FrontalSide_Changed"
                          ToolTipService.ShowOnDisabled="True"
                          ToolTip="De qu&#233; lado son los dos cortes frontales de al lado. Es independiente del lado que se est&#233; editando." />
                <Button x:Name="InsertPlantaButton" Content="Planta" Style="{StaticResource SecondaryButtonStyle}" MinWidth="88" Margin="{StaticResource ActionGroupGap}"
                        ToolTipService.ShowOnDisabled="True" Click="InsertPlanta_Click" ToolTip="Inserta la vista en planta." />
                <Button x:Name="InsertButton" Content="Insertar vista actual" Style="{StaticResource PrimaryButtonStyle}" MinWidth="152" Margin="{StaticResource ActionLast}"
                        ToolTipService.ShowOnDisabled="True" Click="Insert_Click" ToolTip="Inserta la vista seleccionada en el previsualizador." />
            </StackPanel>
        </shell:RackEditorVisualShell.PrimaryActions>
        <shell:RackEditorVisualShell.TrailingActions>
            <Button x:Name="CloseButton" Content="Cerrar" Style="{StaticResource SecondaryButtonStyle}" MinWidth="88" Margin="{StaticResource ActionLast}" IsCancel="True" Click="Close_Click" />
        </shell:RackEditorVisualShell.TrailingActions>
    </shell:RackEditorVisualShell>
</Window>
